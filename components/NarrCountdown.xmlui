<!-- A narration's countdown while it records: the clip's start and end with a
     ProgressBar between them
     (https://www.xmlui.org/docs/reference/components/ProgressBar), and the
     Stop button, which counts down the seconds left. Its own component, as
     Playhead is, because it changes every tick: when the whole Narrate tab
     took each tick, the countdown lagged behind the recording (user,
     2026-10-13). The Stop button is here, not in the tab, so the countdown
     is where you look to stop.

     Props: clip ([start, end], the stretch being recorded). time starts at
     the clip's start (it started at 0, and the first frame read the clip's
     end as the seconds left: "24 s left" for a 5 s narration), and the
     seconds left never exceed the clip's length. Event: stop().
     Method:
     setTime(t), the playhead, called by the editor's 40 ms tick while
     recording (https://www.xmlui.org/docs/howto/pass-arguments-to-a-component-method). -->
<Component name="NarrCountdown" var.time="{$props.clip ? $props.clip[0] : 0}">
  <method name="setTime">
    (t) => { time = t; }
  </method>
  <VStack>
    <HStack verticalAlignment="center">
      <Text value="{$props.clip ? $props.clip[0].toFixed(2) + ' s' : ''}" />
      <ProgressBar width="*"
        value="{$props.clip ? Math.max(0, Math.min(1, (time - $props.clip[0]) / ($props.clip[1] - $props.clip[0]))) : 0}" />
      <Text value="{$props.clip ? $props.clip[1].toFixed(2) + ' s' : ''}" />
    </HStack>
    <Button label="{'⏹ Stop recording · ' + ($props.clip ? Math.min($props.clip[1] - $props.clip[0], Math.max(0, $props.clip[1] - time)).toFixed(1) : '0.0') + ' s left'}"
      size="xs" themeColor="attention"
      tooltip="Stop now: what you said so far replaces the audio, and the rest of the clip is silent"
      handlerTimeoutMs:onClick="0"
      onClick="emitEvent('stop')" />
  </VStack>
</Component>
