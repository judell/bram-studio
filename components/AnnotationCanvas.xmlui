<!-- The take editor's picture: the scene's items as PointerLayer anchors over
     the player, with the current item's handles. Everything that changes per
     pointer move lives here, so a drag re-evaluates only this component, not
     the whole page (every binding in App scope re-ran on each move, ~200 ms
     each in an Inspector trace, 2026-10-05:
     https://www.xmlui.org/docs/howto/confine-a-hot-input-to-its-own-component).

     Props: aspect (the picture's), tool (PointerLayer's), sprites (the
     scene's saved sprites), time (the playhead), current ({id, box, shape,
     shown, sprite}: the current item, its box as saved, its latest sprite).
     The player is the children (<Slot />): slot content evaluates in the
     caller's scope, so its id stays the page's:
     https://www.xmlui.org/docs/howto/pass-a-template-slot-to-a-component

     Events, committed values only (emitEvent; props in, events out:
     https://www.xmlui.org/docs/howto/emit-a-custom-event-from-a-component):
     pickItem(id) when a drag starts on another item, which becomes current
     and moves; moveItem({dx, dy}) and resizeItem(box) when a drag ends;
     drawItem(e) for a ⌘-drag (PointerLayer's shapeEnd).

     dragPos: the current item's anchor while it's moved. liveBox: its box
     while a handle is dragged, drawn as a plain outline (no server call)
     until the page's new sprite arrives. Both clear when the sprite or the
     current item changes, or on release(), for a drag the page didn't save
     (it came back, or hit the edge). Helpers (EDGES, resized, outline) are in
     the <script> below (https://www.xmlui.org/docs/helper-tags#script), not a
     code-behind file: the standalone engine loads a component it discovers
     on demand without its .xmlui.xs, which left them undefined. -->
<Component name="AnnotationCanvas" var.dragPos="{null}" var.dragFrom="{null}" var.liveBox="{null}"
  var.cur="{$props.current || {}}"
  var.handleBox="{cur.shown &amp;&amp; (liveBox || cur.box) ? (!cur.shape &amp;&amp; !liveBox &amp;&amp; cur.box.x2 - cur.box.x1 &lt; 0.001 &amp;&amp; cur.sprite ? { x1: cur.sprite.x, y1: cur.sprite.y, x2: cur.sprite.x + cur.sprite.width, y2: cur.sprite.y + cur.sprite.height } : (liveBox || cur.box)) : null}"
  var.handles="{handleBox &amp;&amp; $props.aspect &amp;&amp; !dragPos &amp;&amp; cur.shape !== 'pointer' ? ((cur.shape === 'arrow' || cur.shape === 'line') ? [['a', handleBox.x1, handleBox.y1], ['b', handleBox.x2, handleBox.y2]] : [['nw', handleBox.x1, handleBox.y1], ['n', (handleBox.x1 + handleBox.x2) / 2, handleBox.y1], ['ne', handleBox.x2, handleBox.y1], ['e', handleBox.x2, (handleBox.y1 + handleBox.y2) / 2], ['se', handleBox.x2, handleBox.y2], ['s', (handleBox.x1 + handleBox.x2) / 2, handleBox.y2], ['sw', handleBox.x1, handleBox.y2], ['w', handleBox.x1, (handleBox.y1 + handleBox.y2) / 2]]).map((h) => ({ id: h[0], url: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 10%22%3E%3Crect x=%221%22 y=%221%22 width=%228%22 height=%228%22 fill=%22white%22 stroke=%22%23222%22 stroke-width=%221.5%22/%3E%3C/svg%3E', x: h[1] - 0.009, y: h[2] - 0.009 * $props.aspect, width: 0.018, height: 0.018 * $props.aspect, cursor: { nw: 'nwse-resize', se: 'nwse-resize', ne: 'nesw-resize', sw: 'nesw-resize', n: 'ns-resize', s: 'ns-resize', e: 'ew-resize', w: 'ew-resize' }[h[0]] || 'crosshair' })) : []}">

  <!-- What clears the drag state: a new sprite (the page saved and redrew
       the item) or another current item. -->
  <ChangeListener listenTo="{cur.sprite ? cur.sprite.url : null}" onDidChange="dragPos = null; liveBox = null;" />
  <ChangeListener listenTo="{cur.id}" onDidChange="dragPos = null; liveBox = null; dragFrom = null;" />

  <method name="release">
    () => { dragPos = null; liveBox = null; }
  </method>

  <script>
    // A handle's edges: which of x1, y1, x2, y2 follow the pointer.
    var EDGES = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1],
                  s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0], a: [1, 1, 0, 0], b: [0, 0, 1, 1] };
    // The box a handle drag gives, from the box at its start: an arrow's or
    // line's ends move freely; a box keeps a minimum size.
    function resized(id, b, dx, dy) {
      const g = EDGES[id];
      if (cur.shape === 'arrow' || cur.shape === 'line') {
        return { x1: Math.min(1, Math.max(0, b.x1 + g[0] * dx)), y1: Math.min(1, Math.max(0, b.y1 + g[1] * dy)),
                 x2: Math.min(1, Math.max(0, b.x2 + g[2] * dx)), y2: Math.min(1, Math.max(0, b.y2 + g[3] * dy)) };
      }
      return { x1: Math.max(0, Math.min(b.x1 + g[0] * dx, b.x2 - 0.04)), y1: Math.max(0, Math.min(b.y1 + g[1] * dy, b.y2 - 0.03)),
               x2: Math.min(1, Math.max(b.x2 + g[2] * dx, b.x1 + 0.04)), y2: Math.min(1, Math.max(b.y2 + g[3] * dy, b.y1 + 0.03)) };
    }
    // The current item while a handle is dragged: an outline of liveBox (a
    // line, for an arrow or a line), drawn here rather than fetched.
    function outline(b) {
      const x = Math.min(b.x1, b.x2);
      const y = Math.min(b.y1, b.y2);
      const w = Math.max(Math.abs(b.x2 - b.x1), 0.004);
      const h = Math.max(Math.abs(b.y2 - b.y1), 0.004);
      const free = cur.shape === 'arrow' || cur.shape === 'line';
      const mark = free
        ? '%3Cline x1=%22' + (b.x2 >= b.x1 ? 0 : 100) + '%22 y1=%22' + (b.y2 >= b.y1 ? 0 : 100) + '%22 x2=%22' + (b.x2 >= b.x1 ? 100 : 0) + '%22 y2=%22' + (b.y2 >= b.y1 ? 100 : 0) + '%22/%3E'
        : '%3Crect x=%220%22 y=%220%22 width=%22100%22 height=%22100%22 fill=%22none%22/%3E';
      return { id: cur.id, x: x, y: y, width: w, height: h,
               url: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22 preserveAspectRatio=%22none%22 overflow=%22visible%22 stroke=%22%23ff3b30%22 stroke-width=%223%22 vector-effect=%22non-scaling-stroke%22%3E' + mark + '%3C/svg%3E' };
    }
  </script>

  <PointerLayer contentAspect="{$props.aspect}" anchorDrag="true" pointerShape="arrow" tool="{$props.tool}"
    anchors="{(($props.sprites || []).filter((a) => a.id === cur.id ? cur.shown : ($props.time >= a.t_in &amp;&amp; $props.time &lt;= a.t_out))
              .concat(cur.shown &amp;&amp; cur.sprite &amp;&amp; !($props.sprites || []).some((a) => a.id === cur.id) ? [cur.sprite] : [])
              .map((a) => a.id !== cur.id ? a
                : liveBox ? outline(liveBox)
                : { id: a.id, url: (cur.sprite || a).url, x: dragPos ? dragPos.x : (cur.sprite || a).x, y: dragPos ? dragPos.y : (cur.sprite || a).y,
                    width: (cur.sprite || a).width, height: (cur.sprite || a).height }))
              .concat(handles)}"
    onAnchorDragStart="(e) => {
      if (EDGES[e.id]) {
        dragFrom = handleBox;
      } else if (e.id !== cur.id) {
        emitEvent('pickItem', e.id);
        dragFrom = null;
      }
    }"
    onAnchorDragMove="(e) => {
      if (EDGES[e.id]) {
        if (dragFrom) liveBox = resized(e.id, dragFrom, e.dx, e.dy);
      } else {
        dragPos = { x: e.x, y: e.y };
      }
    }"
    onAnchorDragEnd="(e) => {
      if (EDGES[e.id]) {
        const nb = dragFrom ? resized(e.id, dragFrom, e.dx, e.dy) : null;
        dragFrom = null;
        if (nb) {
          liveBox = nb;
          emitEvent('resizeItem', nb);
        }
      } else if (e.dx === 0 &amp;&amp; e.dy === 0) {
        dragPos = null;
      } else {
        emitEvent('moveItem', { dx: e.dx, dy: e.dy });
      }
    }"
    onShapeEnd="(e) => emitEvent('drawItem', e)">
    <Slot />
    <property name="anchorTemplate">
      <!-- PointerLayer gives every draggable anchor cursor: move, handles
           too; each anchor's own cursor (a handle's resize cursor, an
           item's move) is set on the image, which wins while the pointer is
           over it: https://www.xmlui.org/docs/styles-and-themes/layout-props#cursor -->
      <Image src="{$item.url}" width="100%" cursor="{$item.cursor || 'move'}" />
    </property>
  </PointerLayer>
</Component>
