<!-- The Podcast editor, what a podcast project opens in (Main.xmlui's page
     at /): where a recorded conversation is edited and its companion
     composed. Its source is the project's (project.json's sources, passed
     as the sources prop): the first one, with a picker only when the project
     has several. Transcribe it (serve_media.py's
     /transcripts/start runs whisper-cli with the names you give it), then
     edit it on the Edit text tab. A source is transcribed once: Transcribe
     is offered only while it has no finished transcript. The project's
     speakers are kept on the Settings page (components/Settings.xmlui).

     Labeling segments happens in conversation for now: the agent labels
     through /segments/speaker, and every write arrives here as an /events
     message ({changed: 'transcripts'|'speakers'}), so this page refetches
     on those alone and its own handlers don't. Progress while whisper runs
     arrives the same way ({transcribing, done_s, duration_s}).

     The transcript is a List (virtualized:
     https://www.xmlui.org/docs/reference/components/List), preserve-state
     keeping its scroll across a refetch. Clicking a row's time plays from
     there; while playing, the spoken row is tinted. (A speaker filter,
     scroll-to-follow and on-page labeling were tried and taken out until
     there's a use for them.) -->
<Component name="Podcast"
  var.source="{($props.sources || [])[0] || ''}" var.currentId="{null}" var.progress="{null}" var.checkBusy="{false}" var.checkProgress="{null}"
  var.tagMode="{false}" var.project="{$props.project || ''}" var.openCut="{null}" var.openSample="{null}" var.jumped="{false}" var.view="{$props.view || 'Edit text'}" var.currentPara="{null}" var.paraClock="{null}" var.rawPlace="{null}" var.samplesHold="{null}"
  var.leader="{null}" var.videoPara="{null}" var.cardSeek="{null}"
  var.findText="{''}" var.findNeedle="{''}" var.findCursor="{0}">

  <DataSource id="transcript" url="{window.STUDIO_API + '/query?p=' + encodeURIComponent(project || '')}" method="POST" dataType="sql"
    body="{{ sql: 'SELECT status, model, prompt, duration_s, finished_at FROM transcripts WHERE source = ?', params: [source] }}" />
  <DataSource id="segments" url="{window.STUDIO_API + '/query?p=' + encodeURIComponent(project || '')}" method="POST" dataType="sql"
    body="{{ sql: 'SELECT g.id, g.t0, g.t1, g.text, g.speaker_id, s.name, s.color FROM segments g LEFT JOIN speakers s ON s.id = g.speaker_id WHERE g.source = ? ORDER BY g.t0',
             params: [source] }}" />
  <!-- Raw transcript opened from the Workspace (para=N): where paragraph N
       starts in the original recording, so the segment holding it can be
       scrolled to and tinted. -->
  <DataSource id="paraStart" when="{view === 'Transcript' &amp;&amp; !!source &amp;&amp; $props.para !== undefined &amp;&amp; $props.para !== null &amp;&amp; $props.para !== ''}"
    url="{window.STUDIO_API + '/query?p=' + encodeURIComponent(project || '')}" method="POST" dataType="sql"
    body="{{ sql: 'SELECT min(t0) AS t0 FROM words WHERE source = ? AND para = ?', params: [source, Number($props.para)] }}" />
  <!-- Raw transcript's place, the other way: the paragraph of the segment
       playing (currentId follows playback), by the last word starting at or
       before the segment's start. Emitted as the Workspace's selection
       (raw-transcript-play-sets-workspace-place). -->
  <DataSource id="playPara" when="{view === 'Transcript' &amp;&amp; !!source &amp;&amp; currentId !== null &amp;&amp; !!segments.value &amp;&amp; !!segments.value.find((s) => s.id === currentId)}"
    url="{window.STUDIO_API + '/query?p=' + encodeURIComponent(project || '')}" method="POST" dataType="sql"
    body="{{ sql: 'SELECT para FROM words WHERE source = ? AND t0 &lt;= ? ORDER BY t0 DESC LIMIT 1', params: [source, segments.value &amp;&amp; segments.value.find((s) => s.id === currentId) ? segments.value.find((s) => s.id === currentId).t0 : 0] }}" />

  <!-- The text to edit and the cut list (serve_media.py's /transcripts/text
       and /transcripts/cuts). These and the paragraphs and samples wait for a
       finished transcript: asked before one exists, each answered 404 and
       showed as an error (a new project, 2026-11-14). -->
  <DataSource id="textDoc" when="{!!source &amp;&amp; !!(transcript.value &amp;&amp; transcript.value[0] &amp;&amp; transcript.value[0].status === 'done')}"
    url="{window.STUDIO_API + '/transcripts/text?source=' + encodeURIComponent(source) + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />
  <!-- The paragraphs to edit, each with a version (key) that changes when an
       edit touches it (/transcripts/paras). -->
  <DataSource id="paras" when="{!!source &amp;&amp; !!(transcript.value &amp;&amp; transcript.value[0] &amp;&amp; transcript.value[0].status === 'done')}"
    url="{window.STUDIO_API + '/transcripts/paras?source=' + encodeURIComponent(source) + (tagMode ? '&amp;words=1' : '') + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />
  <!-- Each speaker's tagged and matched speech, and whether it has enough
       tagged to be matched (/speakers/stats; the need is a Setting). -->
  <!-- The sample stretches and their check (/speakers/samples), while
       Samples is on. -->
  <DataSource id="samples" when="{!!source &amp;&amp; tagMode &amp;&amp; !!(transcript.value &amp;&amp; transcript.value[0] &amp;&amp; transcript.value[0].status === 'done')}"
    url="{window.STUDIO_API + '/speakers/samples?source=' + encodeURIComponent(source) + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />
  <DataSource id="speakerStats" when="{!!source}"
    url="{window.STUDIO_API + '/speakers/stats?source=' + encodeURIComponent(source) + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />
  <DataSource id="cutList" when="{!!source &amp;&amp; !!(transcript.value &amp;&amp; transcript.value[0] &amp;&amp; transcript.value[0].status === 'done')}"
    url="{window.STUDIO_API + '/transcripts/cuts?source=' + encodeURIComponent(source) + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />

  <EventSource url="{window.STUDIO_API}/events"
    onMessage="(m) => {
      if (m.transcribing) { if (m.transcribing === source) progress = m; }
      else if (m.changed === 'transcripts') { progress = null; transcript.refetch(); segments.refetch(); textDoc.refetch(); cutList.refetch(); }
      else if (m.changed === 'speakers') { segments.refetch(); speakerStats.refetch(); paras.refetch(); }
      else if (m.changed === 'words') { textDoc.refetch(); cutList.refetch(); paras.refetch(); speakerStats.refetch(); if (tagMode) samples.refetch(); }
      else if (m.samplesChecked) { if (m.samplesChecked === source &amp;&amp; tagMode) samples.refetch(); }
      else if (m.checking) { if (m.checking === source) { checkBusy = !m.done; checkProgress = m.done ? null : m; } }
    }" />

  <script>
    // Find (find-in-long-views): one find state, for whichever list the
    // view shows (the Workspace's paragraphs or the Raw transcript's
    // segments), cleared on a change of view. index.html studioFindPlan.
    function fp() {
      return view === 'Transcript'
        ? window.studioFindPlan(segments.value || [], findNeedle, findCursor, 'text', 'id', 'raw')
        : window.studioFindPlan(paras.value || [], findNeedle, findCursor, 'text', 'para', 'workspace');
    }
    // A finished transcript: what the text, paragraphs and cuts need.
    function transcribed() {
      return !!(transcript.value && transcript.value[0] && transcript.value[0].status === 'done');
    }
    function stamp(s) {
      const t = Math.floor(s || 0);
      const h = Math.floor(t / 3600), m = Math.floor(t / 60) % 60, sec = t % 60;
      return (h ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(sec).padStart(2, '0');
    }
    // The segment being spoken at t (segments are in time order).
    function segmentAt(t) {
      const rows = segments.value || [];
      let lo = 0, hi = rows.length - 1, found = null;
      while (lo <= hi) {
        const mid = (lo + hi) >> 1;
        if (rows[mid].t0 <= t) { found = rows[mid]; lo = mid + 1; } else hi = mid - 1;
      }
      return found && t < found.t1 + 1 ? found.id : null;
    }
    function post(path, body) {
      return Actions.callApi({ url: window.STUDIO_API + path, method: 'post', invalidates: [], body });
    }
    function transcribe() {
      try {
        post('/transcripts/start', { source });
        progress = { done_s: 0, duration_s: 0 };
      } catch (e) {
        toast.error(e.message);
      }
    }
    function textChange(path, body) {
      try {
        const r = post(path, Object.assign({ source }, body));  // body.source, when given, wins
        // No toast for a change that went as typed (the paragraph shows it);
        // only for typed words that couldn't be kept, which would otherwise
        // vanish without a word.
        if (r.ignored) toast(r.ignored + (r.ignored === 1 ? ' typed word has' : ' typed words have')
                             + ' no audio, so ' + (r.ignored === 1 ? 'it was' : 'they were') + ' left out.');
      } catch (e) {
        toast.error(e.message);
      }
    }
    // A paragraph's save, called from its box's lost-focus handler with
    // everything it needs. The draft lives on the paragraph's row (var.draft),
    // not in this component's variables: from inside Tabs > List, assigning
    // those doesn't take, even directly in a handler (xmlui-org/xmlui#3940;
    // the podcast-page log showed it, 2026-11-13).
    function savePara(src, para, text) {
      textChange('/transcripts/edit', { source: src, para, text });
    }
    // Undo and Redo bring the paragraph they changed into view; the line
    // under the buttons says what the next of each would do. No toast: a
    // pop-up per press got in the way of undoing and redoing quickly.
    function stepText(path) {
      try {
        const r = post(path, { source });
        if (r.para !== null && r.para !== undefined) paraList.scrollToIndex(r.para);
      } catch (e) {
        toast.error(e.message);
      }
    }
    // Replace (podcast-search-replace): every "before" in the kept words,
    // any case, becomes "after" as typed, each word keeping its time; one
    // Undo takes it all back. The text refreshes through the words push.
    function replaceWords() {
      const before = (replaceBefore.value || '').trim();
      const after = (replaceAfter.value || '').trim();
      if (!before) return;
      try {
        const r = post('/transcripts/replace', { source, before, after });
        if (r.replaced) {
          toast.success('Replaced ' + r.replaced + (r.replaced === 1 ? ' word' : ' words') + ' in '
            + r.paragraphs + (r.paragraphs === 1 ? ' paragraph' : ' paragraphs'));
          replaceBefore.setValue('');
          replaceAfter.setValue('');
        } else {
          toast('No “' + before + '” to replace');
        }
      } catch (e) {
        toast.error(e.message);
      }
    }
    function undoText() { stepText('/transcripts/undo'); }
    function redoText() { stepText('/transcripts/redo'); }
    // A paragraph's Elide / Restore tics, called from inside the list with
    // everything it needs (xmlui-org/xmlui#3940: no component variables in here).
    function paraTics(path, body) { textChange(path, body); }
    // Tagging: the words from one click to the next go to the speaker in
    // the "Tag as" list ("(no speaker)" clears them). Called from inside the
    // list with everything it needs (#3940).
    function tagRange(src, fromId, toId, speakerId) {
      try {
        post('/words/speaker', { source: src, from_id: fromId, to_id: toId, speaker_id: speakerId });
      } catch (e) {
        toast.error(e.message);
      }
    }
    // A sample's speaker by id, for its hover; the row passes its roster in
    // (#3940: no component variables in the list).
    function nameOf(roster, id) {
      const x = (roster || []).find((r) => r.id === id);
      return x ? x.name : 'a deleted speaker';
    }
    // A word inside the row's selection (word ids rise with position).
    function inRange(id, a, b) {
      if (a === null) return false;
      const lo = b === null ? a : Math.min(a, b), hi = b === null ? a : Math.max(a, b);
      return id >= lo && id <= hi;
    }
    // A sample's sound alone (or a flagged part of one), so its player's
    // scrubber spans just that stretch (/speakers/sample-audio).
    function sampleAudio(t0, t1) {
      return window.STUDIO_API + '/speakers/sample-audio?source=' + encodeURIComponent(source)
        + '&t0=' + t0 + '&t1=' + t1;
    }
    function clearSample(src, fromId, toId) {
      tagRange(src, fromId, toId, null);
    }
    function sampleSummary() {
      const s = samples.value;
      if (!s) return 'Samples';
      const flagged = s.stretches.filter((x) => x.flags.length).length;
      return s.stretches.length + ' samples'
        + (s.checking ? ' · checking…' : s.checked ? (flagged ? ' · ⚠ ' + flagged + ' with someone else in them' : ' · all clean') : '');
    }
    function taggedLine() {
      const st = speakerStats.value;
      if (!st || !st.speakers.length) return 'No speakers yet: add them in Settings › Speakers.';
      return 'Samples: ' + st.speakers.map((s) => s.name.split(' ')[0] + ' ' + Math.round(s.tagged) + ' s').join(' · ');
    }
    function playUrl(item) {
      return window.STUDIO_API + '/transcripts/play?source=' + encodeURIComponent(source)
        + '&para=' + item.para + '&v=' + item.v;
    }
    // The paragraph the left pane's video follows: the current one, on Edit
    // text, if any of it is kept.
    function followItem() {
      if (view !== 'Edit text' || currentPara === null || !paras.value) return null;
      const p = paras.value.find((x) => x.para === currentPara);
      return p && p.kept > 0 ? p : null;
    }
    // Put the video where the card's player is (paraClock), playing or not.
    // Logs the video's time before the move: how far it had drifted.
    // Whose sound you hear: 'card' (the video follows a card's player,
    // muted) or 'video' (you played or paused the main video yourself; it
    // has its sound and the cards stop). Logged (podcast-page: leader).
    function setLeader(who, by) {
      if (leader === who) return;
      leader = who;
      Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                        body: { ev: 'leader', leader: who, by, para: currentPara } });
    }
    // Did the main video play or pause because of you? Not if it is showing
    // a paragraph other than the current one (a pause from loading a new
    // file), nor if it did what its card is doing (applyClock following).
    // Nor at its end (t within 0.1 s of it): a paragraph played to the end
    // pauses the video before its card says so.
    function videoTouched(playing, t) {
      if (videoPara !== currentPara) return false;
      if (!playing && t !== undefined && paraVideo.duration && t >= paraVideo.duration - 0.1) return false;
      const c = paraClock;
      return !(leader === 'card' && c && c.para === currentPara && c.playing === playing);
    }
    function playRejected(why, err) {
      Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                        body: { ev: 'clock', why, playRejected: String((err && err.message) || err) } });
    }
    function applyClock(why) {
      const c = paraClock;
      if (leader === 'video' || !c || c.para !== currentPara || !followItem()) return;
      const before = paraVideo.getCurrentTime();
      paraVideo.seek(c.t);
      // A play still pending when the video's file changes or the video is
      // removed is rejected by the browser ("interrupted by load", "media
      // was removed from the document"). Expected: a new file re-applies
      // the clock once loaded. Logged, not shown.
      if (c.playing) {
        try {
          const p = paraVideo.play();
          if (p && typeof p.catch === 'function') p.catch((err) => playRejected(why, err));
        } catch (err) {
          playRejected(why, err);
        }
      } else paraVideo.pause();
      Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                        body: { ev: 'clock', why, para: c.para, by: c.by, card: c.t, video: before,
                                drift: Math.round((before - c.t) * 1000) / 1000, playing: c.playing } });
    }
    function clipChanged(c) {
      const prev = c ? c.prevValue : '', now = c ? c.newValue : '';
      if (!prev || !now || prev.split(':')[0] !== now.split(':')[0]) return;
      cardSeek = null;
      paraClock = { para: currentPara, t: 0, playing: false, by: 'rerendered', n: Date.now() };
      Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                        body: { ev: 'clock', why: 'rerendered', para: currentPara, was: prev, now } });
    }
    function editLine() {
      const d = textDoc.value, c = cutList.value;
      if (!d) return '';
      return d.keptWords + ' words kept' + (c ? ', ' + stamp(c.keptSecs) + ' long' : '')
        + (d.cutWords ? '; ' + d.cutWords + ' cut' + (c ? ' (' + stamp(c.cutSecs) + ')' : '') : '');
    }
    function startCheck() {
      try {
        post('/transcripts/check', { source });
        checkBusy = true;
      } catch (e) {
        toast.error(e.message);
      }
    }
    // The last check's verdict, and any cut placed without alignment.
    function checkLine() {
      const c = cutList.value;
      if (!c) return '';
      const parts = [];
      if (checkBusy) parts.push('Checking joins: rendering the edit and listening to it'
        + (checkProgress && checkProgress.duration_s ? ', ' + stamp(checkProgress.done_s) + ' of ' + stamp(checkProgress.duration_s) : '…'));
      else if (c.check) parts.push('Checked ' + c.check.at + ': ' + c.check.joins + ' joins, '
        + (c.check.suspect ? c.check.suspect + ' to listen to (marked ⚠ under Cuts)' : 'all heard as the text reads')
        + (c.check.range[0] || c.check.range[1] ? ' (' + stamp(c.check.range[0]) + '–' + stamp(c.check.range[1]) + ' only)' : '')
        + '. Edits since then aren’t checked.');
      if (c.unaligned) parts.push(c.unaligned + ' cuts placed without alignment (marked ⚠).');
      return parts.join(' ');
    }
    function playFrom(t) {
      speakerPlayer.seek(t);
      speakerPlayer.play();
    }
  </script>

  <VStack padding="$space-6" gap="$space-4" height="calc(100vh - 150px)">
    <!-- Opened from the final transcript's Edit (?para=&back=): that
         paragraph is selected and scrolled to, once its list has loaded, and
         a link goes back to where you were in the transcript. -->
    <Link when="{!!$props.back}" to="{$props.back || ''}">← Back to final transcript</Link>
    <ChangeListener listenTo="{view === 'Edit text' &amp;&amp; paras.value &amp;&amp; !jumped &amp;&amp; $props.para !== undefined &amp;&amp; $props.para !== null &amp;&amp; $props.para !== '' ? paras.value.length : 0}"
      onDidChange="() => {
        if (view !== 'Edit text' || jumped || !paras.value || $props.para === undefined || $props.para === null || $props.para === '') return;
        const n = Number($props.para);
        const k = paras.value.findIndex((p) => p.para === n);
        if (k &lt; 0) return;
        jumped = true;
        currentPara = n;
        paraList.scrollToIndex(k);
        Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                          body: { ev: 'current', para: n, by: $props.back ? 'final-transcript' : 'return' } });
      }" />
    <!-- The Workspace's selection leaves the page by emitting it: Main.xmlui
         keeps it (workspacePara) for the Final transcript, Final video and
         Raw transcript tabs, and hands it back when this page reopens. -->
    <ChangeListener listenTo="{view === 'Edit text' ? currentPara : null}"
      onDidChange="(c) => { if (c.newValue !== c.prevValue) emitEvent('paraChange', c.newValue); }" />
    <!-- Raw transcript, given the Workspace's paragraph: once the segments and
         the paragraph's start are in, scroll to the last segment starting at
         or before it and tint it (rawPlace, apart from currentId, which
         tracks playback). Once only. -->
    <ChangeListener listenTo="{view === 'Transcript' &amp;&amp; rawPlace === null &amp;&amp; segments.value &amp;&amp; paraStart.value ? segments.value.length : 0}"
      onDidChange="() => {
        if (rawPlace !== null || !segments.value || !paraStart.value) return;
        const t = paraStart.value[0] ? paraStart.value[0].t0 : null;
        const segs = segments.value;
        let k = -1;
        if (t !== null &amp;&amp; t !== undefined) {
          for (let j = 0; j &lt; segs.length; j++) { if (segs[j].t0 &lt;= t) k = j; }
        }
        rawPlace = k >= 0 ? segs[k].id : -1;
        Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                          body: { ev: 'raw-place', para: Number($props.para), t0: t, segment: k >= 0 ? segs[k].id : null } });
        if (k >= 0) transcriptList.scrollToIndex(k);
      }" />
    <!-- Playing in Raw transcript makes that paragraph the Workspace's place.
         The arrival scroll above counts as done once you've played, so the
         list doesn't jump when the new place comes back as para. -->
    <ChangeListener listenTo="{view === 'Transcript' &amp;&amp; playPara.value &amp;&amp; playPara.value[0] ? playPara.value[0].para : null}"
      onDidChange="(c) => {
        if (c.newValue === null || c.newValue === undefined || c.newValue === c.prevValue) return;
        if (rawPlace === null) rawPlace = -1;
        emitEvent('paraChange', c.newValue);
        Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                          body: { ev: 'raw-play-place', segment: currentId, para: c.newValue } });
      }" />
    <!-- The project's sources can change (another project opened, a source
         added): keep the chosen one if it's still there, else the first. -->
    <ChangeListener listenTo="{$props.sources}"
      onDidChange="
        const list = $props.sources || [];
        if (!list.includes(source)) { source = list[0] || ''; currentId = null; progress = null; }
      " />

    <!-- Transcribing, offered only for a source with no transcript (or a
         failed one). No names box: whisper's prompt is the project's
         speakers, if any yet (start_transcript); other names are corrected
         while editing. -->
    <HStack verticalAlignment="center"
      when="{!!source &amp;&amp; !progress &amp;&amp; transcript.loaded &amp;&amp; !(transcript.value &amp;&amp; transcript.value[0] &amp;&amp; transcript.value[0].status === 'done')}">
      <Button size="sm" variant="outlined" label="Transcribe" onClick="transcribe()" />
    </HStack>
    <HStack verticalAlignment="center" when="{!!progress}">
      <Spinner />
      <Text value="{'Transcribing ' + source + (progress &amp;&amp; progress.duration_s ? ': ' + stamp(progress.done_s) + ' of ' + stamp(progress.duration_s) : '…')}" />
    </HStack>

    <!-- A splitter: on the left the video and the tabs' controls, on the
         right the paragraphs (or the Transcript tab's rows); drag the divider
         to give either more width
         (https://www.xmlui.org/docs/reference/components/Splitter,
         orientation horizontal: side by side). Each side scrolls on its own;
         the page doesn't: it sizes itself to the window (the root VStack's
         height: the window less Studio's header, its nav row and the page
         padding, ~150 px), and the splitter takes the height left (height="*" in a parent
         of fixed height). XMLUI's scrollWholePage is
         App-wide only; binding it to $pathname so only Podcast stopped
         scrolling didn't take (2026-11-13). The tabs hold only their
         controls; which list the right side shows follows the tab (view). -->
    <Splitter when="{!!source}" orientation="horizontal" height="*"
      initialPrimarySize="40%" minPrimarySize="20%" maxPrimarySize="-320px">
      <VStack height="100%" overflowY="auto" gap="$space-4" paddingRight="$space-4">
        <!-- Which recording, only when the project has more than one; then
             when and how it was transcribed. -->
        <Select when="{($props.sources || []).length > 1}" width="100%"
          data="{($props.sources || []).map((n) => ({ name: n }))}" valueField="name" labelField="name"
          initialValue="{source}"
          onDidChange="(v) => { if (v &amp;&amp; v !== source) { source = v; currentId = null; progress = null; } }" />
        <Text variant="secondary" when="{transcript.value &amp;&amp; transcript.value.length > 0}"
          value="{transcript.value &amp;&amp; transcript.value[0]
            ? (transcript.value[0].status === 'done'
                ? 'Transcribed ' + transcript.value[0].finished_at + ' with ' + transcript.value[0].model
                : 'Transcript ' + transcript.value[0].status)
            : ''}" />
        <!-- On Edit text, the left pane shows the current paragraph as
             edited: the same .mp4 its card plays as audio
             (/transcripts/play), muted, following the card's player. The
             card's play, pause and seek set paraClock, applied here
             (applyClock), and again once a newly chosen paragraph's video
             has loaded. Rows don't call paraVideo themselves: a List row
             reaching a component's player has been unreliable
             (xmlui-org/xmlui#3940). Elsewhere, the original recording.

             It has its controls: play or pause it yourself and it takes
             over (leader 'video', setLeader): it unmutes, the cards stop,
             and pausing it moves its card's player to the same place
             (cardSeek). Playing a card hands it back. -->
        <MediaPlayer id="paraVideo" when="{!!followItem()}" width="100%" muted="{leader !== 'video'}"
          preload="metadata" src="{followItem() ? playUrl(followItem()) : undefined}"
          onLoadedMetadata="videoPara = currentPara; applyClock('loaded')"
          onPlay="(e) => { if (videoTouched(true)) setLeader('video', 'video play'); }"
          onPause="(e) => {
            if (!videoTouched(false, e.currentTime)) return;
            setLeader('video', 'video pause');
            cardSeek = { para: currentPara, t: e.currentTime, n: Date.now() };
          }" />
        <ChangeListener listenTo="{paraClock}" onDidChange="applyClock('clock')" />
        <!-- The current paragraph re-rendered (Elide, Restore, Undo, an
             edit: a new version, a redrawn card with a new clip): start over
             at 0, paused. Carrying the old clip's place over put the video
             past the new clip's end, and the first play stopped at once
             (log, paragraph 53, 2026-11-14 09:22). -->
        <ChangeListener listenTo="{followItem() ? followItem().para + ':' + followItem().v : ''}"
          onDidChange="(c) => clipChanged(c)" />
        <MediaPlayer id="speakerPlayer" when="{!followItem()}" width="100%"
          src="{window.STUDIO_API + '/sources/' + encodeURIComponent(source)}"
          onTimeUpdate="(e) => { const id = segmentAt(e.currentTime); if (id !== currentId) currentId = id; }" />
        <!-- Edit text: the podcast edited as its text, a paragraph at a
             time, no time codes. Delete anything in a paragraph's box; when
             you leave the box it saves: the server diffs that paragraph word
             by word (deleted words are cut, words changed one for one are
             corrections, cut words pasted back are restored). Under each
             box, its audio as edited (/transcripts/play), rendered when you
             press play. Paragraphs never move: they were set from all the
             words, cut or not.

             Rows are keyed by the paragraph's version, so a paragraph an
             edit touched (yours, Undo, Restore, the agent's) is drawn anew
             with its new text and audio, and the others are left alone,
             including one you're typing in. The list is virtualized, which
             is why a box saves when you leave it rather than on a button:
             a paragraph scrolled away is unmounted. -->
        <!-- Which view, from the page (Main.xmlui's nav): Workspace is
             Edit text, Raw transcript is Transcript. -->
            <VStack when="{view === 'Edit text' &amp;&amp; transcribed()}" gap="$space-2">
              <VStack gap="$space-2">
                <HStack verticalAlignment="center">
                  <Button size="sm" variant="outlined" label="Undo"
                    enabled="{!!(textDoc.value &amp;&amp; textDoc.value.canUndo)}" onClick="undoText()" />
                  <Button size="sm" variant="outlined" label="Redo"
                    enabled="{!!(textDoc.value &amp;&amp; textDoc.value.canRedo)}" onClick="redoText()" />
                  <!-- Check joins: render the whole edit, transcribe it and flag
                       each join where the words heard differ from the words
                       kept (serve_media.py's /transcripts/check). About as long
                       as a transcription. Hidden for now (2026-11-13), with its
                       status line and ⚠ marks: editing and checking each
                       paragraph by ear comes first. Remove when="{false}" here
                       and on the marks below to bring it back. -->
                  <Button when="{false}" size="sm" variant="outlined" label="Check joins" enabled="{!checkBusy &amp;&amp; !progress}"
                    tooltip="Render the edit, listen to it, and flag joins that don't sound like the text"
                    onClick="startCheck()" />
                  <Spinner when="{false &amp;&amp; checkBusy}" />
                </HStack>
                <!-- Its own line: beside Undo and Redo it ran off a narrow pane. -->
                <Text variant="secondary" value="{editLine()}" />
                <Text variant="secondary" when="{false &amp;&amp; !!checkLine()}" value="{checkLine()}" />
                <Text variant="secondary" value="Each paragraph saves when you click outside it. Undo and Redo work across all paragraphs, newest first." />
                <!-- Samples: a few stretches of each speaker's voice, marked
                     in the text (an underline; hover for whose). Later, and
                     optionally, they identify who's who: Match voices
                     (voiceprint.py, hidden) or a transcript formatted by
                     speaker. -->
                <!-- Mark the card (index.html studioMarkCard) and hold it
                     (samplesHold) before the re-render; paraList's
                     onVisibleRangeDidChange puts it back. -->
                <HStack width="fit-content" verticalAlignment="center" gap="$space-1">
                  <Switch label="Samples" labelPosition="end" initialValue="{false}"
                    enabled="{currentPara !== null || tagMode}"
                    onDidChange="(v) => {
                      const p = window.studioMarkCard(currentPara);
                      const k = p !== null &amp;&amp; paras.value ? paras.value.findIndex((x) => x.para === p) : -1;
                      samplesHold = p !== null &amp;&amp; k >= 0 ? { para: p, k: k, tries: 0 } : null;
                      tagMode = v;
                    }" />
                  <Button icon="info" size="xs" variant="ghost" tooltip="About samples" onClick="samplesInfo.open()" />
                </HStack>
                <VStack when="{tagMode}" gap="$space-2">
                  <HStack verticalAlignment="center" wrapContent="true">
                    <!-- Matching voices (voiceprint.py) is part of Make
                         final transcript (components/FinalTranscript.xmlui). -->
                    <Text variant="secondary" value="{taggedLine()}" />
                  </HStack>
                  <Text variant="secondary"
                    value="Drag across a stretch (or double-click a word), then pick whose voice it is. Underlined words are samples: hover for whose." />
                  <!-- Every sample stretch (/speakers/samples), with Play
                       (an audio player under it, of just that stretch,
                       so you can seek within it), Clear
                       (untags it; Undo brings it back) and the check's
                       flags: runs of it that sound like someone else
                       (voiceprint.py --check, rerun by itself whenever the
                       samples change). A sample with someone else in it
                       pulls its speaker's voiceprint toward theirs: Liam's
                       took 51 of Doc's words (2026-11-14). -->
                  <ExpandableItem initiallyExpanded="{true}" iconPosition="start" fullWidthSummary="true"
                    summary="{sampleSummary()}">
                    <Items data="{(samples.value &amp;&amp; samples.value.stretches) || []}">
                      <VStack gap="$space-1" paddingBottom="$space-2">
                        <HStack verticalAlignment="center" gap="$space-2" wrapContent="true">
                          <!-- A sample with a flagged part says so first,
                               without opening anything. -->
                          <Text when="{$item.flags.length > 0}" variant="strong" color="$color-warn" value="⚠ Undecided" />
                          <Text variant="strong" color="{$item.color || '$textColor-secondary'}" value="{$item.name}" />
                          <Text variant="secondary" value="{stamp($item.t0) + ' · ' + $item.secs + ' s'}" />
                          <Button size="xs" variant="ghost" label="{openSample === $item.key ? 'Close' : 'Play'}"
                            onClick="openSample = openSample === $item.key ? null : $item.key" />
                          <Button size="xs" variant="ghost" label="Clear"
                            tooltip="Stop using this as a sample (the words stay; Undo brings it back)"
                            onClick="clearSample(source, $item.fromId, $item.toId)" />
                        </HStack>
                        <Text variant="secondary" value="{$item.text}" />
                        <MediaPlayer when="{openSample === $item.key}" kind="audio" autoPlay="true" width="100%"
                          src="{sampleAudio($item.t0, $item.t1)}" />
                        <Items data="{$item.flags}">
                          <!-- A flagged part: undecided until you listen.
                               Clear untags just its words. -->
                          <HStack verticalAlignment="center" gap="$space-2">
                            <Text variant="strong" color="$color-warn" value="⚠ Undecided" />
                            <Button size="xs" variant="ghost"
                              label="{openSample === 'flag-' + $item.t0 ? 'Close' : 'Play'}"
                              onClick="openSample = openSample === 'flag-' + $item.t0 ? null : 'flag-' + $item.t0" />
                            <Button when="{$item.fromId !== null}" size="xs" variant="ghost" label="Clear"
                              tooltip="Stop using just this part as a sample (Undo brings it back)"
                              onClick="clearSample(source, $item.fromId, $item.toId)" />
                          </HStack>
                          <Text color="$color-warn"
                            value="{'Sounds like ' + $item.likeName + ', ' + stamp($item.t0) + '–' + stamp($item.t1) + ': “' + $item.text + '”'}" />
                          <MediaPlayer when="{openSample === 'flag-' + $item.t0}" kind="audio" autoPlay="true" width="100%"
                            src="{sampleAudio($item.t0, $item.t1)}" />
                        </Items>
                      </VStack>
                    </Items>
                  </ExpandableItem>
                </VStack>
                <Text variant="secondary" when="{!!(textDoc.value &amp;&amp; (textDoc.value.undoLabel || textDoc.value.redoLabel))}"
                  value="{[textDoc.value.undoLabel ? 'Undo would ' + textDoc.value.undoLabel : '',
                           textDoc.value.redoLabel ? 'Redo would ' + textDoc.value.redoLabel : ''].filter((x) => x).join(' · ')}" />
              </VStack>
            </VStack>
        <Text when="{view === 'Transcript'}" variant="secondary"
          value="whisper's segments, with their times: click a time to play from there." />
        <!-- Replace across every paragraph (podcast-search-replace), between
             Samples and Cuts: a misheard name fixed once, as corrections. -->
        <HStack when="{view === 'Edit text' &amp;&amp; transcribed()}" verticalAlignment="center">
          <TextBox id="replaceBefore" placeholder="Before" width="*" />
          <TextBox id="replaceAfter" placeholder="After" width="*" />
          <Button label="Replace" variant="outlined" enabled="{!!(replaceBefore.value || '').trim()}"
            onClick="replaceWords()" />
        </HStack>
        <!-- The cuts: what was taken out, for interest, folded at first
             (2026-11-14: "not super valuable, but slightly interesting").
             No Restore here: typing words back, Undo, or a paragraph's
             Restore tics bring cuts back. A long cut has More / Less. -->
        <ExpandableItem when="{view === 'Edit text' &amp;&amp; transcribed()}" initiallyExpanded="{false}" iconPosition="start" fullWidthSummary="true"
          summary="{'Cuts: ' + (cutList.value ? cutList.value.spans.length : 0) + ', ' + stamp(cutList.value ? cutList.value.cutSecs : 0)}">
          <Items data="{cutList.value ? cutList.value.spans : []}">
            <VStack gap="0">
              <HStack verticalAlignment="start">
                <Text width="50px" variant="secondary" value="{stamp($item.t1 - $item.t0)}" />
                <Text when="{openCut !== $item.ids[0]}" width="*" maxLines="2"
                  value="{$item.text + ($item.reason.indexOf('tic') >= 0 ? '  (tic)' : '')}" />
                <Text when="{openCut === $item.ids[0]}" width="*"
                  value="{$item.text + ($item.reason.indexOf('tic') >= 0 ? '  (tic)' : '')}" />
                <Text when="{false &amp;&amp; $item.check &amp;&amp; $item.check.ok}" value="✓" tooltip="The last check heard this join as the text reads" />
                <!-- A long cut (more than two lines' worth) can be read whole. -->
                <Button when="{$item.text.length > 120}" size="xs" variant="ghost"
                  label="{openCut === $item.ids[0] ? 'Less' : 'More'}"
                  onClick="openCut = openCut === $item.ids[0] ? null : $item.ids[0]" />
              </HStack>
              <Text when="{false &amp;&amp; $item.unaligned}" variant="secondary"
                value="⚠ Placed by whisper's word times, which can be off: listen to this join." />
              <Text when="{false &amp;&amp; $item.check &amp;&amp; !$item.check.ok}" variant="secondary"
                value="{'⚠ Heard: “' + $item.check.heard + '” where the text keeps “' + $item.check.kept + '”'}" />
            </VStack>
          </Items>
        </ExpandableItem>
      </VStack>
      <!-- A click in the right pane outside every card (between cards,
           below the last) deselects: currentPara null, so the tint goes,
           a playing card stops and the left pane shows the original
           recording. Cards carry automationId="para-card" (rendered as
           data-automation-id, possibly prefixed, hence *=); the click's
           target says whether it landed in one. Logged
           (podcast-page: pane-click). -->
      <!-- The right pane: the find bar fixed at the top, the lists in a
           scroller below it, so the bar never scrolls away
           (find-in-long-views). The lists draw only rows near the screen,
           so the browser's find misses the rest; the bar searches the data.
           A step moves to the match's row; in the Workspace that paragraph
           becomes the selection (the Workspace's place, by: 'find'). Each
           change of match logs podcast-page: find. -->
      <VStack height="100%" gap="$space-2" paddingLeft="$space-4">
      <FindBar when="{view === 'Transcript' || (view === 'Edit text' &amp;&amp; transcribed())}"
        placeholder="{view === 'Transcript' ? 'Find in raw transcript…' : 'Find in paragraphs…'}"
        matchCount="{fp().total}" current="{fp().cursor}" showCount="{findText.trim().length >= 2}"
        onNeedleChange="(v) => findText = v"
        onStep="(d) => { const n = fp().total; findCursor = n ? ((fp().cursor + d) % n + n) % n : 0; }" />
      <ChangeListener listenTo="{findText}" debounceWaitInMs="200"
        onDidChange="() => { findCursor = 0; findNeedle = findText.trim(); }" />
      <ChangeListener listenTo="{view}"
        onDidChange="() => { findText = ''; findNeedle = ''; findCursor = 0; }" />
      <ChangeListener listenTo="{findNeedle + '|' + fp().cursor + '|' + fp().total}"
        onDidChange="() => {
          const p = fp();
          if (findNeedle.length &lt; 2) return;
          Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                            body: { ev: 'find', view: view === 'Transcript' ? 'raw' : 'workspace', q: findNeedle,
                                    n: p.total ? p.cursor + 1 : 0, of: p.total, row: p.activeRow, key: p.activeKey, occ: p.activeOcc } });
        }" />
      <ChangeListener listenTo="{(view === 'Transcript' ? 'raw:' : 'ws:') + fp().activeRow}"
        onDidChange="() => {
          const p = fp();
          if (p.activeRow &lt; 0) return;
          if (view === 'Transcript') { transcriptList.scrollToIndex(p.activeRow); return; }
          if (currentPara !== p.activeKey) {
            currentPara = p.activeKey;
            Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                              body: { ev: 'current', para: p.activeKey, by: 'find', readBack: currentPara } });
          }
          paraList.scrollToIndex(p.activeRow);
        }" />
      <VStack height="*" overflowY="auto"
        onClick="(e) => {
          if (view !== 'Edit text') return;
          const t = e &amp;&amp; e.target;
          // A card redrawn under the click (a save gives the paragraph a
          // new version, and rows are keyed by version) has taken the
          // clicked element off the page: not a click outside.
          if (t &amp;&amp; t.isConnected === false) {
            Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                              body: { ev: 'pane-click', detached: true, tag: t.tagName, current: currentPara } });
            return;
          }
          const hit = !!(t &amp;&amp; t.closest &amp;&amp; t.closest('[data-automation-id*=para-card]'));
          Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                            body: { ev: 'pane-click', hit, tag: t ? t.tagName : null, current: currentPara } });
          if (!hit &amp;&amp; currentPara !== null) {
            currentPara = null;
            Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                              body: { ev: 'current', para: null, by: 'outside', readBack: currentPara } });
          }
        }">
      <!-- Before a transcript: what's next, not a list waiting for data
           (the paragraphs aren't asked for until one is done). -->
      <Text when="{view === 'Edit text' &amp;&amp; transcript.loaded &amp;&amp; !transcribed()}" variant="secondary"
        value="{progress ? 'Transcribing… the text appears here when it’s done.' : 'Not transcribed yet: click Transcribe, and the text to edit appears here.'}" />
      <VStack when="{view === 'Edit text' &amp;&amp; transcribed()}" gap="$space-2">
        <!-- The Samples switch's hold (samples-toggle-holds-after-jump): the
             re-render changes card heights, and the list reports its new
             visible range. Then the marked card is put back where it was
             (index.html studioPlaceCard, a labelled DOM workaround); not drawn,
             scroll to it by index. Placing repeats on every report until one
             barely moves it (settled) or after 6, since late reports from an
             earlier toggle can place it before the re-render
             (samples-hold-until-settled).
             Right after a jump the cards above are only estimated, which is
             when a timed restore used to lose it. -->
        <List id="paraList" data="{paras}" idKey="key" dataRefreshMode="preserve-state"
          onVisibleRangeDidChange="(r) => {
            if (samplesHold === null) return;
            const h = samplesHold;
            const a = window.studioPlaceCard(h.para);
            const n = h.tries + 1;
            // Settled: placed after the re-render (the card's height changed),
            // or placed with almost no correction. Otherwise a later report
            // (possibly your own scroll) would snap the card back.
            const settled = a.found &amp;&amp; (a.rerendered || Math.abs(a.moved) &lt; 2);
            Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                              body: { ev: 'samples-hold', para: h.para, k: h.k, first: r.startIndex, last: r.endIndex,
                                      placed: a.found, moved: a.moved, rerendered: a.rerendered, n: n, settled: settled } });
            if (settled || n >= 6) { samplesHold = null; window.studioForgetCard(); return; }
            samplesHold = { para: h.para, k: h.k, tries: n };
            if (!a.found) paraList.scrollToIndex(h.k);
          }">
          <!-- draft is the row's own: assignments to the component's
               variables made in here don't take (podcast-page log,
               2026-11-13: editingPara and paraDraft read back null in
               the same handler that set them; xmlui-org/xmlui#3940
               reaches further than its workaround). -->
          <!-- Each paragraph is a card: its words, player and counts in one
               faintly tinted container; the current paragraph (currentPara:
               the one last clicked into, or whose player last started) a
               shade stronger. When another paragraph becomes current, this
               one's player stops, so one plays at a time. currentPara is the
               component's, assigned from in here: #3940 broke that under
               Tabs, and this list has been outside the Tabs since the
               splitter layout. Each assignment logs what it reads back
               (podcast-page: current). -->
          <VStack paddingBottom="$space-3" var.draft="{$item.text}" var.anchor="{null}" var.focus="{null}" var.marks="{null}"
            var.roster="{$item.speakers || []}" var.findHit="{!!fp().hits[String($item.para)]}"
            var.editReady="{false}" var.skipNext="{false}">
          <!-- When another card becomes current, this one stops; and the card
               being left (only that one: every card hears the change) goes
               back to its start, so choosing it again plays the paragraph
               from the beginning, not from where it was left
               (podcast-card-switch-resets-playback; 2026-11-15: "click-
               switching to a card should reset playback"). -->
          <ChangeListener listenTo="{currentPara}"
            onDidChange="(change) => {
              if (currentPara === $item.para || $item.kept === 0) return;
              if (!paraPlayer.paused) paraPlayer.pause();
              if (change.prevValue === $item.para) {
                paraPlayer.seek(0);
                Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                  body: { ev: 'card-reset', para: $item.para, now: currentPara } });
              }
            }" />
          <!-- The main video taking over stops this card; pausing the video
               leaves this card's player where the video stopped. -->
          <ChangeListener listenTo="{leader}"
            onDidChange="if (leader === 'video' &amp;&amp; $item.kept > 0 &amp;&amp; !paraPlayer.paused) paraPlayer.pause();" />
          <ChangeListener listenTo="{cardSeek}"
            onDidChange="if (cardSeek &amp;&amp; cardSeek.para === $item.para &amp;&amp; $item.kept > 0) paraPlayer.seek(cardSeek.t);" />
          <VStack automationId="{'para-card-' + $item.para}" gap="$space-1" padding="$space-3" borderRadius="$space-2"
            backgroundColor="{currentPara === $item.para ? '$color-primary-50' : '$color-surface-50'}"
            onClick="
              if (currentPara !== $item.para) {
                currentPara = $item.para;
                Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                  body: { ev: 'current', para: $item.para, by: 'click', readBack: currentPara } });
              }
            ">
            <!-- Samples: the paragraph as plain words, ordinary color. A
                 word in a sample (tagged: h is 'tag') has a faint underline
                 and a hover naming whose it is (nameOf, from the row's roster:
                 the word's own $item hides the paragraph's); voiceprint matches show nothing. Dragging
                 across words (or double-clicking one) selects a stretch:
                 Items reports its end words (textSelectionDidChange,
                 xmlui-org/xmlui#3959, a candidate build in vendor/), which
                 become the row's anchor and focus, and the line under the
                 paragraph offers the speakers. Plain Text, not Link: links
                 drag instead of selecting. Each selection is logged
                 (podcast-page: select). -->
            <HStack when="{tagMode}" wrapContent="true" gap="$space-1">
              <Items data="{$item.wl || []}"
                onTextSelectionDidChange="(sel) => {
                  if (!sel || !(sel.text || '').trim() || sel.startIndex === null || !sel.startItem || !sel.endItem) return;
                  anchor = sel.startItem.id;
                  focus = sel.endItem.id;
                  Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                    body: { ev: 'select', from: anchor, to: focus, text: sel.text } });
                }">
                <Text value="{$item.w}"
                  textDecorationLine="{$item.h === 'tag' &amp;&amp; $item.s !== null ? 'underline' : 'none'}"
                  textDecorationColor="$textColor-secondary" textDecorationThickness="1px" textUnderlineOffset="4px"
                  tooltip="{$item.h === 'tag' &amp;&amp; $item.s !== null ? 'Sample: ' + nameOf(roster, $item.s) : undefined}"
                  backgroundColor="{inRange($item.id, anchor, focus) ? '$color-primary-100' : (findHit &amp;&amp; window.studioFindWordHit($item.w, findNeedle) ? '$color-primary-200' : 'transparent')}" />
              </Items>
            </HStack>
            <HStack when="{tagMode &amp;&amp; anchor !== null &amp;&amp; focus !== null}" verticalAlignment="center" wrapContent="true">
              <Text variant="secondary" value="Sample for:" />
              <Items data="{$item.speakers || []}">
                <Button size="xs" variant="outlined" label="{$item.name}"
                  onClick="
                    Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                      body: { ev: 'tag', speaker: $item.id, anchor, focus } });
                    tagRange(source, anchor, focus, $item.id); anchor = null; focus = null;
                  " />
              </Items>
              <Button size="xs" variant="ghost" label="Not a sample"
                when="{($item.wl || []).some((w) => w.h === 'tag' &amp;&amp; inRange(w.id, anchor, focus))}"
                tooltip="Take these words out of any sample"
                onClick="tagRange(source, anchor, focus, null); anchor = null; focus = null" />
              <Button size="xs" variant="ghost" label="Cancel" onClick="anchor = null; focus = null" />
            </HStack>
            <!-- Where the caret lands, the player under the box goes: to the
                 start of the word it's in, in the paragraph's edited audio
                 (/transcripts/marks: [character offset, seconds] per kept
                 word, fetched once per version of the row and kept on it).
                 selectionDidChange fires after the caret is placed, also for
                 clicks inside a box that already has focus, for arrow keys
                 and while typing (xmlui-org/xmlui#3959, a candidate build in
                 vendor/). It moves the player only for a bare caret in an
                 unedited box: typing would chase the caret, and an edit makes
                 the offsets stale until it saves. seek doesn't play. Logged
                 (podcast-page: caret).
                 The first click selects, the second edits
                 (card-first-click-selects; 2026-11-15: "The first click on a
                 card should select it. It then would take a second click to
                 set the [caret]"). Focus arriving in a card that wasn't
                 selected selects it and leaves the box read-only (editReady
                 false), and that click's caret is skipped (skipNext), so the
                 player doesn't move. The next caret change (a second click,
                 or an arrow key) makes it editable and moves the player as
                 before. Focus in a card already selected (by find, play, a
                 tab) edits at once. Leaving the box resets it. -->
            <TextArea when="{!tagMode}" autoSize="true" initialValue="{$item.text}" placeholder="(all of this paragraph is cut)"
              readOnly="{!editReady}"
              onSelectionDidChange="(sel) => {
                if (!sel) return;
                if (!editReady) {
                  if (skipNext) {
                    skipNext = false;
                    Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                      body: { ev: 'caret', para: $item.para, at: sel.start, skipped: 'first-click' } });
                    return;
                  }
                  editReady = true;
                }
                if (sel.start !== sel.end || draft !== $item.text || $item.kept === 0) return;
                if (!marks) {
                  marks = Actions.callApi({ url: window.STUDIO_API + '/transcripts/marks?source=' + encodeURIComponent(source) + '&amp;para=' + $item.para,
                                            method: 'get', invalidates: [] }) || [];
                }
                const hit = marks.filter((m) => m[0] &lt;= sel.start);
                const t = hit.length ? hit[hit.length - 1][1] : 0;
                paraPlayer.seek(t);
                Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                  body: { ev: 'caret', para: $item.para, at: sel.start, t, player: paraPlayer.getCurrentTime() } });
              }"
              onGotFocus="
                const fresh = currentPara !== $item.para;
                if (fresh) currentPara = $item.para;
                editReady = !fresh;
                skipNext = fresh;
                Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                  body: { ev: 'focus', para: $item.para, draftLen: (draft || '').length, current: currentPara, fresh, editReady } });
              "
              onDidChange="(v) => draft = v"
              onLostFocus="
                editReady = false;
                skipNext = false;
                Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                  body: { ev: 'blur', para: $item.para, draftLen: (draft || '').length,
                                          textLen: $item.text.length, changed: draft !== $item.text } });
                if (draft !== $item.text) savePara(source, $item.para, draft);
              " />
            <!-- Its play, pause and seek set paraClock, which the left
                 pane's video follows. -->
            <MediaPlayer id="paraPlayer" kind="audio" preload="none" width="100%" when="{$item.kept > 0}" src="{playUrl($item)}"
              onPause="(e) => paraClock = { para: $item.para, t: e.currentTime, playing: false, by: 'pause', n: Date.now() }"
              onSeeked="(e) => paraClock = { para: $item.para, t: e.currentTime, playing: !paraPlayer.paused, by: 'seek', n: Date.now() }"
              onPlay="(e) => {
                setLeader('card', 'card play');
                paraClock = { para: $item.para, t: e.currentTime, playing: true, by: 'play', n: Date.now() };
                if (currentPara !== $item.para) {
                  currentPara = $item.para;
                  Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                                    body: { ev: 'current', para: $item.para, by: 'play', readBack: currentPara } });
                }
              }" />
            <HStack verticalAlignment="center" gap="$space-2">
              <Text variant="secondary" when="{$item.cut > 0}" value="{$item.cut + ' words cut'}" />
              <Text variant="secondary" when="{$item.ticsCut > 0}"
                value="{'(' + $item.ticsCut + (($item.ticsCut === 1) ? ' tic' : ' tics') + ')'}" />
              <Button size="xs" variant="ghost" when="{$item.ticsCut > 0}" label="Restore tics"
                tooltip="Put back the fillers and stutters Elide tics cut in this paragraph"
                onClick="paraTics('/transcripts/restore', { source, para: $item.para, reason: 'tic' })" />
              <Button size="xs" variant="outlined" when="{$item.ticsKept > 0}"
                label="{'Elide ' + $item.ticsKept + (($item.ticsKept === 1) ? ' tic' : ' tics')}"
                tooltip="Cut this paragraph's fillers and stutters, as one step Undo can take back"
                onClick="paraTics('/transcripts/elide', { source, para: $item.para })" />
            </HStack>
            <Text variant="secondary" when="{false &amp;&amp; $item.suspect}"
              value="⚠ Check joins flagged a join here: listen" />
          </VStack>
          </VStack>
        </List>
      </VStack>
      <List id="transcriptList" when="{view === 'Transcript'}" data="{segments}"
        dataRefreshMode="preserve-state">
        <HStack verticalAlignment="start" gap="$space-2"
          backgroundColor="{$item.id === currentId ? '$color-primary-100' : ($item.id === rawPlace ? '$color-primary-50' : undefined)}">
          <Button size="xs" variant="ghost" label="{stamp($item.t0)}" tooltip="Play from here"
            onClick="playFrom($item.t0)" />
          <Text width="120px" variant="strong" color="{$item.color || '$textColor-secondary'}"
            value="{$item.name || '—'}" />
          <Text width="*" value="{$item.text}" highlightText="{findNeedle}"
            highlightActiveIndex="{fp().activeKey === $item.id ? fp().activeOcc : -1}" />
        </HStack>
      </List>
      </VStack>
      </VStack>
    </Splitter>
  </VStack>
  <ModalDialog id="samplesInfo" title="Samples">
    <Text value="Samples are short stretches of each speaker's voice. Studio uses them to tell who is talking when it makes the final transcript. The names you pick from come from Settings, under Speakers in this project." />
    <Text value="Turning Samples on shows the text word by word, so a selection covers a range of whole words rather than a sweep of characters. Drag across a stretch, or double-click a word, then pick whose voice it is." />
    <Text value="It's especially helpful to isolate a speaker inside a paragraph where two people talk. Whole paragraphs where only one person speaks are useful too." />
    <Text value="Aim for at least 30 seconds of samples for each speaker, chosen from anywhere in the recording. The samples list shows each one's length." />
    <Text value="You can always clear a sample (its Clear button) or add more, then Remake final transcript on the Final transcript page." />
  </ModalDialog>
</Component>
