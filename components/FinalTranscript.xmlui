<!-- Final transcript (Main.xmlui's /final-transcript, a podcast project's
     fourth nav link): the edit's words by speaker turn, timed in a final
     video (components/FinalVideo.xmlui), which it needs first.

     Make (or Remake) final transcript matches voices and saves a new
     version (serve_media.py's POST /podcast/final-transcript,
     make_final_transcript): your samples stay as they are, and every other
     kept word goes to the speaker whose voice it matches (voiceprint.py,
     ~1 min on aiw). Each version keeps a snapshot of every word's speaker
     (media/exports/finals/), because the stored matches change with each
     Remake. Progress arrives on /events ({matching: source, done, total}).
     A turn marked (?) is one most of whose words matched no voice clearly.

     Compare: two versions, word by word (GET
     /podcast/final-transcript/compare): each stretch whose speaker changed,
     with its time in the newer one's video, and words per speaker in each. The way
     to see what more samples changed.

     No player here (2026-11-14: "don't need video on this page"): the
     times say where each turn is in the version's video, on the Final
     video page. -->
<Component name="FinalTranscript" var.source="{($props.sources || [])[0] || ''}" var.busy="{null}" var.project="{$props.project || ''}"
  var.pick="{$props.n !== undefined &amp;&amp; $props.n !== null &amp;&amp; $props.n !== '' ? Number($props.n) : null}"
  var.cameBack="{$props.turn !== undefined &amp;&amp; $props.turn !== null &amp;&amp; $props.turn !== '' ? Number($props.turn) : null}"
  var.scrolledBack="{false}" var.landing="{null}" var.comparing="{false}" var.cmpA="{null}" var.cmpB="{null}" var.confirmDelete="{null}"
  var.findText="{''}" var.findNeedle="{''}" var.findCursor="{0}">

  <DataSource id="ft" when="{!!source}"
    url="{window.STUDIO_API + '/podcast/final-transcript?source=' + encodeURIComponent(source) + (pick !== null ? '&amp;n=' + pick : '') + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />
  <DataSource id="cmp" when="{comparing &amp;&amp; !!aVer() &amp;&amp; !!bVer()}"
    url="{window.STUDIO_API + '/podcast/final-transcript/compare?source=' + encodeURIComponent(source) + '&amp;a=' + aVer() + '&amp;b=' + bVer() + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />

  <EventSource url="{window.STUDIO_API}/events"
    onMessage="(m) => {
      if (m.matching === source) {
        if (m.error) { busy = null; toast.error('Matching voices: ' + m.error); }
        else if (!m.finished) busy = m;
        else busy = { writing: true };
      }
      else if (m.finalTranscript === source) {
        busy = null;
        pick = null;
        cmpA = null;
        cmpB = null;
        ft.refetch();
        if (m.error) toast.error('Final transcript: ' + m.error);
      }
      else if (m.final === source &amp;&amp; m.finished) ft.refetch();
      else if (m.finalDeleted === source) { ft.refetch(); }
      else if (m.changed === 'words') ft.refetch();
    }" />

  <script>
    function stamp(s) {
      const t = Math.floor(s || 0);
      const h = Math.floor(t / 3600), m = Math.floor(t / 60) % 60, sec = t % 60;
      return (h ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(sec).padStart(2, '0');
    }
    // Find (find-in-long-views): the plan over the shown version's turns,
    // counting the text each row highlights (index.html studioFindPlan).
    function fp() {
      return window.studioFindPlan(ft.value ? ft.value.turns : [], findNeedle, findCursor, 'text', 'i', 'final');
    }
    function progress() {
      return busy || (ft.value ? ft.value.matching : null);
    }
    // The pencil's paragraph (pencil-returns-to-your-paragraph): for the turn
    // you landed on from the Workspace (?para=), the paragraph you came from,
    // which can be deep inside a long turn; otherwise the turn's first.
    function cameFromPara() {
      const p = $props.para;
      return p !== undefined && p !== null && p !== '' ? Number(p) : null;
    }
    function pencilPara(t) {
      return t.i === cameBack && cameFromPara() !== null ? cameFromPara() : t.para;
    }
    function all() {
      return (ft.value && ft.value.versions) || [];
    }
    function shown() {
      return ft.value ? ft.value.version : null;
    }
    // Compare: the older (a) and newer (b), by default the newest two.
    function aVer() {
      const vs = all();
      return cmpA !== null ? cmpA : (vs[1] ? vs[1].n : null);
    }
    function bVer() {
      const vs = all();
      return cmpB !== null ? cmpB : (vs[0] ? vs[0].n : null);
    }
    function label(v) {
      return 'v' + v.n + ' · ' + v.madeAt + ' · ' + v.turns + ' turns, ' + v.unsure + ' (?)';
    }
    function samplesLine(v) {
      return v ? 'Samples: ' + v.samples.map((s) => s.name.split(' ')[0] + ' ' + Math.round(s.secs) + ' s').join(' · ')
        + ' · timed by video v' + v.video : '';
    }
    function versionOf(n) {
      return all().find((v) => v.n === n) || null;
    }
    function make() {
      try {
        Actions.callApi({ url: window.STUDIO_API + '/podcast/final-transcript', method: 'post', invalidates: [],
                          body: { source } });
        busy = { done: 0, total: 0 };
      } catch (e) {
        toast.error(e.message);
      }
    }
    function remove(n) {
      confirmDelete = null;
      try {
        Actions.callApi({ url: window.STUDIO_API + '/podcast/final-transcript/delete', method: 'post', invalidates: [],
                          body: { source, n } });
        if (pick === n) pick = null;
        if (cmpA === n) cmpA = null;
        if (cmpB === n) cmpB = null;
      } catch (e) {
        toast.error(e.message);
      }
    }
    function line() {
      const p = progress();
      if (p) return p.writing ? 'Saving the transcript…'
        : 'Matching voices' + (p.total ? ': ' + Math.round(100 * p.done / p.total) + '%' : '…');
      const n = all().length;
      return n ? n + (n === 1 ? ' version' : ' versions') : 'No final transcript yet.';
    }
    function cmpLine() {
      const c = cmp.value;
      if (!c) return '';
      return 'v' + c.a + ' → v' + c.b + ': ' + c.changedWords + ' words changed speaker, in '
        + c.changes.length + ' stretches'
        + (c.onlyA || c.onlyB ? '; ' + c.onlyA + ' words only in v' + c.a + ', ' + c.onlyB + ' only in v' + c.b
           + ' (the edit changed)' : '');
    }
  </script>

  <!-- Tight top (tighter-page-top-and-notes): see Podcast.xmlui's root. -->
  <VStack paddingVertical="$space-2" paddingHorizontal="$space-16" gap="$space-4" height="calc(100vh - 104px)">
    <Select when="{($props.sources || []).length > 1}" width="420px"
      data="{($props.sources || []).map((n) => ({ name: n }))}" valueField="name" labelField="name"
      initialValue="{source}" onDidChange="(v) => { if (v) { source = v; pick = null; cmpA = null; cmpB = null; } }" />
    <HStack when="{!!(ft.value &amp;&amp; ft.value.needVideo)}" verticalAlignment="center">
      <Text value="The transcript is timed by the final video, so make that first:" />
      <Link to="/final-video">Final video</Link>
    </HStack>
    <HStack when="{!!(ft.value &amp;&amp; !ft.value.needVideo)}" verticalAlignment="center">
      <Button size="sm" variant="outlined"
        label="{all().length ? 'Remake final transcript' : 'Make final transcript'}"
        enabled="{!progress() &amp;&amp; !(ft.value &amp;&amp; ft.value.upToDate)}"
        tooltip="{ft.value &amp;&amp; ft.value.upToDate ? 'Up to date: made from the newest final video with the samples you have now. Add samples or remake the video first.' : ''}"
        onClick="make()" />
      <Spinner when="{!!progress()}" />
      <Text variant="secondary" value="{line()}" />
      <SpaceFiller />
      <Switch when="{all().length > 1}" label="Compare" labelPosition="end" initialValue="{false}"
        onDidChange="(v) => comparing = v" />
    </HStack>
    <!-- Why a Remake would differ from the newest version (a newer video,
         changed samples), and whether the newest video still matches the
         edit (if not, remake it first, or the times will be off). -->
    <!-- Both notes on one small line that wraps (tighter-page-top-and-notes). -->
    <Text when="{!!(ft.value &amp;&amp; !progress() &amp;&amp; ((ft.value.remakeWhy &amp;&amp; ft.value.remakeWhy.length) || ft.value.editChanged))}"
      variant="secondary" fontSize="$fontSize-sm"
      value="{ft.value ? [(ft.value.remakeWhy &amp;&amp; ft.value.remakeWhy.length) ? 'Remake would differ: ' + ft.value.remakeWhy.join('; ') + '.' : '',
                         ft.value.editChanged ? 'The edit has changed since the newest final video: remake the video first, so the transcript’s times match the edit.' : ''].filter((x) => x).join(' ') : ''}" />

    <!-- One version: pick it, its samples, its Markdown, Delete. -->
    <HStack when="{!!shown() &amp;&amp; !comparing}" verticalAlignment="center" wrapContent="true">
      <Select width="640px" data="{all().map((v) => ({ value: v.n, label: label(v) + (v.n === all()[0].n ? ' (newest)' : '') }))}"
        initialValue="{shown() ? shown().n : undefined}" onDidChange="(v) => { pick = v; confirmDelete = null; }" />
      <Link when="{!!shown()}" to="{shown() ? shown().md + '?download=1' : ''}" target="_blank">Download Markdown</Link>
      <Button when="{confirmDelete === null}" size="sm" variant="ghost" label="Delete this version"
        enabled="{!progress()}" onClick="confirmDelete = shown().n" />
      <Text when="{confirmDelete !== null}" value="{'Delete v' + confirmDelete + '?'}" />
      <Button when="{confirmDelete !== null}" size="sm" variant="outlined" themeColor="attention" label="Delete"
        onClick="remove(confirmDelete)" />
      <Button when="{confirmDelete !== null}" size="sm" variant="ghost" label="Keep" onClick="confirmDelete = null" />
      <!-- Find (find-in-long-views): the list draws only rows near the
           screen, so the browser's find misses the rest. This bar searches
           the turns' text; it sits in this row, above the list's own
           scroller, so it stays in view (it wraps below on a narrow window). -->
      <FindBar placeholder="Find in transcript…"
        matchCount="{fp().total}" current="{fp().cursor}" showCount="{findText.trim().length >= 2}"
        onNeedleChange="(v) => findText = v"
        onStep="(d) => { const n = fp().total; findCursor = n ? ((fp().cursor + d) % n + n) % n : 0; }" />
    </HStack>
    <!-- The needle applies once typing pauses; a new needle starts at its
         first match. Each change of match logs podcast-page: find. -->
    <ChangeListener listenTo="{findText}" debounceWaitInMs="200"
      onDidChange="() => { findCursor = 0; findNeedle = findText.trim(); }" />
    <ChangeListener listenTo="{findNeedle + '|' + fp().cursor + '|' + fp().total}"
      onDidChange="() => {
        const p = fp();
        if (findNeedle.length &lt; 2) return;
        Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                          body: { ev: 'find', view: 'final', q: findNeedle, n: p.total ? p.cursor + 1 : 0, of: p.total, row: p.activeRow, occ: p.activeOcc } });
      }" />
    <!-- The match's turn changed: land it at the top, the same event-driven
         landing as arriving here (landing, below). Stepping within one turn
         leaves the row alone; Text scrolls its active mark into view. -->
    <ChangeListener listenTo="{fp().activeRow}"
      onDidChange="() => {
        const k = fp().activeRow;
        if (k &lt; 0) return;
        landing = { target: k, by: 'find', tries: 0 };
        turnsList.scrollToIndex(k);
      }" />
    <Text when="{!!shown() &amp;&amp; !comparing}" variant="secondary" value="{samplesLine(shown())}" />

    <!-- Compare: two versions, older first. -->
    <HStack when="{comparing}" verticalAlignment="center" wrapContent="true">
      <Select width="560px" data="{all().map((v) => ({ value: v.n, label: label(v) }))}"
        initialValue="{aVer()}" onDidChange="(v) => cmpA = v" />
      <Text value="→" />
      <Select width="560px" data="{all().map((v) => ({ value: v.n, label: label(v) }))}"
        initialValue="{bVer()}" onDidChange="(v) => cmpB = v" />
    </HStack>
    <Text when="{comparing}" variant="secondary" value="{samplesLine(versionOf(aVer()))}" />
    <Text when="{comparing}" variant="secondary" value="{samplesLine(versionOf(bVer()))}" />
    <Text when="{comparing &amp;&amp; !!cmp.value}" value="{cmpLine()}" />
    <Text when="{comparing &amp;&amp; !!cmp.value}" variant="secondary"
      value="{'Words per speaker: ' + (cmp.value ? cmp.value.totals.map((t) => t.name.split(' ')[0] + ' ' + t.a + ' → ' + t.b).join(' · ') : '')}" />

    <!-- Edit opens the Workspace on the turn's paragraph, with a link back
         here (?n=&turn=); coming back, the list scrolls to that turn and
         tints it, once. -->
    <ChangeListener listenTo="{ft.value &amp;&amp; ft.value.turns &amp;&amp; cameBack !== null &amp;&amp; !scrolledBack ? ft.value.turns.length : 0}"
      onDidChange="() => {
        if (scrolledBack || cameBack === null || !ft.value || ft.value.turns.length <= cameBack) return;
        scrolledBack = true;
        landing = { target: cameBack, by: 'back', tries: 0 };
        turnsList.scrollToIndex(cameBack);
        Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                          body: { ev: 'final-transcript-back', turn: cameBack, n: $props.n } });
      }" />
    <!-- Opened by the nav with ?para=N (the Workspace's selection) and no
         turn: the turn holding that paragraph, the last whose first
         paragraph is at or before it. It becomes cameBack, so the same
         scroll and tint as coming back from Edit apply. -->
    <ChangeListener
      listenTo="{ft.value &amp;&amp; ft.value.turns &amp;&amp; cameBack === null &amp;&amp; !scrolledBack &amp;&amp; $props.para !== undefined &amp;&amp; $props.para !== null &amp;&amp; $props.para !== '' ? ft.value.turns.length : 0}"
      onDidChange="() => {
        if (scrolledBack || cameBack !== null || !ft.value || !ft.value.turns || $props.para === undefined || $props.para === null || $props.para === '') return;
        const n = Number($props.para);
        const turns = ft.value.turns;
        // The first turn starting in that paragraph; with none, the turn it
        // continues (the last starting before it). Not the last turn
        // starting in it: a paragraph can hold several.
        let k = turns.findIndex((t) => t.para === n);
        if (k &lt; 0) {
          for (let j = 0; j &lt; turns.length; j++) {
            if (turns[j].para !== null &amp;&amp; turns[j].para !== undefined &amp;&amp; turns[j].para &lt; n) k = j;
          }
        }
        scrolledBack = true;
        Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                          body: { ev: 'final-transcript-place', para: n, turn: k >= 0 ? turns[k].i : null, found: k >= 0 } });
        if (k &lt; 0) return;
        cameBack = turns[k].i;
        landing = { target: k, by: 'tab', tries: 0 };
        turnsList.scrollToIndex(k);
      }" />
    <!-- The landing is checked when the list reports what's in view, not after
         a guessed wait. List.scrollToIndex takes no alignment, so a target in
         range can sit mid-row: once it's drawn, index.html's studioAlignTop
         aligns its top with the list's top. That's a DOM WORKAROUND waiting on
         xmlui-org/xmlui#3961 (scrollToIndex align: "start"), retired by
         reminder-retire-dom-scroll-workarounds. Not in range yet: scroll to it
         again (at most twice). Each check logs final-transcript-view. -->
    <!-- The lists scroll inside this box, the rest of the page doesn't, so
         the header rows and the find bar stay in view (find-in-long-views;
         2026-11-15: "findbar does not stick to top in final transcript"). A
         List with height="*" here let the whole page scroll instead; the
         Workspace's right pane is built the same way. -->
    <VStack height="*" overflowY="auto">
    <List id="turnsList" when="{!!shown() &amp;&amp; !comparing}" data="{ft.value ? ft.value.turns : []}"
      onVisibleRangeDidChange="(r) => {
        if (landing === null) return;
        const l = landing;
        const inView = r.startIndex &lt;= l.target &amp;&amp; l.target &lt;= r.endIndex;
        const a = inView ? window.studioAlignTop('ft-turn-', l.target) : { found: false, delta: null };
        Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                          body: { ev: 'final-transcript-view', by: l.by, target: l.target, first: r.startIndex, last: r.endIndex, inView: inView, aligned: a.found, delta: a.delta, tries: l.tries } });
        if (a.found || l.tries >= 2) { landing = null; return; }
        landing = { target: l.target, by: l.by, tries: l.tries + 1 };
        turnsList.scrollToIndex(l.target);
      }">
      <HStack automationId="{'ft-turn-' + $item.i}" verticalAlignment="start" gap="$space-4" paddingBottom="$space-4"
        backgroundColor="{$item.i === cameBack ? '$color-primary-50' : undefined}">
        <!-- The time, then a pencil that opens the Workspace on this turn's
             paragraph (final-transcript-pencil-edit): one line, the row only
             as wide as both, inside the column's fixed width. -->
        <VStack width="70px" gap="0">
          <HStack width="fit-content" gap="$space-1" verticalAlignment="center">
            <Text variant="secondary" value="{stamp($item.at)}" />
            <Link when="{$item.para !== null &amp;&amp; $item.para !== undefined}" tooltip="Edit in the Workspace"
              to="{{ pathname: '/', queryParams: { para: pencilPara($item), back: '/final-transcript?n=' + (shown() ? shown().n : '') + '&amp;turn=' + $item.i + (pencilPara($item) !== $item.para ? '&amp;para=' + pencilPara($item) : '') } }}">
              <Icon name="pencil" size="sm" />
            </Link>
          </HStack>
        </VStack>
        <Text width="160px" variant="strong" color="{$item.color || '$textColor-secondary'}"
          value="{$item.name + ($item.unsure ? ' (?)' : '')}" />
        <Text width="*" value="{$item.text}" highlightText="{findNeedle}"
          highlightActiveIndex="{fp().activeKey === $item.i ? fp().activeOcc : -1}" />
      </HStack>
    </List>
    <List when="{comparing}" data="{cmp.value ? cmp.value.changes : []}">
      <HStack verticalAlignment="start" gap="$space-4" paddingBottom="$space-4">
        <Text width="70px" variant="secondary" value="{stamp($item.at)}" />
        <Text width="240px" variant="strong" value="{$item.from + ' → ' + $item.to}" />
        <Text width="*" value="{$item.text}" />
      </HStack>
    </List>
    </VStack>
  </VStack>
</Component>
