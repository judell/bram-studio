<!-- The audio strip's playhead: a 2 px line in a thin row above the level
     bars, after a spacer time / span wide, so it sits over the exact time on
     the bars' own scale. The line is 32 px, its 8 px row plus the bars'
     24 px, so it hangs down across them; the no-op transform puts it above
     them, as a transformed element is drawn over later ordinary ones
     (https://www.xmlui.org/docs/styles-and-themes/layout-props#transform).

     Props: span (the seconds the bars cover), time (the paused playhead, to
     start from). While the scene plays the editor calls setTime(t) every
     40 ms, so a tick re-renders only this, not the editor
     (https://www.xmlui.org/docs/howto/confine-a-hot-input-to-its-own-component).
     time follows its prop until setTime first assigns it
     (https://www.xmlui.org/docs/scripting, "var.x is reactive only until
     you explicitly assign"); the editor calls setTime wherever the prop
     changes, so the two agree. -->
<Component name="Playhead" var.time="{$props.time || 0}">
  <method name="setTime">
    (t) => { time = t; }
  </method>
  <HStack height="8px" gap="0">
    <Stack height="8px" width="{Math.min(100, Math.max(0, time / ($props.span || 1) * 100)) + '%'}" />
    <Stack width="2px" height="32px" transform="translateY(0)" backgroundColor="$color-surface-900" />
  </HStack>
</Component>
