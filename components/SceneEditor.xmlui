<!-- The scene editor: the open scene's player with its items drawn over
     it (AnnotationCanvas), the audio strip, and the Annotate, Cut, Pause,
     Narrate and Undo tabs. Its own component so that its state (the current
     item, the cut, pause and narration being set up, the playhead) lives in
     this scope: an edit re-evaluates this subtree, not every binding in
     Main.xmlui. At App level, each change re-ran all 54 App variables'
     bindings: an Inspector trace and a Chrome profile (2026-10-13) put an
     item's select, add, move or text commit at 1.2-2.8 s, almost all of it
     re-rendering (https://www.xmlui.org/docs/howto/confine-a-hot-input-to-its-own-component).
     Props in: scene (the scenes-list row: id, file, url), duration (its
     length in s), dictating (the mic is taken by a dictation). Events out:
     close. Method: refresh(), the lists that change outside this scope
     (the event stream's reconnect, Scene callouts). Mounted only while a
     scene is open, so opening one starts its state fresh; switching to
     another resets it (the ChangeListener on editTake). Its functions are in
     the <script> below (https://www.xmlui.org/docs/helper-tags#script):
     Main.xmlui's script isn't visible in here
     (https://www.xmlui.org/docs/scripting). -->
<Component name="SceneEditor"
  var.editTake="{$props.scene ? $props.scene.id : null}"
  var.editFile="{$props.scene ? $props.scene.file : ''}"
  var.playing="{$props.scene ? $props.scene.url : ''}"
  var.editDur="{$props.duration || 0}"
  var.audition="{null}"
  var.takeAspect="{undefined}"
  var.calloutBox="{null}"
  var.calloutIn="{0}"
  var.calloutOut="{3}"
  var.editCallout="{null}"
  var.playerTime="{0}"
  var.lastSprite="{null}"
  var.annotKind="{readLocalStorage('studio.annotKind', 'callout')}"
  var.lastCut="{[0, 1]}"
  var.cutSeed="{[0, 1]}"
  var.cutSeq="{0}"
  var.pauseSecs="{readLocalStorage('studio.pauseSeconds', 2)}"
  var.narrClip="{[0, 1]}"
  var.narrSeed="{[0, 1]}"
  var.narrating="{null}"
  var.narrBusy="{false}"
  var.resumeAt="{null}"
  var.lastLevels="{null}"
  var.narrAdding="{false}"
  var.pauseAdding="{false}"
  var.cutAdding="{false}"
  var.cutSel="{null}"
  var.cutSelAt="{null}"
  var.pauseSel="{null}"
  var.pauseSelAt="{null}"
  var.narrSel="{null}"
  var.narrSelAt="{null}"
  var.curShape="{null}"
  var.curText=""
  var.curTail="none"
  var.undoLogSeq="{0}">

  <method name="refresh">
    () => { edits.refetch(); narrs.refetch(); pauses.refetch(); cuts.refetch(); callouts.refetch(); savedSprites.refetch(); }
  </method>

  <!-- Another scene opened while this one was: per-scene state starts over,
       as opening one from the list always did (openScene). -->
  <ChangeListener listenTo="{editTake}" onDidChange="resumeAt = null; lastLevels = null; lastCut = [0, 1]; cutSeed = [0, 1]; narrClip = [0, 1]; narrSeed = [0, 1]; editCallout = null; calloutBox = null; lastSprite = null; curShape = null; curText = ''; curTail = 'none'; audition = null; narrAdding = false; narrSel = null; narrSelAt = null; pauseAdding = false; pauseSel = null; pauseSelAt = null; cutAdding = false; cutSel = null; cutSelAt = null;" />

  <script>
    // Narrate over a stretch of the take being edited (serve_media.py's
    // /narrate/*). The server answers /narrate/start once the mic is live;
    // then the muted player starts from the clip's start and /narrate/go tells
    // the server that moment, so the words land where they were spoken.
    // narrating holds the clip while the mic is open: it mutes the player,
    // hides its controls and runs the Timer that calls stopNarration at the
    // clip's end. /narrate/stop writes the take (both files), so narrBusy
    // shows a spinner until it answers.
    function startNarration() {
      try {
        audition = null;
        takePlayer.pause();
        takePlayer.seek(narrClip[0]);
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/start', method: 'post',
                          body: { id: editTake, start: narrClip[0], end: narrClip[1] } });
        narrating = narrClip;
        takePlayer.play();
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/go', method: 'post' });
      } catch (e) {
        narrating = null;
        toast.error(e.message);
      }
    }
    // Before a cut: ask the server what it would remove (/takes/cut with
    // dryRun: the narrations and pauses it goes through, items it leaves
    // under 0.05 s, earlier cuts' seams inside it) and, if anything, confirm.
    // A cut through a narration keeps its sound outside the cut but drops its
    // row, so the Narrate tab stops listing it (2026-10-05). True: go ahead.
    // confirm(): https://www.xmlui.org/docs/howto/open-a-confirmation-before-delete
    function confirmCut(start, end) {
      const d = Actions.callApi({ url: 'http://127.0.0.1:8765/takes/cut', method: 'post', invalidates: [],
                                  body: { id: editTake, start: start, end: end, dryRun: true } });
      const s = (t) => t.toFixed(2);
      const lines = []
        .concat(d.narrations.map(n => 'the narration at ' + s(n.t_in) + '–' + s(n.t_out) + ' s'))
        .concat(d.pauses.map(z => 'the ' + z.seconds + ' s pause at ' + s(z.at) + ' s'))
        .concat(d.items.map(o => 'the ' + o.kind + (o.text ? ' "' + o.text + '"' : '') + ' at ' + s(o.t_in) + ' s'))
        .concat(d.seams.map(c => 'the earlier cut at ' + s(c.at) + ' s'));
      if (lines.length === 0) return true;
      return confirm('Cut ' + s(start) + '–' + s(end) + ' s?',
                     'This cut removes ' + lines.join(', ') + '. A narration\'s sound outside the cut stays in the scene, '
                     + 'but it leaves the Narrate list. Undo brings everything back.',
                     'Cut', 'Keep');
    }
    function stopNarration() {
      const clip = narrating;
      takePlayer.pause();
      narrating = null;
      narrBusy = true;
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/stop', method: 'post' });
        // Done: the adding row closes and the new narration is selected in
        // the list (by its start, until the list has its row). A refused
        // narration (nothing said) keeps the adding row open, to retry.
        narrAdding = false;
        narrSel = null;
        narrSelAt = clip ? clip[0] : null;
      } catch (e) {
        toast.error(e.message);
      }
      narrBusy = false;
      resumeAt = clip ? clip[0] : takePlayer.getCurrentTime();
      cutSeq = cutSeq + 1;
      edits.refetch();
      narrs.refetch(); pauses.refetch(); cuts.refetch();
    }
    // The audio strip's bars (under the take player): one per slice of
    // /takes/levels, px tall for its level from -60 dB (1 px) to 0 dB (24 px),
    // narr when its middle falls inside a narration, and tip, what hovering
    // it says.
    function levelBars(lv, narrations) {
      return lv.levels.map((db, i) => {
        const t = (i + 0.5) * lv.binSecs;
        const n = narrations.find((r) => t >= r.t_in && !(t > r.t_out));
        const what = n ? 'Narration ' + n.t_in.toFixed(2) + '–' + n.t_out.toFixed(2) + ' s' : 'Scene audio';
        const level = db > -60 ? Math.round(db) + ' dB' : 'silence';
        return { px: Math.max(1, Math.round(Math.min(1, (db + 60) / 60) * 24)), narr: !!n,
                 tip: what + ' · ' + level + ' at ' + t.toFixed(2) + ' s' };
      });
    }
    // Cut's nudges: move one end of the marked stretch by delta seconds,
    // re-place the handles by re-seeding cutSeed (which fires no slider
    // events), and show that frame, as dragging a handle does. The stretch
    // stays within the take and at least 0.12 s long, as the slider's
    // minStepsBetweenThumbs keeps it.
    // The narration's ends, as the cut's: nudged or typed (TimeEdge), at
    // least 0.52 s apart (as the slider's minStepsBetweenThumbs) and within
    // the scene; re-seeds narrSeed so the handles follow, and shows the frame.
    function nudgeNarr(which, delta) {
      setNarr(which, (which === 'start' ? narrClip[0] : narrClip[1]) + delta);
    }
    function setNarr(which, t) {
      const end = takePlayer.duration || editDur;
      const c = narrClip;
      const s = which === 'start' ? Math.max(0, Math.min(Math.round(t * 100) / 100, c[1] - 0.52)) : c[0];
      const e = which === 'end' ? Math.min(end, Math.max(Math.round(t * 100) / 100, c[0] + 0.52)) : c[1];
      audition = null;
      if (s !== c[0] || e !== c[1]) {
        narrSeed = [s, e];
        narrClip = narrSeed;
      }
      takePlayer.seek(which === 'start' ? s : e);
    }
    // Where a pause goes in: the playhead. Its TimeEdge moves the playhead
    // (within the scene); the slider's handle follows, since its initialValue
    // is the playhead.
    function setPauseAt(t) {
      const end = takePlayer.duration || editDur;
      audition = null;
      takePlayer.seek(Math.max(0, Math.min(Math.round(t * 100) / 100, end)));
    }
    function nudgeCut(which, delta) {
      setCut(which, (which === 'start' ? lastCut[0] : lastCut[1]) + delta);
    }
    // One end of the cut set to t (nudged, or typed into its TimeEdge): at
    // least 0.12 s apart and within the scene, as dragging a handle allows.
    function setCut(which, t) {
      const end = takePlayer.duration || editDur;
      const c = lastCut;
      const s = which === 'start' ? Math.max(0, Math.min(Math.round(t * 100) / 100, c[1] - 0.12)) : c[0];
      const e = which === 'end' ? Math.min(end, Math.max(Math.round(t * 100) / 100, c[0] + 0.12)) : c[1];
      audition = null;
      if (s !== c[0] || e !== c[1]) {
        cutSeed = [s, e];
        lastCut = cutSeed;
      }
      takePlayer.seek(which === 'start' ? s : e);
    }
    // Add annotation: the current tool (annotKind) in the middle of the
    // picture, from the playhead for 3 s (to the scene's end), saved and
    // made current as a ⌘-drag's item is (onShapeEnd).
    function addAnnotation() {
      const t = takePlayer.getCurrentTime();
      const end = takePlayer.duration || editDur;
      const out = Math.max(t + 0.2, Math.min(t + 3, end));
      const shape = annotKind === 'callout' ? null : annotKind;
      const box = shape === 'arrow' || shape === 'line' ? { x1: 0.4, y1: 0.5, x2: 0.6, y2: 0.5 }
        : shape === 'pointer' ? { x1: 0.5, y1: 0.5, x2: 0.5, y2: 0.5 }
        : { x1: 0.35, y1: 0.4, x2: 0.65, y2: 0.55 };
      audition = null;
      // invalidates: [] as addCallout's: the lists it changes are refetched
      // by name below; the default refetched every DataSource, /projects too
      // (https://www.xmlui.org/docs/howto/control-cache-invalidation).
      const r = Actions.callApi({ url: 'http://127.0.0.1:8765/callouts/add', method: 'post', invalidates: [],
                                  body: { take_id: editTake, text: '', x1: box.x1, y1: box.y1, x2: box.x2, y2: box.y2,
                                          t_in: t, t_out: out, tail: 'none', shape: shape } });
      editCallout = r.id;
      edits.refetch();
      curShape = shape;
      curText = '';
      curTail = 'none';
      calloutBox = box;
      calloutIn = t;
      calloutOut = out;
      lastSprite = null;
      callouts.refetch();
      savedSprites.refetch();
    }
    // The current item's In or Out, one frame (delta) earlier or later: In
    // stays at or above 0 and 0.1 s before Out, Out 0.1 s after In and within
    // the scene. Saved at once, and the playhead goes there so the frame is
    // seen.
    function nudgeItem(which, delta) {
      setItemTime(which, (which === 'in' ? calloutIn : calloutOut) + delta);
    }
    // The current item's In or Out set to v (nudged, or typed into its
    // TimeEdge), by the same rules.
    function setItemTime(which, v) {
      const end = takePlayer.duration || editDur;
      const t = which === 'in'
        ? Math.max(0, Math.min(Math.round(v * 100) / 100, calloutOut - 0.1))
        : Math.min(end, Math.max(Math.round(v * 100) / 100, calloutIn + 0.1));
      if (t !== (which === 'in' ? calloutIn : calloutOut)) {
        if (which === 'in') calloutIn = t; else calloutOut = t;
        takePlayer.seek(t);
        saveCurrentItem();
      }
    }
    // The current item's In or Out set from the playhead.
    function setItemEdge(which) {
      const p = takePlayer.getCurrentTime();
      if (which === 'in') calloutIn = Math.max(0, Math.min(p, calloutOut - 0.1));
      else calloutOut = Math.max(p, calloutIn + 0.1);
      saveCurrentItem();
    }
    // A drag's end (AnnotationCanvas's moveItem / resizeItem): the current
    // item's new box, saved; the new sprite that follows clears the canvas's
    // drag state.
    function saveBox(nb) {
      calloutBox = nb;
      saveCurrentItem();
    }
    function saveCurrentItem() {
      updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1,
                              x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: calloutOut, tail: curTail,
                              shape: curShape });
      callouts.refetch();
      savedSprites.refetch();
      edits.refetch();
    }
    // Auditions on the scene player: the same as the capture view's in
    // Main.xmlui (playSourceAudition and its 40 ms Timer, after the data below),
    // here for takePlayer only; each scope keeps its own `audition`.
    function playAudition(start, stop, kind) {
      const end = takePlayer.duration || editDur;
      const a = { start: Math.max(0, start), stop: Math.min(end, stop), kind, startedMs: Date.now(),
                  at: Math.max(0, start), atMs: Date.now(), src: false };
      takePlayer.seek(a.start);
      audition = a;
      takePlayer.play();
    }
    // A Play button pressed again while its stretch plays (it reads Stop):
    // pause and end the audition, unlogged, since nothing was measured.
    function stopAudition() {
      const a = audition;
      if (a) takePlayer.pause();
      audition = null;
      if (a && a.returnTo !== undefined) takePlayer.seek(a.returnTo);
    }
    function yieldAudition(t) {
      const a = audition;
      audition = null;
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/audition/log', method: 'post', invalidates: [],
                          body: { kind: 'yielded-to-scrub-' + a.kind, start: a.start, stop: a.stop, stoppedAt: t } });
      } catch (e) {
        // A missing log line is no reason to bother the user.
      }
    }
    function endAudition() {
      const a = audition;
      takePlayer.pause();
      audition = null;
      const stoppedAt = takePlayer.getCurrentTime();
      // A preview that asked to (the Pause tab's) puts the playhead back.
      if (a.returnTo !== undefined) takePlayer.seek(a.returnTo);
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/audition/log', method: 'post', invalidates: [],
                          body: { kind: a.kind, start: a.start, stop: a.stop, stoppedAt } });
      } catch (e) {
        // A missing log line is no reason to bother the user.
      }
    }
  </script>

  <!-- Callouts and shapes: text, boxes, ovals, arrows and pointers burned into
       a take (overlay.py). Add/delete edit the list; render burns them in from
       the take's clean copy. -->
  <DataSource id="callouts" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, text, x1, y1, x2, y2, t_in, t_out, tail, shape FROM overlays WHERE take_id = ? AND kind IN (?, ?) ORDER BY t_in', params: [editTake, &quot;callout&quot;, &quot;shape&quot;] }}" />
  <!-- The edited take's narrations (serve_media.py's narrations table), for
       the Narrate tab's list and the Cut and Pause tabs' warnings. -->
  <DataSource id="narrs" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, t_in, t_out FROM narrations WHERE take_id = ? ORDER BY t_in', params: [editTake] }}" />
  <!-- The edited scene's inserted pauses (serve_media.py's pauses table),
       for the Pause tab's rows. -->
  <DataSource id="pauses" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, at, seconds FROM pauses WHERE take_id = ? ORDER BY at', params: [editTake] }}" />
  <!-- The edited scene's cuts (serve_media.py's cuts table), for the Cut
       tab's rows. -->
  <DataSource id="cuts" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, at, seconds FROM cuts WHERE take_id = ? ORDER BY at', params: [editTake] }}" />
  <APICall id="removeNarration" method="post" url="http://127.0.0.1:8765/narrate/remove"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="addCallout" method="post" url="http://127.0.0.1:8765/callouts/add"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="updateCallout" method="post" url="http://127.0.0.1:8765/callouts/update"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteCallout" method="post" url="http://127.0.0.1:8765/callouts/delete"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Cut a stretch out of a take (serve_media.py's /takes/cut: the take and
       its clean copy, callouts shifted). No onSuccess (xmlui-org/xmlui#3924).
       cutSeq goes into the take player's src so it reloads the changed video.
       edits is the edited take's history for the Undo tab (GET
       /takes/edits: its edits newest first, which one Undo would take back,
       and whether Undo and Redo are possible); it is refetched after every
       edit, undo and redo and whenever the takes change. undoEdit and
       redoEdit step back and forth through it. -->
  <DataSource id="edits" url="{'http://127.0.0.1:8765/takes/edits?id=' + (editTake || 0)}" />
  <!-- The edited take's sound level per slice, for the audio strip under its
       player; cutSeq (bumped by every edit) makes an edited take refetch. -->
  <DataSource id="takeLevels" url="{'http://127.0.0.1:8765/takes/levels?id=' + (editTake || 0) + '&amp;c=' + cutSeq}"
    onLoaded="(d) => lastLevels = d" />
  <APICall id="undoEdit" method="post" url="http://127.0.0.1:8765/takes/undo"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="redoEdit" method="post" url="http://127.0.0.1:8765/takes/redo"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Standing instrumentation for the Undo button (its enabled, on the Undo
       tab): whenever one of its inputs changes, one undo-gate line in
       serve_media.log (/undo/log) with every input, which ones changed and
       whether Undo is on. After a narration, Undo stayed off while the server
       said canUndo (2026-10-05); this names the input holding it. Sources by
       name: https://www.xmlui.org/docs/reference/components/ChangeListener
       The posts run concurrently and can arrive out of order, so each carries
       seq (undoLogSeq, this page's count) and pageMs (when the page saw the
       change): sort by seq to read them in the page's order. -->
  <ChangeListener
    listenToSources="{{
      take: editTake,
      edits: !!edits.value,
      canUndo: !!(edits.value &amp;&amp; edits.value.canUndo),
      undoing: undoEdit.inProgress,
      redoing: redoEdit.inProgress,
      cutting: cutTake.inProgress,
      pausing: pauseTake.inProgress,
      narrating: narrating,
      narrBusy: narrBusy
    }}"
    onDidChange="(change) => {
      const v = change.newValue;
      undoLogSeq = undoLogSeq + 1;
      const seq = undoLogSeq;
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/undo/log', method: 'post', invalidates: [],
                          body: { seq: seq, pageMs: Date.now(), take: v.take, edits: v.edits, canUndo: v.canUndo,
                                  undoing: v.undoing, redoing: v.redoing, cutting: v.cutting,
                                  pausing: v.pausing, narrating: v.narrating, narrBusy: v.narrBusy,
                                  changed: change.changedSources,
                                  enabled: !!(v.edits &amp;&amp; v.canUndo &amp;&amp; !v.undoing &amp;&amp; !v.redoing &amp;&amp; !v.cutting &amp;&amp; !v.pausing &amp;&amp; !v.narrating &amp;&amp; !v.narrBusy) } });
      } catch (e) {
        // A missing log line is no reason to bother the user.
      }
    }" />
  <APICall id="cutTake" method="post" url="http://127.0.0.1:8765/takes/cut"
    body="{{ id: $param.id, start: $param.start, end: $param.end }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Insert a pause: hold the frame at a point for some seconds, with silence
       (serve_media.py's /takes/pause). An edit like a cut. -->
  <APICall id="pauseTake" method="post" url="http://127.0.0.1:8765/takes/pause"
    body="{{ id: $param.id, at: $param.at, seconds: $param.seconds }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />

  <Timer interval="40" enabled="{!!audition}"
    onTick="
      const P = takePlayer;
      const t = P.getCurrentTime();
      const now = Date.now();
      const young = !!audition &amp;&amp; now - audition.startedMs &lt; 600;
      const landed = !!audition &amp;&amp; t >= audition.start - 0.15 &amp;&amp; t &lt;= audition.start + 0.9;
      if (audition &amp;&amp; P.paused) {
        audition = now - audition.startedMs > 600 ? null : { ...audition, at: audition.start, atMs: now };
      } else if (audition &amp;&amp; young &amp;&amp; !landed) {
        audition = { ...audition, at: audition.start, atMs: now };
      } else if (audition &amp;&amp; (t > audition.at + (now - audition.atMs) / 1000 + 0.3 || t &lt; audition.at - 0.3)) {
        yieldAudition(t);
      } else if (audition &amp;&amp; t >= audition.stop) {
        endAudition();
      } else {
        audition = { ...audition, at: t, atMs: now };
      }
    " />
  <!-- The take loaded in the take player (its URL); hidden while recording. -->
  <!-- editSprite: the current item's sprite from the DataSource, or its
       last one while the next loads; never another item's.
       annotKind: what the editor places (callout, rect, ellipse, arrow or
       pointer). The handles, and dragging, are AnnotationCanvas's
       (components/AnnotationCanvas.xmlui). -->
  <!-- The editor has no draft and nothing to save (take-editor-live-model). Command-drag places an item,
       which is saved at once (/callouts/add) and becomes the current one.
       editCallout is the current item's id; calloutBox, calloutIn,
       calloutOut, curShape, curText and curTail hold its fields, set when
       it is placed or selected and at each change, and every change is
       saved at once (/callouts/update) and the lists refetched. Clicking
       or dragging an item on the picture, or its name in the list, makes
       it current. annotKind is only the tool: what the next Command-drag
       places. A cut, a pause or Undo retimes items on the server, so
       each of those lets go of the current item. curShown: the current
       item is on the picture, with its handles, only within its In and
       Out, paused or playing, as it will be in the take (shown at every
       paused position, it looked on screen where it isn't). Picking it,
       its In/Out nudges and placing it all put the playhead inside it.
       Clicking the current item's name in the list again lets go of it. -->
  <VStack when="{playing}"
    var.editSprite="{calloutSprite.value &amp;&amp; calloutSprite.value.id === editCallout ? calloutSprite.value : (lastSprite &amp;&amp; lastSprite.id === editCallout ? lastSprite : null)}"
    var.curShown="{!!editCallout &amp;&amp; playerTime >= calloutIn &amp;&amp; playerTime &lt;= calloutOut}">
    <!-- The player's close box (the tools are on the Annotate tab). -->
    <HStack verticalAlignment="center">
      <SpaceFiller />
      <Button icon="close" variant="ghost" aria-label="Close player"
        tooltip="Close the player" onClick="audition = null; emitEvent('close');" />
    </HStack>
    <!-- Callouts (overlay.py), edited directly on the video: the player
         shows the take's clean copy (no burned-in text, /clean/<file>) and
         PointerLayer's anchors (xmlui-org/xmlui#3922) draw each callout on
         it as a sprite from the server, made by the same code Export burns in with.
         Items show between their in and out points; the current one
         always shows, and dragging it moves it, and dragging one of its
         eight handles resizes it, shown as an outline until the drag ends
         and the new sprite arrives (AnnotationCanvas). Command-drag
         places a new item. calloutSprite is the current item's sprite as
         its fields stand now (with a callout's selection frame); the
         server echoes the item's id, so a sprite still loading for the
         previously current item is never shown for this one. -->
    <DataSource id="calloutSprite" url="http://127.0.0.1:8765/callouts/sprite" method="POST"
      when="{!!editCallout &amp;&amp; !!calloutBox &amp;&amp; !!editTake}"
      body="{{ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, tail: curTail, shape: curShape, frame: !curShape }}"
      onLoaded="(d) => lastSprite = d" />
    <DataSource id="savedSprites" url="http://127.0.0.1:8765/callouts/sprites" method="POST"
      when="{!!editTake}" body="{{ take_id: editTake }}" />
    <!-- The picture: AnnotationCanvas (components/AnnotationCanvas.xmlui)
         draws the scene's items over the player and handles dragging,
         keeping per-move state in its own scope so a drag doesn't
         re-evaluate this page. It reports committed changes only:
         pickItem (another item grabbed: it becomes current, and the drag
         moves it), moveItem {dx, dy} and resizeItem (a box) at a drag's
         end, drawItem for a ⌘-drag. A move clamped to nothing saves
         nothing, so release() lets the canvas drop its drag offset. The
         player is its children, so takePlayer stays this page's. -->
    <AnnotationCanvas id="canvas" aspect="{takeAspect}" time="{playerTime}"
      tool="{annotKind === 'arrow' || annotKind === 'line' || annotKind === 'pointer' ? annotKind : 'rect'}"
      sprites="{savedSprites.value || []}"
      current="{{ id: editCallout, box: calloutBox, shape: curShape, shown: curShown, sprite: editSprite }}"
      onPickItem="(id) => {
        const it = (callouts.value || []).find((c) => c.id === id);
        if (it) {
          editCallout = it.id;
          curShape = it.shape || null;
          curText = it.text;
          curTail = it.tail || 'none';
          calloutBox = { x1: it.x1, y1: it.y1, x2: it.x2, y2: it.y2 };
          calloutIn = it.t_in;
          calloutOut = it.t_out;
          lastSprite = null;
        }
      }"
      onMoveItem="(d) => {
        const c = calloutBox;
        const dx = c ? Math.min(Math.max(d.dx, -Math.min(c.x1, c.x2)), 1 - Math.max(c.x1, c.x2)) : 0;
        const dy = c ? Math.min(Math.max(d.dy, -Math.min(c.y1, c.y2)), 1 - Math.max(c.y1, c.y2)) : 0;
        if (!editCallout || (dx === 0 &amp;&amp; dy === 0)) {
          canvas.release();
        } else {
          saveBox({ x1: c.x1 + dx, y1: c.y1 + dy, x2: c.x2 + dx, y2: c.y2 + dy });
        }
      }"
      onResizeItem="(nb) => {
        if (editCallout) saveBox(nb); else canvas.release();
      }"
      onDrawItem="(e) => {
        const t = takePlayer.getCurrentTime();
        const out = Math.max(t + 0.2, Math.min(t + 3, editDur));
        const shape = annotKind === 'callout' ? null : annotKind;
        const free = shape === 'arrow' || shape === 'line';
        const box = free ? { x1: e.x1, y1: e.y1, x2: e.x2, y2: e.y2 } : { x1: Math.min(e.x1, e.x2), y1: Math.min(e.y1, e.y2), x2: Math.max(e.x1, e.x2), y2: Math.max(e.y1, e.y2) };
        // invalidates: [], as in addAnnotation: the default refetched
        // every DataSource and took a drawn shape ~3 s (trace, 2026-10-13).
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/callouts/add', method: 'post', invalidates: [], body: { take_id: editTake, text: '', x1: box.x1, y1: box.y1, x2: box.x2, y2: box.y2, t_in: t, t_out: out, tail: 'none', shape: shape } });
        editCallout = r.id;
        edits.refetch();
        curShape = shape;
        curText = '';
        curTail = 'none';
        calloutBox = box;
        calloutIn = t;
        calloutOut = out;
        lastSprite = null;
        callouts.refetch();
        savedSprites.refetch();
        editTabs.setActiveTabIndex(0);
      }">
      <!-- After an edit the file reloads (cutSeq changes src); it goes
           back to where the edit was (resumeAt), paused, rather than
           playing from 0:00. Nothing plays by itself: opening a scene
           (its name's link) shows it paused at its start. Its height is fixed (the picture fits inside,
           letterboxed if need be): while the file reloads the player had no
           size of its own, so it vanished, came back short, then grew,
           moving everything below it twice. -->
      <MediaPlayer id="takePlayer" autoPlay="false" height="55vh"
        muted="{!!narrating}" controls="{!narrating}"
        src="{editFile ? 'http://127.0.0.1:8765/clean/' + encodeURIComponent(editFile) + '?c=' + cutSeq : playing}"
        onLoadedMetadata="(e) => {
          takeAspect = e.videoWidth / e.videoHeight;
          if (resumeAt !== null) {
            takePlayer.seek(resumeAt);
            takePlayer.pause();
            resumeAt = null;
          }
        }"
        onTimeUpdate="(e) => playerTime = e.currentTime"
        onSeeked="(e) => playerTime = e.currentTime" />
    </AnnotationCanvas>
    <!-- Where the scene's audio lives: one bar per slice of the scene
         (takeLevels, serve_media.py's /takes/levels), its height the
         slice's level from -60 dB (none) to 0 dB, coloured as a narration
         or the scene's own sound. A scene with no audio (every slice under
         -60 dB) shows no strip. Hovering a bar says which, and the level
         there (the tooltip behavior works on any visual component:
         https://www.xmlui.org/docs/behaviors#tooltip). The bars don't
         depend on the playhead, so they are drawn once per load. The
         playhead is a 2 px line in a thin row just above them, after a
         spacer playerTime / (slice length x slices) wide, so it sits over
         the exact time on the bars' own scale and is the one thing that
         moves as the scene plays (it was the marker in whichever of 200
         slots held the playhead: it stepped a slot at a time, and every
         40 ms tick re-checked all 200). The line is 32 px, its 8 px row
         plus the bars' 24 px, so it hangs down across the bars; the no-op
         transform puts it above them, as a transformed element is drawn
         over later ordinary ones
         (https://www.xmlui.org/docs/styles-and-themes/layout-props#transform). -->
    <VStack gap="0" var.lv="{takeLevels.value || lastLevels}"
      when="{!!editTake &amp;&amp; editDur > 0 &amp;&amp; !!(takeLevels.value || lastLevels) &amp;&amp; (takeLevels.value || lastLevels).levels.some((db) => db > -60)}">
      <HStack height="8px" gap="0">
        <Stack height="8px" width="{Math.min(100, Math.max(0, playerTime / (lv.binSecs * lv.levels.length) * 100)) + '%'}" />
        <Stack width="2px" height="32px" transform="translateY(0)" backgroundColor="$color-surface-900" />
      </HStack>
      <HStack height="24px" gap="0" verticalAlignment="end">
        <Items data="{levelBars(lv, narrs.value || [])}">
          <VStack width="*" height="100%" verticalAlignment="end" tooltip="{$item.tip}">
            <Stack when="{$item.narr}" width="100%" height="{$item.px + 'px'}" backgroundColor="$color-warn-500" />
            <Stack when="{!$item.narr}" width="100%" height="{$item.px + 'px'}" backgroundColor="$color-primary-400" />
          </VStack>
        </Items>
      </HStack>
    </VStack>
    <!-- The take's edits, one per tab (https://www.xmlui.org/docs/reference/components/Tabs):
         in each, the slider at full width, then its controls on a second
         row. keepMounted: Tabs otherwise unmounts the hidden tabs, and a
         slider mounted again would show its last seed (initialValue), not
         where its handles were dragged, while lastCut / narrClip
         still held the dragged values. Switching tabs ends an audition,
         whose buttons would be out of sight. The Theme makes the tab strip
         compact. The Timers stay outside: Tabs shows only TabItems. -->
    <Theme paddingVertical-trigger-Tabs="$space-1" paddingHorizontal-trigger-Tabs="$space-3"
      paddingTop-TabItem="$space-2">
    <!-- Leaving a tab closes its adding row (Cut's, Pause's, and
         Narrate's unless a narration is recording). didChange passes the new
         tab's index, id and label
         (https://www.xmlui.org/docs/reference/components/Tabs). -->
    <Tabs id="editTabs" keepMounted="true" when="{!!editTake &amp;&amp; editDur > 0}"
      onDidChange="(index, id, label) => {
        audition = null;
        if (label !== 'Cut') cutAdding = false;
        if (label !== 'Narrate' &amp;&amp; !narrating &amp;&amp; !narrBusy) narrAdding = false;
        if (label !== 'Pause') pauseAdding = false;
      }">
    <!-- Annotate: Add annotation and the tools (the current one solid),
         then the scene's items, one row each. Add annotation places the
         current tool in the middle of the picture at the playhead for 3 s
         (addAnnotation); ⌘-drag places it where you drag. The tool is
         remembered (studio.annotKind) and starts as Callout. Clicking a
         row makes that item current and moves the playhead to its start
         (again lets go of it); the current row offers its controls: text
         and tail (a callout's), In and Out with one-frame nudges, Play
         (its span, reading Stop while it plays) and ✕. Text and tail save
         as they change; their boxes take curText and curTail
         (initialValue), made fresh with the row. Every add, change and
         delete is a step in the Undo tab's history (so edits.refetch()
         after each); Export burns the items into the video. -->
    <TabItem label="Annotate">
    <VStack>
      <HStack verticalAlignment="center">
        <Button label="Add annotation" size="xs" variant="outlined"
          tooltip="Place the current tool in the middle of the picture, from the playhead for 3 s"
          onClick="addAnnotation()" />
        <Items data="{[['callout', 'Callout'], ['rect', 'Box'], ['ellipse', 'Oval'], ['arrow', 'Arrow'], ['line', 'Line'], ['pointer', 'Pointer']]}">
          <Button label="{$item[1]}" size="xs"
            variant="{annotKind === $item[0] ? 'solid' : 'outlined'}"
            tooltip="What Add annotation places, and ⌘-drag on the picture (click, for Pointer)"
            onClick="annotKind = $item[0]; writeLocalStorage('studio.annotKind', $item[0]);" />
        </Items>
      </HStack>
      <Items data="{callouts.value || []}">
        <HStack verticalAlignment="center">
          <Button size="xs" variant="{$item.id === editCallout ? 'solid' : 'ghost'}"
            label="{($item.shape ? ({ rect: 'Box', ellipse: 'Oval', arrow: 'Arrow', line: 'Line', pointer: 'Pointer' })[$item.shape] : $item.text || '(empty callout)') + ' · ' + $item.t_in.toFixed(2) + '–' + $item.t_out.toFixed(2) + ' s'}"
            onClick="
              audition = null;
              if ($item.id === editCallout) {
                editCallout = null;
                calloutBox = null;
                lastSprite = null;
                curShape = null;
                curText = '';
                curTail = 'none';
                calloutIn = 0;
                calloutOut = 3;
              } else {
                editCallout = $item.id;
                curShape = $item.shape || null;
                curText = $item.text;
                curTail = $item.tail || 'none';
                calloutBox = { x1: $item.x1, y1: $item.y1, x2: $item.x2, y2: $item.y2 };
                calloutIn = $item.t_in;
                calloutOut = $item.t_out;
                lastSprite = null;
                takePlayer.seek($item.t_in);
              }
            " />
          <!-- The current item's controls. In and Out are TimeEdges
               (components/TimeEdge.xmlui): « » move the time 1 s, ‹ › one
               frame (0.04 s at 25 fps), and the time itself sets it from
               the playhead; each saves at once and takes the playhead
               there so the frame is seen. -->
          <HStack when="{$item.id === editCallout}" verticalAlignment="center">
            <!-- The text box is its own component (ItemText, after the
                 App), so a keystroke re-evaluates only its subtree, not
                 every binding in App scope
                 (https://www.xmlui.org/docs/howto/confine-a-hot-input-to-its-own-component);
                 the text is saved when the box loses focus. -->
            <ItemText when="{!curShape}" text="{curText}"
              onCommit="(v) => { if (calloutBox &amp;&amp; v !== curText) { curText = v; saveCurrentItem(); } }" />
            <TimeEdge what="In" text="{calloutIn.toFixed(2) + ' s'}"
              onNudge="(d) => nudgeItem('in', d)" onToPlayhead="setItemEdge('in')" />
            <TimeEdge what="Out" text="{calloutOut.toFixed(2) + ' s'}"
              onNudge="(d) => nudgeItem('out', d)" onToPlayhead="setItemEdge('out')" />
            <!-- Tail: a speech-bubble pointer off the box at a compass point. -->
            <Select when="{!curShape}" initialValue="{curTail}" width="120px"
              onDidChange="(v) => {
                if (editCallout &amp;&amp; calloutBox &amp;&amp; !curShape &amp;&amp; v !== curTail) {
                  curTail = v;
                  updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: calloutOut, tail: v, shape: curShape });
                  callouts.refetch();
                  savedSprites.refetch();
                  edits.refetch();
                }
              }">
              <Option value="none" label="No tail" />
              <Option value="nw" label="Tail ↖ nw" />
              <Option value="n" label="Tail ↑ n" />
              <Option value="ne" label="Tail ↗ ne" />
              <Option value="e" label="Tail → e" />
              <Option value="se" label="Tail ↘ se" />
              <Option value="s" label="Tail ↓ s" />
              <Option value="sw" label="Tail ↙ sw" />
              <Option value="w" label="Tail ← w" />
            </Select>
            <Button label="{audition &amp;&amp; audition.kind === 'item' ? 'Stop' : 'Play'}" size="xs" variant="outlined"
              tooltip="Play this item's span"
              onClick="audition &amp;&amp; audition.kind === 'item' ? stopAudition() : playAudition(calloutIn, calloutOut, 'item')" />
            <Button icon="close" size="xs" variant="ghost"
              aria-label="Remove this item" tooltip="Remove this item from the scene"
              onClick="
                audition = null;
                deleteCallout.execute(editCallout);
                edits.refetch();
                editCallout = null;
                calloutBox = null;
                lastSprite = null;
                curShape = null;
                curText = '';
                curTail = 'none';
                calloutIn = 0;
                calloutOut = 3;
                callouts.refetch();
                savedSprites.refetch();
              " />
          </HStack>
        </HStack>
      </Items>
    </VStack>
    </TabItem>
    <!-- Cut: the scene's cuts (serve_media.py's cuts table) and Add cut,
         as on the Narrate and Pause tabs. Add opens the adding row: the
         slider's two handles mark the stretch
         (https://www.xmlui.org/docs/reference/components/Slider), from the
         playhead, 5 s, in one-frame steps; moving a handle seeks the player
         to it (lastCut tells which one moved); nudges move either end.
         Play cut, Intro and Outro hear the marked stretch; nothing changes
         on disk until Cut, which re-encodes two files, so its click has no
         handler timeout
         (https://www.xmlui.org/docs/managed-react/cooperative-concurrency).
         After a cut the row closes and the new cut is selected (cutSelAt:
         its seam, until the list has its row). A cut's row selects it and
         moves the playhead to its seam; the selected one offers Play the
         join (2 s either side of the seam) and its ✕, which puts the
         removed stretch back (/cuts/restore; Undo takes that back). -->
    <TabItem label="Cut">
    <VStack>
      <Button label="Add cut" size="xs" variant="outlined" when="{!cutAdding}"
        tooltip="Mark a stretch from the playhead to remove"
        enabled="{!cutTake.inProgress}"
        onClick="
          const end = takePlayer.duration || editDur;
          const s = Math.max(0, Math.min(takePlayer.getCurrentTime(), end - 0.12));
          audition = null;
          cutSeed = [s, Math.min(end, s + 5)];
          lastCut = cutSeed;
          cutAdding = true;
        " />
      <VStack when="{cutAdding}">
      <!-- valueFormat is a sync callback: one arrow expression, in braces
           (https://www.xmlui.org/docs/howto/keep-sync-callbacks-to-one-expression).
           The handles are placed by re-seeding through initialValue
           (cutSeed), which fires no events, not by setValue
           (https://www.xmlui.org/docs/howto/drive-a-slider-with-a-runtime-domain);
           lastCut follows them, from didChange and alongside each re-seed. -->
      <Slider id="cutSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
        initialValue="{cutSeed}" minStepsBetweenThumbs="{3}"
        valueFormat="{(v) => v.toFixed(2) + 's'}"
        enabled="{!cutTake.inProgress}"
        onDidChange="(v) => {
          audition = null;
          takePlayer.seek(v[0] !== lastCut[0] ? v[0] : v[1]);
          lastCut = v;
        }" />
      <!-- The cut's ends, one group each: « » move it 1 s, ‹ › one frame
           (nudgeCut), and the player shows the frame there, as dragging
           a handle does. Nothing here reads the playhead: the handles and
           nudges set the cut, the player only shows it, and its own
           controls stay yours. The groups are tight inside ($space-1),
           as In and Out are on the Annotate tab. -->
      <HStack verticalAlignment="center">
        <TimeEdge what="Start" text="{lastCut[0].toFixed(2) + ' s'}" enabled="{!cutTake.inProgress}"
          onNudge="(d) => nudgeCut('start', d)" onToPlayhead="setCut('start', takePlayer.getCurrentTime())" />
        <TimeEdge what="End" text="{lastCut[1].toFixed(2) + ' s'}" enabled="{!cutTake.inProgress}"
          onNudge="(d) => nudgeCut('end', d)" onToPlayhead="setCut('end', takePlayer.getCurrentTime())" />
      </HStack>
      <HStack verticalAlignment="center">
      <!-- Hear the stretch the cut would remove (playAudition), as the
           Narrate tab's rows hear a narration: whole, or its first or last
           3 s. Nothing changes on disk until Cut. -->
      <Button label="Play cut" size="xs" variant="outlined"
        tooltip="Play the stretch the cut would remove, from start to end. Nothing is changed."
        enabled="{!cutTake.inProgress}"
        onClick="playAudition(lastCut[0], lastCut[1], 'cut-clip')" />
      <Button label="Intro 3s" size="xs" variant="outlined"
        tooltip="Play the marked stretch's first 3 seconds"
        enabled="{!cutTake.inProgress}"
        onClick="playAudition(lastCut[0], Math.min(lastCut[0] + 3, lastCut[1]), 'cut-intro')" />
      <Button label="Outro 3s" size="xs" variant="outlined"
        tooltip="Play the marked stretch's last 3 seconds"
        enabled="{!cutTake.inProgress}"
        onClick="playAudition(Math.max(lastCut[1] - 3, lastCut[0]), lastCut[1], 'cut-outro')" />
      <Button label="{'Cut ' + (lastCut[1] - lastCut[0]).toFixed(2) + 's'}" size="xs" themeColor="attention"
        tooltip="Remove this stretch from the scene (Undo brings it back)"
        enabled="{!cutTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
        handlerTimeoutMs:onClick="0"
        onClick="
          if (confirmCut(lastCut[0], lastCut[1])) {
            audition = null;
            editCallout = null; calloutBox = null; lastSprite = null;
            curShape = null; curText = ''; curTail = 'none';
            cutTake.execute({ id: editTake, start: lastCut[0], end: lastCut[1] });
            resumeAt = lastCut[0];
            cutAdding = false;
            cutSel = null;
            cutSelAt = lastCut[0];
            cutSeq = cutSeq + 1;
            lastCut = [0, 1]; cutSeed = [0, 1];
            edits.refetch();
            narrs.refetch(); pauses.refetch(); cuts.refetch();
            callouts.refetch();
            savedSprites.refetch();
          }
        " />
      <Button label="Cancel" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
        onClick="audition = null; cutAdding = false;" />
      <Spinner when="{cutTake.inProgress}" />
      </HStack>
      <!-- A cut through a narration takes away its ✕ (the audio kept for
           removing it no longer fits; serve_media.py drops its row, with
           one frame of slack at its ends). Say so before the click; it
           doesn't block, since Undo brings the row back. -->
      <Text color="$color-warn-700"
        when="{(narrs.value || []).some((n) => lastCut[0] &lt; n.t_out - 0.04 &amp;&amp; lastCut[1] > n.t_in + 0.04)}"
        value="{'This cut goes through the narration at ' + (narrs.value || []).filter((n) => lastCut[0] &lt; n.t_out - 0.04 &amp;&amp; lastCut[1] > n.t_in + 0.04).map((n) => n.t_in.toFixed(1) + '–' + n.t_out.toFixed(1) + ' s').join(' and ') + '. Afterwards its ✕ can no longer remove it; only Undo can.'}" />
      </VStack>
      <Items data="{cuts.value || []}">
        <HStack verticalAlignment="center"
          var.sel="{cutSel === $item.id || (cutSel === null &amp;&amp; cutSelAt !== null &amp;&amp; Math.abs($item.at - cutSelAt) &lt; 0.06)}">
          <Button size="xs" variant="{sel ? 'solid' : 'ghost'}"
            label="{'Cut ' + $item.seconds.toFixed(2) + ' s at ' + $item.at.toFixed(2) + ' s'}"
            enabled="{!cutTake.inProgress}"
            onClick="
              audition = null;
              cutSel = $item.id;
              cutSelAt = null;
              takePlayer.seek($item.at);
            " />
          <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'cut-join' &amp;&amp; Math.abs(audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? 'Stop' : 'Play the join'}"
            size="xs" variant="outlined" tooltip="Play from 2 s before this cut's seam to 2 s after it"
            onClick="audition &amp;&amp; audition.kind === 'cut-join' &amp;&amp; Math.abs(audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? stopAudition() : playAudition(Math.max(0, $item.at - 2), $item.at + 2, 'cut-join')" />
          <Button when="{sel}" icon="close" size="xs" variant="ghost"
            aria-label="Restore this cut"
            tooltip="Put the removed stretch back at this seam (Undo takes it out again)"
            enabled="{!cutTake.inProgress &amp;&amp; !pauseTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
            handlerTimeoutMs:onClick="0"
            onClick="
              audition = null;
              editCallout = null; calloutBox = null; lastSprite = null;
              curShape = null; curText = ''; curTail = 'none';
              try {
                Actions.callApi({ url: 'http://127.0.0.1:8765/cuts/restore', method: 'post', invalidates: [], body: { id: $item.id } });
              } catch (e) {
                toast.error(e.message);
              }
              cutSel = null;
              cutSelAt = null;
              resumeAt = $item.at;
              cutSeq = cutSeq + 1;
              edits.refetch();
              narrs.refetch(); pauses.refetch(); cuts.refetch();
              callouts.refetch();
              savedSprites.refetch();
            " />
        </HStack>
      </Items>
    </VStack>
    </TabItem>
    <!-- Pause: the scene's pauses (serve_media.py's pauses table) and Add
         pause, as on the Narrate tab. Add opens the adding row: the point
         (the slider is the player's playhead: playerTime re-seeds its
         initialValue, which fires no events,
         https://www.xmlui.org/docs/howto/drive-a-slider-with-a-runtime-domain,
         and dragging it seeks the player), drawn as a plain line
         (https://www.xmlui.org/docs/howto/style-slider-track-thumb-and-range);
         the seconds (remembered as the next default,
         https://www.xmlui.org/docs/globals#local-storage-utilities);
         Insert; Cancel. (A Play of 2 s either side of the point was
         removed as not useful, 2026-10-05.)
         Once inserted the row closes and the new pause is selected
         (pauseSelAt: its point, until the list has its row). A pause's
         row selects it and moves the playhead to it; the selected one
         offers Play (2 s before to 2 s after) and its ✕, which cuts the
         held stretch back out (/pauses/remove; Undo puts it back). -->
    <TabItem label="Pause">
    <VStack>
      <Button label="Add pause" size="xs" variant="outlined" when="{!pauseAdding}"
        tooltip="Hold a frame, with silence, at a point you choose"
        enabled="{!pauseTake.inProgress}"
        onClick="audition = null; pauseAdding = true;" />
      <VStack when="{pauseAdding}">
        <Theme backgroundColor-range-Slider="$color-surface-300" backgroundColor-track-Slider="$color-surface-300"
          backgroundColor-range-Slider--disabled="$color-surface-300" backgroundColor-track-Slider--disabled="$color-surface-300">
        <Slider id="pauseSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
          initialValue="{playerTime}"
          valueFormat="{(v) => v.toFixed(2) + 's'}"
          enabled="{!pauseTake.inProgress}"
          onDidChange="(v) => {
            audition = null;
            takePlayer.seek(v);
          }" />
        </Theme>
        <!-- The point the pause goes in at is the playhead: its TimeEdge
             nudges it (setPauseAt), and the slider follows. -->
        <TimeEdge what="At" text="{playerTime.toFixed(2) + ' s'}" playhead="{false}" enabled="{!pauseTake.inProgress}"
          onNudge="(d) => setPauseAt(playerTime + d)" />
        <HStack verticalAlignment="center">
          <NumberBox width="110px" initialValue="{pauseSecs}" minValue="{0.5}" maxValue="{30}" step="{0.5}"
            endText="s" tooltip="How long the pause lasts (remembered as the default)"
            onDidChange="(v) => {
              if (v >= 0.5 &amp;&amp; v &lt;= 30) {
                pauseSecs = v;
                writeLocalStorage('studio.pauseSeconds', v);
              }
            }" />
          <Button label="{'Insert ' + pauseSecs + 's pause'}" size="xs" themeColor="attention"
            tooltip="{'Hold the frame at ' + playerTime.toFixed(2) + ' s (the playhead) for ' + pauseSecs + ' s, with silence (Undo takes it back)'}"
            enabled="{!pauseTake.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy &amp;&amp; !audition}"
            handlerTimeoutMs:onClick="0"
            onClick="
              const at = takePlayer.getCurrentTime();
              audition = null;
              editCallout = null; calloutBox = null; lastSprite = null;
              curShape = null; curText = ''; curTail = 'none';
              pauseTake.execute({ id: editTake, at: at, seconds: pauseSecs });
              pauseAdding = false;
              pauseSel = null;
              pauseSelAt = at;
              resumeAt = at;
              cutSeq = cutSeq + 1;
              edits.refetch();
              narrs.refetch(); pauses.refetch(); cuts.refetch();
              callouts.refetch();
              savedSprites.refetch();
            " />
          <Button label="Cancel" size="xs" variant="ghost" enabled="{!pauseTake.inProgress}"
            onClick="audition = null; pauseAdding = false;" />
          <Spinner when="{pauseTake.inProgress}" />
        </HStack>
        <!-- The same warning for a pause that falls inside a narration. -->
        <Text color="$color-warn-700"
          when="{(narrs.value || []).some((n) => playerTime > n.t_in + 0.04 &amp;&amp; playerTime &lt; n.t_out - 0.04)}"
          value="{'This pause falls inside the narration at ' + (narrs.value || []).filter((n) => playerTime > n.t_in + 0.04 &amp;&amp; playerTime &lt; n.t_out - 0.04).map((n) => n.t_in.toFixed(1) + '–' + n.t_out.toFixed(1) + ' s').join(' and ') + '. Afterwards its ✕ can no longer remove it; only Undo can.'}" />
      </VStack>
      <Items data="{pauses.value || []}">
        <HStack verticalAlignment="center"
          var.sel="{pauseSel === $item.id || (pauseSel === null &amp;&amp; pauseSelAt !== null &amp;&amp; Math.abs($item.at - pauseSelAt) &lt; 0.06)}">
          <Button size="xs" variant="{sel ? 'solid' : 'ghost'}"
            label="{'Pause at ' + $item.at.toFixed(2) + ' s · ' + $item.seconds + ' s'}"
            enabled="{!pauseTake.inProgress}"
            onClick="
              audition = null;
              pauseSel = $item.id;
              pauseSelAt = null;
              takePlayer.seek($item.at);
            " />
          <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'pause-row' &amp;&amp; Math.abs(audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? 'Stop' : 'Play'}"
            size="xs" variant="outlined" tooltip="Play from 2 s before this pause to 2 s after it"
            onClick="audition &amp;&amp; audition.kind === 'pause-row' &amp;&amp; Math.abs(audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? stopAudition() : playAudition(Math.max(0, $item.at - 2), $item.at + $item.seconds + 2, 'pause-row')" />
          <Button when="{sel}" icon="close" size="xs" variant="ghost"
            aria-label="Remove this pause"
            tooltip="Remove this pause: its held frame and silence come out of the scene (Undo puts it back)"
            enabled="{!pauseTake.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
            handlerTimeoutMs:onClick="0"
            onClick="
              audition = null;
              editCallout = null; calloutBox = null; lastSprite = null;
              curShape = null; curText = ''; curTail = 'none';
              try {
                Actions.callApi({ url: 'http://127.0.0.1:8765/pauses/remove', method: 'post', invalidates: [], body: { id: $item.id } });
              } catch (e) {
                toast.error(e.message);
              }
              pauseSel = null;
              pauseSelAt = null;
              resumeAt = $item.at;
              cutSeq = cutSeq + 1;
              edits.refetch();
              narrs.refetch(); pauses.refetch(); cuts.refetch();
              callouts.refetch();
              savedSprites.refetch();
            " />
        </HStack>
      </Items>
    </VStack>
    </TabItem>
    <!-- Narrate: the scene's narrations, and Add narration. Add opens the
         adding row: the two-handle slider (narrSeed re-seeds it, narrClip
         follows it) from the playhead, 10 s; Play, to hear what is there
         now before narrating over it (playAudition); Narrate; Cancel.
         Narrate plays the clip muted, without the player's own controls,
         while the mic records; the Timer after the Tabs stops it at the
         clip's end (a Timer waits for its handler before ticking again:
         https://www.xmlui.org/docs/reference/components/Timer), or Stop
         does earlier, and the scene's audio there is replaced (Undo, on
         the Undo tab, takes it back). While narrating, the clip's
         start and end show with a ProgressBar between them
         (https://www.xmlui.org/docs/reference/components/ProgressBar) and
         Stop counts down, since the player's own controls are hidden.
         Once it lands, the adding row closes and the new narration is
         selected (narrSelAt: its start, until the list has its row). A
         narration's row selects it (and moves the playhead to its start);
         the selected one shows Play, Intro 3s, Outro 3s and its ✕. -->
    <TabItem label="Narrate">
    <VStack>
      <Button label="Add narration" size="xs" variant="outlined" when="{!narrAdding}"
        tooltip="Mark a stretch from the playhead to narrate over"
        enabled="{!narrBusy}"
        onClick="
          const end = takePlayer.duration || editDur;
          const s = Math.max(0, Math.min(takePlayer.getCurrentTime(), end - 0.52));
          audition = null;
          narrSeed = [s, Math.min(end, s + 10)];
          narrClip = narrSeed;
          narrAdding = true;
        " />
      <VStack when="{narrAdding}">
        <Slider id="narrSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
          initialValue="{narrSeed}" minStepsBetweenThumbs="{13}"
          valueFormat="{(v) => v.toFixed(2) + 's'}"
          enabled="{!narrating &amp;&amp; !narrBusy}"
          onDidChange="(v) => {
            audition = null;
            takePlayer.seek(v[0] !== narrClip[0] ? v[0] : v[1]);
            narrClip = v;
          }" />
        <HStack when="{!narrating}" verticalAlignment="center">
          <TimeEdge what="Start" text="{narrClip[0].toFixed(2) + ' s'}" enabled="{!narrBusy}"
            onNudge="(d) => nudgeNarr('start', d)" onToPlayhead="setNarr('start', takePlayer.getCurrentTime())" />
          <TimeEdge what="End" text="{narrClip[1].toFixed(2) + ' s'}" enabled="{!narrBusy}"
            onNudge="(d) => nudgeNarr('end', d)" onToPlayhead="setNarr('end', takePlayer.getCurrentTime())" />
        </HStack>
        <HStack when="{!!narrating}" verticalAlignment="center">
          <Text value="{narrating ? narrating[0].toFixed(2) + ' s' : ''}" />
          <ProgressBar width="*"
            value="{narrating ? Math.max(0, Math.min(1, (playerTime - narrating[0]) / (narrating[1] - narrating[0]))) : 0}" />
          <Text value="{narrating ? narrating[1].toFixed(2) + ' s' : ''}" />
        </HStack>
        <HStack verticalAlignment="center">
          <Button label="{audition &amp;&amp; audition.kind === 'narr-preview' ? 'Stop' : 'Play'}" size="xs" variant="outlined"
            tooltip="Play the marked stretch as it sounds now, to hear what you would narrate over"
            enabled="{!narrating &amp;&amp; !narrBusy}"
            onClick="audition &amp;&amp; audition.kind === 'narr-preview' ? stopAudition() : playAudition(narrClip[0], narrClip[1], 'narr-preview')" />
          <Button label="{narrating ? '⏹ Stop recording · ' + Math.max(0, narrating[1] - playerTime).toFixed(1) + ' s left' : '🎤 Narrate ' + (narrClip[1] - narrClip[0]).toFixed(2) + 's'}"
            size="xs" themeColor="attention"
            tooltip="{narrating ? 'Stop now: what you said so far replaces the audio, and the rest of the clip is silent' : 'Play this stretch muted and record the microphone over it, replacing its audio (Undo takes it back)'}"
            enabled="{!narrBusy &amp;&amp; !$props.dictating &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress}"
            handlerTimeoutMs:onClick="0"
            onClick="narrating ? stopNarration() : startNarration();" />
          <Button label="Cancel" size="xs" variant="ghost" when="{!narrating}" enabled="{!narrBusy}"
            onClick="audition = null; narrAdding = false;" />
          <Spinner when="{narrBusy}" />
        </HStack>
      </VStack>
      <!-- The scene's narrations, one row each; the ✕ puts back the audio a
           narration replaced (/narrate/remove), at any time, and Undo on the
           Undo tab restores it. Play, Intro and Outro hear it as judell/av
           plays a clip, its intro and its outro
           (https://github.com/judell/av av.js). -->
      <Items data="{narrs.value || []}">
        <HStack verticalAlignment="center"
          var.sel="{narrSel === $item.id || (narrSel === null &amp;&amp; narrSelAt !== null &amp;&amp; Math.abs($item.t_in - narrSelAt) &lt; 0.06)}">
          <Button size="xs" variant="{sel ? 'solid' : 'ghost'}"
            label="{'Narration ' + $item.t_in.toFixed(2) + '–' + $item.t_out.toFixed(2) + ' s'}"
            enabled="{!narrating &amp;&amp; !narrBusy}"
            onClick="
              audition = null;
              narrSel = $item.id;
              narrSelAt = null;
              takePlayer.seek($item.t_in);
            " />
          <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'clip' &amp;&amp; Math.abs(audition.start - $item.t_in) &lt; 0.05 ? 'Stop' : 'Play'}" size="xs" variant="outlined"
            tooltip="Play this narration from start to end"
            enabled="{!narrating &amp;&amp; !narrBusy}"
            onClick="audition &amp;&amp; audition.kind === 'clip' &amp;&amp; Math.abs(audition.start - $item.t_in) &lt; 0.05 ? stopAudition() : playAudition($item.t_in, $item.t_out, 'clip')" />
          <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'intro' &amp;&amp; Math.abs(audition.start - $item.t_in) &lt; 0.05 ? 'Stop' : 'Intro 3s'}" size="xs" variant="outlined"
            tooltip="Play this narration's first 3 seconds"
            enabled="{!narrating &amp;&amp; !narrBusy}"
            onClick="audition &amp;&amp; audition.kind === 'intro' &amp;&amp; Math.abs(audition.start - $item.t_in) &lt; 0.05 ? stopAudition() : playAudition($item.t_in, Math.min($item.t_in + 3, $item.t_out), 'intro')" />
          <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'outro' &amp;&amp; Math.abs(audition.stop - $item.t_out) &lt; 0.05 ? 'Stop' : 'Outro 3s'}" size="xs" variant="outlined"
            tooltip="Play this narration's last 3 seconds"
            enabled="{!narrating &amp;&amp; !narrBusy}"
            onClick="audition &amp;&amp; audition.kind === 'outro' &amp;&amp; Math.abs(audition.stop - $item.t_out) &lt; 0.05 ? stopAudition() : playAudition(Math.max($item.t_out - 3, $item.t_in), $item.t_out, 'outro')" />
          <Button when="{sel}" icon="close" size="xs" variant="ghost"
            aria-label="Remove this narration"
            tooltip="Remove this narration: the audio that was there before comes back (Undo restores the narration)"
            enabled="{!removeNarration.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
            handlerTimeoutMs:onClick="0"
            onClick="
              audition = null;
              narrSel = null;
              narrSelAt = null;
              removeNarration.execute($item.id);
              resumeAt = $item.t_in;
              cutSeq = cutSeq + 1;
              narrs.refetch(); pauses.refetch(); cuts.refetch(); edits.refetch();
            " />
        </HStack>
      </Items>
    </VStack>
    </TabItem>
    <!-- History: the take's edits (cut, pause, narrate, a narration
         removed), newest first, with when each was made. The tinted row
         is the edit Undo takes back: the most recent one still in effect.
         Undo moves the tint down a row and leaves the undone edit above
         it, dimmed; Redo puts the edit just above the tint back. A new
         edit discards the undone ones. The table is plain rows, not a
         Table: Table has no per-row style, and tinting each cell from its
         row (https://www.xmlui.org/docs/howto/highlight-rows-conditionally)
         left the tint as separate blocks with gaps between them.
         Both buttons let go of the current item first, as a cut does:
         the take's items are swapped with its files. -->
    <TabItem label="Undo">
    <VStack>
      <HStack verticalAlignment="center">
        <Button label="Undo" size="xs" variant="outlined"
          tooltip="Take back the tinted edit"
          enabled="{!!edits.value &amp;&amp; edits.value.canUndo &amp;&amp; !undoEdit.inProgress &amp;&amp; !redoEdit.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
          handlerTimeoutMs:onClick="0"
          onClick="
            audition = null;
            editCallout = null; calloutBox = null; lastSprite = null;
            curShape = null; curText = ''; curTail = 'none';
            resumeAt = takePlayer.getCurrentTime();
            undoEdit.execute(editTake);
            cutSeq = cutSeq + 1;
            lastCut = [0, 1]; cutSeed = [0, 1];
            edits.refetch();
            narrs.refetch(); pauses.refetch(); cuts.refetch();
            callouts.refetch();
            savedSprites.refetch();
          " />
        <Button label="Redo" size="xs" variant="outlined"
          tooltip="Put back the edit just above the tinted one"
          enabled="{!!edits.value &amp;&amp; edits.value.canRedo &amp;&amp; !undoEdit.inProgress &amp;&amp; !redoEdit.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
          handlerTimeoutMs:onClick="0"
          onClick="
            audition = null;
            editCallout = null; calloutBox = null; lastSprite = null;
            curShape = null; curText = ''; curTail = 'none';
            resumeAt = takePlayer.getCurrentTime();
            redoEdit.execute(editTake);
            cutSeq = cutSeq + 1;
            lastCut = [0, 1]; cutSeed = [0, 1];
            edits.refetch();
            narrs.refetch(); pauses.refetch(); cuts.refetch();
            callouts.refetch();
            savedSprites.refetch();
          " />
        <Spinner when="{undoEdit.inProgress || redoEdit.inProgress}" />
        <Text variant="secondary" when="{!!edits.value &amp;&amp; !!edits.value.note}" value="{edits.value.note}" />
      </HStack>
      <Text variant="secondary" when="{!!edits.value &amp;&amp; edits.value.edits.length === 0}"
        value="No edits to this scene yet." />
      <VStack gap="0" when="{!!edits.value &amp;&amp; edits.value.edits.length > 0}">
        <HStack paddingHorizontal="$space-2" paddingVertical="$space-1">
          <Text variant="secondary" width="200px" value="When" />
          <Text variant="secondary" value="Edit" />
        </HStack>
        <Items data="{edits.value ? edits.value.edits : []}">
          <HStack verticalAlignment="center" paddingHorizontal="$space-2" paddingVertical="$space-1"
            backgroundColor="{$item.current ? '$color-primary-100' : 'transparent'}">
            <Text width="200px" when="{!$item.undone}" value="{$item.when}" />
            <Text width="200px" when="{$item.undone}" variant="secondary" value="{$item.when}" />
            <Text when="{!$item.undone}" value="{$item.what}" />
            <Text when="{$item.undone}" variant="secondary" value="{$item.what + ' (undone)'}" />
          </HStack>
        </Items>
      </VStack>
    </VStack>
    </TabItem>
    </Tabs>
    </Theme>
    <Timer interval="40" enabled="{!!narrating}"
      onTick="
        if (narrating &amp;&amp; takePlayer.getCurrentTime() >= Math.min(narrating[1], takePlayer.duration || narrating[1]) - 0.05) stopNarration();
      " />
    <!-- While the take plays, playerTime follows the player every 40 ms.
         The player's timeUpdate arrives about four times a second, which
         showed items a third of a second late (measured 2026-10-01: an
         item set to 2.0-5.0 s was on screen 2.32-5.37 s). -->
    <Timer interval="40" enabled="{!takePlayer.paused}"
      onTick="playerTime = takePlayer.getCurrentTime()" />
  </VStack>
</Component>
