<!-- Final video (Main.xmlui's /final-video, a podcast project's third nav
     link): the whole edit as one video. Make (or Remake) asks the server for
     a new version (serve_media.py's POST /podcast/final, make_final): every
     paragraph with kept words, rendered as its card plays it, joined end to
     end. Every version is kept (v1, v2..., media/exports/finals/); the
     picker shows any of them, newest first, and Delete removes one (a video
     is ~210 MB). The newest is also media/exports/<project>-final.mp4, which
     the Exports page lists. Progress arrives on /events ({final: source,
     done, total}). GET /podcast/final says whether the newest is current:
     false once any paragraph's cuts have changed since.

     genre="screencast" (a screencast project's Final video): Make runs
     Export (POST /export: any scene whose items changed is burned in, then
     all scenes are joined in list order into media/exports/<stamp>-takes.mp4)
     and waits for it. The versions are Studio's exports, newest first (GET
     /screencast/final), each current or not by the scenes it was made from;
     Delete is the Exports page's (/exports/delete). -->
<Component name="FinalVideo" var.source="{($props.sources || [])[0] || ''}" var.making="{null}" var.project="{$props.project || ''}"
  var.pick="{null}" var.confirmDelete="{null}" var.genre="{$props.genre || 'podcast'}">

  <DataSource id="final" when="{genre === 'screencast' || !!source}"
    url="{genre === 'screencast' ? window.STUDIO_API + '/screencast/final' : window.STUDIO_API + '/podcast/final?source=' + encodeURIComponent(source) + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />

  <!-- Opened from the Workspace's selection (para=N): where that paragraph
       starts in the newest version (serve_media.py's GET /final/at). The
       player is cued there, not played; another picked version starts at 0:00,
       the time belonging to the newest. -->
  <DataSource id="at" when="{genre === 'podcast' &amp;&amp; !!source &amp;&amp; $props.para !== undefined &amp;&amp; $props.para !== null &amp;&amp; $props.para !== ''}"
    url="{window.STUDIO_API + '/final/at?source=' + encodeURIComponent(source) + '&amp;para=' + encodeURIComponent($props.para) + (project ? '&amp;p=' + encodeURIComponent(project) : '')}" />

  <EventSource url="{window.STUDIO_API}/events"
    onMessage="(m) => {
      if (m.final === source) {
        if (m.finished || m.error) {
          making = null;
          pick = null;
          final.refetch();
          if (m.error) toast.error('Final video: ' + m.error);
        } else making = m;
      }
      else if (m.finalDeleted === source || m.changed === 'words') final.refetch();
      else if (genre === 'screencast' &amp;&amp; (m.changed === 'exports' || m.changed === 'takes')) final.refetch();
    }" />

  <script>
    function stamp(s) {
      const t = Math.floor(s || 0);
      const h = Math.floor(t / 3600), m = Math.floor(t / 60) % 60, sec = t % 60;
      return (h ? h + ':' + String(m).padStart(2, '0') : m) + ':' + String(sec).padStart(2, '0');
    }
    function progress() {
      return making || (final.value ? final.value.making : null);
    }
    function all() {
      return (final.value && final.value.versions) || [];
    }
    // Every video the picker offers (screencast-exports-coherent): Studio's
    // versions, newest first, then (a screencast's Exports tab) every other
    // video in its exports, edited elsewhere or leveled, so each file is
    // listed once. key: 'v<n>' for a version, 'f:<name>' for another file.
    function videos() {
      const vs = all().map((v) => ({ ...v, key: 'v' + v.n, version: true }));
      const others = ((final.value && final.value.others) || [])
        .map((o) => ({ ...o, key: 'f:' + o.name, version: false }));
      return vs.concat(others);
    }
    // The video shown: the one picked, else the newest version (or file).
    function shown() {
      const list = videos();
      return list.find((v) => v.key === pick) || list[0] || null;
    }
    function label(v) {
      if (!v.version) {
        return v.name + ' · ' + (v.leveled ? 'leveled' : 'edited elsewhere') + ' · ' + v.madeAt
          + (v.secs ? ' · ' + stamp(v.secs) : '');
      }
      return 'v' + v.n + ' · ' + v.madeAt + ' · ' + stamp(v.secs) + (all()[0] && v.n === all()[0].n ? ' (newest)' : '');
    }
    // A file's note (screencast), saved when the box loses focus; an empty
    // note removes it (POST /exports/note).
    function saveNote(v, text) {
      if (!v || text === (v.note || '')) return;
      try {
        Actions.callApi({ url: window.STUDIO_API + '/exports/note', method: 'post', invalidates: [],
                          body: { name: v.name, where: v.where || 'exports', note: text } });
      } catch (e) {
        toast.error(e.message);
      }
      final.refetch();
    }
    function make() {
      if (genre === 'screencast') {
        making = { exporting: true };
        try {
          Actions.callApi({ url: window.STUDIO_API + '/export', method: 'post', invalidates: [], body: {} });
          pick = null;
        } catch (e) {
          toast.error(e.message);
        }
        making = null;
        final.refetch();
        return;
      }
      try {
        Actions.callApi({ url: window.STUDIO_API + '/podcast/final', method: 'post', invalidates: [], body: { source } });
        making = { done: 0, total: 0 };
      } catch (e) {
        toast.error(e.message);
      }
    }
    // Delete the video with this key: a screencast's file (version or not)
    // through the Exports delete, a podcast version through its own.
    function remove(key) {
      confirmDelete = null;
      const v = videos().find((x) => x.key === key);
      if (!v) return;
      if (genre === 'screencast') {
        try {
          Actions.callApi({ url: window.STUDIO_API + '/exports/delete', method: 'post', invalidates: [],
                          body: { name: v.name, where: v.where || 'exports' } });
          if (pick === key) pick = null;
        } catch (e) {
          toast.error(e.message);
        }
        final.refetch();
        return;
      }
      try {
        Actions.callApi({ url: window.STUDIO_API + '/podcast/final/delete', method: 'post', invalidates: [],
                          body: { source, n: v.n } });
        if (pick === key) pick = null;
      } catch (e) {
        toast.error(e.message);
      }
    }
    // The cue: the time in the newest version, when it's the one shown.
    function cueAt() {
      const a = at.value, vs = all();
      if (!a || a.at === null || a.at === undefined || !vs[0] || !shown() || shown().key !== 'v' + vs[0].n) return null;
      return a.at;
    }
    function cue() {
      const t = cueAt();
      if (t === null) return;
      try { player.seek(t); } catch (e) { /* the player isn't up yet: its metadata event cues */ }
    }
    function line() {
      const p = progress(), f = final.value;
      if (p && p.exporting) return 'Exporting the scenes…';
      if (p) return 'Making the final video' + (p.total ? ': paragraph ' + p.done + ' of ' + p.total : '…');
      if (!f) return '';
      if (f.noTranscript) return 'Nothing to make yet: transcribe the recording in the Workspace first.';
      const others = (f.others || []).length;
      const more = others ? ' · ' + others + (others === 1 ? ' other video' : ' other videos') : '';
      if (!f.exists) return 'No final video yet.' + more;
      return all().length + (all().length === 1 ? ' version' : ' versions') + more;
    }
  </script>

  <!-- Tight top (tighter-page-top-and-notes): see Podcast.xmlui's root. -->
  <VStack paddingHorizontal="$space-6" paddingVertical="$space-2" gap="$space-4">
    <Select when="{genre !== 'screencast' &amp;&amp; ($props.sources || []).length > 1}" width="420px"
      data="{($props.sources || []).map((n) => ({ name: n }))}" valueField="name" labelField="name"
      initialValue="{source}" onDidChange="(v) => { if (v) { source = v; pick = null; } }" />
    <HStack verticalAlignment="center">
      <!-- Dimmed when the newest version is known to be current: nothing
           would change (screencast-exports-coherent). Unknown (made before
           Studio recorded what went into a version) stays enabled. -->
      <Button size="sm" variant="outlined"
        label="{final.value &amp;&amp; final.value.exists ? 'Remake final video' : 'Make final video'}"
        tooltip="{final.value &amp;&amp; final.value.exists &amp;&amp; final.value.current === true ? 'Nothing has changed since the newest version' : ''}"
        enabled="{(genre === 'screencast' || !!source) &amp;&amp; !progress() &amp;&amp; !(final.value &amp;&amp; final.value.noTranscript) &amp;&amp; !(final.value &amp;&amp; final.value.exists &amp;&amp; final.value.current === true)}" onClick="make()" />
      <Spinner when="{!!progress()}" />
      <Text variant="secondary" value="{line()}" />
    </HStack>
    <Text when="{!!(final.value &amp;&amp; final.value.exists &amp;&amp; final.value.current === false &amp;&amp; !progress())}"
      variant="secondary" fontSize="$fontSize-sm"
      value="{genre === 'screencast' ? 'The scenes have changed since the newest version was made: Remake to bring it up to date.' : 'The edit has changed since the newest version was made: Remake to bring it up to date.'}" />
    <Text variant="secondary" fontSize="$fontSize-sm" when="{!!(final.value &amp;&amp; final.value.exists &amp;&amp; final.value.current === null &amp;&amp; !progress())}"
      value="Studio can’t tell whether this version is up to date: it was made before Studio kept track of what goes into each version. Remake once, and from then on Remake is dimmed whenever nothing has changed." />
    <HStack when="{!!shown()}" verticalAlignment="center">
      <Select width="420px" data="{videos().map((v) => ({ value: v.key, label: label(v) }))}"
        initialValue="{shown() ? shown().key : undefined}" onDidChange="(v) => { pick = v; confirmDelete = null; }" />
      <Link when="{confirmDelete === null}" to="{shown() ? shown().url + (shown().url.indexOf('?') &gt;= 0 ? '&amp;' : '?') + 'download=1' : ''}"
        target="_blank">Download video</Link>
      <Button when="{confirmDelete === null}" size="sm" variant="ghost"
        label="{shown() &amp;&amp; shown().version ? 'Delete this version' : 'Delete this video'}"
        enabled="{!progress()}" onClick="confirmDelete = shown().key" />
      <Text when="{confirmDelete !== null}"
        value="{'Delete ' + (shown() &amp;&amp; shown().version ? 'v' + shown().n : (shown() ? shown().name : '')) + '?'}" />
      <Button when="{confirmDelete !== null}" size="sm" variant="outlined" themeColor="attention" label="Delete"
        onClick="remove(confirmDelete)" />
      <Button when="{confirmDelete !== null}" size="sm" variant="ghost" label="Keep" onClick="confirmDelete = null" />
    </HStack>
    <!-- Sized to the window: as wide as the page allows, and no taller than
         what's left under the header, nav and the rows above (~360 px), so
         the whole video and its controls are in view. The browser keeps
         its proportions within both limits. -->
    <MediaPlayer id="player" when="{!!shown()}" width="100%" maxHeight="calc(100vh - 360px)"
      preload="metadata" src="{shown() ? shown().url : undefined}" onLoadedMetadata="cue()" />
    <Text variant="secondary" when="{cueAt() !== null}"
      value="{'Cued to ' + stamp(cueAt()) + ', where your selected paragraph starts'}" />
    <ChangeListener listenTo="{at.value ? at.value.at + '|' + at.value.n : ''}"
      onDidChange="() => {
        if (!at.value) return;
        Actions.callApi({ url: window.STUDIO_API + '/podcast/log', method: 'post', invalidates: [],
                          body: { ev: 'final-video-place', para: Number($props.para), n: at.value.n, at: at.value.at } });
        try { if (player.duration) cue(); } catch (e) { }
      }" />
    <!-- The shown file's note (a screencast's Exports tab): what it is,
         since names can't say. Saved when the box loses focus; keyed by the
         file so switching files shows each one's own note. Typed only: the
         Exports list's 🎤 dictation lived in Main.xmlui's scope. -->
    <ChangeListener listenTo="{shown() ? shown().key + '|' + (shown().note || '') : ''}"
      onDidChange="if (genre === 'screencast' &amp;&amp; shown()) noteBox.setValue(shown().note || '');" />
    <TextBox when="{genre === 'screencast' &amp;&amp; !!shown()}" id="noteBox" width="100%"
      placeholder="A note on this video, e.g. what's in it or where it went"
      initialValue="{shown() ? (shown().note || '') : ''}"
      onLostFocus="saveNote(shown(), (noteBox.value || '').trim())" />
  </VStack>
</Component>
