<!-- The scene editor's Pause tab: the scene's pauses (serve_media.py's
     pauses table) and Add pause. Its own component, as CutTab is, so its
     state re-renders only this tab.

     Add opens the adding row: the point (the slider is the player's
     playhead: time re-seeds its initialValue, which fires no events,
     https://www.xmlui.org/docs/howto/drive-a-slider-with-a-runtime-domain,
     and dragging it seeks the player), drawn as a plain line
     (https://www.xmlui.org/docs/howto/style-slider-track-thumb-and-range);
     the seconds (remembered as the next default,
     https://www.xmlui.org/docs/globals#local-storage-utilities); Insert;
     Cancel. Once inserted the row closes and the new pause is selected
     (pauseSelAt: its point, until the list has its row; set by the editor
     through inserted(at), since the point is the live playhead). A pause's
     row selects it and moves the playhead to it; the selected one offers
     Play (2 s before to 2 s after) and its ✕, which cuts the held stretch
     back out (/pauses/remove; Undo puts it back).

     Props: take, duration, audition, pauses and narrs (the lists),
     pausing, cutting, narrating, narrBusy. The playhead comes by method
     (setTime: time). Events: seek(t), hush(), play({start, stop, kind}),
     stopPlay(), insert({seconds}) (the editor reads the playhead, calls
     inserted(at) and inserts there), removePause({id, at}).
     Methods: inserted(at), close(). -->
<Component name="PauseTab"
  var.dur="{$props.duration || 0}"
  var.time="{0}"
  var.pauseSecs="{readLocalStorage('studio.pauseSeconds', 2)}"
  var.pauseAdding="{false}"
  var.pauseSel="{null}"
  var.pauseSelAt="{null}">

  <ChangeListener listenTo="{$props.take}"
    onDidChange="pauseAdding = false; pauseSel = null; pauseSelAt = null;" />

  <method name="inserted">
    (at) => { pauseAdding = false; pauseSel = null; pauseSelAt = at; }
  </method>
  <!-- The playhead, pushed by the editor (on load, seek and pause; every
       tick while a narration records), so a seek re-renders this tab, not
       the editor. -->
  <method name="setTime">
    (t) => { time = t; }
  </method>
  <method name="close">
    () => { pauseAdding = false; }
  </method>

  <VStack>
    <Button label="Add pause" size="xs" variant="outlined" when="{!pauseAdding}"
      tooltip="Hold a frame, with silence, at a point you choose"
      enabled="{!$props.pausing}"
      onClick="emitEvent('hush'); pauseAdding = true;" />
    <VStack when="{pauseAdding}">
      <Theme backgroundColor-range-Slider="$color-surface-300" backgroundColor-track-Slider="$color-surface-300"
        backgroundColor-range-Slider--disabled="$color-surface-300" backgroundColor-track-Slider--disabled="$color-surface-300">
      <Slider id="pauseSlider" width="100%" minValue="{0}" maxValue="{dur}" step="{0.04}"
        initialValue="{time || 0}"
        valueFormat="{(v) => v.toFixed(2) + 's'}"
        enabled="{!$props.pausing}"
        onDidChange="(v) => emitEvent('seek', v)" />
      </Theme>
      <!-- The point the pause goes in at is the playhead: its TimeEdge
           nudges it (within the scene), and the slider follows. -->
      <TimeEdge what="At" text="{time.toFixed(2) + ' s'}" playhead="{false}" enabled="{!$props.pausing}"
        onNudge="(d) => emitEvent('seek', Math.max(0, Math.min(Math.round((time + d) * 100) / 100, dur)))" />
      <HStack verticalAlignment="center">
        <NumberBox width="110px" initialValue="{pauseSecs}" minValue="{0.5}" maxValue="{30}" step="{0.5}"
          endText="s" tooltip="How long the pause lasts (remembered as the default)"
          onDidChange="(v) => {
            if (v >= 0.5 &amp;&amp; v &lt;= 30) {
              pauseSecs = v;
              writeLocalStorage('studio.pauseSeconds', v);
            }
          }" />
        <Button label="{'Insert ' + pauseSecs + 's pause'}" size="xs" themeColor="attention"
          tooltip="{'Hold the frame at ' + time.toFixed(2) + ' s (the playhead) for ' + pauseSecs + ' s, with silence (Undo takes it back)'}"
          enabled="{!$props.pausing &amp;&amp; !$props.cutting &amp;&amp; !$props.narrating &amp;&amp; !$props.narrBusy &amp;&amp; !$props.audition}"
          handlerTimeoutMs:onClick="0"
          onClick="emitEvent('insert', { seconds: pauseSecs })" />
        <Button label="Cancel" size="xs" variant="ghost" enabled="{!$props.pausing}"
          onClick="emitEvent('hush'); pauseAdding = false;" />
        <Spinner when="{$props.pausing}" />
      </HStack>
      <!-- A pause that falls inside a narration takes away its ✕, as a cut
           through one does. -->
      <Text color="$color-warn-700"
        when="{($props.narrs || []).some((n) => time > n.t_in + 0.04 &amp;&amp; time &lt; n.t_out - 0.04)}"
        value="{'This pause falls inside the narration at ' + ($props.narrs || []).filter((n) => time > n.t_in + 0.04 &amp;&amp; time &lt; n.t_out - 0.04).map((n) => n.t_in.toFixed(1) + '–' + n.t_out.toFixed(1) + ' s').join(' and ') + '. Afterwards its ✕ can no longer remove it; only Undo can.'}" />
    </VStack>
    <Items data="{$props.pauses || []}">
      <HStack verticalAlignment="center"
        var.sel="{pauseSel === $item.id || (pauseSel === null &amp;&amp; pauseSelAt !== null &amp;&amp; Math.abs($item.at - pauseSelAt) &lt; 0.06)}">
        <Button size="xs" variant="{sel ? 'solid' : 'ghost'}"
          label="{'Pause at ' + $item.at.toFixed(2) + ' s · ' + $item.seconds + ' s'}"
          enabled="{!$props.pausing}"
          onClick="
            pauseSel = $item.id;
            pauseSelAt = null;
            emitEvent('seek', $item.at);
          " />
        <Button when="{sel}" label="{$props.audition &amp;&amp; $props.audition.kind === 'pause-row' &amp;&amp; Math.abs($props.audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? 'Stop' : 'Play'}"
          size="xs" variant="outlined" tooltip="Play from 2 s before this pause to 2 s after it"
          onClick="$props.audition &amp;&amp; $props.audition.kind === 'pause-row' &amp;&amp; Math.abs($props.audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? emitEvent('stopPlay') : emitEvent('play', { start: Math.max(0, $item.at - 2), stop: $item.at + $item.seconds + 2, kind: 'pause-row' })" />
        <Button when="{sel}" icon="close" size="xs" variant="ghost"
          aria-label="Remove this pause"
          tooltip="Remove this pause: its held frame and silence come out of the scene (Undo puts it back)"
          enabled="{!$props.pausing &amp;&amp; !$props.cutting &amp;&amp; !$props.narrating &amp;&amp; !$props.narrBusy}"
          handlerTimeoutMs:onClick="0"
          onClick="
            pauseSel = null;
            pauseSelAt = null;
            emitEvent('removePause', { id: $item.id, at: $item.at });
          " />
      </HStack>
    </Items>
  </VStack>
</Component>
