<App name="Bram Studio" layout="vertical-sticky" var.playing="" var.sourceAspect="{undefined}" var.editTake="{null}" var.takeAspect="{undefined}" var.calloutBox="{null}" var.calloutIn="{0}" var.calloutOut="{3}" var.editCallout="{null}" var.editFile="" var.playerTime="{0}" var.dragPos="{null}" var.dragFrom="{null}" var.lastSprite="{null}" var.savedKey="" var.annotKind="{readLocalStorage('studio.annotKind', 'callout')}" var.dismissedUndo="" var.noteBuffer="" var.dictating="" var.noteEdited="{false}" var.lastCut="{[0, 1]}" var.cutSeed="{[0, 1]}" var.cutSeq="{0}" var.pauseSecs="{readLocalStorage('studio.pauseSeconds', 2)}" var.narrClip="{[0, 1]}" var.narrSeed="{[0, 1]}" var.narrating="{null}" var.narrBusy="{false}" var.audition="{null}" var.resumeAt="{null}" var.lastLevels="{null}" var.capClip="{[0, 1]}" var.capSeed="{[0, 1]}" var.srcDur="{0}" var.clipBusy="{false}" var.narrAdding="{false}" var.pauseAdding="{false}" var.cutAdding="{false}" var.cutSel="{null}" var.cutSelAt="{null}" var.pauseSel="{null}" var.pauseSelAt="{null}" var.narrSel="{null}" var.narrSelAt="{null}" var.renamingTake="{null}" var.renameDraft="" var.curShape="{null}" var.curText="" var.curTail="none" var.opening="" var.copyingProject="" var.editingSafe="" var.safeDrafts="{{}}">
  <!-- Bram's own layout (~/bram/app/tools/Main.xmlui): header band over the
       main area, nav always visible. themes/studio.json keeps the nav from
       collapsing into a drawer on a narrow window, as Bram's theme does. -->
  <!-- Takes live in the open project's studio.db (see schema.sql and
       studio_paths.py). serve_media.py answers the project's queries
       read-only at its own /query, since it is what knows which project is
       open; Bram's /query serves only the repo's studio.db, which holds the
       shared Audio bench (voiceTests below). Each take's MP4 is served by
       serve_media.py too, which Bram's loopback can't do yet (no video
       content types, no byte ranges). -->
  <DataSource id="takes" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, name, created_at, substr(created_at, 6) AS recorded, duration_s, url, file, source, src_end, warning FROM takes ORDER BY position, created_at DESC', params: [] }}"
    pollIntervalInSeconds="60" />
  <!-- A scene appears here when Make scene's clip (/takes/clip) registers. -->
  <DataSource id="sources" url="http://127.0.0.1:8765/sources" pollIntervalInSeconds="60" />
  <!-- The project folders and which one is open ({open, name, projects};
       list_projects() in serve_media.py), for the Projects page and the name
       at the top of the nav panel. -->
  <DataSource id="projects" url="http://127.0.0.1:8765/projects" />
  <!-- Push instead of polling: serve_media.py's GET /events says which list
       changed ({changed: 'takes'|'sources'|'exports'|'projects'})
       and only that one is refetched, plus the Projects page's list, which
       'takes', 'exports' and 'projects' (a project folder changed) all
       affect. Two fetches of that list close together are harmless: the
       later one wins and reads the newer state. 'takes' (any change to
       studio.db) otherwise refetches only the scenes list: the page's own
       edits refresh the lists they touch
       (history, narrations, pauses, items) from their handlers and leave the
       scenes list to this, so no list is fetched twice at once (XMLUI cancels
       a list's fetch in flight when another starts: two rounds 10 ms apart
       after every edit, 2026-10-03, likely what left a stale narrations
       list). EventSource is experimental in XMLUI and has no docs
       page yet (source: xmlui/src/components/EventSource/EventSource.tsx), so
       the polls above stay as a 60 s fallback. -->
  <!-- onOpen (load and every reconnect): the bridge (studio-dictation.js)
       tells the server whether this page is dictating, and into which row,
       so a reload can't leave the server holding the mic for a dictation
       that no longer exists. -->
  <!-- A reconnect also follows the server starting over on another project
       (Open or Create on the Projects page), so onOpen refetches every list;
       when this page asked for the switch (`opening`), it then shows Takes. -->
  <EventSource url="http://127.0.0.1:8765/events"
    onOpen="() => {
      dictating = window.studioDictationSync();
      projects.refetch(); takes.refetch(); exports.refetch(); edits.refetch(); narrs.refetch(); pauses.refetch(); cuts.refetch();
      if (opening) { opening = ''; navigate('/'); }
    }"
    onMessage="(m) => {
      if (m.changed === 'takes') { takes.refetch(); projects.refetch(); }
      else if (m.changed === 'sources') sources.refetch();
      else if (m.changed === 'exports') { exports.refetch(); projects.refetch(); }
      else if (m.changed === 'projects') projects.refetch();
    }" />
  <!-- One click, no warning: serve_media.py moves the MP4 to media/.trash/. -->
  <!-- The table is refreshed in the trash button's click, after execute():
       this APICall's onSuccess refetch didn't take effect (rows lingered until
       the 5s poll, and clicking one gave "no take with id N"). invalidates="{[]}"
       stops the default refresh of every DataSource (including /devices, which
       runs ffmpeg) after each delete; only the takes table needs refetching. -->
  <!-- The finishing workflow's two lists ({exports, leveled}, each newest
       first; see list_exports() in serve_media.py), deleting one (moved to
       media/.trash/), and leveling an export with level_edit.py. No
       onSuccess on either call (xmlui-org/xmlui#3924): the clicks refetch. -->
  <DataSource id="exports" url="http://127.0.0.1:8765/exports" />
  <APICall id="deleteExport" method="post" url="http://127.0.0.1:8765/exports/delete"
    body="{{ name: $param.name, where: $param.where }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="levelExport" method="post" url="http://127.0.0.1:8765/exports/level"
    body="{{ name: $param.name, where: $param.where }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- A row's note, saved when its field loses focus: the buffered-edit shape
       from https://www.xmlui.org/docs/howto/buffer-a-reactive-edit (noteBuffer),
       refetching in the handler instead of onSuccess (xmlui-org/xmlui#3924). -->
  <APICall id="saveExportNote" method="post" url="http://127.0.0.1:8765/exports/note"
    body="{{ name: $param.name, where: $param.where, note: $param.note }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Every field that takes dictation has the same frame: 🎤 before it (⏹
       while dictating) and ✕ after it to clear it. Keep that when adding
       dictation anywhere else.
       Export-row notes: typed, or dictated with the row's mic. Dictation is
       Bram's script (/__shell/dictation.js, judell/bram#417) behind the
       bridge in studio-dictation.js, called through window as Bram's own
       pane markup does (judell/bram
       app/tools/components/IsolatedDraftEditor.xmlui). The mic starts it: the
       bridge claims the mic from serve_media.py, captures in the browser and
       writes the text into the note as you speak; what you type meanwhile is
       kept. The mic again, or Enter in the note (its Form submits,
       https://www.xmlui.org/docs/howto/submit-a-form-from-a-custom-button),
       stops it, and the page saves the field's text as the note.
       The bridge can't read the field (a component passed to page script is
       a snapshot), so the field's onDidChange reports its text; the bridge
       writes with setValue
       (https://www.xmlui.org/docs/reference/components/TextArea). -->
  <script>
    function noteKey(item) { return item.where + '/' + item.name; }
    function commitNote(item) {
      const note = noteBuffer.trim();
      if (note === (item.note || '')) return;
      // Only an edit deletes: leaving a field with an empty buffer you didn't
      // type into never removes its note (dictation-robust).
      if (note === '') { if (!noteEdited) return; }
      saveExportNote.execute({ name: item.name, where: item.where, note });
      exports.refetch();
    }
    // The ✕ after a dictation field: clearing is the edit itself, so it saves
    // the empty note directly, without the noteEdited guard.
    function clearNote(item) {
      noteBuffer = '';
      saveExportNote.execute({ name: item.name, where: item.where, note: '' });
      exports.refetch();
    }
    function startDictation(item, box) {
      try {
        window.studioDictationStart(box, noteKey(item));
        dictating = noteKey(item);
        box.focus();
      } catch (e) {
        toast.error(e.message);
      }
    }
    function stopDictation(item) {
      try {
        // The field's final text, dictated and typed; null if nothing ran.
        const note = window.studioDictationStop();
        if (typeof note === 'string') {
          noteBuffer = note;
          saveExportNote.execute({ name: item.name, where: item.where, note: note.trim() });
        }
      } catch (e) {
        toast.error(e.message);
      }
      exports.refetch();
      dictating = '';
    }
    function submitNote(item) {
      if (dictating === noteKey(item)) stopDictation(item);
      else commitNote(item);
    }
    // Narrate over a stretch of the take being edited (serve_media.py's
    // /narrate/*). The server answers /narrate/start once the mic is live;
    // then the muted player starts from the clip's start and /narrate/go tells
    // the server that moment, so the words land where they were spoken.
    // narrating holds the clip while the mic is open: it mutes the player,
    // hides its controls and runs the Timer that calls stopNarration at the
    // clip's end. /narrate/stop writes the take (both files), so narrBusy
    // shows a spinner until it answers.
    function startNarration() {
      try {
        audition = null;
        takePlayer.pause();
        takePlayer.seek(narrClip[0]);
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/start', method: 'post',
                          body: { id: editTake, start: narrClip[0], end: narrClip[1] } });
        narrating = narrClip;
        takePlayer.play();
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/go', method: 'post' });
      } catch (e) {
        narrating = null;
        toast.error(e.message);
      }
    }
    function stopNarration() {
      const clip = narrating;
      takePlayer.pause();
      narrating = null;
      narrBusy = true;
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/stop', method: 'post' });
        // Done: the adding row closes and the new narration is selected in
        // the list (by its start, until the list has its row). A refused
        // narration (nothing said) keeps the adding row open, to retry.
        narrAdding = false;
        narrSel = null;
        narrSelAt = clip ? clip[0] : null;
      } catch (e) {
        toast.error(e.message);
      }
      narrBusy = false;
      resumeAt = clip ? clip[0] : takePlayer.getCurrentTime();
      cutSeq = cutSeq + 1;
      edits.refetch();
      narrs.refetch(); pauses.refetch(); cuts.refetch();
    }
    // An audition plays a bounded stretch of the take and stops, as judell/av
    // does (https://github.com/judell/av, av.js playIntro/playOutro/playClip):
    // seek to start, set where to stop, play. Its Timer (after the Tabs)
    // pauses once the playhead reaches stop. A handle moved, a tab switched,
    // an edit or another take ends an audition, as does pausing the player. Each stop is logged (/audition/log) with where
    // the playhead actually stopped, to measure how close the 40 ms Timer
    // gets. invalidates: [] keeps the log call from refetching every list.
    // (Not from / to: the markup's script parser rejects from as a name.)
    function playAudition(start, stop, kind, src) {
      // src: the capture view's source player, else the take player.
      const P = src ? sourcePlayer : takePlayer;
      const end = src ? (sourcePlayer.duration || srcDur) : (takePlayer.duration || editDur);
      const a = { start: Math.max(0, start), stop: Math.min(end, stop), kind, startedMs: Date.now(),
                  at: Math.max(0, start), atMs: Date.now(), src: !!src };
      // No pause before the seek: a pause cuts off a play() still starting
      // (a quick second click), which the page shows as an error.
      P.seek(a.start);
      audition = a;
      P.play();
    }
    // The capture view's nudges: move one end of the clip by delta seconds,
    // re-place the handles by re-seeding capSeed (which fires no slider
    // events), and show that frame, as on the Cut tab. The clip stays within
    // the source and at least 0.52 s long (a take must be 0.5 s).
    function nudgeCap(which, delta) {
      const end = sourcePlayer.duration || srcDur;
      const c = capClip;
      const s = which === 'start' ? Math.max(0, Math.min(Math.round((c[0] + delta) * 100) / 100, c[1] - 0.52)) : c[0];
      const e = which === 'end' ? Math.min(end, Math.max(Math.round((c[1] + delta) * 100) / 100, c[0] + 0.52)) : c[1];
      audition = null;
      if (s !== c[0] || e !== c[1]) {
        capSeed = [s, e];
        capClip = capSeed;
      }
      sourcePlayer.seek(which === 'start' ? s : e);
    }
    // Where the next scene from a source starts: the end of the most recent
    // scene made from it (a clip, file *-clip*), or 0:00 with none.
    function lastSceneEnd(source) {
      const made = (takes.value || []).filter((t) => t.source === source && (t.file || '').indexOf('-clip') !== -1 && t.src_end);
      if (!made.length) return 0;
      return Number(made.reduce((a, b) => (b.id > a.id ? b : a)).src_end) || 0;
    }
    // Set the next scene to start at startAt and run 10 s (or to the end of
    // the source), and show that frame. (Not "from": the markup's script
    // parser rejects it as a name.)
    function nextClipFrom(startAt) {
      const end = sourcePlayer.duration || srcDur || 0;
      const s = Math.max(0, Math.min(startAt, Math.max(0, end - 0.52)));
      capSeed = [s, Math.min(end || s + 10, s + 10)];
      capClip = capSeed;
      sourcePlayer.seek(s);
    }
    // Export: join all scenes into one video. The server applies any scene
    // whose items changed since its last Apply first, so what each scene's
    // list shows is what goes out.
    function startExport() {
      navigate('/exports');
      exportTakes.execute();
      exports.refetch();
    }
    // Open a scene in the editor (its name's link in the scenes list), paused
    // at its start: nothing plays by itself. Per-scene state starts over.
    function openScene(item) {
      if (playing === item.url) return;
      resumeAt = null;
      lastLevels = null;
      playing = item.url;
      editTake = item.id;
      editFile = item.file;
      lastCut = [0, 1]; cutSeed = [0, 1];
      narrClip = [0, 1]; narrSeed = [0, 1];
      editCallout = null; calloutBox = null; lastSprite = null;
      curShape = null; curText = ''; curTail = 'none';
      audition = null;
      narrAdding = false; narrSel = null; narrSelAt = null;
      pauseAdding = false; pauseSel = null; pauseSelAt = null;
      cutAdding = false; cutSel = null; cutSelAt = null;
    }
    // m:ss.ss for the capture view's times (sources run to minutes).
    function mmss(t) {
      const m = Math.floor(t / 60);
      const r = (t - m * 60).toFixed(2);
      return m + ':' + (r.length === 4 ? '0' + r : r);
    }
    // The audio strip's bars (under the take player): one per slice of
    // /takes/levels, px tall for its level from -60 dB (1 px) to 0 dB (24 px),
    // narr when its middle falls inside a narration, and tip, what hovering
    // it says.
    function levelBars(lv, narrations) {
      return lv.levels.map((db, i) => {
        const t = (i + 0.5) * lv.binSecs;
        const n = narrations.find((r) => t >= r.t_in && !(t > r.t_out));
        const what = n ? 'Narration ' + n.t_in.toFixed(2) + '–' + n.t_out.toFixed(2) + ' s' : 'Scene audio';
        const level = db > -60 ? Math.round(db) + ' dB' : 'silence';
        return { px: Math.max(1, Math.round(Math.min(1, (db + 60) / 60) * 24)), narr: !!n,
                 tip: what + ' · ' + level + ' at ' + t.toFixed(2) + ' s' };
      });
    }
    // Cut's nudges: move one end of the marked stretch by delta seconds,
    // re-place the handles by re-seeding cutSeed (which fires no slider
    // events), and show that frame, as dragging a handle does. The stretch
    // stays within the take and at least 0.12 s long, as the slider's
    // minStepsBetweenThumbs keeps it.
    function nudgeCut(which, delta) {
      const end = takePlayer.duration || editDur;
      const c = lastCut;
      const s = which === 'start' ? Math.max(0, Math.min(Math.round((c[0] + delta) * 100) / 100, c[1] - 0.12)) : c[0];
      const e = which === 'end' ? Math.min(end, Math.max(Math.round((c[1] + delta) * 100) / 100, c[0] + 0.12)) : c[1];
      audition = null;
      if (s !== c[0] || e !== c[1]) {
        cutSeed = [s, e];
        lastCut = cutSeed;
      }
      takePlayer.seek(which === 'start' ? s : e);
    }
    // Add annotation: the current tool (annotKind) in the middle of the
    // picture, from the playhead for 3 s (to the scene's end), saved and
    // made current as a ⌘-drag's item is (onShapeEnd).
    function addAnnotation() {
      const t = takePlayer.getCurrentTime();
      const end = takePlayer.duration || editDur;
      const out = Math.max(t + 0.2, Math.min(t + 3, end));
      const shape = annotKind === 'callout' ? null : annotKind;
      const box = shape === 'arrow' || shape === 'line' ? { x1: 0.4, y1: 0.5, x2: 0.6, y2: 0.5 }
        : shape === 'pointer' ? { x1: 0.5, y1: 0.5, x2: 0.5, y2: 0.5 }
        : { x1: 0.35, y1: 0.4, x2: 0.65, y2: 0.55 };
      audition = null;
      const r = Actions.callApi({ url: 'http://127.0.0.1:8765/callouts/add', method: 'post',
                                  body: { take_id: editTake, text: '', x1: box.x1, y1: box.y1, x2: box.x2, y2: box.y2,
                                          t_in: t, t_out: out, tail: 'none', shape: shape } });
      editCallout = r.id;
      curShape = shape;
      curText = '';
      curTail = 'none';
      calloutBox = box;
      calloutIn = t;
      calloutOut = out;
      lastSprite = null;
      dragPos = null;
      callouts.refetch();
      savedSprites.refetch();
      applyState.refetch();
    }
    // The current item's In or Out, one frame (delta) earlier or later: In
    // stays at or above 0 and 0.1 s before Out, Out 0.1 s after In and within
    // the scene. Saved at once, and the playhead goes there so the frame is
    // seen.
    function nudgeItem(which, delta) {
      const end = takePlayer.duration || editDur;
      const t = which === 'in'
        ? Math.max(0, Math.min(Math.round((calloutIn + delta) * 100) / 100, calloutOut - 0.1))
        : Math.min(end, Math.max(Math.round((calloutOut + delta) * 100) / 100, calloutIn + 0.1));
      if (t !== (which === 'in' ? calloutIn : calloutOut)) {
        if (which === 'in') calloutIn = t; else calloutOut = t;
        takePlayer.seek(t);
        saveCurrentItem();
      }
    }
    // The current item's In or Out set from the playhead.
    function setItemEdge(which) {
      const p = takePlayer.getCurrentTime();
      if (which === 'in') calloutIn = Math.max(0, Math.min(p, calloutOut - 0.1));
      else calloutOut = Math.max(p, calloutIn + 0.1);
      saveCurrentItem();
    }
    function saveCurrentItem() {
      updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1,
                              x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: calloutOut, tail: curTail,
                              shape: curShape });
      callouts.refetch();
      savedSprites.refetch();
      applyState.refetch();
    }
    // A Play button pressed again while its stretch plays (it reads Stop):
    // pause and end the audition, unlogged, since nothing was measured.
    function stopAudition() {
      const a = audition;
      if (a) (a.src ? sourcePlayer : takePlayer).pause();
      audition = null;
      if (a && a.returnTo !== undefined) takePlayer.seek(a.returnTo);
    }
    // The user scrubbed during an audition: let go without pausing, so the
    // player does what they asked, and log where the playhead went.
    function yieldAudition(t) {
      const a = audition;
      audition = null;
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/audition/log', method: 'post', invalidates: [],
                          body: { kind: 'yielded-to-scrub-' + a.kind, start: a.start, stop: a.stop, stoppedAt: t } });
      } catch (e) {
        // A missing log line is no reason to bother the user.
      }
    }
    function endAudition() {
      const a = audition;
      const P = a.src ? sourcePlayer : takePlayer;
      P.pause();
      audition = null;
      const stoppedAt = P.getCurrentTime();
      // A preview that asked to (the Pause tab's) puts the playhead back.
      if (a.returnTo !== undefined) P.seek(a.returnTo);
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/audition/log', method: 'post', invalidates: [],
                          body: { kind: a.kind, start: a.start, stop: a.stop, stoppedAt } });
      } catch (e) {
        // A missing log line is no reason to bother the user.
      }
    }
    // Open and New project (the Projects page). The server writes which
    // project is open and starts itself over on it, so the page doesn't
    // refetch here: the event stream drops and reconnects, and its onOpen
    // (above) refetches every list, clears `opening` and shows Takes. The
    // player closes first, since its take belongs to the project being left.
    // A refusal (a take being recorded, an export running) arrives as an
    // error (https://www.xmlui.org/docs/reference/components/APICall, "Error
    // handling in try/catch blocks"). invalidates: [] (Actions.callApi,
    // https://www.xmlui.org/docs/globals) stops the refetch of every list
    // that would otherwise follow the call and land while the server is
    // starting over, each failing with a toast.
    // A size on the Projects page, its dialogs and notices: binary units with
    // three significant figures (5.95 MiB, 23.8 MiB, 448 MiB, 1.03 GiB), "-"
    // for nothing. formatFileSizeInBytes gives one decimal at every size, so
    // four files of 5.948 MiB read 5.9 each under a total of 23.8.
    function sizeText(bytes) {
      if (!bytes) return '-';
      const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
      const i = Math.min(units.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)));
      const v = bytes / Math.pow(1024, i);
      return i === 0 ? bytes + ' B' : v.toFixed(v >= 100 ? 0 : v >= 10 ? 1 : 2) + ' ' + units[i];
    }
    // A project's line on the Projects page, after its name.
    function projectFacts(p) {
      const facts = [p.takes + (p.takes === 1 ? ' take' : ' takes'), p.seconds + ' s', sizeText(p.bytes)];
      if (p.changed) facts.push('changed ' + p.changed.substring(5));
      if (p.safekeeping.last) facts.push('copied ' + p.safekeeping.last.at.substring(5)
        + (p.safekeeping.changed_since ? ' (changed since)' : ''));
      if (p.stray.length) facts.push(p.stray.length + (p.stray.length === 1 ? ' stray item' : ' stray items'));
      return facts.join(' · ');
    }
    // Safekeeping (the Projects page): where a project's copies go, what the
    // last copy was, and making one (set_safekeeping and copy_project in
    // serve_media.py). The copy runs while you wait; copyingProject shows it.
    function safekeepingNote(s) {
      if (!s.location) return 'No safekeeping location yet.';
      if (!s.exists) return 'The location isn\'t there now: ' + s.location;
      if (!s.last) return 'Not copied yet.';
      return 'Last copied ' + s.last.at.substring(5) + ': ' + s.last.files + ' files, '
        + sizeText(s.last.bytes) + (s.changed_since ? '. The project has changed since.' : '. Unchanged since.')
        + (s.last.extra ? ' ' + s.last.extra + (s.last.extra === 1 ? ' file' : ' files')
          + ' there are no longer in the project (copies never delete).' : '');
    }
    // The location's button: Change (a location is saved, not being
    // edited), Set (the box differs from what's saved) or Cancel (it
    // doesn't). The page's state is passed in, so the expressions that call
    // these follow it.
    function safeEditing(p, editing) { return !p.safekeeping.location || editing === p.slug; }
    function safeDraft(p, drafts) {
      const d = drafts[p.slug];
      return (d === undefined ? (p.safekeeping.location || '') : d).trim();
    }
    function setSafeDraft(slug, v) {
      const d = Object.assign({}, safeDrafts);
      d[slug] = v;
      safeDrafts = d;
    }
    function safeButtonLabel(p, editing, drafts) {
      if (!safeEditing(p, editing)) return 'Change';
      return p.safekeeping.location && safeDraft(p, drafts) === p.safekeeping.location ? 'Cancel' : 'Set';
    }
    function safeButtonEnabled(p, editing, drafts) {
      return safeButtonLabel(p, editing, drafts) !== 'Set' || safeDraft(p, drafts) !== '';
    }
    function safeButton(p) {
      const label = safeButtonLabel(p, editingSafe, safeDrafts);
      if (label === 'Change') {
        setSafeDraft(p.slug, p.safekeeping.location);
        editingSafe = p.slug;
      } else if (label === 'Cancel') {
        editingSafe = '';
      } else if (setSafekeeping(p.slug, safeDraft(p, safeDrafts))) {
        editingSafe = '';
      }
    }
    // Saves a location; true once saved. A folder that isn't there yet is
    // offered to be made (the server asks for create: true before making it).
    function setSafekeeping(slug, location, create) {
      let saved = false;
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/safekeeping', method: 'post',
          body: { slug: slug, location: location, create: !!create }, invalidates: [] });
        if (r.missing) {
          const yes = confirm('Make the folder?', 'There is no folder at ' + r.location + ' yet. Make it, and send copies there?',
            'Make it', 'Cancel');
          return yes ? setSafekeeping(slug, location, true) : false;
        }
        toast.success(r.location ? 'Copies will go to ' + r.location + '.'
          : 'No safekeeping location now. Copies already made are still where they were.');
        saved = true;
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
      return saved;
    }
    // A project's Delete (the Projects page): the question asked first, and
    // the move to the Trash once the answer is yes.
    function deleteProjectQuestion(p) {
      const folder = projects.value ? projects.value.folder : 'projects';
      return 'Move ' + p.name + ' (' + p.takes + (p.takes === 1 ? ' take, ' : ' takes, ') + p.seconds + ' s, '
        + sizeText(p.bytes) + ') to the Trash? To bring it back, drag the folder ' + p.slug
        + ' from the Trash into ' + folder + ' and click Refresh.'
        + (p.safekeeping.copy_exists ? ' Its safekeeping copy in ' + p.safekeeping.copy_path + ' stays where it is.' : '');
    }
    function deleteProject(p) {
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/delete', method: 'post',
          body: { slug: p.slug }, invalidates: [] });
        toast.success(p.name + ' is in the Trash, as ' + r.as + '.');
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
    }
    function clearSafekeepingQuestion(p) {
      const s = p.safekeeping;
      return 'Move the safekeeping copy of ' + p.name + ' (' + s.copy_path
        + (s.last ? ', ' + s.last.files + ' files, ' + sizeText(s.last.bytes) : '')
        + ') to the Trash? The location stays set; the next Copy to safekeeping copies everything again.';
    }
    function clearSafekeeping(p) {
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/projects/safekeeping/clear', method: 'post',
          body: { slug: p.slug }, invalidates: [] });
        toast.success('The safekeeping copy of ' + p.name + ' is in the Trash.');
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
    }
    function copyToSafekeeping(p) {
      copyingProject = p.slug;
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/copy', method: 'post',
          body: { slug: p.slug }, invalidates: [] });
        toast.success('Copied ' + p.name + ': ' + (r.copied - 2) + ' files new or changed, ' + r.skipped
          + ' unchanged, ' + sizeText(r.bytes) + ' in all.');
      } catch (e) {
        toast.error(e.message);
      }
      copyingProject = '';
      projects.refetch();
    }
    // A stray item's Delete (the Projects page): the question the click asks
    // first, and the move to the macOS Trash once the answer is yes.
    function strayQuestion(item) {
      return 'Move ' + item.path + ' (' + sizeText(item.bytes) + ') to the Trash? '
        + 'Its space comes back when you empty the Trash.';
    }
    function deleteStray(item) {
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/projects/stray/delete', method: 'post',
          body: { slug: item.slug, path: item.path }, invalidates: [] });
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
    }
    // A category's clean-up button (the Projects page). cleanPlan asks the
    // server what the button would remove, without removing it ({files,
    // bytes}; null, with a note, when that is nothing); cleanQuestion words
    // the confirmation from it; cleanProject does it.
    function cleanPlan(action) {
      try {
        const plan = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/clean', method: 'post',
          body: { slug: action.slug, what: action.what, days: action.days, dry: true }, invalidates: [] });
        if (!plan.files) {
          toast(action.days ? 'Nothing here was deleted more than ' + action.days + ' days ago.' : 'Nothing to clean up.');
          return null;
        }
        return plan;
      } catch (e) {
        toast.error(e.message);
        return null;
      }
    }
    function cleanQuestion(action, plan) {
      return 'Move ' + plan.summary + ' (' + sizeText(plan.bytes) + ') from ' + action.project
        + ' to the Trash? ' + action.warning + ' The space comes back when you empty the Trash.';
    }
    function cleanProject(action) {
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/clean', method: 'post',
          body: { slug: action.slug, what: action.what, days: action.days }, invalidates: [] });
        toast.success('Moved ' + sizeText(r.bytes) + ' to the Trash, as ' + r.as + '.');
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
    }
    function switchProject(path, body, label) {
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/' + path, method: 'post', body: body, invalidates: [] });
        if (r.restarting) {
          playing = '';
          editTake = null;
          opening = label;
        } else {
          projects.refetch();
        }
        return true;
      } catch (e) {
        toast.error(e.message);
        return false;
      }
    }
  </script>
  <!-- Joins every take, in list order, into one MP4 (media/exports/). -->
  <APICall id="exportTakes" method="post" url="http://127.0.0.1:8765/export"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="reorderTakes" method="post" url="http://127.0.0.1:8765/reorder"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- The Projects page's drag order, saved to projects/.order. -->
  <APICall id="reorderProjects" method="post" url="http://127.0.0.1:8765/projects/reorder"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Callouts and shapes: text, boxes, ovals, arrows and pointers burned into
       a take (overlay.py). Add/delete edit the list; render burns them in from
       the take's clean copy. -->
  <DataSource id="callouts" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, text, x1, y1, x2, y2, t_in, t_out, tail, shape FROM overlays WHERE take_id = ? AND kind IN (?, ?) ORDER BY t_in', params: [editTake, &quot;callout&quot;, &quot;shape&quot;] }}" />
  <!-- The edited take's narrations (serve_media.py's narrations table), for
       the Narrate tab's list and the Cut and Pause tabs' warnings. -->
  <DataSource id="narrs" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, t_in, t_out FROM narrations WHERE take_id = ? ORDER BY t_in', params: [editTake] }}" />
  <!-- The edited scene's inserted pauses (serve_media.py's pauses table),
       for the Pause tab's rows. -->
  <DataSource id="pauses" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, at, seconds FROM pauses WHERE take_id = ? ORDER BY at', params: [editTake] }}" />
  <!-- The edited scene's cuts (serve_media.py's cuts table), for the Cut
       tab's rows. -->
  <DataSource id="cuts" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, at, seconds FROM cuts WHERE take_id = ? ORDER BY at', params: [editTake] }}" />
  <APICall id="removeNarration" method="post" url="http://127.0.0.1:8765/narrate/remove"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="addCallout" method="post" url="http://127.0.0.1:8765/callouts/add"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="updateCallout" method="post" url="http://127.0.0.1:8765/callouts/update"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteCallout" method="post" url="http://127.0.0.1:8765/callouts/delete"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="renderOverlay" method="post" url="http://127.0.0.1:8765/overlay/render"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteTake" method="post" url="http://127.0.0.1:8765/delete"
    body="{{ id: $param }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Cut a stretch out of a take (serve_media.py's /takes/cut: the take and
       its clean copy, callouts shifted). No onSuccess (xmlui-org/xmlui#3924).
       cutSeq goes into the take player's src so it reloads the changed video.
       edits is the edited take's history for the Undo tab (GET
       /takes/edits: its edits newest first, which one Undo would take back,
       and whether Undo and Redo are possible); it is refetched after every
       edit, undo and redo and whenever the takes change. undoEdit and
       redoEdit step back and forth through it. -->
  <DataSource id="edits" url="{'http://127.0.0.1:8765/takes/edits?id=' + (editTake || 0)}" />
  <!-- The edited take's sound level per slice, for the audio strip under its
       player; cutSeq (bumped by every edit) makes an edited take refetch. -->
  <DataSource id="takeLevels" url="{'http://127.0.0.1:8765/takes/levels?id=' + (editTake || 0) + '&amp;c=' + cutSeq}"
    onLoaded="(d) => lastLevels = d" />
  <APICall id="undoEdit" method="post" url="http://127.0.0.1:8765/takes/undo"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="redoEdit" method="post" url="http://127.0.0.1:8765/takes/redo"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Standing instrumentation for the Undo button (its enabled, on the Undo
       tab): whenever one of its inputs changes, one undo-gate line in
       serve_media.log (/undo/log) with every input, which ones changed and
       whether Undo is on. After a narration, Undo stayed off while the server
       said canUndo (2026-10-05); this names the input holding it. Sources by
       name: https://www.xmlui.org/docs/reference/components/ChangeListener -->
  <ChangeListener
    listenToSources="{{
      take: editTake,
      edits: !!edits.value,
      canUndo: !!(edits.value &amp;&amp; edits.value.canUndo),
      undoing: undoEdit.inProgress,
      redoing: redoEdit.inProgress,
      cutting: cutTake.inProgress,
      pausing: pauseTake.inProgress,
      narrating: narrating,
      narrBusy: narrBusy
    }}"
    onDidChange="(change) => {
      const v = change.newValue;
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/undo/log', method: 'post', invalidates: [],
                          body: { take: v.take, edits: v.edits, canUndo: v.canUndo,
                                  undoing: v.undoing, redoing: v.redoing, cutting: v.cutting,
                                  pausing: v.pausing, narrating: v.narrating, narrBusy: v.narrBusy,
                                  changed: change.changedSources,
                                  enabled: !!(v.edits &amp;&amp; v.canUndo &amp;&amp; !v.undoing &amp;&amp; !v.redoing &amp;&amp; !v.cutting &amp;&amp; !v.pausing &amp;&amp; !v.narrating &amp;&amp; !v.narrBusy) } });
      } catch (e) {
        // A missing log line is no reason to bother the user.
      }
    }" />
  <APICall id="cutTake" method="post" url="http://127.0.0.1:8765/takes/cut"
    body="{{ id: $param.id, start: $param.start, end: $param.end }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Insert a pause: hold the frame at a point for some seconds, with silence
       (serve_media.py's /takes/pause). An edit like a cut. -->
  <APICall id="pauseTake" method="post" url="http://127.0.0.1:8765/takes/pause"
    body="{{ id: $param.id, at: $param.at, seconds: $param.seconds }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Undo the last delete: serve_media.py restores the take, its files and its
       callouts from the .trash/<stem>.json that /delete wrote. The Undo line binds
       to deleteTake.lastResult (https://www.xmlui.org/docs/howto/consume-an-apicall-response);
       dismissedUndo hides it once used; the next delete replaces it. (A ✕ beside Undo read as "cancel the delete" and was clicked for that, 2026-09-28.) No onSuccess on either call:
       an Inspector trace (2026-09-28) showed deleteTake's onSuccess, run from a
       DndItems row, logging success:start but never success:end, which holds
       lastResult back until the 30s handler timeout. Waiting on xmlui-org/xmlui#3924
       (FIFO scheduler; fine with strictDeterminism false, which we don't want). -->
  <APICall id="undeleteTake" method="post" url="http://127.0.0.1:8765/undelete"
    body="{{ undo: $param }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />

  <!-- Audio recording test: serve_media.py runs voicetest.py, which records 10s
       with the chosen mic and recorder and adds a voice_tests row. -->
  <DataSource id="devices" url="http://127.0.0.1:8765/devices" />
  <DataSource id="voiceTests" url="/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT * FROM voice_tests ORDER BY created_at DESC', params: [] }}" />
  <APICall id="voiceTest" method="post" url="http://127.0.0.1:8765/voicetest"
    body="{$param}"
    onSuccess="voiceTests.refetch()"
    errorNotificationMessage="{$error.message}" />

  <AppHeader>
    <HStack verticalAlignment="center" width="100%">
      <H3>Bram Studio</H3>
      <!-- The open project, so it is always clear which one a recording
           will land in. It is here, not in the nav panel: the panel's logo
           slot doesn't wrap, and clipped a long name at both ends. -->
      <Text variant="secondary" value="{projects.value ? projects.value.name : ''}" />
      <SpaceFiller />
      <!-- XMLUI trace viewer. The studio carries its own xs-diff.html and the
           xmlui-parser.es.js it imports (vendor/), as it carries its own engine;
           config.json's appGlobals.xsVerbose turns capture on. -->
      <Inspector src="/vendor/xs-diff.html" tooltip="Inspector: XMLUI trace" />
    </HStack>
  </AppHeader>
  <NavPanel>
    <property name="logoTemplate">
      <Fragment/>
    </property>
    <property name="footerTemplate">
      <Fragment/>
    </property>
    <NavLink label="Projects" to="/projects" />
    <NavLink label="Scenes" to="/" />
    <NavLink label="Exports" to="/exports" />
    <NavLink label="Audio" to="/bench" />
  </NavPanel>
  <Pages fallbackPath="/">
    <!-- Projects: a screencast each, a folder under projects/ (studio_paths.py).
         Open switches Studio to one; Create makes an empty one and opens it.
         Both go through switchProject (above). Rows are laid out like the
         Exports page's. -->
    <Page url="/projects">
      <!-- A clean-up's confirmation, opened with {action, plan}
           (https://www.xmlui.org/docs/howto/choose-between-imperative-and-state-driven-modal-dialogs):
           the plan's summary counts what means something (sessions, takes,
           edits), not files, which a take recorded with ink runs into the
           thousands; below it, the folders things would go from, largest
           first, each an expander listing what in it would go
           (clean_summary in serve_media.py). Nothing moves until Move to
           Trash. -->
      <ModalDialog id="cleanDialog" title="{$param ? 'Clean up: ' + $param.action.category : ''}">
        <Text variant="strong" value="{$param ? 'You lose: ' + $param.action.loses + '.' : ''}" />
        <Text value="{$param ? cleanQuestion($param.action, $param.plan) : ''}" />
        <Text variant="strong" value="What would go" />
        <Items data="{$param ? $param.plan.tree : []}">
          <ExpandableItem iconPosition="start" fullWidthSummary="true">
            <property name="summary">
              <HStack width="100%" verticalAlignment="center">
                <Text value="{$item.path}" width="*" />
                <Text value="{$item.count + ($item.count === 1 ? ' item' : ' items')}" width="90px" />
                <Text value="{sizeText($item.bytes)}" width="90px" />
              </HStack>
            </property>
            <VStack gap="0">
              <Items data="{$item.items}">
                <HStack>
                  <Text variant="secondary" value="{$item.name + ($item.folder ? '/' : '')}" width="*" />
                  <Text variant="secondary" value="{sizeText($item.bytes)}" width="90px" />
                </HStack>
              </Items>
              <Text when="{$item.more > 0}" variant="secondary" value="{'and ' + $item.more + ' more'}" />
            </VStack>
          </ExpandableItem>
        </Items>
        <HStack horizontalAlignment="end">
          <Button label="Keep" variant="ghost" onClick="cleanDialog.close()" />
          <Button label="Move to Trash" themeColor="attention"
            onClick="
              const action = $param.action;
              cleanDialog.close();
              cleanProject(action);
            " />
        </HStack>
      </ModalDialog>
      <!-- Sizes are worked out when the list is fetched (project_usage in
           serve_media.py): at load, after a switch or an action here, and
           whenever the server's change stream says takes, exports or a
           project folder changed (the EventSource above), so there is no
           Refresh button. -->
      <H2>Projects</H2>
      <Text variant="secondary" when="{projects.value &amp;&amp; projects.value.projects.length === 0}"
        value="No projects yet: this Studio keeps its scenes in the repo itself (see README, Where things are kept). Create one below to start a new screencast." />
      <!-- Each project is one line, so the page can be scanned: an expander
           (https://www.xmlui.org/docs/reference/components/ExpandableItem)
           whose summary is the project's row, closed until clicked. Inside:
           what its disk space is for, one line a category, then anything in
           its folder that isn't Studio's (an editor's project folder, a stray
           file), each with Delete. Open sits beside the expander, not in its
           summary, so clicking it doesn't also toggle the details. The inner
           lists have their own $item
           (https://www.xmlui.org/docs/reference/components/Items), so a stray
           row carries its project's slug itself. The list is a drag list like
           the Takes list (DndItems, the xmlui-dnd-list extension): only the
           grip drags, and the order is saved to projects/.order. -->
      <DndItems data="{projects.value ? projects.value.projects : []}" dragHandle="true"
        onReorder="(newOrder) => {
          reorderProjects.execute({ slugs: newOrder.map(p => p.slug) });
          projects.refetch();
        }">
        <HStack verticalAlignment="start" width="100%">
        <ExpandableItem width="*" iconPosition="start" fullWidthSummary="true">
          <property name="summary">
            <!-- One run of text, not columns: spaced out, the facts read as
                 headers for the rows below, which they aren't. -->
            <HStack verticalAlignment="center" width="100%" gap="$space-2">
              <Text value="{$item.name}" variant="{$item.open ? 'strong' : 'inherit'}" />
              <Text variant="secondary" value="{projectFacts($item)}" />
            </HStack>
          </property>
        <!-- Rows are parted by a light rule and a little padding, not a gap
             (borderBottom, as in
             https://www.xmlui.org/docs/howto/dock-elements-to-panel-edges). -->
        <VStack gap="0">
        <Items data="{$item.categories}">
          <HStack verticalAlignment="center" paddingLeft="$space-4" paddingVertical="$space-1"
            borderBottom="1px solid $color-surface-200" when="{($item.key !== 'stray' &amp;&amp; $item.key !== 'logs') || $item.bytes > 0}">
            <Text value="{$item.label}" width="170px" />
            <Text value="{sizeText($item.bytes)}" width="90px" />
            <Text variant="secondary" value="{$item.about}" width="*" />
            <!-- The category's clean-up buttons (CLEAN in serve_media.py;
                 none for takes, re-mix ingredients and exports). A click
                 first asks the server what would go, then asks you in
                 cleanDialog (below), which says what is lost and lets you
                 look through what would go. -->
            <!-- A column of its own on every row, buttons or not, so the
                 descriptions keep their width and the buttons line up. Two
                 buttons stack rather than sit side by side, which kept the
                 column narrow enough for a narrow window. The server sends
                 only buttons that would remove something now. -->
            <VStack width="210px" horizontalAlignment="end" gap="$space-1">
              <Items data="{$item.actions}">
                <Button label="{$item.label}" variant="outlined" size="sm" themeColor="attention"
                  tooltip="Move these to the Trash"
                  onClick="
                    const plan = cleanPlan($item);
                    if (plan) cleanDialog.open({ action: $item, plan: plan });
                  " />
              </Items>
              <!-- What the clean-up costs (LOSES in serve_media.py), under its
                   button, so which ones end an undo is plain before a click. -->
              <Text when="{$item.actions.length > 0}" variant="secondary" textAlign="end"
                value="{'You lose: ' + $item.loses}" />
            </VStack>
          </HStack>
        </Items>
        <Items data="{$item.stray}">
          <HStack verticalAlignment="center" paddingLeft="$space-4" paddingVertical="$space-1"
            borderBottom="1px solid $color-surface-200">
            <Text value="{$item.path + ($item.folder ? '/' : '')}" width="*" />
            <Text value="{sizeText($item.bytes)}" width="100px" />
            <!-- Asks first (https://www.xmlui.org/docs/howto/open-a-confirmation-before-delete). -->
            <Button label="Delete" variant="outlined" size="sm" themeColor="attention"
              tooltip="Move this to the Trash"
              onClick="
                const yes = confirm('Delete a stray item', strayQuestion($item), 'Move to Trash', 'Keep');
                if (yes) deleteStray($item);
              " />
          </HStack>
        </Items>
        <!-- Safekeeping, last in the project: a copy of the project in a
             folder you name (a OneDrive folder, say), of what can't be made
             again and what re-mixing needs (KEEP in serve_media.py). Copy is
             dimmed while nothing has changed since the last copy. -->
        <VStack gap="$space-1" paddingLeft="$space-4" paddingVertical="$space-2">
          <!-- The saved location reads as text with Change; Change turns it
               into a box, and the button becomes Set once the text differs
               (Cancel while it doesn't). With no location yet, the box shows.
               The box's text is kept per project in safeDrafts, through its
               onDidChange, as the Exports notes are (noteBuffer). -->
          <HStack verticalAlignment="center">
            <Text value="Safekeeping" width="170px" />
            <Text when="{!safeEditing($item, editingSafe)}" value="{$item.safekeeping.location}" width="*" />
            <TextBox when="{safeEditing($item, editingSafe)}" width="*" initialValue="{$item.safekeeping.location}"
              placeholder="A folder for copies, such as ~/Library/CloudStorage/OneDrive-Personal"
              onDidChange="(v) => setSafeDraft($item.slug, v)" />
            <Button label="{safeButtonLabel($item, editingSafe, safeDrafts)}" variant="outlined" size="sm"
              enabled="{safeButtonEnabled($item, editingSafe, safeDrafts)}"
              onClick="safeButton($item)" />
          </HStack>
          <HStack verticalAlignment="center">
            <Spinner when="{copyingProject === $item.slug}" />
            <Text variant="secondary" width="*"
              value="{copyingProject === $item.slug ? 'Copying…' : safekeepingNote($item.safekeeping)}" />
            <Button label="Copy to safekeeping" variant="outlined" size="sm"
              enabled="{$item.safekeeping.exists &amp;&amp; $item.safekeeping.changed_since !== false &amp;&amp; !copyingProject}"
              tooltip="{$item.safekeeping.changed_since === false ? 'Nothing has changed since the last copy' : 'Copy the scenes, their re-mix ingredients, exports and logs; unchanged files are skipped'}"
              onClick="copyToSafekeeping($item)" />
            <!-- A fresh start: the copy goes to the Trash (after asking), the
                 location stays, and the next Copy copies everything again. -->
            <Button label="Clear safekeeping" variant="outlined" size="sm" themeColor="attention"
              enabled="{$item.safekeeping.copy_exists &amp;&amp; !copyingProject}"
              tooltip="Move this project's safekeeping copy to the Trash, for a fresh start"
              onClick="
                const yes = confirm('Clear safekeeping', clearSafekeepingQuestion($item), 'Move to Trash', 'Keep');
                if (yes) clearSafekeeping($item);
              " />
          </HStack>
        </VStack>
        </VStack>
        </ExpandableItem>
        <!-- The summary's own top padding (padding-summary-ExpandableItem),
             so this lines up with it. -->
        <HStack width="90px" horizontalAlignment="end" verticalAlignment="center" paddingTop="$space-2">
          <Text when="{$item.open}" variant="secondary" value="open" />
          <Button when="{!$item.open}" label="Open" variant="outlined" size="sm"
            enabled="{!opening}"
            tooltip="Switch Studio to this project"
            onClick="switchProject('open', { slug: $item.slug }, $item.name)" />
        </HStack>
        <!-- Delete, last on the row: the whole project folder to the Trash,
             under its own name, so dragging it back into projects/ restores
             it (delete_project in serve_media.py). Asks first
             (https://www.xmlui.org/docs/howto/open-a-confirmation-before-delete).
             Not the open project, which Studio is running on. -->
        <HStack width="80px" horizontalAlignment="end" verticalAlignment="center" paddingTop="$space-2">
          <Button label="Delete" variant="outlined" size="sm" themeColor="attention"
            enabled="{!$item.open &amp;&amp; !opening &amp;&amp; !copyingProject}"
            tooltip="{$item.open ? 'This is the open project: open another one to delete it' : 'Move this project to the Trash'}"
            onClick="
              const yes = confirm('Delete a project', deleteProjectQuestion($item), 'Move to Trash', 'Keep');
              if (yes) deleteProject($item);
            " />
        </HStack>
        </HStack>
      </DndItems>
      <!-- The same for what projects share: sources/ and the repo's media/. -->
      <H3 when="{projects.value &amp;&amp; projects.value.shared_stray.length > 0}">Stray items in shared folders</H3>
      <Items data="{projects.value ? projects.value.shared_stray : []}">
        <HStack verticalAlignment="center" paddingLeft="$space-4">
          <Text value="{$item.path + ($item.folder ? '/' : '')}" width="*" />
          <Text value="{sizeText($item.bytes)}" width="100px" />
          <Button label="Delete" variant="outlined" size="sm" themeColor="attention"
            tooltip="Move this to the Trash"
            onClick="
              const yes = confirm('Delete a stray item', strayQuestion($item), 'Move to Trash', 'Keep');
              if (yes) deleteStray($item);
            " />
        </HStack>
      </Items>
      <HStack verticalAlignment="center" when="{!!opening}">
        <Spinner />
        <Text value="{'Opening ' + opening + '…'}" />
      </HStack>
      <H2>New project</H2>
      <HStack verticalAlignment="center">
        <TextBox id="newProjectName" placeholder="Name" width="260px" />
        <Button label="Create"
          enabled="{!!newProjectName.value &amp;&amp; !!newProjectName.value.trim() &amp;&amp; !opening}"
          tooltip="Make an empty project with this name and open it"
          onClick="
            if (switchProject('new', { name: newProjectName.value.trim() }, newProjectName.value.trim())) newProjectName.setValue('');
          " />
      </HStack>
    </Page>
    <Page url="/">
      <HStack verticalAlignment="center">
        <H2>Sources</H2>
        <Select id="sourceChoice" data="{sources}" valueField="name" labelField="name"
          placeholder="Choose a source"
          width="260px" onDidChange="audition = null; playing = '';" />
        <!-- Scene callouts (/scenes/callouts): each scene gets at most one
             3 s callout of its name at the top right, an ordinary item to
             edit on the Annotate tab, burned in only by Apply. The button
             previews (dryRun) and the dialog confirms. -->
        <Button label="Scene callouts" variant="outlined" size="sm"
          tooltip="Add a 3 s callout of each scene's name at its top right, to edit before you Apply"
          enabled="{!!takes.value &amp;&amp; takes.value.length > 0}"
          onClick="
            try {
              calloutsDialog.open(Actions.callApi({ url: 'http://127.0.0.1:8765/scenes/callouts', method: 'post',
                                                    invalidates: [], body: { dryRun: true } }));
            } catch (e) {
              toast.error(e.message);
            }
          " />
        <Button label="Export" variant="outlined" size="sm"
          tooltip="Join all scenes, in list order, into one video (any scene whose items changed since its last Apply is applied first)"
          enabled="{!exportTakes.inProgress &amp;&amp; !!takes.value &amp;&amp; takes.value.length > 0}"
          onClick="startExport()" />
      </HStack>
      <!-- Scene callouts' confirmation: every scene, the callout it has (and
           whether it is applied), the one it would get, and any exact copies
           that would be removed; the button carries the plan out. -->
      <ModalDialog id="calloutsDialog" title="Scene callouts">
        <Text value="{$param &amp;&amp; ($param.add || $param.remove) ? 'Each scene gets one 3 s callout of its name at the top right, to edit before you Apply.' : 'Every scene has its callout; there is nothing to add or remove.'}" />
        <Items data="{$param ? $param.scenes : []}">
          <Text value="{$item.name + ': ' + ($item.has ? 'has &quot;' + $item.has.text + '&quot; ' + ($item.has.applied ? '✓ applied' : '✗ not applied') : 'would add &quot;' + $item.add + '&quot;') + ($item.remove ? '; ' + $item.remove + ' duplicate' + ($item.remove === 1 ? '' : 's') + ' would be removed' : '')}" />
        </Items>
        <HStack>
          <Button when="{$param &amp;&amp; ($param.add || $param.remove)}" themeColor="primary"
            label="{$param ? [$param.add ? 'Add ' + $param.add + ' callout' + ($param.add === 1 ? '' : 's') : '', $param.remove ? 'Remove ' + $param.remove + ' duplicate' + ($param.remove === 1 ? '' : 's') : ''].filter((x) => x).join(' and ') : ''}"
            onClick="
              try {
                const r = Actions.callApi({ url: 'http://127.0.0.1:8765/scenes/callouts', method: 'post', invalidates: [], body: {} });
                toast.success([r.add ? 'Added ' + r.add + ' callout' + (r.add === 1 ? '' : 's') : '', r.remove ? 'removed ' + r.remove + ' duplicate' + (r.remove === 1 ? '' : 's') : ''].filter((x) => x).join(', ') || 'Nothing to change');
              } catch (e) {
                toast.error(e.message);
              }
              calloutsDialog.close();
              callouts.refetch();
              savedSprites.refetch();
              applyState.refetch();
            " />
          <Button label="{$param &amp;&amp; ($param.add || $param.remove) ? 'Cancel' : 'Close'}" variant="ghost"
            onClick="calloutsDialog.close()" />
        </HStack>
      </ModalDialog>
      <HStack verticalAlignment="center" when="{exportTakes.inProgress}">
        <Spinner />
        <Text value="Exporting scenes…" />
      </HStack>
      <!-- Capture: a take is a stretch of a source movie (/takes/clip), to be
           sequenced and then edited in the take editor (narration, pauses,
           annotations, cuts). The slider's two handles and the nudges set the
           stretch and the player only shows it, as on the Cut tab; the
           player's own scrubber and play/pause stay yours. Play clip, Intro
           and Outro hear it (playAudition, for this player). Shown for the
           chosen source while no take is open: one player at a time. -->
      <VStack when="{!!sourceChoice.value &amp;&amp; !playing}">
        <MediaPlayer id="sourcePlayer" maxHeight="55vh"
          src="{'http://127.0.0.1:8765/sources/' + encodeURIComponent(sourceChoice.value)}"
          onLoadedMetadata="(e) => { sourceAspect = e.videoWidth / e.videoHeight; srcDur = e.duration || 0; nextClipFrom(lastSceneEnd(sourceChoice.value)); }" />
        <Slider id="capSlider" width="100%" minValue="{0}" maxValue="{srcDur || 1}" step="{0.04}"
          initialValue="{capSeed}" minStepsBetweenThumbs="{13}"
          valueFormat="{(v) => mmss(v)}"
          enabled="{srcDur > 0 &amp;&amp; !clipBusy}"
          onDidChange="(v) => {
            audition = null;
            sourcePlayer.seek(v[0] !== capClip[0] ? v[0] : v[1]);
            capClip = v;
          }" />
        <HStack verticalAlignment="center">
          <HStack verticalAlignment="center" gap="$space-1">
            <Button label="«" size="xs" variant="ghost" enabled="{srcDur > 0}"
              tooltip="Start 1 second earlier" onClick="nudgeCap('start', -1)" />
            <Button label="‹" size="xs" variant="ghost" enabled="{srcDur > 0}"
              tooltip="Start one frame earlier" onClick="nudgeCap('start', -0.04)" />
            <Text value="{'Start ' + mmss(capClip[0])}" />
            <Button label="›" size="xs" variant="ghost" enabled="{srcDur > 0}"
              tooltip="Start one frame later" onClick="nudgeCap('start', 0.04)" />
            <Button label="»" size="xs" variant="ghost" enabled="{srcDur > 0}"
              tooltip="Start 1 second later" onClick="nudgeCap('start', 1)" />
          </HStack>
          <HStack verticalAlignment="center" gap="$space-1">
            <Button label="«" size="xs" variant="ghost" enabled="{srcDur > 0}"
              tooltip="End 1 second earlier" onClick="nudgeCap('end', -1)" />
            <Button label="‹" size="xs" variant="ghost" enabled="{srcDur > 0}"
              tooltip="End one frame earlier" onClick="nudgeCap('end', -0.04)" />
            <Text value="{'End ' + mmss(capClip[1])}" />
            <Button label="›" size="xs" variant="ghost" enabled="{srcDur > 0}"
              tooltip="End one frame later" onClick="nudgeCap('end', 0.04)" />
            <Button label="»" size="xs" variant="ghost" enabled="{srcDur > 0}"
              tooltip="End 1 second later" onClick="nudgeCap('end', 1)" />
          </HStack>
        </HStack>
        <HStack verticalAlignment="center">
          <Button label="Play scene" size="xs" variant="outlined" enabled="{srcDur > 0}"
            tooltip="Play the scene from start to end"
            onClick="playAudition(capClip[0], capClip[1], 'capture-clip', true)" />
          <Button label="Intro 3s" size="xs" variant="outlined" enabled="{srcDur > 0}"
            tooltip="Play the scene's first 3 seconds"
            onClick="playAudition(capClip[0], Math.min(capClip[0] + 3, capClip[1]), 'capture-intro', true)" />
          <Button label="Outro 3s" size="xs" variant="outlined" enabled="{srcDur > 0}"
            tooltip="Play the scene's last 3 seconds"
            onClick="playAudition(Math.max(capClip[1] - 3, capClip[0]), capClip[1], 'capture-outro', true)" />
          <Button label="{'Make scene · ' + mmss(capClip[1] - capClip[0])}" size="xs" themeColor="primary"
            tooltip="Add this scene to the list, with the source's own sound, as the next Scene N (rename it there)"
            enabled="{srcDur > 0 &amp;&amp; !clipBusy}"
            handlerTimeoutMs:onClick="0"
            onClick="
              audition = null;
              clipBusy = true;
              try {
                const r = Actions.callApi({ url: 'http://127.0.0.1:8765/takes/clip', method: 'post', invalidates: [],
                                            body: { source: sourceChoice.value, start: capClip[0], end: capClip[1] } });
                toast.success('Added ' + (r &amp;&amp; r.name ? r.name : 'the scene'));
                // Ready for the next scene: it starts where this one ended.
                nextClipFrom(capClip[1]);
              } catch (e) {
                toast.error(e.message);
              }
              clipBusy = false;
            " />
          <Spinner when="{clipBusy}" />
        </HStack>
      </VStack>
      <!-- At page level, so it runs for the capture view and the take editor
           alike (audition.src: the source player). An audition stops at its end (playAudition), and yields to the
           player, whose scrubber and play/pause are always live: a pause
           ends it (one in its first 600 ms is the play() still starting,
           not the user), and so does a scrub, seen as the playhead more
           than 0.3 s from where playing would have taken it: audition.at
           (where it was found) plus the time since (audition.atMs). While
           starting up (its first 0.6 s: paused, or the seek to its start
           not landed yet), audition.at is its start, not what the player
           reports: the seek and the play() both land late, and a press made
           while the player sat at the last stop read that stale position,
           took the jump back for a scrub and played on past the end, every
           other time (2026-10-03, narr-preview yields at 13.4-13.7 s of a
           12.59-18.04 s stretch). A scrub is a jump forward past where
           playing could have taken the playhead (audition.at, where the last
           tick found it, plus the time since) or a jump back from where the
           last tick found it. Playback starting late only leaves the playhead
           behind schedule, never behind its last place: judged against the
           schedule both ways, a start that lagged 0.3 s while the Timer got
           no tick read as a scrub about 0.9 s in, every other press
           (2026-10-03, 11.99-19.64 s yielded at 12.87 s). A yield is logged
           (yieldAudition). -->
      <Timer interval="40" enabled="{!!audition}"
        onTick="
          const P = audition &amp;&amp; audition.src ? sourcePlayer : takePlayer;
          const t = P.getCurrentTime();
          const now = Date.now();
          const young = !!audition &amp;&amp; now - audition.startedMs &lt; 600;
          const landed = !!audition &amp;&amp; t >= audition.start - 0.15 &amp;&amp; t &lt;= audition.start + 0.9;
          if (audition &amp;&amp; P.paused) {
            audition = now - audition.startedMs > 600 ? null : { ...audition, at: audition.start, atMs: now };
          } else if (audition &amp;&amp; young &amp;&amp; !landed) {
            audition = { ...audition, at: audition.start, atMs: now };
          } else if (audition &amp;&amp; (t > audition.at + (now - audition.atMs) / 1000 + 0.3 || t &lt; audition.at - 0.3)) {
            yieldAudition(t);
          } else if (audition &amp;&amp; t >= audition.stop) {
            endAudition();
          } else {
            audition = { ...audition, at: t, atMs: now };
          }
        " />
      <!-- The take loaded in the take player (its URL); hidden while recording. -->
      <!-- calloutHandles: the edited callout's eight resize handles (anchors
           named by compass point), centered on its box's corners and edge
           midpoints, square on screen (height scaled by the picture's aspect);
           hidden while the callout is being moved. They depend only on the
           box, never on the sprite, so a handle can't leave anchors mid-drag
           (PointerLayer ends a drag whose anchor disappears). -->
      <!-- editSprite: the current item's sprite from the DataSource, or its
           last one while the next loads; never another item's.
           annotKind: what the editor places (callout, rect, ellipse, arrow or
           pointer); an arrow gets two handles at its ends (a: tail, b: tip), a
           pointer none (it only moves). -->
      <!-- The editor has no draft and nothing to save (take-editor-live-model). Command-drag places an item,
           which is saved at once (/callouts/add) and becomes the current one.
           editCallout is the current item's id; calloutBox, calloutIn,
           calloutOut, curShape, curText and curTail hold its fields, set when
           it is placed or selected and at each change, and every change is
           saved at once (/callouts/update) and the lists refetched. Clicking
           or dragging an item on the picture, or its name in the list, makes
           it current. annotKind is only the tool: what the next Command-drag
           places. A cut, a pause or Undo retimes items on the server, so
           each of those lets go of the current item. curShown: the current
           item is on the picture, with its handles, only within its In and
           Out, paused or playing, as it will be in the take (shown at every
           paused position, it looked on screen where it isn't). Picking it,
           its In/Out nudges and placing it all put the playhead inside it.
           Clicking the current item's name in the list again lets go of it. -->
      <VStack when="{playing}"
        var.editDur="{((takes.value || []).find((t) => t.id === editTake) || { duration_s: 0 }).duration_s}"
        var.editSprite="{calloutSprite.value &amp;&amp; calloutSprite.value.id === editCallout ? calloutSprite.value : (lastSprite &amp;&amp; lastSprite.id === editCallout ? lastSprite : null)}"
        var.curShown="{!!editCallout &amp;&amp; playerTime >= calloutIn &amp;&amp; playerTime &lt;= calloutOut}"
        var.handleBox="{curShown &amp;&amp; calloutBox &amp;&amp; !curShape &amp;&amp; calloutBox.x2 - calloutBox.x1 &lt; 0.001 &amp;&amp; editSprite ? { x1: editSprite.x, y1: editSprite.y, x2: editSprite.x + editSprite.width, y2: editSprite.y + editSprite.height } : (curShown ? calloutBox : null)}"
        var.calloutHandles="{handleBox &amp;&amp; takeAspect &amp;&amp; !dragPos &amp;&amp; curShape !== 'pointer' ? ((curShape === 'arrow' || curShape === 'line') ? [['a', handleBox.x1, handleBox.y1], ['b', handleBox.x2, handleBox.y2]] : [['nw', handleBox.x1, handleBox.y1], ['n', (handleBox.x1 + handleBox.x2) / 2, handleBox.y1], ['ne', handleBox.x2, handleBox.y1], ['e', handleBox.x2, (handleBox.y1 + handleBox.y2) / 2], ['se', handleBox.x2, handleBox.y2], ['s', (handleBox.x1 + handleBox.x2) / 2, handleBox.y2], ['sw', handleBox.x1, handleBox.y2], ['w', handleBox.x1, (handleBox.y1 + handleBox.y2) / 2]]).map((h) => ({ id: h[0], url: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 10%22%3E%3Crect x=%221%22 y=%221%22 width=%228%22 height=%228%22 fill=%22white%22 stroke=%22%23222%22 stroke-width=%221.5%22/%3E%3C/svg%3E', x: h[1] - 0.009, y: h[2] - 0.009 * takeAspect, width: 0.018, height: 0.018 * takeAspect })) : []}">
        <!-- The player's close box (the tools are on the Annotate tab). -->
        <HStack verticalAlignment="center">
          <SpaceFiller />
          <Button icon="close" variant="ghost" aria-label="Close player"
            tooltip="Close the player" onClick="playing = ''" />
        </HStack>
        <!-- Callouts (overlay.py), edited directly on the video: the player
             shows the take's clean copy (no burned-in text, /clean/<file>) and
             PointerLayer's anchors (xmlui-org/xmlui#3922) draw each callout on
             it as a sprite from the server, made by the same code Apply uses.
             Items show between their in and out points; the current one
             always shows, and dragging it moves it (the layer reports the
             drag; the page moves the anchor), and dragging one of its eight
             handles resizes it (the text refits as you drag). Command-drag
             places a new item. calloutSprite is the current item's sprite as
             its fields stand now (with a callout's selection frame); the
             server echoes the item's id, so a sprite still loading for the
             previously current item is never shown for this one. -->
        <DataSource id="calloutSprite" url="http://127.0.0.1:8765/callouts/sprite" method="POST"
          when="{!!editCallout &amp;&amp; !!calloutBox &amp;&amp; !!editTake}"
          body="{{ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, tail: curTail, shape: curShape, frame: !curShape }}"
          onLoaded="(d) => { lastSprite = d; dragPos = null; }" />
        <!-- applyState.dirty: the saved callouts differ from what was last burned
             in (the SQL is overlay.py's APPLIED_SQL, which fills
             takes.overlay_applied at Apply); Apply is dimmed otherwise. -->
        <DataSource id="applyState" url="http://127.0.0.1:8765/query" method="POST" dataType="sql" when="{!!editTake}"
          body="{{ sql: 'SELECT (SELECT group_concat(id || char(58) || text || char(58) || x1 || char(58) || y1 || char(58) || x2 || char(58) || y2 || char(58) || t_in || char(58) || t_out || char(58) || ifnull(tail, char(45)) || char(58) || ifnull(shape, char(45)), char(124)) FROM (SELECT * FROM overlays WHERE take_id = ? ORDER BY id)) IS NOT overlay_applied AS dirty FROM takes WHERE id = ?', params: [editTake, editTake] }}" />
        <DataSource id="savedSprites" url="http://127.0.0.1:8765/callouts/sprites" method="POST"
          when="{!!editTake}" body="{{ take_id: editTake }}" />
        <!-- Every item's anchor has the item's id, the current one's too, so
             a drag that starts on another item makes it current and carries
             on as a move (a dragged anchor that unmounts leaves PointerLayer's
             drag stuck). The current item is drawn from editSprite once that
             has loaded, and from its saved sprite until then; lastSprite is
             its latest sprite, kept while the next one loads. One just placed
             isn't in savedSprites until the refetch lands, hence the last
             concat. At the end of a drag, nb is the current item's new box
             when the drag changed it; a click, or a drag that came back,
             saves nothing, and since no new sprite will then load to clear
             dragPos, it is cleared there. -->
        <PointerLayer id="calloutLayer" contentAspect="{takeAspect}" anchorDrag="true" pointerShape="arrow"
          tool="{annotKind === 'arrow' || annotKind === 'line' || annotKind === 'pointer' ? annotKind : 'rect'}"
          anchors="{(savedSprites.value || []).filter((a) => a.id === editCallout ? curShown : (playerTime >= a.t_in &amp;&amp; playerTime &lt;= a.t_out)).map((a) => a.id !== editCallout ? a : { id: a.id, url: (editSprite || a).url, x: dragPos ? dragPos.x : (editSprite || a).x, y: dragPos ? dragPos.y : (editSprite || a).y, width: (editSprite || a).width, height: (editSprite || a).height }).concat(curShown &amp;&amp; editSprite &amp;&amp; !(savedSprites.value || []).some((a) => a.id === editCallout) ? [{ id: editCallout, url: editSprite.url, x: dragPos ? dragPos.x : editSprite.x, y: dragPos ? dragPos.y : editSprite.y, width: editSprite.width, height: editSprite.height }] : []).concat(calloutHandles)}"
          onAnchorDragStart="(e) => {
            const edges = { nw: 1, n: 1, ne: 1, e: 1, se: 1, s: 1, sw: 1, w: 1, a: 1, b: 1 }[e.id];
            if (edges) {
              dragFrom = handleBox;
            } else if (e.id === editCallout) {
              dragFrom = calloutBox;
            } else {
              const it = (callouts.value || []).find((c) => c.id === e.id);
              if (it) {
                editCallout = it.id;
                curShape = it.shape || null;
                curText = it.text;
                curTail = it.tail || 'none';
                calloutBox = { x1: it.x1, y1: it.y1, x2: it.x2, y2: it.y2 };
                calloutIn = it.t_in;
                calloutOut = it.t_out;
                lastSprite = null;
                dragPos = null;
                dragFrom = { x1: it.x1, y1: it.y1, x2: it.x2, y2: it.y2 };
              }
            }
          }"
          onAnchorDragMove="(e) => {
            const edges = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1], s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0], a: [1, 1, 0, 0], b: [0, 0, 1, 1] }[e.id];
            if (e.id === editCallout) {
              dragPos = { x: e.x, y: e.y };
            } else if (edges &amp;&amp; dragFrom &amp;&amp; (curShape === 'arrow' || curShape === 'line')) {
              const b = dragFrom;
              calloutBox = { x1: Math.min(1, Math.max(0, b.x1 + edges[0] * e.dx)), y1: Math.min(1, Math.max(0, b.y1 + edges[1] * e.dy)), x2: Math.min(1, Math.max(0, b.x2 + edges[2] * e.dx)), y2: Math.min(1, Math.max(0, b.y2 + edges[3] * e.dy)) };
            } else if (edges &amp;&amp; dragFrom) {
              const b = dragFrom;
              const x1 = Math.max(0, Math.min(b.x1 + edges[0] * e.dx, b.x2 - 0.04));
              const y1 = Math.max(0, Math.min(b.y1 + edges[1] * e.dy, b.y2 - 0.03));
              const x2 = Math.min(1, Math.max(b.x2 + edges[2] * e.dx, b.x1 + 0.04));
              const y2 = Math.min(1, Math.max(b.y2 + edges[3] * e.dy, b.y1 + 0.03));
              calloutBox = { x1: x1, y1: y1, x2: x2, y2: y2 };
            }
          }"
          onAnchorDragEnd="(e) => {
            const edges = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1], s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0], a: [1, 1, 0, 0], b: [0, 0, 1, 1] }[e.id];
            let nb = null;
            if (e.id === editCallout &amp;&amp; calloutBox) {
              const c = calloutBox;
              const dx = Math.min(Math.max(e.dx, -Math.min(c.x1, c.x2)), 1 - Math.max(c.x1, c.x2));
              const dy = Math.min(Math.max(e.dy, -Math.min(c.y1, c.y2)), 1 - Math.max(c.y1, c.y2));
              if (dx === 0 &amp;&amp; dy === 0) {
                dragPos = null;
              } else {
                nb = { x1: c.x1 + dx, y1: c.y1 + dy, x2: c.x2 + dx, y2: c.y2 + dy };
              }
            } else if (edges &amp;&amp; dragFrom &amp;&amp; (curShape === 'arrow' || curShape === 'line')) {
              const b = dragFrom;
              nb = { x1: Math.min(1, Math.max(0, b.x1 + edges[0] * e.dx)), y1: Math.min(1, Math.max(0, b.y1 + edges[1] * e.dy)), x2: Math.min(1, Math.max(0, b.x2 + edges[2] * e.dx)), y2: Math.min(1, Math.max(0, b.y2 + edges[3] * e.dy)) };
            } else if (edges &amp;&amp; dragFrom) {
              const b = dragFrom;
              const x1 = Math.max(0, Math.min(b.x1 + edges[0] * e.dx, b.x2 - 0.04));
              const y1 = Math.max(0, Math.min(b.y1 + edges[1] * e.dy, b.y2 - 0.03));
              const x2 = Math.min(1, Math.max(b.x2 + edges[2] * e.dx, b.x1 + 0.04));
              const y2 = Math.min(1, Math.max(b.y2 + edges[3] * e.dy, b.y1 + 0.03));
              nb = { x1: x1, y1: y1, x2: x2, y2: y2 };
            }
            dragFrom = null;
            if (nb &amp;&amp; editCallout) {
              calloutBox = nb;
              updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: nb.x1, y1: nb.y1, x2: nb.x2, y2: nb.y2, t_in: calloutIn, t_out: calloutOut, tail: curTail, shape: curShape });
              callouts.refetch();
              savedSprites.refetch();
              applyState.refetch();
            }
          }"
          onShapeEnd="(e) => {
            const t = takePlayer.getCurrentTime();
            const out = Math.max(t + 0.2, Math.min(t + 3, editDur));
            const shape = annotKind === 'callout' ? null : annotKind;
            const free = shape === 'arrow' || shape === 'line';
            const box = free ? { x1: e.x1, y1: e.y1, x2: e.x2, y2: e.y2 } : { x1: Math.min(e.x1, e.x2), y1: Math.min(e.y1, e.y2), x2: Math.max(e.x1, e.x2), y2: Math.max(e.y1, e.y2) };
            const r = Actions.callApi({ url: 'http://127.0.0.1:8765/callouts/add', method: 'post', body: { take_id: editTake, text: '', x1: box.x1, y1: box.y1, x2: box.x2, y2: box.y2, t_in: t, t_out: out, tail: 'none', shape: shape } });
            editCallout = r.id;
            curShape = shape;
            curText = '';
            curTail = 'none';
            calloutBox = box;
            calloutIn = t;
            calloutOut = out;
            lastSprite = null;
            dragPos = null;
            callouts.refetch();
            savedSprites.refetch();
            applyState.refetch();
            editTabs.setActiveTabIndex(0);
          }">
          <!-- After an edit the file reloads (cutSeq changes src); it goes
               back to where the edit was (resumeAt), paused, rather than
               playing from 0:00. Nothing plays by itself: opening a scene
               (its name's link) shows it paused at its start. Its height is fixed (the picture fits inside,
               letterboxed if need be): while the file reloads the player had no
               size of its own, so it vanished, came back short, then grew,
               moving everything below it twice. -->
          <MediaPlayer id="takePlayer" autoPlay="false" height="55vh"
            muted="{!!narrating}" controls="{!narrating}"
            src="{editFile ? 'http://127.0.0.1:8765/clean/' + encodeURIComponent(editFile) + '?c=' + cutSeq : playing}"
            onLoadedMetadata="(e) => {
              takeAspect = e.videoWidth / e.videoHeight;
              if (resumeAt !== null) {
                takePlayer.seek(resumeAt);
                takePlayer.pause();
                resumeAt = null;
              }
            }"
            onTimeUpdate="(e) => playerTime = e.currentTime"
            onSeeked="(e) => playerTime = e.currentTime" />
          <property name="anchorTemplate">
            <Image src="{$item.url}" width="100%" />
          </property>
        </PointerLayer>
        <!-- Where the scene's audio lives: one bar per slice of the scene
             (takeLevels, serve_media.py's /takes/levels), its height the
             slice's level from -60 dB (none) to 0 dB, coloured as a narration
             or the scene's own sound. A scene with no audio (every slice under
             -60 dB) shows no strip. Hovering a bar says which, and the level
             there (the tooltip behavior works on any visual component:
             https://www.xmlui.org/docs/behaviors#tooltip). The bars don't
             depend on the playhead, so they are drawn once per load. The
             playhead is a 2 px line in a thin row just above them, after a
             spacer playerTime / (slice length x slices) wide, so it sits over
             the exact time on the bars' own scale and is the one thing that
             moves as the scene plays (it was the marker in whichever of 200
             slots held the playhead: it stepped a slot at a time, and every
             40 ms tick re-checked all 200). The line is 32 px, its 8 px row
             plus the bars' 24 px, so it hangs down across the bars; the no-op
             transform puts it above them, as a transformed element is drawn
             over later ordinary ones
             (https://www.xmlui.org/docs/styles-and-themes/layout-props#transform). -->
        <VStack gap="0" var.lv="{takeLevels.value || lastLevels}"
          when="{!!editTake &amp;&amp; editDur > 0 &amp;&amp; !!(takeLevels.value || lastLevels) &amp;&amp; (takeLevels.value || lastLevels).levels.some((db) => db > -60)}">
          <HStack height="8px" gap="0">
            <Stack height="8px" width="{Math.min(100, Math.max(0, playerTime / (lv.binSecs * lv.levels.length) * 100)) + '%'}" />
            <Stack width="2px" height="32px" transform="translateY(0)" backgroundColor="$color-surface-900" />
          </HStack>
          <HStack height="24px" gap="0" verticalAlignment="end">
            <Items data="{levelBars(lv, narrs.value || [])}">
              <VStack width="*" height="100%" verticalAlignment="end" tooltip="{$item.tip}">
                <Stack when="{$item.narr}" width="100%" height="{$item.px + 'px'}" backgroundColor="$color-warn-500" />
                <Stack when="{!$item.narr}" width="100%" height="{$item.px + 'px'}" backgroundColor="$color-primary-400" />
              </VStack>
            </Items>
          </HStack>
        </VStack>
        <!-- The take's edits, one per tab (https://www.xmlui.org/docs/reference/components/Tabs):
             in each, the slider at full width, then its controls on a second
             row. keepMounted: Tabs otherwise unmounts the hidden tabs, and a
             slider mounted again would show its last seed (initialValue), not
             where its handles were dragged, while lastCut / narrClip
             still held the dragged values. Switching tabs ends an audition,
             whose buttons would be out of sight. The Theme makes the tab strip
             compact. The Timers stay outside: Tabs shows only TabItems. -->
        <Theme paddingVertical-trigger-Tabs="$space-1" paddingHorizontal-trigger-Tabs="$space-3"
          paddingTop-TabItem="$space-2">
        <!-- Leaving a tab closes its adding row (Cut's, Pause's, and
             Narrate's unless a narration is recording). didChange passes the new
             tab's index, id and label
             (https://www.xmlui.org/docs/reference/components/Tabs). -->
        <Tabs id="editTabs" keepMounted="true" when="{!!editTake &amp;&amp; editDur > 0}"
          onDidChange="(index, id, label) => {
            audition = null;
            if (label !== 'Cut') cutAdding = false;
            if (label !== 'Narrate' &amp;&amp; !narrating &amp;&amp; !narrBusy) narrAdding = false;
            if (label !== 'Pause') pauseAdding = false;
          }">
        <!-- Annotate: Add annotation and the tools (the current one solid),
             then the scene's items, one row each. Add annotation places the
             current tool in the middle of the picture at the playhead for 3 s
             (addAnnotation); ⌘-drag places it where you drag. The tool is
             remembered (studio.annotKind) and starts as Callout. Clicking a
             row makes that item current and moves the playhead to its start
             (again lets go of it); the current row offers its controls: text
             and tail (a callout's), In and Out with one-frame nudges, Play
             (its span, reading Stop while it plays) and ✕. Text and tail save
             as they change; their boxes take curText and curTail
             (initialValue), made fresh with the row. Apply burns the items
             into the video, the one explicit step, since it re-encodes. -->
        <TabItem label="Annotate">
        <VStack>
          <HStack verticalAlignment="center">
            <Button label="Add annotation" size="xs" variant="outlined"
              tooltip="Place the current tool in the middle of the picture, from the playhead for 3 s"
              onClick="addAnnotation()" />
            <Items data="{[['callout', 'Callout'], ['rect', 'Box'], ['ellipse', 'Oval'], ['arrow', 'Arrow'], ['line', 'Line'], ['pointer', 'Pointer']]}">
              <Button label="{$item[1]}" size="xs"
                variant="{annotKind === $item[0] ? 'solid' : 'outlined'}"
                tooltip="What Add annotation places, and ⌘-drag on the picture (click, for Pointer)"
                onClick="annotKind = $item[0]; writeLocalStorage('studio.annotKind', $item[0]);" />
            </Items>
            <SpaceFiller />
            <Spinner when="{renderOverlay.inProgress}" />
            <Button label="Apply" size="xs"
              enabled="{!renderOverlay.inProgress &amp;&amp; !!applyState.value &amp;&amp; !!applyState.value[0] &amp;&amp; !!applyState.value[0].dirty}"
              tooltip="Burn this scene's items into its video file (Export also does this for any scene that needs it)"
              onClick="
                renderOverlay.execute(editTake);
                applyState.refetch();
              " />
          </HStack>
          <Items data="{callouts.value || []}">
            <HStack verticalAlignment="center">
              <Button size="xs" variant="{$item.id === editCallout ? 'solid' : 'ghost'}"
                label="{($item.shape ? ({ rect: 'Box', ellipse: 'Oval', arrow: 'Arrow', line: 'Line', pointer: 'Pointer' })[$item.shape] : $item.text || '(empty callout)') + ' · ' + $item.t_in.toFixed(2) + '–' + $item.t_out.toFixed(2) + ' s'}"
                onClick="
                  audition = null;
                  if ($item.id === editCallout) {
                    editCallout = null;
                    calloutBox = null;
                    lastSprite = null;
                    curShape = null;
                    curText = '';
                    curTail = 'none';
                    calloutIn = 0;
                    calloutOut = 3;
                  } else {
                    editCallout = $item.id;
                    curShape = $item.shape || null;
                    curText = $item.text;
                    curTail = $item.tail || 'none';
                    calloutBox = { x1: $item.x1, y1: $item.y1, x2: $item.x2, y2: $item.y2 };
                    calloutIn = $item.t_in;
                    calloutOut = $item.t_out;
                    lastSprite = null;
                    dragPos = null;
                    takePlayer.seek($item.t_in);
                  }
                " />
              <!-- The current item's controls. In and Out, each with a − before
                   it and a + after it that move the time one frame (0.04 s at
                   25 fps), save at once, and take the playhead there so the
                   frame is seen; the In and Out buttons set it from the
                   playhead. -->
              <HStack when="{$item.id === editCallout}" verticalAlignment="center">
                <!-- The text box is its own component (ItemText, after the
                     App), so a keystroke re-evaluates only its subtree, not
                     every binding in App scope
                     (https://www.xmlui.org/docs/howto/confine-a-hot-input-to-its-own-component);
                     the text is saved when the box loses focus. -->
                <ItemText when="{!curShape}" text="{curText}"
                  onCommit="(v) => { if (calloutBox &amp;&amp; v !== curText) { curText = v; saveCurrentItem(); } }" />
                <HStack verticalAlignment="center" gap="$space-1">
                  <Button label="−" size="xs" variant="ghost" tooltip="Start one frame earlier" onClick="nudgeItem('in', -0.04)" />
                  <Button label="{'In ' + calloutIn.toFixed(2) + 's'}" size="xs" variant="outlined"
                    tooltip="Start this item at the playhead" onClick="setItemEdge('in')" />
                  <Button label="+" size="xs" variant="ghost" tooltip="Start one frame later" onClick="nudgeItem('in', 0.04)" />
                </HStack>
                <HStack verticalAlignment="center" gap="$space-1">
                  <Button label="−" size="xs" variant="ghost" tooltip="End one frame earlier" onClick="nudgeItem('out', -0.04)" />
                  <Button label="{'Out ' + calloutOut.toFixed(2) + 's'}" size="xs" variant="outlined"
                    tooltip="End this item at the playhead" onClick="setItemEdge('out')" />
                  <Button label="+" size="xs" variant="ghost" tooltip="End one frame later" onClick="nudgeItem('out', 0.04)" />
                </HStack>
                <!-- Tail: a speech-bubble pointer off the box at a compass point. -->
                <Select when="{!curShape}" initialValue="{curTail}" width="120px"
                  onDidChange="(v) => {
                    if (editCallout &amp;&amp; calloutBox &amp;&amp; !curShape &amp;&amp; v !== curTail) {
                      curTail = v;
                      updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: calloutOut, tail: v, shape: curShape });
                      callouts.refetch();
                      savedSprites.refetch();
                      applyState.refetch();
                    }
                  }">
                  <Option value="none" label="No tail" />
                  <Option value="nw" label="Tail ↖ nw" />
                  <Option value="n" label="Tail ↑ n" />
                  <Option value="ne" label="Tail ↗ ne" />
                  <Option value="e" label="Tail → e" />
                  <Option value="se" label="Tail ↘ se" />
                  <Option value="s" label="Tail ↓ s" />
                  <Option value="sw" label="Tail ↙ sw" />
                  <Option value="w" label="Tail ← w" />
                </Select>
                <Button label="{audition &amp;&amp; audition.kind === 'item' ? 'Stop' : 'Play'}" size="xs" variant="outlined"
                  tooltip="Play this item's span"
                  onClick="audition &amp;&amp; audition.kind === 'item' ? stopAudition() : playAudition(calloutIn, calloutOut, 'item')" />
                <Button icon="close" size="xs" variant="ghost"
                  aria-label="Remove this item" tooltip="Remove this item from the scene"
                  onClick="
                    audition = null;
                    deleteCallout.execute(editCallout);
                    editCallout = null;
                    calloutBox = null;
                    lastSprite = null;
                    curShape = null;
                    curText = '';
                    curTail = 'none';
                    calloutIn = 0;
                    calloutOut = 3;
                    callouts.refetch();
                    savedSprites.refetch();
                    applyState.refetch();
                  " />
              </HStack>
            </HStack>
          </Items>
        </VStack>
        </TabItem>
        <!-- Cut: the scene's cuts (serve_media.py's cuts table) and Add cut,
             as on the Narrate and Pause tabs. Add opens the adding row: the
             slider's two handles mark the stretch
             (https://www.xmlui.org/docs/reference/components/Slider), from the
             playhead, 5 s, in one-frame steps; moving a handle seeks the player
             to it (lastCut tells which one moved); nudges move either end.
             Play cut, Intro and Outro hear the marked stretch; nothing changes
             on disk until Cut, which re-encodes two files, so its click has no
             handler timeout
             (https://www.xmlui.org/docs/managed-react/cooperative-concurrency).
             After a cut the row closes and the new cut is selected (cutSelAt:
             its seam, until the list has its row). A cut's row selects it and
             moves the playhead to its seam; the selected one offers Play the
             join (2 s either side of the seam) and its ✕, which puts the
             removed stretch back (/cuts/restore; Undo takes that back). -->
        <TabItem label="Cut">
        <VStack>
          <Button label="Add cut" size="xs" variant="outlined" when="{!cutAdding}"
            tooltip="Mark a stretch from the playhead to remove"
            enabled="{!cutTake.inProgress}"
            onClick="
              const end = takePlayer.duration || editDur;
              const s = Math.max(0, Math.min(takePlayer.getCurrentTime(), end - 0.12));
              audition = null;
              cutSeed = [s, Math.min(end, s + 5)];
              lastCut = cutSeed;
              cutAdding = true;
            " />
          <VStack when="{cutAdding}">
          <!-- valueFormat is a sync callback: one arrow expression, in braces
               (https://www.xmlui.org/docs/howto/keep-sync-callbacks-to-one-expression).
               The handles are placed by re-seeding through initialValue
               (cutSeed), which fires no events, not by setValue
               (https://www.xmlui.org/docs/howto/drive-a-slider-with-a-runtime-domain);
               lastCut follows them, from didChange and alongside each re-seed. -->
          <Slider id="cutSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
            initialValue="{cutSeed}" minStepsBetweenThumbs="{3}"
            valueFormat="{(v) => v.toFixed(2) + 's'}"
            enabled="{!cutTake.inProgress}"
            onDidChange="(v) => {
              audition = null;
              takePlayer.seek(v[0] !== lastCut[0] ? v[0] : v[1]);
              lastCut = v;
            }" />
          <!-- The cut's ends, one group each: « » move it 1 s, ‹ › one frame
               (nudgeCut), and the player shows the frame there, as dragging
               a handle does. Nothing here reads the playhead: the handles and
               nudges set the cut, the player only shows it, and its own
               controls stay yours. The groups are tight inside ($space-1),
               as In and Out are on the Annotate tab. -->
          <HStack verticalAlignment="center">
            <HStack verticalAlignment="center" gap="$space-1">
              <Button label="«" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
                tooltip="Start 1 second earlier" onClick="nudgeCut('start', -1)" />
              <Button label="‹" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
                tooltip="Start one frame earlier" onClick="nudgeCut('start', -0.04)" />
              <Text value="{'Start ' + lastCut[0].toFixed(2) + 's'}" />
              <Button label="›" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
                tooltip="Start one frame later" onClick="nudgeCut('start', 0.04)" />
              <Button label="»" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
                tooltip="Start 1 second later" onClick="nudgeCut('start', 1)" />
            </HStack>
            <HStack verticalAlignment="center" gap="$space-1">
              <Button label="«" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
                tooltip="End 1 second earlier" onClick="nudgeCut('end', -1)" />
              <Button label="‹" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
                tooltip="End one frame earlier" onClick="nudgeCut('end', -0.04)" />
              <Text value="{'End ' + lastCut[1].toFixed(2) + 's'}" />
              <Button label="›" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
                tooltip="End one frame later" onClick="nudgeCut('end', 0.04)" />
              <Button label="»" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
                tooltip="End 1 second later" onClick="nudgeCut('end', 1)" />
            </HStack>
          </HStack>
          <HStack verticalAlignment="center">
          <!-- Hear the stretch the cut would remove (playAudition), as the
               Narrate tab's rows hear a narration: whole, or its first or last
               3 s. Nothing changes on disk until Cut. -->
          <Button label="Play cut" size="xs" variant="outlined"
            tooltip="Play the stretch the cut would remove, from start to end. Nothing is changed."
            enabled="{!cutTake.inProgress}"
            onClick="playAudition(lastCut[0], lastCut[1], 'cut-clip')" />
          <Button label="Intro 3s" size="xs" variant="outlined"
            tooltip="Play the marked stretch's first 3 seconds"
            enabled="{!cutTake.inProgress}"
            onClick="playAudition(lastCut[0], Math.min(lastCut[0] + 3, lastCut[1]), 'cut-intro')" />
          <Button label="Outro 3s" size="xs" variant="outlined"
            tooltip="Play the marked stretch's last 3 seconds"
            enabled="{!cutTake.inProgress}"
            onClick="playAudition(Math.max(lastCut[1] - 3, lastCut[0]), lastCut[1], 'cut-outro')" />
          <Button label="{'Cut ' + (lastCut[1] - lastCut[0]).toFixed(2) + 's'}" size="xs" themeColor="attention"
            tooltip="Remove this stretch from the scene (Undo brings it back)"
            enabled="{!cutTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
            handlerTimeoutMs:onClick="0"
            onClick="
              audition = null;
              editCallout = null; calloutBox = null; lastSprite = null;
              curShape = null; curText = ''; curTail = 'none';
              cutTake.execute({ id: editTake, start: lastCut[0], end: lastCut[1] });
              resumeAt = lastCut[0];
              cutAdding = false;
              cutSel = null;
              cutSelAt = lastCut[0];
              cutSeq = cutSeq + 1;
              lastCut = [0, 1]; cutSeed = [0, 1];
              edits.refetch();
              narrs.refetch(); pauses.refetch(); cuts.refetch();
              callouts.refetch();
              savedSprites.refetch();
              applyState.refetch();
            " />
          <Button label="Cancel" size="xs" variant="ghost" enabled="{!cutTake.inProgress}"
            onClick="audition = null; cutAdding = false;" />
          <Spinner when="{cutTake.inProgress}" />
          </HStack>
          <!-- A cut through a narration takes away its ✕ (the audio kept for
               removing it no longer fits; serve_media.py drops its row, with
               one frame of slack at its ends). Say so before the click; it
               doesn't block, since Undo brings the row back. -->
          <Text color="$color-warn-700"
            when="{(narrs.value || []).some((n) => lastCut[0] &lt; n.t_out - 0.04 &amp;&amp; lastCut[1] > n.t_in + 0.04)}"
            value="{'This cut goes through the narration at ' + (narrs.value || []).filter((n) => lastCut[0] &lt; n.t_out - 0.04 &amp;&amp; lastCut[1] > n.t_in + 0.04).map((n) => n.t_in.toFixed(1) + '–' + n.t_out.toFixed(1) + ' s').join(' and ') + '. Afterwards its ✕ can no longer remove it; only Undo can.'}" />
          </VStack>
          <Items data="{cuts.value || []}">
            <HStack verticalAlignment="center"
              var.sel="{cutSel === $item.id || (cutSel === null &amp;&amp; cutSelAt !== null &amp;&amp; Math.abs($item.at - cutSelAt) &lt; 0.06)}">
              <Button size="xs" variant="{sel ? 'solid' : 'ghost'}"
                label="{'Cut ' + $item.seconds.toFixed(2) + ' s at ' + $item.at.toFixed(2) + ' s'}"
                enabled="{!cutTake.inProgress}"
                onClick="
                  audition = null;
                  cutSel = $item.id;
                  cutSelAt = null;
                  takePlayer.seek($item.at);
                " />
              <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'cut-join' &amp;&amp; Math.abs(audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? 'Stop' : 'Play the join'}"
                size="xs" variant="outlined" tooltip="Play from 2 s before this cut's seam to 2 s after it"
                onClick="audition &amp;&amp; audition.kind === 'cut-join' &amp;&amp; Math.abs(audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? stopAudition() : playAudition(Math.max(0, $item.at - 2), $item.at + 2, 'cut-join')" />
              <Button when="{sel}" icon="close" size="xs" variant="ghost"
                aria-label="Restore this cut"
                tooltip="Put the removed stretch back at this seam (Undo takes it out again)"
                enabled="{!cutTake.inProgress &amp;&amp; !pauseTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
                handlerTimeoutMs:onClick="0"
                onClick="
                  audition = null;
                  editCallout = null; calloutBox = null; lastSprite = null;
                  curShape = null; curText = ''; curTail = 'none';
                  try {
                    Actions.callApi({ url: 'http://127.0.0.1:8765/cuts/restore', method: 'post', invalidates: [], body: { id: $item.id } });
                  } catch (e) {
                    toast.error(e.message);
                  }
                  cutSel = null;
                  cutSelAt = null;
                  resumeAt = $item.at;
                  cutSeq = cutSeq + 1;
                  edits.refetch();
                  narrs.refetch(); pauses.refetch(); cuts.refetch();
                  callouts.refetch();
                  savedSprites.refetch();
                  applyState.refetch();
                " />
            </HStack>
          </Items>
        </VStack>
        </TabItem>
        <!-- Pause: the scene's pauses (serve_media.py's pauses table) and Add
             pause, as on the Narrate tab. Add opens the adding row: the point
             (the slider is the player's playhead: playerTime re-seeds its
             initialValue, which fires no events,
             https://www.xmlui.org/docs/howto/drive-a-slider-with-a-runtime-domain,
             and dragging it seeks the player), drawn as a plain line
             (https://www.xmlui.org/docs/howto/style-slider-track-thumb-and-range);
             the seconds (remembered as the next default,
             https://www.xmlui.org/docs/globals#local-storage-utilities); Play,
             2 s either side of the point, after which the playhead goes back
             to the point (returnTo) so Insert lands there; Insert; Cancel.
             Once inserted the row closes and the new pause is selected
             (pauseSelAt: its point, until the list has its row). A pause's
             row selects it and moves the playhead to it; the selected one
             offers Play (2 s before to 2 s after) and its ✕, which cuts the
             held stretch back out (/pauses/remove; Undo puts it back). -->
        <TabItem label="Pause">
        <VStack>
          <Button label="Add pause" size="xs" variant="outlined" when="{!pauseAdding}"
            tooltip="Hold a frame, with silence, at a point you choose"
            enabled="{!pauseTake.inProgress}"
            onClick="audition = null; pauseAdding = true;" />
          <VStack when="{pauseAdding}">
            <Theme backgroundColor-range-Slider="$color-surface-300" backgroundColor-track-Slider="$color-surface-300"
              backgroundColor-range-Slider--disabled="$color-surface-300" backgroundColor-track-Slider--disabled="$color-surface-300">
            <Slider id="pauseSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
              initialValue="{playerTime}"
              valueFormat="{(v) => v.toFixed(2) + 's'}"
              enabled="{!pauseTake.inProgress}"
              onDidChange="(v) => {
                audition = null;
                takePlayer.seek(v);
              }" />
            </Theme>
            <HStack verticalAlignment="center">
              <NumberBox width="110px" initialValue="{pauseSecs}" minValue="{0.5}" maxValue="{30}" step="{0.5}"
                endText="s" tooltip="How long the pause lasts (remembered as the default)"
                onDidChange="(v) => {
                  if (v >= 0.5 &amp;&amp; v &lt;= 30) {
                    pauseSecs = v;
                    writeLocalStorage('studio.pauseSeconds', v);
                  }
                }" />
              <Button label="{audition &amp;&amp; audition.kind === 'pause-preview' ? 'Stop' : 'Play'}" size="xs" variant="outlined"
                tooltip="Play 2 s either side of the point, then come back to it"
                enabled="{!pauseTake.inProgress}"
                onClick="
                  if (audition &amp;&amp; audition.kind === 'pause-preview') {
                    stopAudition();
                  } else {
                    const p = takePlayer.getCurrentTime();
                    playAudition(Math.max(0, p - 2), p + 2, 'pause-preview');
                    audition = { ...audition, returnTo: p };
                  }
                " />
              <Button label="{'Insert ' + pauseSecs + 's pause'}" size="xs" themeColor="attention"
                tooltip="{'Hold the frame at ' + playerTime.toFixed(2) + ' s (the playhead) for ' + pauseSecs + ' s, with silence (Undo takes it back)'}"
                enabled="{!pauseTake.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy &amp;&amp; !audition}"
                handlerTimeoutMs:onClick="0"
                onClick="
                  const at = takePlayer.getCurrentTime();
                  audition = null;
                  editCallout = null; calloutBox = null; lastSprite = null;
                  curShape = null; curText = ''; curTail = 'none';
                  pauseTake.execute({ id: editTake, at: at, seconds: pauseSecs });
                  pauseAdding = false;
                  pauseSel = null;
                  pauseSelAt = at;
                  resumeAt = at;
                  cutSeq = cutSeq + 1;
                  edits.refetch();
                  narrs.refetch(); pauses.refetch(); cuts.refetch();
                  callouts.refetch();
                  savedSprites.refetch();
                  applyState.refetch();
                " />
              <Button label="Cancel" size="xs" variant="ghost" enabled="{!pauseTake.inProgress}"
                onClick="audition = null; pauseAdding = false;" />
              <Spinner when="{pauseTake.inProgress}" />
            </HStack>
            <!-- The same warning for a pause that falls inside a narration. -->
            <Text color="$color-warn-700"
              when="{(narrs.value || []).some((n) => playerTime > n.t_in + 0.04 &amp;&amp; playerTime &lt; n.t_out - 0.04)}"
              value="{'This pause falls inside the narration at ' + (narrs.value || []).filter((n) => playerTime > n.t_in + 0.04 &amp;&amp; playerTime &lt; n.t_out - 0.04).map((n) => n.t_in.toFixed(1) + '–' + n.t_out.toFixed(1) + ' s').join(' and ') + '. Afterwards its ✕ can no longer remove it; only Undo can.'}" />
          </VStack>
          <Items data="{pauses.value || []}">
            <HStack verticalAlignment="center"
              var.sel="{pauseSel === $item.id || (pauseSel === null &amp;&amp; pauseSelAt !== null &amp;&amp; Math.abs($item.at - pauseSelAt) &lt; 0.06)}">
              <Button size="xs" variant="{sel ? 'solid' : 'ghost'}"
                label="{'Pause at ' + $item.at.toFixed(2) + ' s · ' + $item.seconds + ' s'}"
                enabled="{!pauseTake.inProgress}"
                onClick="
                  audition = null;
                  pauseSel = $item.id;
                  pauseSelAt = null;
                  takePlayer.seek($item.at);
                " />
              <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'pause-row' &amp;&amp; Math.abs(audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? 'Stop' : 'Play'}"
                size="xs" variant="outlined" tooltip="Play from 2 s before this pause to 2 s after it"
                onClick="audition &amp;&amp; audition.kind === 'pause-row' &amp;&amp; Math.abs(audition.start - Math.max(0, $item.at - 2)) &lt; 0.05 ? stopAudition() : playAudition(Math.max(0, $item.at - 2), $item.at + $item.seconds + 2, 'pause-row')" />
              <Button when="{sel}" icon="close" size="xs" variant="ghost"
                aria-label="Remove this pause"
                tooltip="Remove this pause: its held frame and silence come out of the scene (Undo puts it back)"
                enabled="{!pauseTake.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
                handlerTimeoutMs:onClick="0"
                onClick="
                  audition = null;
                  editCallout = null; calloutBox = null; lastSprite = null;
                  curShape = null; curText = ''; curTail = 'none';
                  try {
                    Actions.callApi({ url: 'http://127.0.0.1:8765/pauses/remove', method: 'post', invalidates: [], body: { id: $item.id } });
                  } catch (e) {
                    toast.error(e.message);
                  }
                  pauseSel = null;
                  pauseSelAt = null;
                  resumeAt = $item.at;
                  cutSeq = cutSeq + 1;
                  edits.refetch();
                  narrs.refetch(); pauses.refetch(); cuts.refetch();
                  callouts.refetch();
                  savedSprites.refetch();
                  applyState.refetch();
                " />
            </HStack>
          </Items>
        </VStack>
        </TabItem>
        <!-- Narrate: the scene's narrations, and Add narration. Add opens the
             adding row: the two-handle slider (narrSeed re-seeds it, narrClip
             follows it) from the playhead, 10 s; Play, to hear what is there
             now before narrating over it (playAudition); Narrate; Cancel.
             Narrate plays the clip muted, without the player's own controls,
             while the mic records; the Timer after the Tabs stops it at the
             clip's end (a Timer waits for its handler before ticking again:
             https://www.xmlui.org/docs/reference/components/Timer), or Stop
             does earlier, and the scene's audio there is replaced (Undo, on
             the Undo tab, takes it back). While narrating, the clip's
             start and end show with a ProgressBar between them
             (https://www.xmlui.org/docs/reference/components/ProgressBar) and
             Stop counts down, since the player's own controls are hidden.
             Once it lands, the adding row closes and the new narration is
             selected (narrSelAt: its start, until the list has its row). A
             narration's row selects it (and moves the playhead to its start);
             the selected one shows Play, Intro 3s, Outro 3s and its ✕. -->
        <TabItem label="Narrate">
        <VStack>
          <Button label="Add narration" size="xs" variant="outlined" when="{!narrAdding}"
            tooltip="Mark a stretch from the playhead to narrate over"
            enabled="{!narrBusy}"
            onClick="
              const end = takePlayer.duration || editDur;
              const s = Math.max(0, Math.min(takePlayer.getCurrentTime(), end - 0.52));
              audition = null;
              narrSeed = [s, Math.min(end, s + 10)];
              narrClip = narrSeed;
              narrAdding = true;
            " />
          <VStack when="{narrAdding}">
            <Slider id="narrSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
              initialValue="{narrSeed}" minStepsBetweenThumbs="{13}"
              valueFormat="{(v) => v.toFixed(2) + 's'}"
              enabled="{!narrating &amp;&amp; !narrBusy}"
              onDidChange="(v) => {
                audition = null;
                takePlayer.seek(v[0] !== narrClip[0] ? v[0] : v[1]);
                narrClip = v;
              }" />
            <HStack when="{!!narrating}" verticalAlignment="center">
              <Text value="{narrating ? narrating[0].toFixed(2) + ' s' : ''}" />
              <ProgressBar width="*"
                value="{narrating ? Math.max(0, Math.min(1, (playerTime - narrating[0]) / (narrating[1] - narrating[0]))) : 0}" />
              <Text value="{narrating ? narrating[1].toFixed(2) + ' s' : ''}" />
            </HStack>
            <HStack verticalAlignment="center">
              <Button label="{audition &amp;&amp; audition.kind === 'narr-preview' ? 'Stop' : 'Play'}" size="xs" variant="outlined"
                tooltip="Play the marked stretch as it sounds now, to hear what you would narrate over"
                enabled="{!narrating &amp;&amp; !narrBusy}"
                onClick="audition &amp;&amp; audition.kind === 'narr-preview' ? stopAudition() : playAudition(narrClip[0], narrClip[1], 'narr-preview')" />
              <Button label="{narrating ? '⏹ Stop recording · ' + Math.max(0, narrating[1] - playerTime).toFixed(1) + ' s left' : '🎤 Narrate ' + (narrClip[1] - narrClip[0]).toFixed(2) + 's'}"
                size="xs" themeColor="attention"
                tooltip="{narrating ? 'Stop now: what you said so far replaces the audio, and the rest of the clip is silent' : 'Play this stretch muted and record the microphone over it, replacing its audio (Undo takes it back)'}"
                enabled="{!narrBusy &amp;&amp; !dictating &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress}"
                handlerTimeoutMs:onClick="0"
                onClick="narrating ? stopNarration() : startNarration();" />
              <Button label="Cancel" size="xs" variant="ghost" when="{!narrating}" enabled="{!narrBusy}"
                onClick="audition = null; narrAdding = false;" />
              <Spinner when="{narrBusy}" />
            </HStack>
          </VStack>
          <!-- The scene's narrations, one row each; the ✕ puts back the audio a
               narration replaced (/narrate/remove), at any time, and Undo on the
               Undo tab restores it. Play, Intro and Outro hear it as judell/av
               plays a clip, its intro and its outro
               (https://github.com/judell/av av.js). -->
          <Items data="{narrs.value || []}">
            <HStack verticalAlignment="center"
              var.sel="{narrSel === $item.id || (narrSel === null &amp;&amp; narrSelAt !== null &amp;&amp; Math.abs($item.t_in - narrSelAt) &lt; 0.06)}">
              <Button size="xs" variant="{sel ? 'solid' : 'ghost'}"
                label="{'Narration ' + $item.t_in.toFixed(2) + '–' + $item.t_out.toFixed(2) + ' s'}"
                enabled="{!narrating &amp;&amp; !narrBusy}"
                onClick="
                  audition = null;
                  narrSel = $item.id;
                  narrSelAt = null;
                  takePlayer.seek($item.t_in);
                " />
              <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'clip' &amp;&amp; Math.abs(audition.start - $item.t_in) &lt; 0.05 ? 'Stop' : 'Play'}" size="xs" variant="outlined"
                tooltip="Play this narration from start to end"
                enabled="{!narrating &amp;&amp; !narrBusy}"
                onClick="audition &amp;&amp; audition.kind === 'clip' &amp;&amp; Math.abs(audition.start - $item.t_in) &lt; 0.05 ? stopAudition() : playAudition($item.t_in, $item.t_out, 'clip')" />
              <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'intro' &amp;&amp; Math.abs(audition.start - $item.t_in) &lt; 0.05 ? 'Stop' : 'Intro 3s'}" size="xs" variant="outlined"
                tooltip="Play this narration's first 3 seconds"
                enabled="{!narrating &amp;&amp; !narrBusy}"
                onClick="audition &amp;&amp; audition.kind === 'intro' &amp;&amp; Math.abs(audition.start - $item.t_in) &lt; 0.05 ? stopAudition() : playAudition($item.t_in, Math.min($item.t_in + 3, $item.t_out), 'intro')" />
              <Button when="{sel}" label="{audition &amp;&amp; audition.kind === 'outro' &amp;&amp; Math.abs(audition.stop - $item.t_out) &lt; 0.05 ? 'Stop' : 'Outro 3s'}" size="xs" variant="outlined"
                tooltip="Play this narration's last 3 seconds"
                enabled="{!narrating &amp;&amp; !narrBusy}"
                onClick="audition &amp;&amp; audition.kind === 'outro' &amp;&amp; Math.abs(audition.stop - $item.t_out) &lt; 0.05 ? stopAudition() : playAudition(Math.max($item.t_out - 3, $item.t_in), $item.t_out, 'outro')" />
              <Button when="{sel}" icon="close" size="xs" variant="ghost"
                aria-label="Remove this narration"
                tooltip="Remove this narration: the audio that was there before comes back (Undo restores the narration)"
                enabled="{!removeNarration.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
                handlerTimeoutMs:onClick="0"
                onClick="
                  audition = null;
                  narrSel = null;
                  narrSelAt = null;
                  removeNarration.execute($item.id);
                  resumeAt = $item.t_in;
                  cutSeq = cutSeq + 1;
                  narrs.refetch(); pauses.refetch(); cuts.refetch(); edits.refetch();
                " />
            </HStack>
          </Items>
        </VStack>
        </TabItem>
        <!-- History: the take's edits (cut, pause, narrate, a narration
             removed), newest first, with when each was made. The tinted row
             is the edit Undo takes back: the most recent one still in effect.
             Undo moves the tint down a row and leaves the undone edit above
             it, dimmed; Redo puts the edit just above the tint back. A new
             edit discards the undone ones. The table is plain rows, not a
             Table: Table has no per-row style, and tinting each cell from its
             row (https://www.xmlui.org/docs/howto/highlight-rows-conditionally)
             left the tint as separate blocks with gaps between them.
             Both buttons let go of the current item first, as a cut does:
             the take's items are swapped with its files. -->
        <TabItem label="Undo">
        <VStack>
          <HStack verticalAlignment="center">
            <Button label="Undo" size="xs" variant="outlined"
              tooltip="Take back the tinted edit"
              enabled="{!!edits.value &amp;&amp; edits.value.canUndo &amp;&amp; !undoEdit.inProgress &amp;&amp; !redoEdit.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
              handlerTimeoutMs:onClick="0"
              onClick="
                audition = null;
                editCallout = null; calloutBox = null; lastSprite = null;
                curShape = null; curText = ''; curTail = 'none';
                resumeAt = takePlayer.getCurrentTime();
                undoEdit.execute(editTake);
                cutSeq = cutSeq + 1;
                lastCut = [0, 1]; cutSeed = [0, 1];
                edits.refetch();
                narrs.refetch(); pauses.refetch(); cuts.refetch();
                callouts.refetch();
                savedSprites.refetch();
                applyState.refetch();
              " />
            <Button label="Redo" size="xs" variant="outlined"
              tooltip="Put back the edit just above the tinted one"
              enabled="{!!edits.value &amp;&amp; edits.value.canRedo &amp;&amp; !undoEdit.inProgress &amp;&amp; !redoEdit.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
              handlerTimeoutMs:onClick="0"
              onClick="
                audition = null;
                editCallout = null; calloutBox = null; lastSprite = null;
                curShape = null; curText = ''; curTail = 'none';
                resumeAt = takePlayer.getCurrentTime();
                redoEdit.execute(editTake);
                cutSeq = cutSeq + 1;
                lastCut = [0, 1]; cutSeed = [0, 1];
                edits.refetch();
                narrs.refetch(); pauses.refetch(); cuts.refetch();
                callouts.refetch();
                savedSprites.refetch();
                applyState.refetch();
              " />
            <Spinner when="{undoEdit.inProgress || redoEdit.inProgress}" />
            <Text variant="secondary" when="{!!edits.value &amp;&amp; !!edits.value.note}" value="{edits.value.note}" />
          </HStack>
          <Text variant="secondary" when="{!!edits.value &amp;&amp; edits.value.edits.length === 0}"
            value="No edits to this scene yet." />
          <VStack gap="0" when="{!!edits.value &amp;&amp; edits.value.edits.length > 0}">
            <HStack paddingHorizontal="$space-2" paddingVertical="$space-1">
              <Text variant="secondary" width="200px" value="When" />
              <Text variant="secondary" value="Edit" />
            </HStack>
            <Items data="{edits.value ? edits.value.edits : []}">
              <HStack verticalAlignment="center" paddingHorizontal="$space-2" paddingVertical="$space-1"
                backgroundColor="{$item.current ? '$color-primary-100' : 'transparent'}">
                <Text width="200px" when="{!$item.undone}" value="{$item.when}" />
                <Text width="200px" when="{$item.undone}" variant="secondary" value="{$item.when}" />
                <Text when="{!$item.undone}" value="{$item.what}" />
                <Text when="{$item.undone}" variant="secondary" value="{$item.what + ' (undone)'}" />
              </HStack>
            </Items>
          </VStack>
        </VStack>
        </TabItem>
        </Tabs>
        </Theme>
        <Timer interval="40" enabled="{!!narrating}"
          onTick="
            if (narrating &amp;&amp; takePlayer.getCurrentTime() >= Math.min(narrating[1], takePlayer.duration || narrating[1]) - 0.05) stopNarration();
          " />
        <!-- While the take plays, playerTime follows the player every 40 ms.
             The player's timeUpdate arrives about four times a second, which
             showed items a third of a second late (measured 2026-10-01: an
             item set to 2.0-5.0 s was on screen 2.32-5.37 s). -->
        <Timer interval="40" enabled="{!takePlayer.paused}"
          onTick="playerTime = takePlayer.getCurrentTime()" />
      </VStack>
      <!-- Takes as a drag-reorderable list (DndItems, the xmlui-dnd-list extension
           Bram's queue uses): only the grip drags, so the row's buttons stay live.
           The order is saved to takes.position via POST /reorder. New takes go to
           the top (register.py). -->
      <HStack when="{deleteTake.lastResult &amp;&amp; deleteTake.lastResult.undo !== dismissedUndo}"
        verticalAlignment="center">
        <Text value="Deleted {deleteTake.lastResult.name}." />
        <Button label="Undo" size="sm" variant="outlined"
          onClick="
            dismissedUndo = deleteTake.lastResult.undo;
            undeleteTake.execute(dismissedUndo);
          " />
      </HStack>
      <DndItems data="{takes}" dragHandle="true"
        onReorder="(newOrder) => {
          reorderTakes.execute({ ids: newOrder.map(t => t.id) });
        }">
        <!-- The open scene's row is tinted, as the Undo tab tints its
             current edit. -->
        <HStack width="100%" verticalAlignment="center" paddingVertical="$space-2" paddingHorizontal="$space-2"
          borderRadius="$space-1"
          backgroundColor="{playing === $item.url ? '$color-primary-100' : 'transparent'}">
          <!-- A take's warning, set when it was registered (only takes
               recorded live by the retired record.sh have one: an empty take,
               with what the player reported at Stop). -->
          <Icon name="warning" when="{$item.warning}" tooltip="{$item.warning}" />
          <!-- The name is a link that opens the scene in the editor, paused at
               its start (nothing plays by itself; Link's click event:
               https://www.xmlui.org/docs/reference/components/Link). The pencil
               turns it into a text box, which saves when it loses focus
               (TextBox has no Enter event:
               https://www.xmlui.org/docs/reference/components/TextBox), if
               changed and not empty. One scene at a time. -->
          <Link when="{renamingTake !== $item.id}" label="{$item.name}" tooltip="Open this scene"
            onClick="openScene($item)" />
          <TextBox when="{renamingTake === $item.id}" width="320px" initialValue="{$item.name}" autoFocus="true"
            onDidChange="(v) => renameDraft = v"
            onLostFocus="
              const name = renameDraft.trim();
              renamingTake = null;
              if (name &amp;&amp; name !== $item.name) {
                try {
                  Actions.callApi({ url: 'http://127.0.0.1:8765/takes/rename', method: 'post', invalidates: [],
                                    body: { id: $item.id, name: name } });
                } catch (e) {
                  toast.error(e.message);
                }
              }
            " />
          <Button icon="pencil" size="xs" variant="ghost" when="{renamingTake !== $item.id}"
            aria-label="Rename scene" tooltip="Rename this scene"
            onClick="renameDraft = $item.name; renamingTake = $item.id;" />
          <SpaceFiller />
          <Text value="{$item.recorded}" width="110px" />
          <Text value="{$item.duration_s + 's'}" width="70px" />
          <Text value="{$item.source}" width="160px" />
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete scene" tooltip="Delete this scene (moves the MP4 to media/.trash; Undo brings it back)"
            onClick="
              if (playing === $item.url) playing = '';
              deleteTake.execute($item.id);
            " />
        </HStack>
      </DndItems>
    </Page>
    <!-- Exports, a page of its own between Takes and Audio (it was a
         collapsible panel on the Takes page until 2026-10-01). The finishing
         workflow, two sections, each newest first: when, how long, a link, a
         note, and delete. Exports is everything in media/exports/ that isn't
         leveled (what Export makes, and anything an editor saved there);
         Leveled exports is what Level wrote. The Takes page's Export button
         comes here, so the new file's "writing…" row is seen. -->
    <Page url="/exports">
      <!-- One Theme around the lists, not one per row: small spinners
           (https://www.xmlui.org/docs/howto/scope-theme-outside-loops). A
           row whose file an editor is still writing shows "writing… N MB" and
           waits to offer Level. -->
      <Theme size-Spinner="1em">
      <H2>Exports</H2>
      <HStack verticalAlignment="center" when="{exportTakes.inProgress}">
        <Spinner />
        <Text value="Exporting scenes…" />
      </HStack>
      <Text variant="secondary" when="{exports.value &amp;&amp; exports.value.exports.length === 0}"
        value="Nothing exported yet." />
      <!-- Each export takes two lines, in both sections. First: time 110px,
           length 150px, the name. Second: mic, the note (all the width
           that's left; a leveled row's loudness beneath it), its ✕, Level
           (unleveled only) and delete, which ends the line in both sections,
           so the trash cans line up. On one line the fixed columns left the
           note a third of a wide window and almost nothing of a narrow one.
           Exports holds every file here that isn't leveled. One that isn't
           exactly what Export wrote (an editor saved over it, or beside it)
           carries an "edited" tag; the note says what was done. -->
      <Items data="{exports.value ? exports.value.exports : []}">
        <VStack gap="$space-1" paddingBottom="$space-3">
        <HStack verticalAlignment="center">
          <Text value="{$item.created.substring(5, 16)}" width="110px" />
          <HStack width="150px" verticalAlignment="center" gap="$space-1">
            <Text when="{!$item.writing}" value="{$item.seconds + 's'}" />
            <Spinner when="{$item.writing}" />
            <Text when="{$item.writing}" variant="secondary" value="{'writing… ' + ($item.bytes / 1048576).toFixed(1) + ' MB'}" />
          </HStack>
          <HStack width="*" verticalAlignment="center" gap="$space-2">
            <Link to="{$item.url}" target="_blank" label="{$item.name}" />
            <Text variant="secondary" when="{$item.edited}" value="edited" />
          </HStack>
        </HStack>
        <HStack verticalAlignment="center">
          <HStack width="*" verticalAlignment="center" gap="$space-1">
            <Button variant="ghost" label="{dictating === noteKey($item) ? '⏹' : '🎤'}"
              tooltip="{dictating === noteKey($item) ? 'Stop dictating (or press Enter)' : 'Dictate a note'}"
              enabled="{!dictating || dictating === noteKey($item)}"
              onClick="dictating === noteKey($item) ? stopDictation($item) : startDictation($item, noteBox)" />
            <Form width="*" hideButtonRow="true" onSubmit="submitNote($item)">
              <TextArea id="noteBox" width="100%" placeholder="Note…" autoSize="true" maxRows="3" initialValue="{$item.note}"
                onGotFocus="noteBuffer = $item.note || ''; noteEdited = false"
                onDidChange="(v) => { noteBuffer = v; noteEdited = true; window.studioDictationValue(noteKey($item), v); }"
                onLostFocus="if (dictating !== noteKey($item)) commitNote($item)" />
            </Form>
            <Button icon="close" variant="ghost" aria-label="Clear note" tooltip="Clear this note"
              enabled="{!!$item.note &amp;&amp; dictating !== noteKey($item)}"
              onClick="clearNote($item)" />
          </HStack>
          <!-- An export that needs no editing can be leveled directly. -->
          <HStack width="100px" horizontalAlignment="end">
            <Button label="Level" variant="outlined" size="sm"
              enabled="{!levelExport.inProgress &amp;&amp; !$item.writing}"
              tooltip="Cut rumble and even out loudness (level_edit.py) into leveled-…mp4"
              onClick="
                levelExport.execute($item);
                exports.refetch();
              " />
          </HStack>
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete export" tooltip="Delete this export (moves it to media/.trash)"
            onClick="
              deleteExport.execute($item);
              exports.refetch();
            " />
        </HStack>
        </VStack>
      </Items>
      <HStack verticalAlignment="center" when="{levelExport.inProgress}">
        <Spinner />
        <Text value="Leveling…" />
      </HStack>
      <H2>Leveled exports</H2>
      <Text variant="secondary" when="{exports.value &amp;&amp; exports.value.leveled.length === 0}"
        value="Click Level on an export." />
      <!-- A leveled row's second line is aligned to its top: the loudness
           report under the note makes the note's column taller than the
           buttons beside it. -->
      <Items data="{exports.value ? exports.value.leveled : []}">
        <VStack gap="$space-1" paddingBottom="$space-3">
        <HStack verticalAlignment="center">
          <Text value="{$item.created.substring(5, 16)}" width="110px" />
          <HStack width="150px" verticalAlignment="center" gap="$space-1">
            <Text when="{!$item.writing}" value="{$item.seconds + 's'}" />
            <Spinner when="{$item.writing}" />
            <Text when="{$item.writing}" variant="secondary" value="{'writing… ' + ($item.bytes / 1048576).toFixed(1) + ' MB'}" />
          </HStack>
          <Link to="{$item.url}" target="_blank" label="{$item.name}" width="*" />
        </HStack>
        <HStack verticalAlignment="start">
          <HStack width="*" verticalAlignment="start" gap="$space-1">
            <Button variant="ghost" label="{dictating === noteKey($item) ? '⏹' : '🎤'}"
              tooltip="{dictating === noteKey($item) ? 'Stop dictating (or press Enter)' : 'Dictate a note'}"
              enabled="{!dictating || dictating === noteKey($item)}"
              onClick="dictating === noteKey($item) ? stopDictation($item) : startDictation($item, noteBox)" />
            <Form width="*" hideButtonRow="true" onSubmit="submitNote($item)">
              <TextArea id="noteBox" width="100%" placeholder="Note…" autoSize="true" maxRows="3" initialValue="{$item.note}"
                onGotFocus="noteBuffer = $item.note || ''; noteEdited = false"
                onDidChange="(v) => { noteBuffer = v; noteEdited = true; window.studioDictationValue(noteKey($item), v); }"
                onLostFocus="if (dictating !== noteKey($item)) commitNote($item)" />
              <Text variant="secondary" value="{$item.report}" />
            </Form>
            <Button icon="close" variant="ghost" aria-label="Clear note" tooltip="Clear this note"
              enabled="{!!$item.note &amp;&amp; dictating !== noteKey($item)}"
              onClick="clearNote($item)" />
          </HStack>
          <Stack width="100px" />
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete leveled export" tooltip="Delete this file (moves it to media/.trash)"
            onClick="
              deleteExport.execute($item);
              exports.refetch();
            " />
        </HStack>
        </VStack>
      </Items>
      </Theme>
    </Page>
    <Page url="/bench">
      <H2>Audio recording test</H2>
      <HStack verticalAlignment="center">
        <Select id="mic" data="{devices}" valueField="name" labelField="name"
          initialValue="MacBook Air Microphone" width="260px" />
        <Select id="recorderChoice" initialValue="ffmpeg-raw" width="300px">
          <Option value="ffmpeg-raw" label="ffmpeg raw (today's session.sh)" />
          <Option value="ffmpeg-async" label="ffmpeg + gap fill" />
          <Option value="native" label="native macOS (no ffmpeg)" />
        </Select>
        <Button label="Test (10s)" enabled="{!voiceTest.inProgress}"
          onClick="
            toast('Recording 10s: read the sentence below now');
            voiceTest.execute({ mic: mic.value, recorder: recorderChoice.value });
          " />
      </HStack>
      <Text>
        Read aloud: "She sells sea shells by the seashore, and the quick brown fox
        jumps past six sharp scissors."
      </Text>
      <Table data="{voiceTests}">
        <!-- Never show "No data available" (it flashes while data loads). -->
        <property name="noDataTemplate">
          <Fragment/>
        </property>
        <Column header="Tested" bindTo="created_at" width="190px" />
        <Column header="Mic" bindTo="mic" />
        <Column header="Recorder" bindTo="recorder" />
        <Column header="Expected s" bindTo="expected_s" />
        <Column header="Captured s" bindTo="captured_s" />
        <Column header="Short %" bindTo="short_pct" />
        <Column header="Clicks" bindTo="clicks" />
        <Column header="Peak dB" bindTo="peak_db" />
        <Column header="RMS dB" bindTo="rms_db" />
        <Column header="Play">
          <HStack>
            <Link to="{$item.raw_url}" target="_blank" label="raw" />
            <Link to="{$item.leveled_url}" target="_blank" label="leveled" />
          </HStack>
        </Column>
      </Table>

      <!-- Audio playback test: MediaPlayer's kind="audio" (xmlui-org/xmlui#3913)
           on any take or source. An audio element plays an MP4's audio track,
           so no separate audio files are needed. -->
      <VStack var.audioLog="{[]}" var.audioDuration="">
        <H2>Audio playback test</H2>
        <HStack verticalAlignment="center">
          <Select id="audioChoice" placeholder="Play from…" width="480px"
            data="{[
              ...(takes.value || []).map(t => ({ label: 'Scene: ' + t.name.slice(0, 60), value: t.url })),
              ...(sources.value || []).map(x => ({ label: 'Source: ' + x.name, value: 'http://127.0.0.1:8765/sources/' + encodeURIComponent(x.name) }))
            ]}"
            onDidChange="audioLog = []; audioDuration = ''">
            <!-- A take's name is long enough to wrap, and a Select's wrapped
                 value centers by default (its face is a button). The
                 template's width and textAlign make it wrap from the left
                 (https://www.xmlui.org/docs/howto/customize-a-selects-selected-value). -->
            <property name="valueTemplate">
              <Text width="100%" textAlign="start" value="{$item.label}" />
            </property>
          </Select>
          <Button label="Clear log" variant="outlined" onClick="audioLog = []" />
        </HStack>
        <MediaPlayer kind="audio" when="{audioChoice.value}" src="{audioChoice.value}"
          onLoadedMetadata="(e) => audioDuration = e.duration.toFixed(2) + ' s'"
          onPlay="(e) => audioLog = [...audioLog, 'play at ' + e.currentTime.toFixed(2) + ' s']"
          onPause="(e) => audioLog = [...audioLog, 'pause at ' + e.currentTime.toFixed(2) + ' s']"
          onSeeked="(e) => audioLog = [...audioLog, 'seeked at ' + e.currentTime.toFixed(2) + ' s']"
          onEnded="(e) => audioLog = [...audioLog, 'ended at ' + e.currentTime.toFixed(2) + ' s']" />
        <Text when="{audioChoice.value}" value="Duration: {audioDuration || '(loading)'}" />
        <Items data="{audioLog}">
          <Text value="{$item}" />
        </Items>
      </VStack>
    </Page>
  </Pages>
</App>
<!-- A callout's text box on the Annotate tab, in a component of its own so
     typing touches only draft, here, and not the App scope's many bindings
     (https://www.xmlui.org/docs/howto/confine-a-hot-input-to-its-own-component;
     inline components: https://www.xmlui.org/docs/howto/keep-a-small-app-in-one-file).
     The text goes up as a commit event when the box loses focus (TextBox has
     no Enter event: https://www.xmlui.org/docs/reference/components/TextBox). -->
<Component name="ItemText" var.draft="{$props.text}">
  <TextBox id="box" width="220px" initialValue="{$props.text}" placeholder="Callout text"
    onDidChange="(v) => draft = v"
    onLostFocus="draft = box.value; emitEvent('commit', draft);" />
</Component>
