<App name="Bram Studio" layout="vertical-sticky" var.playing="" var.capturing="{false}" var.recEvents="{[]}" var.recPaused="{false}" var.sourceAspect="{undefined}" var.inkTool="callout" var.liveAnnots="{[]}" var.liveCur="{null}" var.liveSeq="{0}" var.liveDrag="{null}" var.liveFrom="{null}" var.lastLiveSprites="{null}" var.onAirYet="{false}" var.editTake="{null}" var.takeAspect="{undefined}" var.calloutBox="{null}" var.calloutIn="{0}" var.calloutOut="{3}" var.editCallout="{null}" var.editFile="" var.playerTime="{0}" var.dragPos="{null}" var.dragFrom="{null}" var.lastSprite="{null}" var.savedKey="" var.annotKind="callout" var.dismissedUndo="" var.noteBuffer="" var.dictating="" var.noteEdited="{false}" var.lastCut="{[0, 1]}" var.cutSeed="{[0, 1]}" var.cutPreview="{null}" var.cutSeq="{0}" var.pauseAt="{0}" var.pauseSeed="{0}" var.pauseSecs="{readLocalStorage('studio.pauseSeconds', 2)}" var.narrClip="{[0, 1]}" var.narrSeed="{[0, 1]}" var.narrating="{null}" var.narrBusy="{false}" var.curShape="{null}" var.curText="" var.curTail="none" var.liveTick="{null}" var.opening="">
  <!-- Bram's own layout (~/bram/app/tools/Main.xmlui): header band over the
       main area, nav always visible. themes/studio.json keeps the nav from
       collapsing into a drawer on a narrow window, as Bram's theme does. -->
  <!-- Takes live in the open project's studio.db (see schema.sql and
       studio_paths.py). serve_media.py answers the project's queries
       read-only at its own /query, since it is what knows which project is
       open; Bram's /query serves only the repo's studio.db, which holds the
       shared Audio bench (voiceTests below). Each take's MP4 is served by
       serve_media.py too, which Bram's loopback can't do yet (no video
       content types, no byte ranges). -->
  <DataSource id="takes" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, name, created_at, substr(created_at, 6) AS recorded, duration_s, url, file, source, warning FROM takes ORDER BY position, created_at DESC', params: [] }}"
    pollIntervalInSeconds="60" />
  <!-- serve_media.py runs record.sh; Stop posts the source player's event
       log, record.sh renders from it, and the take appears when it
       registers. -->
  <DataSource id="sources" url="http://127.0.0.1:8765/sources" pollIntervalInSeconds="60" />
  <!-- The project folders and which one is open ({open, name, projects};
       list_projects() in serve_media.py), for the Projects page and the name
       at the top of the nav panel. -->
  <DataSource id="projects" url="http://127.0.0.1:8765/projects" />
  <DataSource id="recStatus" url="http://127.0.0.1:8765/record/status"
    pollIntervalInSeconds="60" />
  <!-- Push instead of polling: serve_media.py's GET /events says which list
       changed ({changed: 'takes'|'sources'|'record'|'exports'}) and only that
       one is refetched. EventSource is experimental in XMLUI and has no docs
       page yet (source: xmlui/src/components/EventSource/EventSource.tsx), so
       the polls above stay as a 60 s fallback. -->
  <!-- onOpen (load and every reconnect): the bridge (studio-dictation.js)
       tells the server whether this page is dictating, and into which row,
       so a reload can't leave the server holding the mic for a dictation
       that no longer exists. -->
  <!-- A reconnect also follows the server starting over on another project
       (Open or Create on the Projects page), so onOpen refetches every list;
       when this page asked for the switch (`opening`), it then shows Takes. -->
  <EventSource url="http://127.0.0.1:8765/events"
    onOpen="() => {
      dictating = window.studioDictationSync();
      projects.refetch(); takes.refetch(); exports.refetch(); recStatus.refetch(); edits.refetch(); narrs.refetch();
      if (opening) { opening = ''; navigate('/'); }
    }"
    onMessage="(m) => {
      if (m.changed === 'takes') { takes.refetch(); edits.refetch(); narrs.refetch(); }
      else if (m.changed === 'sources') sources.refetch();
      else if (m.changed === 'record') { recStatus.refetch(); edits.refetch(); }
      else if (m.changed === 'exports') exports.refetch();
    }" />
  <APICall id="startRecording" method="post" url="http://127.0.0.1:8765/record"
    body="{$param}"
    errorNotificationMessage="{$error.message}" />
  <!-- Page state is reset in the Record/Stop click handlers, after execute()
       returns: assignments in this APICall's success handler ran but didn't
       take effect (the page stayed stuck in recording mode). -->
  <!-- Restart discards the running take (no render, no row) and starts a new
       one; Discard only ends it, for a page that lost the take (a reload). -->
  <APICall id="restartRecording" method="post" url="http://127.0.0.1:8765/record/restart"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="cancelRecording" method="post" url="http://127.0.0.1:8765/record/cancel"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="stopRecording" method="post" url="http://127.0.0.1:8765/record/stop"
    body="{$param}"
    errorNotificationMessage="{$error.message}" />
  <!-- One click, no warning: serve_media.py moves the MP4 to media/.trash/. -->
  <!-- The table is refreshed in the trash button's click, after execute():
       this APICall's onSuccess refetch didn't take effect (rows lingered until
       the 5s poll, and clicking one gave "no take with id N"). invalidates="{[]}"
       stops the default refresh of every DataSource (including /devices, which
       runs ffmpeg) after each delete; only the takes table needs refetching. -->
  <!-- The finishing workflow's two lists ({exports, leveled}, each newest
       first; see list_exports() in serve_media.py), deleting one (moved to
       media/.trash/), and leveling an export with level_edit.py. No
       onSuccess on either call (xmlui-org/xmlui#3924): the clicks refetch. -->
  <DataSource id="exports" url="http://127.0.0.1:8765/exports" />
  <APICall id="deleteExport" method="post" url="http://127.0.0.1:8765/exports/delete"
    body="{{ name: $param.name, where: $param.where }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="levelExport" method="post" url="http://127.0.0.1:8765/exports/level"
    body="{{ name: $param.name, where: $param.where }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- A row's note, saved when its field loses focus: the buffered-edit shape
       from https://www.xmlui.org/docs/howto/buffer-a-reactive-edit (noteBuffer),
       refetching in the handler instead of onSuccess (xmlui-org/xmlui#3924). -->
  <APICall id="saveExportNote" method="post" url="http://127.0.0.1:8765/exports/note"
    body="{{ name: $param.name, where: $param.where, note: $param.note }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Every field that takes dictation has the same frame: 🎤 before it (⏹
       while dictating) and ✕ after it to clear it. Keep that when adding
       dictation anywhere else.
       Export-row notes: typed, or dictated with the row's mic. Dictation is
       Bram's script (/__shell/dictation.js, judell/bram#417) behind the
       bridge in studio-dictation.js, called through window as Bram's own
       pane markup does (judell/bram
       app/tools/components/IsolatedDraftEditor.xmlui). The mic starts it: the
       bridge claims the mic from serve_media.py, captures in the browser and
       writes the text into the note as you speak; what you type meanwhile is
       kept. The mic again, or Enter in the note (its Form submits,
       https://www.xmlui.org/docs/howto/submit-a-form-from-a-custom-button),
       stops it, and the page saves the field's text as the note.
       The bridge can't read the field (a component passed to page script is
       a snapshot), so the field's onDidChange reports its text; the bridge
       writes with setValue
       (https://www.xmlui.org/docs/reference/components/TextArea). -->
  <script>
    function noteKey(item) { return item.where + '/' + item.name; }
    function commitNote(item) {
      const note = noteBuffer.trim();
      if (note === (item.note || '')) return;
      // Only an edit deletes: leaving a field with an empty buffer you didn't
      // type into never removes its note (dictation-robust).
      if (note === '') { if (!noteEdited) return; }
      saveExportNote.execute({ name: item.name, where: item.where, note });
      exports.refetch();
    }
    // The ✕ after a dictation field: clearing is the edit itself, so it saves
    // the empty note directly, without the noteEdited guard.
    function clearNote(item) {
      noteBuffer = '';
      saveExportNote.execute({ name: item.name, where: item.where, note: '' });
      exports.refetch();
    }
    function startDictation(item, box) {
      try {
        window.studioDictationStart(box, noteKey(item));
        dictating = noteKey(item);
        box.focus();
      } catch (e) {
        toast.error(e.message);
      }
    }
    function stopDictation(item) {
      try {
        // The field's final text, dictated and typed; null if nothing ran.
        const note = window.studioDictationStop();
        if (typeof note === 'string') {
          noteBuffer = note;
          saveExportNote.execute({ name: item.name, where: item.where, note: note.trim() });
        }
      } catch (e) {
        toast.error(e.message);
      }
      exports.refetch();
      dictating = '';
    }
    function submitNote(item) {
      if (dictating === noteKey(item)) stopDictation(item);
      else commitNote(item);
    }
    // A recording's events (everything but pointer samples and ink strokes)
    // go to the server as they happen (POST /record/event) as well as into
    // recEvents. recEvents is rewritten on every event, and an item's
    // annotAdd and annotRemove were found missing from it (session
    // 20261001-150809); at Stop the server puts back whatever recEvents lacks
    // and logs the difference. A failed post is ignored: the event is still
    // in recEvents.
    function logEvents(list) {
      recEvents = recEvents.concat(list);
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/record/event', method: 'post', body: { events: list } });
      } catch (e) {
        const ignored = e;
      }
    }
    // Narrate over a stretch of the take being edited (serve_media.py's
    // /narrate/*). The server answers /narrate/start once the mic is live;
    // then the muted player starts from the clip's start and /narrate/go tells
    // the server that moment, so the words land where they were spoken.
    // narrating holds the clip while the mic is open: it mutes the player,
    // hides its controls and runs the Timer that calls stopNarration at the
    // clip's end. /narrate/stop writes the take (both files), so narrBusy
    // shows a spinner until it answers.
    function startNarration() {
      try {
        cutPreview = null;
        takePlayer.pause();
        takePlayer.seek(narrClip[0]);
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/start', method: 'post',
                          body: { id: editTake, start: narrClip[0], end: narrClip[1] } });
        narrating = narrClip;
        takePlayer.play();
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/go', method: 'post' });
      } catch (e) {
        narrating = null;
        toast.error(e.message);
      }
    }
    function stopNarration() {
      takePlayer.pause();
      narrating = null;
      narrBusy = true;
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/narrate/stop', method: 'post' });
      } catch (e) {
        toast.error(e.message);
      }
      narrBusy = false;
      cutSeq = cutSeq + 1;
      edits.refetch();
      narrs.refetch();
      takes.refetch();
    }
    // Open and New project (the Projects page). The server writes which
    // project is open and starts itself over on it, so the page doesn't
    // refetch here: the event stream drops and reconnects, and its onOpen
    // (above) refetches every list, clears `opening` and shows Takes. The
    // player closes first, since its take belongs to the project being left.
    // A refusal (a take being recorded, an export running) arrives as an
    // error (https://www.xmlui.org/docs/reference/components/APICall, "Error
    // handling in try/catch blocks"). invalidates: [] (Actions.callApi,
    // https://www.xmlui.org/docs/globals) stops the refetch of every list
    // that would otherwise follow the call and land while the server is
    // starting over, each failing with a toast.
    function switchProject(path, body, label) {
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/' + path, method: 'post', body: body, invalidates: [] });
        if (r.restarting) {
          playing = '';
          editTake = null;
          opening = label;
        } else {
          projects.refetch();
        }
        return true;
      } catch (e) {
        toast.error(e.message);
        return false;
      }
    }
  </script>
  <!-- Joins every take, in list order, into one MP4 (media/exports/). -->
  <APICall id="exportTakes" method="post" url="http://127.0.0.1:8765/export"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="reorderTakes" method="post" url="http://127.0.0.1:8765/reorder"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Callouts and shapes: text, boxes, ovals, arrows and pointers burned into
       a take (overlay.py). Add/delete edit the list; render burns them in from
       the take's clean copy. -->
  <DataSource id="callouts" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, text, x1, y1, x2, y2, t_in, t_out, tail, shape FROM overlays WHERE take_id = ? AND kind IN (?, ?) ORDER BY t_in', params: [editTake, &quot;callout&quot;, &quot;shape&quot;] }}" />
  <!-- The edited take's narrations (serve_media.py's narrations table), for
       the Annotate tab's list and the Cut and Pause tabs' warnings. -->
  <DataSource id="narrs" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, t_in, t_out FROM narrations WHERE take_id = ? ORDER BY t_in', params: [editTake] }}" />
  <APICall id="removeNarration" method="post" url="http://127.0.0.1:8765/narrate/remove"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="addCallout" method="post" url="http://127.0.0.1:8765/callouts/add"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="updateCallout" method="post" url="http://127.0.0.1:8765/callouts/update"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteCallout" method="post" url="http://127.0.0.1:8765/callouts/delete"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="renderOverlay" method="post" url="http://127.0.0.1:8765/overlay/render"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteTake" method="post" url="http://127.0.0.1:8765/delete"
    body="{{ id: $param }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Cut a stretch out of a take (serve_media.py's /takes/cut: the take and
       its clean copy, callouts shifted). No onSuccess (xmlui-org/xmlui#3924).
       cutSeq goes into the take player's src so it reloads the changed video.
       edits is the edited take's history for the History tab (GET
       /takes/edits: its edits newest first, which one Undo would take back,
       and whether Undo and Redo are possible); it is refetched after every
       edit, undo and redo and whenever the takes change. undoEdit and
       redoEdit step back and forth through it. -->
  <DataSource id="edits" url="{'http://127.0.0.1:8765/takes/edits?id=' + (editTake || 0)}" />
  <APICall id="undoEdit" method="post" url="http://127.0.0.1:8765/takes/undo"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="redoEdit" method="post" url="http://127.0.0.1:8765/takes/redo"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="cutTake" method="post" url="http://127.0.0.1:8765/takes/cut"
    body="{{ id: $param.id, start: $param.start, end: $param.end }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Insert a pause: hold the frame at a point for some seconds, with silence
       (serve_media.py's /takes/pause). An edit like a cut. -->
  <APICall id="pauseTake" method="post" url="http://127.0.0.1:8765/takes/pause"
    body="{{ id: $param.id, at: $param.at, seconds: $param.seconds }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Undo the last delete: serve_media.py restores the take, its files and its
       callouts from the .trash/<stem>.json that /delete wrote. The Undo line binds
       to deleteTake.lastResult (https://www.xmlui.org/docs/howto/consume-an-apicall-response);
       dismissedUndo hides it once used; the next delete replaces it. (A ✕ beside Undo read as "cancel the delete" and was clicked for that, 2026-09-28.) No onSuccess on either call:
       an Inspector trace (2026-09-28) showed deleteTake's onSuccess, run from a
       DndItems row, logging success:start but never success:end, which holds
       lastResult back until the 30s handler timeout. Waiting on xmlui-org/xmlui#3924
       (FIFO scheduler; fine with strictDeterminism false, which we don't want). -->
  <APICall id="undeleteTake" method="post" url="http://127.0.0.1:8765/undelete"
    body="{{ undo: $param }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />

  <!-- Audio recording test: serve_media.py runs voicetest.py, which records 10s
       with the chosen mic and recorder and adds a voice_tests row. -->
  <DataSource id="devices" url="http://127.0.0.1:8765/devices" />
  <DataSource id="voiceTests" url="/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT * FROM voice_tests ORDER BY created_at DESC', params: [] }}" />
  <APICall id="voiceTest" method="post" url="http://127.0.0.1:8765/voicetest"
    body="{$param}"
    onSuccess="voiceTests.refetch()"
    errorNotificationMessage="{$error.message}" />

  <AppHeader>
    <HStack verticalAlignment="center" width="100%">
      <H3>Bram Studio</H3>
      <!-- The open project, so it is always clear which one a recording
           will land in. It is here, not in the nav panel: the panel's logo
           slot doesn't wrap, and clipped a long name at both ends. -->
      <Text variant="secondary" value="{projects.value ? projects.value.name : ''}" />
      <SpaceFiller />
      <!-- XMLUI trace viewer. The studio carries its own xs-diff.html and the
           xmlui-parser.es.js it imports (vendor/), as it carries its own engine;
           config.json's appGlobals.xsVerbose turns capture on. -->
      <Inspector src="/vendor/xs-diff.html" tooltip="Inspector: XMLUI trace" />
    </HStack>
  </AppHeader>
  <NavPanel>
    <property name="logoTemplate">
      <Fragment/>
    </property>
    <property name="footerTemplate">
      <Fragment/>
    </property>
    <NavLink label="Projects" to="/projects" />
    <NavLink label="Takes" to="/" />
    <NavLink label="Exports" to="/exports" />
    <NavLink label="Audio" to="/bench" />
  </NavPanel>
  <Pages fallbackPath="/">
    <!-- Projects: a screencast each, a folder under projects/ (studio_paths.py).
         Open switches Studio to one; Create makes an empty one and opens it.
         Both go through switchProject (above). Rows are laid out like the
         Exports page's. -->
    <Page url="/projects">
      <H2>Projects</H2>
      <Text variant="secondary" when="{projects.value &amp;&amp; projects.value.projects.length === 0}"
        value="No projects yet: this Studio keeps its takes in the repo itself (see README, Where things are kept). Create one below to start a new screencast." />
      <Items data="{projects.value ? projects.value.projects : []}">
        <HStack verticalAlignment="center" paddingBottom="$space-2">
          <Text value="{$item.name}" width="*" variant="{$item.open ? 'strong' : 'inherit'}" />
          <Text value="{$item.takes + ($item.takes === 1 ? ' take' : ' takes')}" width="90px" />
          <Text value="{$item.seconds + 's'}" width="90px" />
          <Text variant="secondary" value="{$item.changed ? 'changed ' + $item.changed.substring(5) : ''}" width="170px" />
          <HStack width="90px" horizontalAlignment="end">
            <Text when="{$item.open}" variant="secondary" value="open" />
            <Button when="{!$item.open}" label="Open" variant="outlined" size="sm"
              enabled="{!opening &amp;&amp; !capturing}"
              tooltip="Switch Studio to this project"
              onClick="switchProject('open', { slug: $item.slug }, $item.name)" />
          </HStack>
        </HStack>
      </Items>
      <HStack verticalAlignment="center" when="{!!opening}">
        <Spinner />
        <Text value="{'Opening ' + opening + '…'}" />
      </HStack>
      <H2>New project</H2>
      <HStack verticalAlignment="center">
        <TextBox id="newProjectName" placeholder="Name" width="260px" />
        <Button label="Create"
          enabled="{!!newProjectName.value &amp;&amp; !!newProjectName.value.trim() &amp;&amp; !opening &amp;&amp; !capturing}"
          tooltip="Make an empty project with this name and open it"
          onClick="
            if (switchProject('new', { name: newProjectName.value.trim() }, newProjectName.value.trim())) newProjectName.setValue('');
          " />
      </HStack>
    </Page>
    <Page url="/">
      <HStack verticalAlignment="center">
        <H2>Sources</H2>
        <Select id="sourceChoice" data="{sources}" valueField="name" labelField="name"
          placeholder="Choose a source"
          width="260px" />
        <!-- Record shows the source player (paused at 0:00, logged as the start
             row) and starts OFF the air (a recpause right after it), so the time
             spent getting ready is cut and never rendered; Start recording goes on
             the air. Every play/pause/seeked/ended is logged until Stop. -->
        <Button label="Record" when="{!capturing}"
          enabled="{!!sourceChoice.value &amp;&amp; !startRecording.inProgress &amp;&amp; !(recStatus.value &amp;&amp; recStatus.value.phase)}"
          onClick="
            playing = '';
            recPaused = true;
            liveTick = null;
            onAirYet = false;
            recEvents = [{ event: 'start', currentTime: 0, playing: false, wallMs: Date.now() }, { event: 'recpause', wallMs: Date.now() }];
            liveAnnots = [];
            liveCur = null;
            liveDrag = null;
            liveFrom = null;
            lastLiveSprites = null;
            capturing = true;
            try {
              startRecording.execute({ source: sourceChoice.value });
            } catch (e) {
              capturing = false;
            }
          " />
        <!-- Off the air: everything between Pause and Resume is cut from the
             take's picture and voice (render.py); the player is yours to set
             up the next spot meanwhile. -->
        <!-- Pauses the recording, not the video (the player's own controls do
             that); "Pause" alone was mistaken for the video's pause. -->
        <Button label="{recPaused ? (onAirYet ? 'Resume recording' : 'Start recording') : 'Pause recording'}"
          variant="{onAirYet ? 'outlined' : 'solid'}" when="{capturing}"
          enabled="{!!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          onClick="
            if (recPaused) {
              logEvents([{ event: 'recresume', wallMs: Date.now() }]);
              recPaused = false;
              liveTick = null;
              onAirYet = true;
            } else {
              logEvents([{ event: 'recpause', wallMs: Date.now() }]);
              recPaused = true;
              liveTick = null;
              sourcePlayer.pause();
            }
          " />
        <Button label="Restart" variant="outlined" when="{capturing}"
          enabled="{!restartRecording.inProgress &amp;&amp; !!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          tooltip="Discard this take and start again from 0:00"
          onClick="
            sourcePlayer.pause();
            sourcePlayer.seek(0);
            restartRecording.execute({ source: sourceChoice.value });
            recPaused = true;
            liveTick = null;
            onAirYet = false;
            recEvents = [{ event: 'start', currentTime: 0, playing: false, wallMs: Date.now() }, { event: 'recpause', wallMs: Date.now() }];
            liveAnnots = [];
            liveCur = null;
            liveDrag = null;
            liveFrom = null;
            lastLiveSprites = null;
          " />
        <Button label="Stop" themeColor="attention" when="{capturing}"
          enabled="{!stopRecording.inProgress &amp;&amp; !!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          onClick="
            const playerEvents = recEvents.filter(e => ['play', 'pause', 'seeked', 'ended'].includes(e.event)).length;
            const inkEvents = recEvents.filter(e => e.event === 'stroke' || e.event === 'shape' || e.event === 'pointer').length;
            const diag = { duration: sourcePlayer.duration, paused: sourcePlayer.paused,
                           currentTime: sourcePlayer.getCurrentTime(), playerEvents, inkEvents };
            if (!onAirYet) {
              toast('Nothing was recorded: you never clicked Start recording.');
            } else if (playerEvents === 0 &amp;&amp; inkEvents === 0) {
              toast('No player activity in this take, so the picture is a still of 0:00.');
            }
            stopRecording.execute({ events: recEvents, diag });
            capturing = false;
            recPaused = false;
            liveTick = null;
            recEvents = [];
          " />
        <Button label="Export" variant="outlined" size="sm"
          tooltip="Join all takes, in list order, into one video"
          enabled="{!exportTakes.inProgress &amp;&amp; !capturing &amp;&amp; !!takes.value &amp;&amp; takes.value.length > 0}"
          onClick="
            navigate('/exports');
            exportTakes.execute();
            exports.refetch();
          " />
      </HStack>
      <HStack verticalAlignment="center" when="{exportTakes.inProgress}">
        <Spinner />
        <Text value="Exporting takes…" />
      </HStack>
      <!-- A take this page didn't start (it was reloaded mid-take, or another
           tab started it): it has no event log to render, so offer Discard. -->
      <HStack verticalAlignment="center"
        when="{!capturing &amp;&amp; recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}">
        <Text value="A recording is in progress from another page or before a reload." />
        <Button label="Discard" variant="outlined" themeColor="attention"
          enabled="{!cancelRecording.inProgress}" onClick="cancelRecording.execute()" />
      </HStack>
      <HStack verticalAlignment="center" when="{recStatus.value &amp;&amp; recStatus.value.phase}">
        <Spinner />
        <Text value="{recPaused ? (onAirYet ? 'Recording paused: nothing is recorded until you click Resume recording' : 'Ready: set up the video, then click Start recording') : recStatus.value.label}" />
      </HStack>
      <!-- The source movie you narrate over. MediaPlayer is the experimental
           component from xmlui-org/xmlui#3913 (vendor/); its events are the
           take's picture path (render.py's events input). -->
      <!-- One player at a time: the source player exists only while recording
           (Record clears any loaded take; Stop removes it). -->
      <!-- Annotations while recording: the take editor's layer on the source
           player. A placed callout or shape appears at once and stays until
           removed; add, changes and removal go into the event log (annotAdd,
           annotSet, annotRemove), and render.py/register.py make them editable
           items on the take (their on-air spans, last positions winning).
           liveAnnots: the items up now; liveCur: the current one (last placed
           or clicked), whose handles resize it and whose text and tail the row
           below edits. Sprites come from
           /annotations/sprites (sized from the source), the last set kept
           while the next loads so a dragged anchor never vanishes. -->
      <VStack when="{capturing}"
        var.liveCurItem="{liveAnnots.find((a) => a.cid === liveCur) || null}"
        var.liveSpritesNow="{liveAnnots.length ? (liveSprites.value || lastLiveSprites || []).filter((s) => liveAnnots.some((a) => a.cid === s.cid)) : []}"
        var.liveHandleBox="{liveCurItem ? (!liveCurItem.shape &amp;&amp; liveCurItem.x2 - liveCurItem.x1 &lt; 0.001 &amp;&amp; liveSpritesNow.find((s) => s.cid === liveCur) ? { x1: liveSpritesNow.find((s) => s.cid === liveCur).x, y1: liveSpritesNow.find((s) => s.cid === liveCur).y, x2: liveSpritesNow.find((s) => s.cid === liveCur).x + liveSpritesNow.find((s) => s.cid === liveCur).width, y2: liveSpritesNow.find((s) => s.cid === liveCur).y + liveSpritesNow.find((s) => s.cid === liveCur).height } : liveCurItem) : null}"
        var.liveHandles="{liveHandleBox &amp;&amp; sourceAspect &amp;&amp; !liveDrag &amp;&amp; liveCurItem.shape !== 'pointer' ? ((liveCurItem.shape === 'arrow' || liveCurItem.shape === 'line') ? [['a', liveHandleBox.x1, liveHandleBox.y1], ['b', liveHandleBox.x2, liveHandleBox.y2]] : [['nw', liveHandleBox.x1, liveHandleBox.y1], ['n', (liveHandleBox.x1 + liveHandleBox.x2) / 2, liveHandleBox.y1], ['ne', liveHandleBox.x2, liveHandleBox.y1], ['e', liveHandleBox.x2, (liveHandleBox.y1 + liveHandleBox.y2) / 2], ['se', liveHandleBox.x2, liveHandleBox.y2], ['s', (liveHandleBox.x1 + liveHandleBox.x2) / 2, liveHandleBox.y2], ['sw', liveHandleBox.x1, liveHandleBox.y2], ['w', liveHandleBox.x1, (liveHandleBox.y1 + liveHandleBox.y2) / 2]]).map((h) => ({ id: h[0], url: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 10%22%3E%3Crect x=%221%22 y=%221%22 width=%228%22 height=%228%22 fill=%22white%22 stroke=%22%23222%22 stroke-width=%221.5%22/%3E%3C/svg%3E', x: h[1] - 0.009, y: h[2] - 0.009 * sourceAspect, width: 0.018, height: 0.018 * sourceAspect })) : []}">
        <!-- Items last 3 s of on-air time (placing and typing while paused don't
             count), unless kept; an expiring item is taken down exactly as
             Remove does, so the take matches the screen. The countdown uses
             the clock, not a fixed 0.25 per tick: a Timer waits for its handler
             before ticking again
             (https://www.xmlui.org/docs/reference/components/Timer) and the page
             runs handlers one at a time, so busy stretches (typing into a
             callout, pointer traffic) stretched the ticks and a 3 s item was
             measured lasting 3.76 s (2026-10-01). liveTick is the previous
             tick's wall-clock ms, null while the countdown is idle, so idle or
             off-air time is never charged to an item; one tick charges at most
             2 s. Typing into a callout restarts its 3 s (the text box's
             handler sets left back to 3 and clears liveTick): while keys are
             typed the Timer gets no turn at all, each keystroke's handler
             taking about 100 ms, so a callout could never go on time while
             being typed into (measured 6.96 s for 52 characters); now it stays
             while you type and for 3 s after the last key. -->
        <Timer interval="250" enabled="{capturing &amp;&amp; !recPaused &amp;&amp; liveAnnots.some((a) => !a.kept)}"
          onTick="
            const now = Date.now();
            const dt = liveTick ? Math.min(2, (now - liveTick) / 1000) : 0.25;
            const expired = liveAnnots.filter((a) => !a.kept &amp;&amp; a.left &lt;= dt);
            const rest = liveAnnots.filter((a) => a.kept || a.left > dt).map((a) => a.kept ? a : { ...a, left: a.left - dt });
            liveAnnots = rest;
            liveTick = rest.some((a) => !a.kept) ? now : null;
            if (expired.length) {
              logEvents(expired.map((a) => ({ event: 'annotRemove', cid: a.cid, expired: true, wallMs: Date.now() })));
              if (expired.some((a) => a.cid === liveCur)) {
                liveCur = null;
                liveText.setValue('');
                liveTail.setValue('none');
              }
            }
          " />
        <DataSource id="liveSprites" url="http://127.0.0.1:8765/annotations/sprites" method="POST"
          when="{liveAnnots.length > 0}"
          body="{{ source: sourceChoice.value, items: liveAnnots.map((a) => ({ cid: a.cid, shape: a.shape, text: a.text, tail: a.tail, x1: a.x1, y1: a.y1, x2: a.x2, y2: a.y2, frame: a.cid === liveCur })) }}"
          onLoaded="(d) => { lastLiveSprites = d; liveDrag = null; }" />
        <!-- What Command-drag places: a callout or a shape, each an editable
             item. The selected tool is solid. (Freehand ink, which wasn't an
             item, was dropped 2026-10-01; render.py still draws the strokes
             of sessions recorded before then.) -->
        <HStack verticalAlignment="center">
          <Items data="{[['callout', 'Callout'], ['rect', 'Box'], ['ellipse', 'Oval'], ['arrow', 'Arrow'], ['line', 'Line'], ['pointer', 'Pointer']]}">
            <Button label="{$item[1]}" size="xs"
              variant="{inkTool === $item[0] ? 'solid' : 'outlined'}"
              tooltip="Hold Command (⌘) and drag to place (click, for Pointer). An item stays 3 s on the air unless you Keep it."
              onClick="inkTool = $item[0]" />
          </Items>
        </HStack>
        <PointerLayer id="ink" contentAspect="{sourceAspect}" enabled="{capturing}" pointerShape="arrow" anchorDrag="true"
          tool="{inkTool === 'callout' ? 'rect' : inkTool}"
          anchors="{liveSpritesNow.map((s) => ({ id: s.cid, url: s.url, x: liveDrag &amp;&amp; liveDrag.cid === s.cid ? liveDrag.x : s.x, y: liveDrag &amp;&amp; liveDrag.cid === s.cid ? liveDrag.y : s.y, width: s.width, height: s.height })).concat(liveHandles)}"
          onAnchorDragStart="(e) => {
            const edges = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1], s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0], a: [1, 1, 0, 0], b: [0, 0, 1, 1] }[e.id];
            if (edges) {
              liveFrom = liveHandleBox;
            } else {
              const it = liveAnnots.find((a) => a.cid === e.id);
              liveCur = e.id;
              liveText.setValue(it ? it.text : '');
              liveTail.setValue(it &amp;&amp; it.tail ? it.tail : 'none');
            }
          }"
          onAnchorDragMove="(e) => {
            const edges = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1], s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0], a: [1, 1, 0, 0], b: [0, 0, 1, 1] }[e.id];
            if (edges &amp;&amp; liveFrom &amp;&amp; liveCurItem) {
              const b = liveFrom;
              const free = liveCurItem.shape === 'arrow' || liveCurItem.shape === 'line';
              const x1 = free ? Math.min(1, Math.max(0, b.x1 + edges[0] * e.dx)) : Math.max(0, Math.min(b.x1 + edges[0] * e.dx, b.x2 - 0.04));
              const y1 = free ? Math.min(1, Math.max(0, b.y1 + edges[1] * e.dy)) : Math.max(0, Math.min(b.y1 + edges[1] * e.dy, b.y2 - 0.03));
              const x2 = free ? Math.min(1, Math.max(0, b.x2 + edges[2] * e.dx)) : Math.min(1, Math.max(b.x2 + edges[2] * e.dx, b.x1 + 0.04));
              const y2 = free ? Math.min(1, Math.max(0, b.y2 + edges[3] * e.dy)) : Math.min(1, Math.max(b.y2 + edges[3] * e.dy, b.y1 + 0.03));
              liveAnnots = liveAnnots.map((a) => a.cid === liveCur ? { ...a, x1: x1, y1: y1, x2: x2, y2: y2 } : a);
            } else if (!edges) {
              liveDrag = { cid: e.id, x: e.x, y: e.y };
            }
          }"
          onAnchorDragEnd="(e) => {
            const edges = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1], s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0], a: [1, 1, 0, 0], b: [0, 0, 1, 1] }[e.id];
            if (edges &amp;&amp; liveFrom &amp;&amp; liveCurItem) {
              const b = liveFrom;
              const free = liveCurItem.shape === 'arrow' || liveCurItem.shape === 'line';
              const x1 = free ? Math.min(1, Math.max(0, b.x1 + edges[0] * e.dx)) : Math.max(0, Math.min(b.x1 + edges[0] * e.dx, b.x2 - 0.04));
              const y1 = free ? Math.min(1, Math.max(0, b.y1 + edges[1] * e.dy)) : Math.max(0, Math.min(b.y1 + edges[1] * e.dy, b.y2 - 0.03));
              const x2 = free ? Math.min(1, Math.max(0, b.x2 + edges[2] * e.dx)) : Math.min(1, Math.max(b.x2 + edges[2] * e.dx, b.x1 + 0.04));
              const y2 = free ? Math.min(1, Math.max(0, b.y2 + edges[3] * e.dy)) : Math.min(1, Math.max(b.y2 + edges[3] * e.dy, b.y1 + 0.03));
              liveAnnots = liveAnnots.map((a) => a.cid === liveCur ? { ...a, x1: x1, y1: y1, x2: x2, y2: y2 } : a);
              logEvents([{ event: 'annotSet', cid: liveCur, x1: x1, y1: y1, x2: x2, y2: y2, wallMs: Date.now() }]);
            } else if (!edges) {
              const it = liveAnnots.find((a) => a.cid === e.id);
              if (it) {
                const dx = Math.min(Math.max(e.dx, -Math.min(it.x1, it.x2)), 1 - Math.max(it.x1, it.x2));
                const dy = Math.min(Math.max(e.dy, -Math.min(it.y1, it.y2)), 1 - Math.max(it.y1, it.y2));
                liveAnnots = liveAnnots.map((a) => a.cid === e.id ? { ...a, x1: it.x1 + dx, y1: it.y1 + dy, x2: it.x2 + dx, y2: it.y2 + dy } : a);
                logEvents([{ event: 'annotSet', cid: e.id, x1: it.x1 + dx, y1: it.y1 + dy, x2: it.x2 + dx, y2: it.y2 + dy, wallMs: Date.now() }]);
              }
            }
            liveFrom = null;
          }"
          onShapeEnd="(e) => {
            if (capturing) {
              const cid = liveSeq + 1;
              const pt = inkTool === 'pointer';
              const a = { cid: cid, shape: inkTool === 'callout' ? null : inkTool, text: '', tail: 'none', x1: e.x1, y1: e.y1, x2: pt ? e.x1 : e.x2, y2: pt ? e.y1 : e.y2, left: 3, kept: false };
              liveSeq = cid;
              if (!liveAnnots.some((a) => !a.kept)) liveTick = null;
              liveAnnots = liveAnnots.concat([a]);
              liveCur = cid;
              liveText.setValue('');
              liveTail.setValue('none');
              logEvents([{ event: 'annotAdd', cid: cid, shape: a.shape, text: '', tail: 'none', x1: a.x1, y1: a.y1, x2: a.x2, y2: a.y2, wallMs: Date.now() }]);
            }
          }"
          onPointerMove="(e) => { if (capturing) recEvents = [...recEvents, { event: 'pointer', x: e.x, y: e.y, buttons: e.buttons, wallMs: e.time }] }">
        <MediaPlayer id="sourcePlayer" maxHeight="55vh"
          src="{'http://127.0.0.1:8765/sources/' + encodeURIComponent(sourceChoice.value)}"
          onLoadedMetadata="(e) => sourceAspect = e.videoWidth / e.videoHeight"
          onPlay="(e) => { if (capturing) logEvents([{ event: 'play', currentTime: e.currentTime, wallMs: Date.now() }]) }"
          onPause="(e) => { if (capturing) logEvents([{ event: 'pause', currentTime: e.currentTime, wallMs: Date.now() }]) }"
          onSeeked="(e) => { if (capturing) logEvents([{ event: 'seeked', currentTime: e.currentTime, wallMs: Date.now() }]) }"
          onEnded="(e) => { if (capturing) logEvents([{ event: 'ended', currentTime: e.currentTime, wallMs: Date.now() }]) }" />
          <property name="anchorTemplate">
            <Image src="{$item.url}" width="100%" />
          </property>
        </PointerLayer>
        <!-- The current item's text and tail (a callout's), and removal, which
             ends its span in the take. Always rendered (dimmed with nothing
             current) so setValue always has a component to reach. -->
        <HStack verticalAlignment="center">
          <TextBox id="liveText" width="*" enabled="{!!liveCurItem &amp;&amp; !liveCurItem.shape}"
            placeholder="{!liveCurItem ? 'Hold Command and drag to place a callout or shape' : liveCurItem.shape ? 'Shapes have no text' : 'Callout text (or fill it in after the take)'}"
            onDidChange="(v) => {
              if (liveCurItem &amp;&amp; !liveCurItem.shape &amp;&amp; v !== liveCurItem.text) {
                liveAnnots = liveAnnots.map((a) => a.cid === liveCur ? { ...a, text: v, left: 3 } : a);
                liveTick = null;
                logEvents([{ event: 'annotSet', cid: liveCur, text: v, wallMs: Date.now() }]);
              }
            }" />
          <Select id="liveTail" initialValue="none" width="130px" enabled="{!!liveCurItem &amp;&amp; !liveCurItem.shape}"
            onDidChange="(v) => {
              if (liveCurItem &amp;&amp; !liveCurItem.shape &amp;&amp; v !== liveCurItem.tail) {
                liveAnnots = liveAnnots.map((a) => a.cid === liveCur ? { ...a, tail: v } : a);
                logEvents([{ event: 'annotSet', cid: liveCur, tail: v, wallMs: Date.now() }]);
              }
            }">
            <Option value="none" label="No tail" />
            <Option value="nw" label="Tail ↖ nw" />
            <Option value="n" label="Tail ↑ n" />
            <Option value="ne" label="Tail ↗ ne" />
            <Option value="e" label="Tail → e" />
            <Option value="se" label="Tail ↘ se" />
            <Option value="s" label="Tail ↓ s" />
            <Option value="sw" label="Tail ↙ sw" />
            <Option value="w" label="Tail ← w" />
          </Select>
          <Button label="{liveCurItem &amp;&amp; liveCurItem.kept ? 'Kept' : 'Keep'}" size="xs"
            variant="{liveCurItem &amp;&amp; liveCurItem.kept ? 'solid' : 'outlined'}" enabled="{!!liveCurItem}"
            tooltip="Keep this item up until you remove it, instead of 3 seconds on the air (click again to let it expire)"
            onClick="
              if (!liveAnnots.some((a) => !a.kept)) liveTick = null;
              logEvents([{ event: 'annotKeep', cid: liveCur, kept: !liveCurItem.kept, wallMs: Date.now() }]);
              liveAnnots = liveAnnots.map((a) => a.cid === liveCur ? { ...a, kept: !a.kept, left: 3 } : a);
            " />
          <Button label="Remove" size="xs" variant="outlined" enabled="{!!liveCurItem}"
            tooltip="Take this item down now (its span in the take ends here)"
            onClick="
              logEvents([{ event: 'annotRemove', cid: liveCur, wallMs: Date.now() }]);
              liveAnnots = liveAnnots.filter((a) => a.cid !== liveCur);
              liveCur = null;
              liveText.setValue('');
              liveTail.setValue('none');
            " />
        </HStack>
        <!-- Items up now: click one to make it current, ✕ to take it down. -->
        <Items data="{liveAnnots}">
          <HStack verticalAlignment="center">
            <Button size="xs" variant="{$item.cid === liveCur ? 'solid' : 'ghost'}"
              label="{($item.shape ? ({ rect: 'Box', ellipse: 'Oval', arrow: 'Arrow', line: 'Line', pointer: 'Pointer' })[$item.shape] : $item.text || '(empty callout)') + ($item.kept ? ' · kept' : ' · ' + Math.ceil($item.left) + ' s')}"
              onClick="
                liveCur = $item.cid;
                liveText.setValue($item.text);
                liveTail.setValue($item.tail || 'none');
              " />
            <Button icon="close" size="xs" variant="ghost" aria-label="Take this item down"
              onClick="
                logEvents([{ event: 'annotRemove', cid: $item.cid, wallMs: Date.now() }]);
                liveAnnots = liveAnnots.filter((a) => a.cid !== $item.cid);
                if (liveCur === $item.cid) {
                  liveCur = null;
                  liveText.setValue('');
                  liveTail.setValue('none');
                }
              " />
          </HStack>
        </Items>
      </VStack>
      <!-- The take loaded in the take player (its URL); hidden while recording. -->
      <!-- calloutHandles: the edited callout's eight resize handles (anchors
           named by compass point), centered on its box's corners and edge
           midpoints, square on screen (height scaled by the picture's aspect);
           hidden while the callout is being moved. They depend only on the
           box, never on the sprite, so a handle can't leave anchors mid-drag
           (PointerLayer ends a drag whose anchor disappears). -->
      <!-- editSprite: the current item's sprite from the DataSource, or its
           last one while the next loads; never another item's.
           annotKind: what the editor places (callout, rect, ellipse, arrow or
           pointer); an arrow gets two handles at its ends (a: tail, b: tip), a
           pointer none (it only moves). -->
      <!-- The editor works as the recording view does (take-editor-live-model):
           there is no draft and nothing to save. Command-drag places an item,
           which is saved at once (/callouts/add) and becomes the current one.
           editCallout is the current item's id; calloutBox, calloutIn,
           calloutOut, curShape, curText and curTail hold its fields, set when
           it is placed or selected and at each change, and every change is
           saved at once (/callouts/update) and the lists refetched. Clicking
           or dragging an item on the picture, or its name in the list, makes
           it current. annotKind is only the tool: what the next Command-drag
           places. A cut, a pause or Undo retimes items on the server, so
           each of those lets go of the current item. curShown: paused, the
           current item is always on the picture, with its handles, so it can
           be edited from any playhead position; playing, it obeys its In and
           Out like the rest, so Play always previews the take as it will be.
           Clicking the current item's name in the list again lets go of it. -->
      <VStack when="{playing &amp;&amp; !capturing}"
        var.editDur="{((takes.value || []).find((t) => t.id === editTake) || { duration_s: 0 }).duration_s}"
        var.editSprite="{calloutSprite.value &amp;&amp; calloutSprite.value.id === editCallout ? calloutSprite.value : (lastSprite &amp;&amp; lastSprite.id === editCallout ? lastSprite : null)}"
        var.curShown="{!!editCallout &amp;&amp; (takePlayer.paused || (playerTime >= calloutIn &amp;&amp; playerTime &lt;= calloutOut))}"
        var.handleBox="{curShown &amp;&amp; calloutBox &amp;&amp; !curShape &amp;&amp; calloutBox.x2 - calloutBox.x1 &lt; 0.001 &amp;&amp; editSprite ? { x1: editSprite.x, y1: editSprite.y, x2: editSprite.x + editSprite.width, y2: editSprite.y + editSprite.height } : (curShown ? calloutBox : null)}"
        var.calloutHandles="{handleBox &amp;&amp; takeAspect &amp;&amp; !dragPos &amp;&amp; curShape !== 'pointer' ? ((curShape === 'arrow' || curShape === 'line') ? [['a', handleBox.x1, handleBox.y1], ['b', handleBox.x2, handleBox.y2]] : [['nw', handleBox.x1, handleBox.y1], ['n', (handleBox.x1 + handleBox.x2) / 2, handleBox.y1], ['ne', handleBox.x2, handleBox.y1], ['e', handleBox.x2, (handleBox.y1 + handleBox.y2) / 2], ['se', handleBox.x2, handleBox.y2], ['s', (handleBox.x1 + handleBox.x2) / 2, handleBox.y2], ['sw', handleBox.x1, handleBox.y2], ['w', handleBox.x1, (handleBox.y1 + handleBox.y2) / 2]]).map((h) => ({ id: h[0], url: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 10%22%3E%3Crect x=%221%22 y=%221%22 width=%228%22 height=%228%22 fill=%22white%22 stroke=%22%23222%22 stroke-width=%221.5%22/%3E%3C/svg%3E', x: h[1] - 0.009, y: h[2] - 0.009 * takeAspect, width: 0.018, height: 0.018 * takeAspect })) : []}">
        <!-- The tools, above the player as when recording, and the player's
             close box at the end of the row. A tool can be switched at any
             time. -->
        <HStack verticalAlignment="center">
          <Items data="{[['callout', 'Callout'], ['rect', 'Box'], ['ellipse', 'Oval'], ['arrow', 'Arrow'], ['line', 'Line'], ['pointer', 'Pointer']]}">
            <Button label="{$item[1]}" size="xs"
              variant="{annotKind === $item[0] ? 'solid' : 'outlined'}"
              tooltip="Hold Command (⌘) and drag to place (click, for Pointer). It starts at the playhead and lasts 3 s; In and Out change that."
              onClick="annotKind = $item[0]" />
          </Items>
          <SpaceFiller />
          <Button icon="close" variant="ghost" aria-label="Close player"
            tooltip="Close the player" onClick="playing = ''" />
        </HStack>
        <!-- Callouts (overlay.py), edited directly on the video: the player
             shows the take's clean copy (no burned-in text, /clean/<file>) and
             PointerLayer's anchors (xmlui-org/xmlui#3922) draw each callout on
             it as a sprite from the server, made by the same code Apply uses.
             Items show between their in and out points; the current one
             always shows, and dragging it moves it (the layer reports the
             drag; the page moves the anchor), and dragging one of its eight
             handles resizes it (the text refits as you drag). Command-drag
             places a new item. calloutSprite is the current item's sprite as
             its fields stand now (with a callout's selection frame); the
             server echoes the item's id, so a sprite still loading for the
             previously current item is never shown for this one. -->
        <DataSource id="calloutSprite" url="http://127.0.0.1:8765/callouts/sprite" method="POST"
          when="{!!editCallout &amp;&amp; !!calloutBox &amp;&amp; !!editTake}"
          body="{{ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, tail: curTail, shape: curShape, frame: !curShape }}"
          onLoaded="(d) => { lastSprite = d; dragPos = null; }" />
        <!-- applyState.dirty: the saved callouts differ from what was last burned
             in (the SQL is overlay.py's APPLIED_SQL, which fills
             takes.overlay_applied at Apply); Apply is dimmed otherwise. -->
        <DataSource id="applyState" url="http://127.0.0.1:8765/query" method="POST" dataType="sql" when="{!!editTake}"
          body="{{ sql: 'SELECT (SELECT group_concat(id || char(58) || text || char(58) || x1 || char(58) || y1 || char(58) || x2 || char(58) || y2 || char(58) || t_in || char(58) || t_out || char(58) || ifnull(tail, char(45)) || char(58) || ifnull(shape, char(45)), char(124)) FROM (SELECT * FROM overlays WHERE take_id = ? ORDER BY id)) IS NOT overlay_applied AS dirty FROM takes WHERE id = ?', params: [editTake, editTake] }}" />
        <DataSource id="savedSprites" url="http://127.0.0.1:8765/callouts/sprites" method="POST"
          when="{!!editTake}" body="{{ take_id: editTake }}" />
        <!-- Every item's anchor has the item's id, the current one's too, so
             a drag that starts on another item makes it current and carries
             on as a move (a dragged anchor that unmounts leaves PointerLayer's
             drag stuck). The current item is drawn from editSprite once that
             has loaded, and from its saved sprite until then; lastSprite is
             its latest sprite, kept while the next one loads. One just placed
             isn't in savedSprites until the refetch lands, hence the last
             concat. At the end of a drag, nb is the current item's new box
             when the drag changed it; a click, or a drag that came back,
             saves nothing, and since no new sprite will then load to clear
             dragPos, it is cleared there. -->
        <PointerLayer id="calloutLayer" contentAspect="{takeAspect}" anchorDrag="true" pointerShape="arrow"
          tool="{annotKind === 'arrow' || annotKind === 'line' || annotKind === 'pointer' ? annotKind : 'rect'}"
          anchors="{(savedSprites.value || []).filter((a) => a.id === editCallout ? curShown : (playerTime >= a.t_in &amp;&amp; playerTime &lt;= a.t_out)).map((a) => a.id !== editCallout ? a : { id: a.id, url: (editSprite || a).url, x: dragPos ? dragPos.x : (editSprite || a).x, y: dragPos ? dragPos.y : (editSprite || a).y, width: (editSprite || a).width, height: (editSprite || a).height }).concat(curShown &amp;&amp; editSprite &amp;&amp; !(savedSprites.value || []).some((a) => a.id === editCallout) ? [{ id: editCallout, url: editSprite.url, x: dragPos ? dragPos.x : editSprite.x, y: dragPos ? dragPos.y : editSprite.y, width: editSprite.width, height: editSprite.height }] : []).concat(calloutHandles)}"
          onAnchorDragStart="(e) => {
            const edges = { nw: 1, n: 1, ne: 1, e: 1, se: 1, s: 1, sw: 1, w: 1, a: 1, b: 1 }[e.id];
            if (edges) {
              dragFrom = handleBox;
            } else if (e.id === editCallout) {
              dragFrom = calloutBox;
            } else {
              const it = (callouts.value || []).find((c) => c.id === e.id);
              if (it) {
                editCallout = it.id;
                curShape = it.shape || null;
                curText = it.text;
                curTail = it.tail || 'none';
                calloutBox = { x1: it.x1, y1: it.y1, x2: it.x2, y2: it.y2 };
                calloutIn = it.t_in;
                calloutOut = it.t_out;
                lastSprite = null;
                dragPos = null;
                dragFrom = { x1: it.x1, y1: it.y1, x2: it.x2, y2: it.y2 };
                calloutText.setValue(it.text);
                calloutTail.setValue(it.tail || 'none');
              }
            }
          }"
          onAnchorDragMove="(e) => {
            const edges = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1], s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0], a: [1, 1, 0, 0], b: [0, 0, 1, 1] }[e.id];
            if (e.id === editCallout) {
              dragPos = { x: e.x, y: e.y };
            } else if (edges &amp;&amp; dragFrom &amp;&amp; (curShape === 'arrow' || curShape === 'line')) {
              const b = dragFrom;
              calloutBox = { x1: Math.min(1, Math.max(0, b.x1 + edges[0] * e.dx)), y1: Math.min(1, Math.max(0, b.y1 + edges[1] * e.dy)), x2: Math.min(1, Math.max(0, b.x2 + edges[2] * e.dx)), y2: Math.min(1, Math.max(0, b.y2 + edges[3] * e.dy)) };
            } else if (edges &amp;&amp; dragFrom) {
              const b = dragFrom;
              const x1 = Math.max(0, Math.min(b.x1 + edges[0] * e.dx, b.x2 - 0.04));
              const y1 = Math.max(0, Math.min(b.y1 + edges[1] * e.dy, b.y2 - 0.03));
              const x2 = Math.min(1, Math.max(b.x2 + edges[2] * e.dx, b.x1 + 0.04));
              const y2 = Math.min(1, Math.max(b.y2 + edges[3] * e.dy, b.y1 + 0.03));
              calloutBox = { x1: x1, y1: y1, x2: x2, y2: y2 };
            }
          }"
          onAnchorDragEnd="(e) => {
            const edges = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1], s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0], a: [1, 1, 0, 0], b: [0, 0, 1, 1] }[e.id];
            let nb = null;
            if (e.id === editCallout &amp;&amp; calloutBox) {
              const c = calloutBox;
              const dx = Math.min(Math.max(e.dx, -Math.min(c.x1, c.x2)), 1 - Math.max(c.x1, c.x2));
              const dy = Math.min(Math.max(e.dy, -Math.min(c.y1, c.y2)), 1 - Math.max(c.y1, c.y2));
              if (dx === 0 &amp;&amp; dy === 0) {
                dragPos = null;
              } else {
                nb = { x1: c.x1 + dx, y1: c.y1 + dy, x2: c.x2 + dx, y2: c.y2 + dy };
              }
            } else if (edges &amp;&amp; dragFrom &amp;&amp; (curShape === 'arrow' || curShape === 'line')) {
              const b = dragFrom;
              nb = { x1: Math.min(1, Math.max(0, b.x1 + edges[0] * e.dx)), y1: Math.min(1, Math.max(0, b.y1 + edges[1] * e.dy)), x2: Math.min(1, Math.max(0, b.x2 + edges[2] * e.dx)), y2: Math.min(1, Math.max(0, b.y2 + edges[3] * e.dy)) };
            } else if (edges &amp;&amp; dragFrom) {
              const b = dragFrom;
              const x1 = Math.max(0, Math.min(b.x1 + edges[0] * e.dx, b.x2 - 0.04));
              const y1 = Math.max(0, Math.min(b.y1 + edges[1] * e.dy, b.y2 - 0.03));
              const x2 = Math.min(1, Math.max(b.x2 + edges[2] * e.dx, b.x1 + 0.04));
              const y2 = Math.min(1, Math.max(b.y2 + edges[3] * e.dy, b.y1 + 0.03));
              nb = { x1: x1, y1: y1, x2: x2, y2: y2 };
            }
            dragFrom = null;
            if (nb &amp;&amp; editCallout) {
              calloutBox = nb;
              updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: nb.x1, y1: nb.y1, x2: nb.x2, y2: nb.y2, t_in: calloutIn, t_out: calloutOut, tail: curTail, shape: curShape });
              callouts.refetch();
              savedSprites.refetch();
              applyState.refetch();
            }
          }"
          onShapeEnd="(e) => {
            const t = takePlayer.getCurrentTime();
            const out = Math.max(t + 0.2, Math.min(t + 3, editDur));
            const shape = annotKind === 'callout' ? null : annotKind;
            const free = shape === 'arrow' || shape === 'line';
            const box = free ? { x1: e.x1, y1: e.y1, x2: e.x2, y2: e.y2 } : { x1: Math.min(e.x1, e.x2), y1: Math.min(e.y1, e.y2), x2: Math.max(e.x1, e.x2), y2: Math.max(e.y1, e.y2) };
            const r = Actions.callApi({ url: 'http://127.0.0.1:8765/callouts/add', method: 'post', body: { take_id: editTake, text: '', x1: box.x1, y1: box.y1, x2: box.x2, y2: box.y2, t_in: t, t_out: out, tail: 'none', shape: shape } });
            editCallout = r.id;
            curShape = shape;
            curText = '';
            curTail = 'none';
            calloutBox = box;
            calloutIn = t;
            calloutOut = out;
            lastSprite = null;
            dragPos = null;
            calloutText.setValue('');
            calloutTail.setValue('none');
            callouts.refetch();
            savedSprites.refetch();
            applyState.refetch();
            editTabs.setActiveTabIndex(0);
          }">
          <MediaPlayer id="takePlayer" autoPlay="true" maxHeight="55vh"
            muted="{!!narrating}" controls="{!narrating}"
            src="{editFile ? 'http://127.0.0.1:8765/clean/' + encodeURIComponent(editFile) + '?c=' + cutSeq : playing}"
            onLoadedMetadata="(e) => takeAspect = e.videoWidth / e.videoHeight"
            onTimeUpdate="(e) => playerTime = e.currentTime"
            onSeeked="(e) => playerTime = e.currentTime" />
          <property name="anchorTemplate">
            <Image src="{$item.url}" width="100%" />
          </property>
        </PointerLayer>
        <!-- The take's edits, one per tab (https://www.xmlui.org/docs/reference/components/Tabs):
             in each, the slider at full width, then its controls on a second
             row. keepMounted: Tabs otherwise unmounts the hidden tabs, and a
             slider mounted again would show its last seed (initialValue), not
             where its handles were dragged, while lastCut / pauseAt / narrClip
             still held the dragged values. Switching tabs ends Preview, whose
             button would be out of sight. The Theme makes the tab strip
             compact. The two Timers stay outside: Tabs shows only TabItems. -->
        <Theme paddingVertical-trigger-Tabs="$space-1" paddingHorizontal-trigger-Tabs="$space-3"
          paddingTop-TabItem="$space-2">
        <Tabs id="editTabs" keepMounted="true" when="{!!editTake &amp;&amp; editDur > 0}"
          onDidChange="cutPreview = null">
        <!-- Annotate: the current item's row (text, tail, In and Out where
             the recording view has Keep, Remove) and the take's items; click
             a name to make that item current and move the playhead to its
             start. Text and tail save as they change: curText and curTail
             are the values last saved (or set when the item became current),
             so setValue on selection saves nothing. Apply burns the items
             into the video; it is the one explicit step, since it re-encodes
             the take. -->
        <TabItem label="Annotate">
        <VStack>
          <HStack verticalAlignment="center">
            <TextBox id="calloutText" width="*" enabled="{!!editCallout &amp;&amp; !curShape}"
              placeholder="{!editCallout ? 'Hold Command and drag on the picture to place a callout or shape' : curShape ? 'Shapes have no text' : 'Callout text'}"
              onDidChange="(v) => {
                if (editCallout &amp;&amp; calloutBox &amp;&amp; !curShape &amp;&amp; v !== curText) {
                  curText = v;
                  updateCallout.execute({ take_id: editTake, id: editCallout, text: v, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: calloutOut, tail: curTail, shape: curShape });
                  callouts.refetch();
                  savedSprites.refetch();
                  applyState.refetch();
                }
              }" />
            <!-- In and Out, each with a − before it and a + after it that move
                 the time one frame (0.04 s at 25 fps), save at once, and take
                 the playhead there so the frame is seen. The two groups are
                 tight inside ($space-1) and the row's ordinary gap apart, so
                 In's + isn't taken for Out's −, without taking width from
                 the text box. Times show two decimals: at one, a
                 one-frame step often wouldn't change the label. -->
            <HStack verticalAlignment="center" gap="$space-1">
              <Button label="−" size="xs" variant="ghost" enabled="{!!editCallout}"
                tooltip="Start one frame earlier"
                onClick="
                  const t = Math.max(0, Math.min(Math.round((calloutIn - 0.04) * 100) / 100, calloutOut - 0.1));
                  if (t !== calloutIn) {
                    calloutIn = t;
                    takePlayer.seek(t);
                    updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: t, t_out: calloutOut, tail: curTail, shape: curShape });
                    callouts.refetch();
                    savedSprites.refetch();
                    applyState.refetch();
                  }
                " />
              <Button label="{'In ' + calloutIn.toFixed(2) + 's'}" size="xs" variant="outlined" enabled="{!!editCallout}"
                tooltip="Start this item at the playhead"
                onClick="
                  const t = Math.max(0, Math.min(takePlayer.getCurrentTime(), calloutOut - 0.1));
                  calloutIn = t;
                  updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: t, t_out: calloutOut, tail: curTail, shape: curShape });
                  callouts.refetch();
                  savedSprites.refetch();
                  applyState.refetch();
                " />
              <Button label="+" size="xs" variant="ghost" enabled="{!!editCallout}"
                tooltip="Start one frame later"
                onClick="
                  const t = Math.max(0, Math.min(Math.round((calloutIn + 0.04) * 100) / 100, calloutOut - 0.1));
                  if (t !== calloutIn) {
                    calloutIn = t;
                    takePlayer.seek(t);
                    updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: t, t_out: calloutOut, tail: curTail, shape: curShape });
                    callouts.refetch();
                    savedSprites.refetch();
                    applyState.refetch();
                  }
                " />
            </HStack>
            <HStack verticalAlignment="center" gap="$space-1">
              <Button label="−" size="xs" variant="ghost" enabled="{!!editCallout}"
                tooltip="End one frame earlier"
                onClick="
                  const t = Math.min(takePlayer.duration || editDur, Math.max(Math.round((calloutOut - 0.04) * 100) / 100, calloutIn + 0.1));
                  if (t !== calloutOut) {
                    calloutOut = t;
                    takePlayer.seek(t);
                    updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: t, tail: curTail, shape: curShape });
                    callouts.refetch();
                    savedSprites.refetch();
                    applyState.refetch();
                  }
                " />
              <Button label="{'Out ' + calloutOut.toFixed(2) + 's'}" size="xs" variant="outlined" enabled="{!!editCallout}"
                tooltip="End this item at the playhead"
                onClick="
                  const t = Math.max(takePlayer.getCurrentTime(), calloutIn + 0.1);
                  calloutOut = t;
                  updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: t, tail: curTail, shape: curShape });
                  callouts.refetch();
                  savedSprites.refetch();
                  applyState.refetch();
                " />
              <Button label="+" size="xs" variant="ghost" enabled="{!!editCallout}"
                tooltip="End one frame later"
                onClick="
                  const t = Math.min(takePlayer.duration || editDur, Math.max(Math.round((calloutOut + 0.04) * 100) / 100, calloutIn + 0.1));
                  if (t !== calloutOut) {
                    calloutOut = t;
                    takePlayer.seek(t);
                    updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: t, tail: curTail, shape: curShape });
                    callouts.refetch();
                    savedSprites.refetch();
                    applyState.refetch();
                  }
                " />
            </HStack>
            <!-- Tail: a speech-bubble pointer off the box at a compass point. -->
            <Select id="calloutTail" initialValue="none" width="130px" enabled="{!!editCallout &amp;&amp; !curShape}"
              onDidChange="(v) => {
                if (editCallout &amp;&amp; calloutBox &amp;&amp; !curShape &amp;&amp; v !== curTail) {
                  curTail = v;
                  updateCallout.execute({ take_id: editTake, id: editCallout, text: curText, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: calloutOut, tail: v, shape: curShape });
                  callouts.refetch();
                  savedSprites.refetch();
                  applyState.refetch();
                }
              }">
              <Option value="none" label="No tail" />
              <Option value="nw" label="Tail ↖ nw" />
              <Option value="n" label="Tail ↑ n" />
              <Option value="ne" label="Tail ↗ ne" />
              <Option value="e" label="Tail → e" />
              <Option value="se" label="Tail ↘ se" />
              <Option value="s" label="Tail ↓ s" />
              <Option value="sw" label="Tail ↙ sw" />
              <Option value="w" label="Tail ← w" />
            </Select>
            <Button label="Remove" size="xs" variant="outlined" enabled="{!!editCallout}"
              tooltip="Delete this item from the take"
              onClick="
                deleteCallout.execute(editCallout);
                editCallout = null;
                calloutBox = null;
                lastSprite = null;
                curShape = null;
                curText = '';
                curTail = 'none';
                calloutIn = 0;
                calloutOut = 3;
                calloutText.setValue('');
                calloutTail.setValue('none');
                callouts.refetch();
                savedSprites.refetch();
                applyState.refetch();
              " />
            <Spinner when="{renderOverlay.inProgress}" />
            <Button label="Apply" size="xs"
              enabled="{!renderOverlay.inProgress &amp;&amp; !!applyState.value &amp;&amp; !!applyState.value[0] &amp;&amp; !!applyState.value[0].dirty}"
              tooltip="Burn this take's items into its video file, for export (the player shows them live either way)"
              onClick="
                renderOverlay.execute(editTake);
                takes.refetch();
                applyState.refetch();
              " />
          </HStack>
          <!-- The take's items and its narrations, in time order, each row
               starting with its ✕ so the ✕s line up. A narration's ✕ puts back
               the audio it replaced (/narrate/remove), at any time; the Undo
               line then offers to restore it. Clicking a narration's name
               moves the playhead to its start. -->
          <Items data="{(callouts.value || []).map((c) => ({ ...c, narr: false })).concat((narrs.value || []).map((n) => ({ id: 'n' + n.id, nid: n.id, t_in: n.t_in, t_out: n.t_out, narr: true }))).sort((a, b) => a.t_in - b.t_in)}">
            <HStack verticalAlignment="center">
              <Button icon="close" size="xs" variant="ghost"
                aria-label="{$item.narr ? 'Remove this narration' : 'Remove this item'}"
                tooltip="{$item.narr ? 'Remove this narration: the audio that was there before comes back (Undo restores the narration)' : 'Remove this item'}"
                enabled="{!removeNarration.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
                handlerTimeoutMs:onClick="0"
                onClick="
                  if ($item.narr) {
                    removeNarration.execute($item.nid);
                    cutSeq = cutSeq + 1;
                    narrs.refetch();
                    edits.refetch();
                    takes.refetch();
                  } else {
                    deleteCallout.execute($item.id);
                    if ($item.id === editCallout) {
                      editCallout = null;
                      calloutBox = null;
                      lastSprite = null;
                      curShape = null;
                      curText = '';
                      curTail = 'none';
                      calloutIn = 0;
                      calloutOut = 3;
                      calloutText.setValue('');
                      calloutTail.setValue('none');
                    }
                    callouts.refetch();
                    savedSprites.refetch();
                    applyState.refetch();
                  }
                " />
              <Button size="xs" variant="{!$item.narr &amp;&amp; $item.id === editCallout ? 'solid' : 'ghost'}"
                label="{($item.narr ? 'Narration' : $item.shape ? ({ rect: 'Box', ellipse: 'Oval', arrow: 'Arrow', line: 'Line', pointer: 'Pointer' })[$item.shape] : $item.text || '(empty callout)') + ' · ' + $item.t_in.toFixed(2) + '–' + $item.t_out.toFixed(2) + ' s'}"
                onClick="
                  if ($item.narr) {
                    takePlayer.seek($item.t_in);
                  } else if ($item.id === editCallout) {
                    editCallout = null;
                    calloutBox = null;
                    lastSprite = null;
                    curShape = null;
                    curText = '';
                    curTail = 'none';
                    calloutIn = 0;
                    calloutOut = 3;
                    calloutText.setValue('');
                    calloutTail.setValue('none');
                  } else {
                    editCallout = $item.id;
                    curShape = $item.shape || null;
                    curText = $item.text;
                    curTail = $item.tail || 'none';
                    calloutBox = { x1: $item.x1, y1: $item.y1, x2: $item.x2, y2: $item.y2 };
                    calloutIn = $item.t_in;
                    calloutOut = $item.t_out;
                    lastSprite = null;
                    dragPos = null;
                    calloutText.setValue($item.text);
                    calloutTail.setValue($item.tail || 'none');
                    takePlayer.seek($item.t_in);
                  }
                " />
            </HStack>
          </Items>
        </VStack>
        </TabItem>
        <!-- Cut a stretch out of the take: the slider's two handles mark its
             start and end (https://www.xmlui.org/docs/reference/components/Slider),
             in one-frame steps; moving a handle seeks the player to it (lastCut
             tells which one moved). While Preview is on, playback skips the
             stretch, with a 40 ms Timer watching the playhead (the player's
             timeUpdate is too coarse); nothing changes on disk until Cut. A cut
             re-encodes two files, so its click has no handler timeout
             (https://www.xmlui.org/docs/managed-react/cooperative-concurrency). -->
        <TabItem label="Cut">
        <VStack>
          <!-- valueFormat is a sync callback: one arrow expression, in braces
               (https://www.xmlui.org/docs/howto/keep-sync-callbacks-to-one-expression).
               The handles are placed by re-seeding through initialValue
               (cutSeed), which fires no events, not by setValue
               (https://www.xmlui.org/docs/howto/drive-a-slider-with-a-runtime-domain);
               lastCut follows them, from didChange and alongside each re-seed. -->
          <Slider id="cutSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
            initialValue="{cutSeed}" minStepsBetweenThumbs="{3}"
            valueFormat="{(v) => v.toFixed(2) + 's'}"
            enabled="{!cutTake.inProgress}"
            onDidChange="(v) => {
              cutPreview = null;
              takePlayer.seek(v[0] !== lastCut[0] ? v[0] : v[1]);
              lastCut = v;
            }" />
          <HStack verticalAlignment="center">
          <Button label="Set start" size="xs" variant="outlined"
            tooltip="Move the cut's start to the playhead"
            onClick="
              cutSeed = [Math.min(takePlayer.getCurrentTime(), lastCut[1] - 0.12), lastCut[1]];
              lastCut = cutSeed;
            " />
          <Button label="Set end" size="xs" variant="outlined"
            tooltip="Move the cut's end to the playhead"
            onClick="
              cutSeed = [lastCut[0], Math.max(takePlayer.getCurrentTime(), lastCut[0] + 0.12)];
              lastCut = cutSeed;
            " />
          <!-- Preview is a mode: while it's on (the button reads Previewing),
               playback skips the marked stretch and otherwise just plays. It
               starts from the playhead, or from 2 s before the cut when the
               playhead is already in or past it. Off again: the button, moving
               a handle, Cut, or choosing another take. -->
          <Button label="{cutPreview ? 'Previewing' : 'Preview'}" size="xs"
            variant="{cutPreview ? 'solid' : 'outlined'}"
            tooltip="{cutPreview ? 'Stop skipping the marked stretch' : 'Play from the playhead, skipping the marked stretch. Nothing is changed.'}"
            onClick="
              if (cutPreview) {
                cutPreview = null;
                takePlayer.pause();
              } else {
                cutPreview = lastCut;
                if (takePlayer.getCurrentTime() >= lastCut[0]) takePlayer.seek(Math.max(0, lastCut[0] - 2));
                takePlayer.play();
              }
            " />
          <Button label="{'Cut ' + (lastCut[1] - lastCut[0]).toFixed(2) + 's'}" size="xs" themeColor="attention"
            tooltip="Remove this stretch from the take (Undo brings it back)"
            enabled="{!cutTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
            handlerTimeoutMs:onClick="0"
            onClick="
              cutPreview = null;
              editCallout = null; calloutBox = null; lastSprite = null;
              curShape = null; curText = ''; curTail = 'none';
              calloutText.setValue(''); calloutTail.setValue('none');
              cutTake.execute({ id: editTake, start: lastCut[0], end: lastCut[1] });
              cutSeq = cutSeq + 1;
              lastCut = [0, 1]; cutSeed = [0, 1];
              edits.refetch();
              narrs.refetch();
              takes.refetch();
              callouts.refetch();
              savedSprites.refetch();
              applyState.refetch();
            " />
          <Spinner when="{cutTake.inProgress}" />
          </HStack>
          <!-- A cut through a narration takes away its ✕ (the audio kept for
               removing it no longer fits; serve_media.py drops its row, with
               one frame of slack at its ends). Say so before the click; it
               doesn't block, since Undo brings the row back. -->
          <Text color="$color-warn-700"
            when="{(narrs.value || []).some((n) => lastCut[0] &lt; n.t_out - 0.04 &amp;&amp; lastCut[1] > n.t_in + 0.04)}"
            value="{'This cut goes through the narration at ' + (narrs.value || []).filter((n) => lastCut[0] &lt; n.t_out - 0.04 &amp;&amp; lastCut[1] > n.t_in + 0.04).map((n) => n.t_in.toFixed(1) + '–' + n.t_out.toFixed(1) + ' s').join(' and ') + '. Afterwards its ✕ can no longer remove it; only Undo can.'}" />
        </VStack>
        </TabItem>
        <!-- Insert a pause: one handle marks where (moving it seeks the player
             to the frame that will be held), a NumberBox says how long. The
             length is remembered in localStorage as the next default
             (https://www.xmlui.org/docs/globals#local-storage-utilities). The
             handle is placed from the playhead by re-seeding initialValue
             (pauseSeed), as for the cut slider. -->
        <TabItem label="Pause">
        <VStack>
          <Slider id="pauseSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
            initialValue="{pauseSeed}"
            valueFormat="{(v) => v.toFixed(2) + 's'}"
            enabled="{!pauseTake.inProgress}"
            onDidChange="(v) => {
              cutPreview = null;
              pauseAt = v;
              takePlayer.seek(v);
            }" />
          <HStack verticalAlignment="center">
          <Button label="Set at playhead" size="xs" variant="outlined"
            tooltip="Put the pause at the playhead"
            onClick="
              pauseSeed = takePlayer.getCurrentTime();
              pauseAt = pauseSeed;
            " />
          <NumberBox width="110px" initialValue="{pauseSecs}" minValue="{0.5}" maxValue="{30}" step="{0.5}"
            endText="s" tooltip="How long the pause lasts (remembered as the default)"
            onDidChange="(v) => {
              if (v >= 0.5 &amp;&amp; v &lt;= 30) {
                pauseSecs = v;
                writeLocalStorage('studio.pauseSeconds', v);
              }
            }" />
          <Button label="{'Insert ' + pauseSecs + 's pause'}" size="xs" themeColor="attention"
            tooltip="{'Hold the frame at ' + pauseAt.toFixed(2) + ' s for ' + pauseSecs + ' s, with silence (Undo takes it back)'}"
            enabled="{!pauseTake.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
            handlerTimeoutMs:onClick="0"
            onClick="
              cutPreview = null;
              editCallout = null; calloutBox = null; lastSprite = null;
              curShape = null; curText = ''; curTail = 'none';
              calloutText.setValue(''); calloutTail.setValue('none');
              pauseTake.execute({ id: editTake, at: pauseAt, seconds: pauseSecs });
              cutSeq = cutSeq + 1;
              edits.refetch();
              narrs.refetch();
              takes.refetch();
              callouts.refetch();
              savedSprites.refetch();
              applyState.refetch();
            " />
          <Spinner when="{pauseTake.inProgress}" />
          </HStack>
          <!-- The same warning for a pause that falls inside a narration. -->
          <Text color="$color-warn-700"
            when="{(narrs.value || []).some((n) => pauseAt > n.t_in + 0.04 &amp;&amp; pauseAt &lt; n.t_out - 0.04)}"
            value="{'This pause falls inside the narration at ' + (narrs.value || []).filter((n) => pauseAt > n.t_in + 0.04 &amp;&amp; pauseAt &lt; n.t_out - 0.04).map((n) => n.t_in.toFixed(1) + '–' + n.t_out.toFixed(1) + ' s').join(' and ') + '. Afterwards its ✕ can no longer remove it; only Undo can.'}" />
        </VStack>
        </TabItem>
        <!-- Narrate over a stretch: two handles mark the clip, as on the Cut
             row (narrSeed re-seeds them, narrClip follows them). Narrate plays
             the clip muted, without the player's own controls, while the mic
             records; the Timer below stops it at the clip's end (a Timer
             waits for its handler before ticking again:
             https://www.xmlui.org/docs/reference/components/Timer), or Stop
             does earlier. The take's audio there is then replaced; Undo, on
             the History tab, takes it back. While narrating, a row under the slider
             shows the clip's start and end with a ProgressBar between them
             (value 0 to 1:
             https://www.xmlui.org/docs/reference/components/ProgressBar)
             following the playhead, and the Stop button counts down the
             seconds left, since the player's own controls are hidden then. -->
        <TabItem label="Narrate">
        <VStack>
          <Slider id="narrSlider" width="100%" minValue="{0}" maxValue="{editDur}" step="{0.04}"
            initialValue="{narrSeed}" minStepsBetweenThumbs="{13}"
            valueFormat="{(v) => v.toFixed(2) + 's'}"
            enabled="{!narrating &amp;&amp; !narrBusy}"
            onDidChange="(v) => {
              cutPreview = null;
              takePlayer.seek(v[0] !== narrClip[0] ? v[0] : v[1]);
              narrClip = v;
            }" />
          <HStack when="{!!narrating}" verticalAlignment="center">
            <Text value="{narrating ? narrating[0].toFixed(2) + ' s' : ''}" />
            <ProgressBar width="*"
              value="{narrating ? Math.max(0, Math.min(1, (playerTime - narrating[0]) / (narrating[1] - narrating[0]))) : 0}" />
            <Text value="{narrating ? narrating[1].toFixed(2) + ' s' : ''}" />
          </HStack>
          <HStack verticalAlignment="center">
          <Button label="Set start" size="xs" variant="outlined"
            tooltip="Move the clip's start to the playhead"
            enabled="{!narrating &amp;&amp; !narrBusy}"
            onClick="
              narrSeed = [Math.min(takePlayer.getCurrentTime(), narrClip[1] - 0.52), narrClip[1]];
              narrClip = narrSeed;
            " />
          <Button label="Set end" size="xs" variant="outlined"
            tooltip="Move the clip's end to the playhead"
            enabled="{!narrating &amp;&amp; !narrBusy}"
            onClick="
              narrSeed = [narrClip[0], Math.max(takePlayer.getCurrentTime(), narrClip[0] + 0.52)];
              narrClip = narrSeed;
            " />
          <Button label="{narrating ? '⏹ Stop recording · ' + Math.max(0, narrating[1] - playerTime).toFixed(1) + ' s left' : '🎤 Narrate ' + (narrClip[1] - narrClip[0]).toFixed(2) + 's'}"
            size="xs" themeColor="attention"
            tooltip="{narrating ? 'Stop now: what you said so far replaces the audio, and the rest of the clip is silent' : 'Play this clip muted and record the microphone over it, replacing its audio (Undo takes it back)'}"
            enabled="{!narrBusy &amp;&amp; !capturing &amp;&amp; !dictating &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress}"
            handlerTimeoutMs:onClick="0"
            onClick="narrating ? stopNarration() : startNarration();" />
          <Spinner when="{narrBusy}" />
          </HStack>
        </VStack>
        </TabItem>
        <!-- History: the take's edits (cut, pause, narrate, a narration
             removed), newest first, with when each was made. The tinted row
             is the edit Undo takes back: the most recent one still in effect.
             Undo moves the tint down a row and leaves the undone edit above
             it, dimmed; Redo puts the edit just above the tint back. A new
             edit discards the undone ones. The table is plain rows, not a
             Table: Table has no per-row style, and tinting each cell from its
             row (https://www.xmlui.org/docs/howto/highlight-rows-conditionally)
             left the tint as separate blocks with gaps between them.
             Both buttons let go of the current item first, as a cut does:
             the take's items are swapped with its files. -->
        <TabItem label="History">
        <VStack>
          <HStack verticalAlignment="center">
            <Button label="Undo" size="xs" variant="outlined"
              tooltip="Take back the tinted edit"
              enabled="{!!edits.value &amp;&amp; edits.value.canUndo &amp;&amp; !undoEdit.inProgress &amp;&amp; !redoEdit.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
              handlerTimeoutMs:onClick="0"
              onClick="
                cutPreview = null;
                editCallout = null; calloutBox = null; lastSprite = null;
                curShape = null; curText = ''; curTail = 'none';
                calloutText.setValue(''); calloutTail.setValue('none');
                undoEdit.execute(editTake);
                cutSeq = cutSeq + 1;
                lastCut = [0, 1]; cutSeed = [0, 1];
                edits.refetch();
                narrs.refetch();
                takes.refetch();
                callouts.refetch();
                savedSprites.refetch();
                applyState.refetch();
              " />
            <Button label="Redo" size="xs" variant="outlined"
              tooltip="Put back the edit just above the tinted one"
              enabled="{!!edits.value &amp;&amp; edits.value.canRedo &amp;&amp; !undoEdit.inProgress &amp;&amp; !redoEdit.inProgress &amp;&amp; !cutTake.inProgress &amp;&amp; !pauseTake.inProgress &amp;&amp; !narrating &amp;&amp; !narrBusy}"
              handlerTimeoutMs:onClick="0"
              onClick="
                cutPreview = null;
                editCallout = null; calloutBox = null; lastSprite = null;
                curShape = null; curText = ''; curTail = 'none';
                calloutText.setValue(''); calloutTail.setValue('none');
                redoEdit.execute(editTake);
                cutSeq = cutSeq + 1;
                lastCut = [0, 1]; cutSeed = [0, 1];
                edits.refetch();
                narrs.refetch();
                takes.refetch();
                callouts.refetch();
                savedSprites.refetch();
                applyState.refetch();
              " />
            <Spinner when="{undoEdit.inProgress || redoEdit.inProgress}" />
            <Text variant="secondary" when="{!!edits.value &amp;&amp; !!edits.value.note}" value="{edits.value.note}" />
          </HStack>
          <Text variant="secondary" when="{!!edits.value &amp;&amp; edits.value.edits.length === 0}"
            value="No edits to this take yet." />
          <VStack gap="0" when="{!!edits.value &amp;&amp; edits.value.edits.length > 0}">
            <HStack paddingHorizontal="$space-2" paddingVertical="$space-1">
              <Text variant="secondary" width="200px" value="When" />
              <Text variant="secondary" value="Edit" />
            </HStack>
            <Items data="{edits.value ? edits.value.edits : []}">
              <HStack verticalAlignment="center" paddingHorizontal="$space-2" paddingVertical="$space-1"
                backgroundColor="{$item.current ? '$color-primary-100' : 'transparent'}">
                <Text width="200px" when="{!$item.undone}" value="{$item.when}" />
                <Text width="200px" when="{$item.undone}" variant="secondary" value="{$item.when}" />
                <Text when="{!$item.undone}" value="{$item.what}" />
                <Text when="{$item.undone}" variant="secondary" value="{$item.what + ' (undone)'}" />
              </HStack>
            </Items>
          </VStack>
        </VStack>
        </TabItem>
        </Tabs>
        </Theme>
        <Timer interval="40" enabled="{!!narrating}"
          onTick="
            if (narrating &amp;&amp; takePlayer.getCurrentTime() >= Math.min(narrating[1], takePlayer.duration || narrating[1]) - 0.05) stopNarration();
          " />
        <!-- While the take plays, playerTime follows the player every 40 ms.
             The player's timeUpdate arrives about four times a second, which
             showed items a third of a second late (measured 2026-10-01: an
             item set to 2.0-5.0 s was on screen 2.32-5.37 s). -->
        <Timer interval="40" enabled="{!takePlayer.paused}"
          onTick="playerTime = takePlayer.getCurrentTime()" />
        <Timer interval="40" enabled="{!!cutPreview}"
          onTick="
            const t = takePlayer.getCurrentTime();
            if (t >= cutPreview[0] &amp;&amp; t &lt; cutPreview[1]) takePlayer.seek(cutPreview[1]);
          " />
      </VStack>
      <!-- Takes as a drag-reorderable list (DndItems, the xmlui-dnd-list extension
           Bram's queue uses): only the grip drags, so the row's buttons stay live.
           The order is saved to takes.position via POST /reorder. New takes go to
           the top (register.py). -->
      <HStack when="{deleteTake.lastResult &amp;&amp; deleteTake.lastResult.undo !== dismissedUndo}"
        verticalAlignment="center">
        <Text value="Deleted {deleteTake.lastResult.name}." />
        <Button label="Undo" size="sm" variant="outlined"
          onClick="
            dismissedUndo = deleteTake.lastResult.undo;
            undeleteTake.execute(dismissedUndo);
            takes.refetch();
          " />
      </HStack>
      <DndItems data="{takes}" dragHandle="true"
        onReorder="(newOrder) => {
          reorderTakes.execute({ ids: newOrder.map(t => t.id) });
          takes.refetch();
        }">
        <HStack width="100%" verticalAlignment="center" paddingVertical="$space-2">
          <!-- Empty take (no player events): record.sh's warning, with what the
               player reported at Stop. -->
          <Icon name="warning" when="{$item.warning}" tooltip="{$item.warning}" />
          <Text value="{$item.name}" overflowMode="flow" width="*" />
          <Text value="{$item.recorded}" width="110px" />
          <Text value="{$item.duration_s + 's'}" width="70px" />
          <Text value="{$item.source}" width="160px" />
          <!-- Play/pause toggle: one slot, icon and tooltip name the next action. -->
          <Button variant="ghost" enabled="{!capturing &amp;&amp; !narrating}"
            icon="{playing === $item.url &amp;&amp; !takePlayer.paused ? 'pause' : 'play'}"
            tooltip="{playing === $item.url &amp;&amp; !takePlayer.paused ? 'Pause' : 'Play'}"
            aria-label="Play or pause take"
            onClick="
              if (playing === $item.url) {
                takePlayer.paused ? takePlayer.play() : takePlayer.pause();
              } else {
                playing = $item.url;
                editTake = $item.id;
                editFile = $item.file;
                pauseAt = 0; pauseSeed = 0;
                lastCut = [0, 1]; cutSeed = [0, 1];
                narrClip = [0, 1]; narrSeed = [0, 1];
                editCallout = null; calloutBox = null; lastSprite = null;
                curShape = null; curText = ''; curTail = 'none';
                cutPreview = null;
              }
            " />
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete take" tooltip="Delete this take (moves the MP4 to media/.trash; Undo brings it back)"
            onClick="
              if (playing === $item.url) playing = '';
              deleteTake.execute($item.id);
              takes.refetch();
            " />
        </HStack>
      </DndItems>
    </Page>
    <!-- Exports, a page of its own between Takes and Audio (it was a
         collapsible panel on the Takes page until 2026-10-01). The finishing
         workflow, two sections, each newest first: when, how long, a link, a
         note, and delete. Exports is everything in media/exports/ that isn't
         leveled (what Export makes, and anything an editor saved there);
         Leveled exports is what Level wrote. The Takes page's Export button
         comes here, so the new file's "writing…" row is seen. -->
    <Page url="/exports">
      <!-- One Theme around the lists, not one per row: small spinners
           (https://www.xmlui.org/docs/howto/scope-theme-outside-loops). A
           row whose file an editor is still writing shows "writing… N MB" and
           waits to offer Level. -->
      <Theme size-Spinner="1em">
      <H2>Exports</H2>
      <HStack verticalAlignment="center" when="{exportTakes.inProgress}">
        <Spinner />
        <Text value="Exporting takes…" />
      </HStack>
      <Text variant="secondary" when="{exports.value &amp;&amp; exports.value.exports.length === 0}"
        value="Nothing exported yet." />
      <!-- Each export takes two lines, in both sections. First: time 110px,
           length 150px, the name. Second: mic, the note (all the width
           that's left; a leveled row's loudness beneath it), its ✕, Level
           (unleveled only) and delete, which ends the line in both sections,
           so the trash cans line up. On one line the fixed columns left the
           note a third of a wide window and almost nothing of a narrow one.
           Exports holds every file here that isn't leveled. One that isn't
           exactly what Export wrote (an editor saved over it, or beside it)
           carries an "edited" tag; the note says what was done. -->
      <Items data="{exports.value ? exports.value.exports : []}">
        <VStack gap="$space-1" paddingBottom="$space-3">
        <HStack verticalAlignment="center">
          <Text value="{$item.created.substring(5, 16)}" width="110px" />
          <HStack width="150px" verticalAlignment="center" gap="$space-1">
            <Text when="{!$item.writing}" value="{$item.seconds + 's'}" />
            <Spinner when="{$item.writing}" />
            <Text when="{$item.writing}" variant="secondary" value="{'writing… ' + ($item.bytes / 1048576).toFixed(1) + ' MB'}" />
          </HStack>
          <HStack width="*" verticalAlignment="center" gap="$space-2">
            <Link to="{$item.url}" target="_blank" label="{$item.name}" />
            <Text variant="secondary" when="{$item.edited}" value="edited" />
          </HStack>
        </HStack>
        <HStack verticalAlignment="center">
          <HStack width="*" verticalAlignment="center" gap="$space-1">
            <Button variant="ghost" label="{dictating === noteKey($item) ? '⏹' : '🎤'}"
              tooltip="{dictating === noteKey($item) ? 'Stop dictating (or press Enter)' : 'Dictate a note'}"
              enabled="{!dictating || dictating === noteKey($item)}"
              onClick="dictating === noteKey($item) ? stopDictation($item) : startDictation($item, noteBox)" />
            <Form width="*" hideButtonRow="true" onSubmit="submitNote($item)">
              <TextArea id="noteBox" width="100%" placeholder="Note…" autoSize="true" maxRows="3" initialValue="{$item.note}"
                onGotFocus="noteBuffer = $item.note || ''; noteEdited = false"
                onDidChange="(v) => { noteBuffer = v; noteEdited = true; window.studioDictationValue(noteKey($item), v); }"
                onLostFocus="if (dictating !== noteKey($item)) commitNote($item)" />
            </Form>
            <Button icon="close" variant="ghost" aria-label="Clear note" tooltip="Clear this note"
              enabled="{!!$item.note &amp;&amp; dictating !== noteKey($item)}"
              onClick="clearNote($item)" />
          </HStack>
          <!-- An export that needs no editing can be leveled directly. -->
          <HStack width="100px" horizontalAlignment="end">
            <Button label="Level" variant="outlined" size="sm"
              enabled="{!levelExport.inProgress &amp;&amp; !$item.writing}"
              tooltip="Cut rumble and even out loudness (level_edit.py) into leveled-…mp4"
              onClick="
                levelExport.execute($item);
                exports.refetch();
              " />
          </HStack>
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete export" tooltip="Delete this export (moves it to media/.trash)"
            onClick="
              deleteExport.execute($item);
              exports.refetch();
            " />
        </HStack>
        </VStack>
      </Items>
      <HStack verticalAlignment="center" when="{levelExport.inProgress}">
        <Spinner />
        <Text value="Leveling…" />
      </HStack>
      <H2>Leveled exports</H2>
      <Text variant="secondary" when="{exports.value &amp;&amp; exports.value.leveled.length === 0}"
        value="Click Level on an export." />
      <!-- A leveled row's second line is aligned to its top: the loudness
           report under the note makes the note's column taller than the
           buttons beside it. -->
      <Items data="{exports.value ? exports.value.leveled : []}">
        <VStack gap="$space-1" paddingBottom="$space-3">
        <HStack verticalAlignment="center">
          <Text value="{$item.created.substring(5, 16)}" width="110px" />
          <HStack width="150px" verticalAlignment="center" gap="$space-1">
            <Text when="{!$item.writing}" value="{$item.seconds + 's'}" />
            <Spinner when="{$item.writing}" />
            <Text when="{$item.writing}" variant="secondary" value="{'writing… ' + ($item.bytes / 1048576).toFixed(1) + ' MB'}" />
          </HStack>
          <Link to="{$item.url}" target="_blank" label="{$item.name}" width="*" />
        </HStack>
        <HStack verticalAlignment="start">
          <HStack width="*" verticalAlignment="start" gap="$space-1">
            <Button variant="ghost" label="{dictating === noteKey($item) ? '⏹' : '🎤'}"
              tooltip="{dictating === noteKey($item) ? 'Stop dictating (or press Enter)' : 'Dictate a note'}"
              enabled="{!dictating || dictating === noteKey($item)}"
              onClick="dictating === noteKey($item) ? stopDictation($item) : startDictation($item, noteBox)" />
            <Form width="*" hideButtonRow="true" onSubmit="submitNote($item)">
              <TextArea id="noteBox" width="100%" placeholder="Note…" autoSize="true" maxRows="3" initialValue="{$item.note}"
                onGotFocus="noteBuffer = $item.note || ''; noteEdited = false"
                onDidChange="(v) => { noteBuffer = v; noteEdited = true; window.studioDictationValue(noteKey($item), v); }"
                onLostFocus="if (dictating !== noteKey($item)) commitNote($item)" />
              <Text variant="secondary" value="{$item.report}" />
            </Form>
            <Button icon="close" variant="ghost" aria-label="Clear note" tooltip="Clear this note"
              enabled="{!!$item.note &amp;&amp; dictating !== noteKey($item)}"
              onClick="clearNote($item)" />
          </HStack>
          <Stack width="100px" />
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete leveled export" tooltip="Delete this file (moves it to media/.trash)"
            onClick="
              deleteExport.execute($item);
              exports.refetch();
            " />
        </HStack>
        </VStack>
      </Items>
      </Theme>
    </Page>
    <Page url="/bench">
      <H2>Audio recording test</H2>
      <HStack verticalAlignment="center">
        <Select id="mic" data="{devices}" valueField="name" labelField="name"
          initialValue="MacBook Air Microphone" width="260px" />
        <Select id="recorderChoice" initialValue="ffmpeg-raw" width="300px">
          <Option value="ffmpeg-raw" label="ffmpeg raw (today's session.sh)" />
          <Option value="ffmpeg-async" label="ffmpeg + gap fill" />
          <Option value="native" label="native macOS (no ffmpeg)" />
        </Select>
        <Button label="Test (10s)" enabled="{!voiceTest.inProgress}"
          onClick="
            toast('Recording 10s: read the sentence below now');
            voiceTest.execute({ mic: mic.value, recorder: recorderChoice.value });
          " />
      </HStack>
      <Text>
        Read aloud: "She sells sea shells by the seashore, and the quick brown fox
        jumps past six sharp scissors."
      </Text>
      <Table data="{voiceTests}">
        <!-- Never show "No data available" (it flashes while data loads). -->
        <property name="noDataTemplate">
          <Fragment/>
        </property>
        <Column header="Tested" bindTo="created_at" width="190px" />
        <Column header="Mic" bindTo="mic" />
        <Column header="Recorder" bindTo="recorder" />
        <Column header="Expected s" bindTo="expected_s" />
        <Column header="Captured s" bindTo="captured_s" />
        <Column header="Short %" bindTo="short_pct" />
        <Column header="Clicks" bindTo="clicks" />
        <Column header="Peak dB" bindTo="peak_db" />
        <Column header="RMS dB" bindTo="rms_db" />
        <Column header="Play">
          <HStack>
            <Link to="{$item.raw_url}" target="_blank" label="raw" />
            <Link to="{$item.leveled_url}" target="_blank" label="leveled" />
          </HStack>
        </Column>
      </Table>

      <!-- Audio playback test: MediaPlayer's kind="audio" (xmlui-org/xmlui#3913)
           on any take or source. An audio element plays an MP4's audio track,
           so no separate audio files are needed. -->
      <VStack var.audioLog="{[]}" var.audioDuration="">
        <H2>Audio playback test</H2>
        <HStack verticalAlignment="center">
          <Select id="audioChoice" placeholder="Play from…" width="480px"
            data="{[
              ...(takes.value || []).map(t => ({ label: 'Take: ' + t.name.slice(0, 60), value: t.url })),
              ...(sources.value || []).map(x => ({ label: 'Source: ' + x.name, value: 'http://127.0.0.1:8765/sources/' + encodeURIComponent(x.name) }))
            ]}"
            onDidChange="audioLog = []; audioDuration = ''">
            <!-- A take's name is long enough to wrap, and a Select's wrapped
                 value centers by default (its face is a button). The
                 template's width and textAlign make it wrap from the left
                 (https://www.xmlui.org/docs/howto/customize-a-selects-selected-value). -->
            <property name="valueTemplate">
              <Text width="100%" textAlign="start" value="{$item.label}" />
            </property>
          </Select>
          <Button label="Clear log" variant="outlined" onClick="audioLog = []" />
        </HStack>
        <MediaPlayer kind="audio" when="{audioChoice.value}" src="{audioChoice.value}"
          onLoadedMetadata="(e) => audioDuration = e.duration.toFixed(2) + ' s'"
          onPlay="(e) => audioLog = [...audioLog, 'play at ' + e.currentTime.toFixed(2) + ' s']"
          onPause="(e) => audioLog = [...audioLog, 'pause at ' + e.currentTime.toFixed(2) + ' s']"
          onSeeked="(e) => audioLog = [...audioLog, 'seeked at ' + e.currentTime.toFixed(2) + ' s']"
          onEnded="(e) => audioLog = [...audioLog, 'ended at ' + e.currentTime.toFixed(2) + ' s']" />
        <Text when="{audioChoice.value}" value="Duration: {audioDuration || '(loading)'}" />
        <Items data="{audioLog}">
          <Text value="{$item}" />
        </Items>
      </VStack>
    </Page>
  </Pages>
</App>
