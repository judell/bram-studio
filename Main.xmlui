<App name="Bram Studio" layout="vertical-sticky" var.playing="" var.capturing="{false}" var.recEvents="{[]}" var.newAfterId="{null}" var.recPaused="{false}" var.sourceAspect="{undefined}" var.inkTool="freehand" var.onAirYet="{false}">
  <!-- Bram's own layout (~/bram/app/tools/Main.xmlui): header band over the
       main area, nav always visible. themes/studio.json keeps the nav from
       collapsing into a drawer on a narrow window, as Bram's theme does. -->
  <!-- Takes live in studio.db (see schema.sql); Bram serves it read-only via
       /query. Each take's MP4 is served by serve_media.py, which Bram's
       loopback can't do yet (no video content types, no byte ranges). -->
  <DataSource id="takes" url="/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, name, created_at, substr(created_at, 6) AS recorded, duration_s, url, source, warning FROM takes ORDER BY position, created_at DESC', params: [] }}"
    pollIntervalInSeconds="5" />
  <!-- serve_media.py runs record.sh; Stop posts the source player's event
       log, record.sh renders from it, and the take appears when it
       registers. -->
  <DataSource id="sources" url="http://127.0.0.1:8765/sources" />
  <DataSource id="recStatus" url="http://127.0.0.1:8765/record/status"
    pollIntervalInSeconds="2" />
  <APICall id="startRecording" method="post" url="http://127.0.0.1:8765/record"
    body="{$param}"
    errorNotificationMessage="{$error.message}" />
  <!-- Page state is reset in the Record/Stop click handlers, after execute()
       returns: assignments in this APICall's success handler ran but didn't
       take effect (the page stayed stuck in recording mode). -->
  <!-- Restart discards the running take (no render, no row) and starts a new
       one; Discard only ends it, for a page that lost the take (a reload). -->
  <APICall id="restartRecording" method="post" url="http://127.0.0.1:8765/record/restart"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="cancelRecording" method="post" url="http://127.0.0.1:8765/record/cancel"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="stopRecording" method="post" url="http://127.0.0.1:8765/record/stop"
    body="{$param}"
    errorNotificationMessage="{$error.message}" />
  <!-- One click, no warning: serve_media.py moves the MP4 to media/.trash/. -->
  <!-- The table is refreshed in the trash button's click, after execute():
       this APICall's onSuccess refetch didn't take effect (rows lingered until
       the 5s poll, and clicking one gave "no take with id N"). invalidates="{[]}"
       stops the default refresh of every DataSource (including /devices, which
       runs ffmpeg) after each delete; only the takes table needs refetching. -->
  <APICall id="reorderTakes" method="post" url="http://127.0.0.1:8765/reorder"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteTake" method="post" url="http://127.0.0.1:8765/delete"
    body="{{ id: $param }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />

  <!-- Audio recording test: serve_media.py runs voicetest.py, which records 10s
       with the chosen mic and recorder and adds a voice_tests row. -->
  <DataSource id="devices" url="http://127.0.0.1:8765/devices" />
  <DataSource id="voiceTests" url="/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT * FROM voice_tests ORDER BY created_at DESC', params: [] }}" />
  <APICall id="voiceTest" method="post" url="http://127.0.0.1:8765/voicetest"
    body="{$param}"
    onSuccess="voiceTests.refetch()"
    errorNotificationMessage="{$error.message}" />

  <AppHeader>
    <HStack verticalAlignment="center" width="100%">
      <H3>Bram Studio</H3>
      <SpaceFiller />
      <!-- XMLUI trace viewer. The studio carries its own xs-diff.html and the
           xmlui-parser.es.js it imports (vendor/), as it carries its own engine;
           config.json's appGlobals.xsVerbose turns capture on. -->
      <Inspector src="/vendor/xs-diff.html" tooltip="Inspector: XMLUI trace" />
    </HStack>
  </AppHeader>
  <NavPanel>
    <property name="logoTemplate">
      <Fragment/>
    </property>
    <property name="footerTemplate">
      <Fragment/>
    </property>
    <NavLink label="Takes" to="/" />
    <NavLink label="Audio" to="/bench" />
  </NavPanel>
  <Pages fallbackPath="/">
    <Page url="/">
      <HStack verticalAlignment="center">
        <H2>Sources</H2>
        <Select id="sourceChoice" data="{sources}" valueField="name" labelField="name"
          placeholder="Choose a source"
          width="260px" />
        <!-- Record shows the source player (paused at 0:00, logged as the start
             row) and starts OFF the air (a recpause right after it), so the time
             spent getting ready is cut and never rendered; Start recording goes on
             the air. Every play/pause/seeked/ended is logged until Stop. -->
        <Button label="Record" when="{!capturing}"
          enabled="{!!sourceChoice.value &amp;&amp; !startRecording.inProgress &amp;&amp; !(recStatus.value &amp;&amp; recStatus.value.phase)}"
          onClick="
            playing = '';
            newAfterId = null;
            recPaused = true;
            onAirYet = false;
            recEvents = [{ event: 'start', currentTime: 0, playing: false, wallMs: Date.now() }, { event: 'recpause', wallMs: Date.now() }];
            capturing = true;
            try {
              startRecording.execute({ source: sourceChoice.value });
            } catch (e) {
              capturing = false;
            }
          " />
        <!-- Off the air: everything between Pause and Resume is cut from the
             take's picture and voice (render.py); the player is yours to set
             up the next spot meanwhile. -->
        <!-- Pauses the recording, not the video (the player's own controls do
             that); "Pause" alone was mistaken for the video's pause. -->
        <Button label="{recPaused ? (onAirYet ? 'Resume recording' : 'Start recording') : 'Pause recording'}"
          variant="{onAirYet ? 'outlined' : 'solid'}" when="{capturing}"
          enabled="{!!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          onClick="
            if (recPaused) {
              recEvents = [...recEvents, { event: 'recresume', wallMs: Date.now() }];
              recPaused = false;
              onAirYet = true;
            } else {
              recEvents = [...recEvents, { event: 'recpause', wallMs: Date.now() }];
              recPaused = true;
              sourcePlayer.pause();
            }
          " />
        <Button label="Restart" variant="outlined" when="{capturing}"
          enabled="{!restartRecording.inProgress &amp;&amp; !!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          tooltip="Discard this take and start again from 0:00"
          onClick="
            sourcePlayer.pause();
            sourcePlayer.seek(0);
            restartRecording.execute({ source: sourceChoice.value });
            recPaused = true;
            onAirYet = false;
            recEvents = [{ event: 'start', currentTime: 0, playing: false, wallMs: Date.now() }, { event: 'recpause', wallMs: Date.now() }];
          " />
        <Button label="Stop" themeColor="attention" when="{capturing}"
          enabled="{!stopRecording.inProgress &amp;&amp; !!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          onClick="
            newAfterId = Math.max(0, ...(takes.value || []).map(t => t.id));
            const playerEvents = recEvents.filter(e => ['play', 'pause', 'seeked', 'ended'].includes(e.event)).length;
            const inkEvents = recEvents.filter(e => e.event === 'stroke' || e.event === 'shape' || e.event === 'pointer').length;
            const diag = { duration: sourcePlayer.duration, paused: sourcePlayer.paused,
                           currentTime: sourcePlayer.getCurrentTime(), playerEvents, inkEvents };
            if (!onAirYet) {
              toast('Nothing was recorded: you never clicked Start recording.');
            } else if (playerEvents === 0 &amp;&amp; inkEvents === 0) {
              toast('No player activity in this take, so the picture is a still of 0:00.');
            }
            stopRecording.execute({ events: recEvents, diag });
            capturing = false;
            recPaused = false;
            recEvents = [];
          " />
        <Button label="Refresh" variant="outlined" size="sm" onClick="takes.refetch()" />
      </HStack>
      <!-- A take this page didn't start (it was reloaded mid-take, or another
           tab started it): it has no event log to render, so offer Discard. -->
      <HStack verticalAlignment="center"
        when="{!capturing &amp;&amp; recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}">
        <Text value="A recording is in progress from another page or before a reload." />
        <Button label="Discard" variant="outlined" themeColor="attention"
          enabled="{!cancelRecording.inProgress}" onClick="cancelRecording.execute()" />
      </HStack>
      <HStack verticalAlignment="center" when="{recStatus.value &amp;&amp; recStatus.value.phase}">
        <Spinner />
        <Text value="{recPaused ? (onAirYet ? 'Recording paused: nothing is recorded until you click Resume recording' : 'Ready: set up the video, then click Start recording') : recStatus.value.label}" />
      </HStack>
      <!-- The source movie you narrate over. MediaPlayer is the experimental
           component from xmlui-org/xmlui#3913 (vendor/); its events are the
           take's picture path (render.py's events input). -->
      <!-- One player at a time: the source player exists only while recording
           (Record clears any loaded take; Stop removes it). -->
      <VStack when="{capturing}">
        <!-- Ink over the source (xmlui-org/xmlui#3919): hold Command and drag to
             draw; without it, clicks reach the player. Strokes and the pointer
             path go into the take's event log, in 0-1 picture coordinates. -->
        <!-- Drawing tools (xmlui-org/xmlui#3919 build 2): the selected one is solid. -->
        <HStack verticalAlignment="center">
          <Items data="{[['freehand', 'Freehand'], ['line', 'Line'], ['arrow', 'Arrow'], ['rect', 'Rect'], ['ellipse', 'Oval'], ['pointer', 'Point']]}">
            <Button label="{$item[1]}" size="sm"
              variant="{inkTool === $item[0] ? 'solid' : 'outlined'}"
              tooltip="Hold Command (⌘) and drag to draw. Add Shift (⇧) for a square, circle or 45° line; add Option (⌥) to draw from the center."
              onClick="inkTool = $item[0]" />
          </Items>
        </HStack>
        <PointerLayer id="ink" contentAspect="{sourceAspect}" enabled="{capturing}" tool="{inkTool}"
          onShapeEnd="(e) => { if (capturing) recEvents = [...recEvents, { event: 'shape', tool: e.tool, x1: e.x1, y1: e.y1, x2: e.x2, y2: e.y2, color: e.color, width: e.width, wallMs: e.time, durationMs: e.duration }] }"
          onStrokeEnd="(e) => { if (capturing) recEvents = [...recEvents, { event: 'stroke', points: e.points, color: e.color, width: e.width, wallMs: e.time }] }"
          onPointerMove="(e) => { if (capturing) recEvents = [...recEvents, { event: 'pointer', x: e.x, y: e.y, buttons: e.buttons, wallMs: e.time }] }">
        <MediaPlayer id="sourcePlayer"
          src="{'http://127.0.0.1:8765/sources/' + encodeURIComponent(sourceChoice.value)}"
          onLoadedMetadata="(e) => sourceAspect = e.videoWidth / e.videoHeight"
          onPlay="(e) => { if (capturing) recEvents = [...recEvents, { event: 'play', currentTime: e.currentTime, wallMs: Date.now() }] }"
          onPause="(e) => { if (capturing) recEvents = [...recEvents, { event: 'pause', currentTime: e.currentTime, wallMs: Date.now() }] }"
          onSeeked="(e) => { if (capturing) recEvents = [...recEvents, { event: 'seeked', currentTime: e.currentTime, wallMs: Date.now() }] }"
          onEnded="(e) => { if (capturing) recEvents = [...recEvents, { event: 'ended', currentTime: e.currentTime, wallMs: Date.now() }] }" />
        </PointerLayer>
      </VStack>
      <!-- The take loaded in the take player (its URL); hidden while recording. -->
      <VStack when="{playing &amp;&amp; !capturing}">
        <HStack horizontalAlignment="end">
          <Button icon="close" variant="ghost" aria-label="Close player"
            tooltip="Close the player" onClick="playing = ''; newAfterId = null" />
        </HStack>
        <MediaPlayer id="takePlayer" src="{playing}" autoPlay="true" />
      </VStack>
      <!-- Takes as a drag-reorderable list (DndItems, the xmlui-dnd-list extension
           Bram's queue uses): only the grip drags, so the row's buttons stay live.
           The order is saved to takes.position via POST /reorder. The playing or
           just-recorded take is tinted across the whole row. -->
      <DndItems data="{takes}" dragHandle="true"
        onReorder="(newOrder) => {
          reorderTakes.execute({ ids: newOrder.map(t => t.id) });
          takes.refetch();
        }">
        <HStack width="100%" verticalAlignment="center" paddingVertical="$space-2"
          backgroundColor="{playing === $item.url || (newAfterId !== null &amp;&amp; $item.id > newAfterId) ? '$color-primary-100' : 'transparent'}">
          <!-- Empty take (no player events): record.sh's warning, with what the
               player reported at Stop. -->
          <Icon name="warning" when="{$item.warning}" tooltip="{$item.warning}" />
          <Text value="{$item.name}" overflowMode="flow" width="*" />
          <Text value="{$item.recorded}" width="110px" />
          <Text value="{$item.duration_s + 's'}" width="70px" />
          <Text value="{$item.source}" width="160px" />
          <!-- Play/pause toggle: one slot, icon and tooltip name the next action. -->
          <Button variant="ghost" enabled="{!capturing}"
            icon="{playing === $item.url &amp;&amp; !takePlayer.paused ? 'pause' : 'play'}"
            tooltip="{playing === $item.url &amp;&amp; !takePlayer.paused ? 'Pause' : 'Play'}"
            aria-label="Play or pause take"
            onClick="
              if (playing === $item.url) {
                takePlayer.paused ? takePlayer.play() : takePlayer.pause();
              } else {
                playing = $item.url;
              }
            " />
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete take" tooltip="Delete this take (moves the MP4 to media/.trash)"
            onClick="
              if (playing === $item.url) playing = '';
              deleteTake.execute($item.id);
              takes.refetch();
            " />
        </HStack>
      </DndItems>
    </Page>
    <Page url="/bench">
      <H2>Audio recording test</H2>
      <HStack verticalAlignment="center">
        <Select id="mic" data="{devices}" valueField="name" labelField="name"
          initialValue="MacBook Air Microphone" width="260px" />
        <Select id="recorderChoice" initialValue="ffmpeg-raw" width="300px">
          <Option value="ffmpeg-raw" label="ffmpeg raw (today's session.sh)" />
          <Option value="ffmpeg-async" label="ffmpeg + gap fill" />
          <Option value="native" label="native macOS (no ffmpeg)" />
        </Select>
        <Button label="Test (10s)" enabled="{!voiceTest.inProgress}"
          onClick="
            toast('Recording 10s: read the sentence below now');
            voiceTest.execute({ mic: mic.value, recorder: recorderChoice.value });
          " />
      </HStack>
      <Text>
        Read aloud: "She sells sea shells by the seashore, and the quick brown fox
        jumps past six sharp scissors."
      </Text>
      <Table data="{voiceTests}">
        <!-- Never show "No data available" (it flashes while data loads). -->
        <property name="noDataTemplate">
          <Fragment/>
        </property>
        <Column header="Tested" bindTo="created_at" width="190px" />
        <Column header="Mic" bindTo="mic" />
        <Column header="Recorder" bindTo="recorder" />
        <Column header="Expected s" bindTo="expected_s" />
        <Column header="Captured s" bindTo="captured_s" />
        <Column header="Short %" bindTo="short_pct" />
        <Column header="Clicks" bindTo="clicks" />
        <Column header="Peak dB" bindTo="peak_db" />
        <Column header="RMS dB" bindTo="rms_db" />
        <Column header="Play">
          <HStack>
            <Link to="{$item.raw_url}" target="_blank" label="raw" />
            <Link to="{$item.leveled_url}" target="_blank" label="leveled" />
          </HStack>
        </Column>
      </Table>

      <!-- Audio playback test: MediaPlayer's kind="audio" (xmlui-org/xmlui#3913)
           on any take or source. An audio element plays an MP4's audio track,
           so no separate audio files are needed. -->
      <VStack var.audioLog="{[]}" var.audioDuration="">
        <H2>Audio playback test</H2>
        <HStack verticalAlignment="center">
          <Select id="audioChoice" placeholder="Play from…" width="480px"
            data="{[
              ...(takes.value || []).map(t => ({ label: 'Take: ' + t.name.slice(0, 60), value: t.url })),
              ...(sources.value || []).map(x => ({ label: 'Source: ' + x.name, value: 'http://127.0.0.1:8765/sources/' + encodeURIComponent(x.name) }))
            ]}"
            onDidChange="audioLog = []; audioDuration = ''" />
          <Button label="Clear log" variant="outlined" onClick="audioLog = []" />
        </HStack>
        <MediaPlayer kind="audio" when="{audioChoice.value}" src="{audioChoice.value}"
          onLoadedMetadata="(e) => audioDuration = e.duration.toFixed(2) + ' s'"
          onPlay="(e) => audioLog = [...audioLog, 'play at ' + e.currentTime.toFixed(2) + ' s']"
          onPause="(e) => audioLog = [...audioLog, 'pause at ' + e.currentTime.toFixed(2) + ' s']"
          onSeeked="(e) => audioLog = [...audioLog, 'seeked at ' + e.currentTime.toFixed(2) + ' s']"
          onEnded="(e) => audioLog = [...audioLog, 'ended at ' + e.currentTime.toFixed(2) + ' s']" />
        <Text when="{audioChoice.value}" value="Duration: {audioDuration || '(loading)'}" />
        <Items data="{audioLog}">
          <Text value="{$item}" />
        </Items>
      </VStack>
    </Page>
  </Pages>
</App>
