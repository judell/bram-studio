<App name="Bram Studio" layout="vertical-sticky" var.playing="" var.capturing="{false}" var.recEvents="{[]}" var.recPaused="{false}" var.sourceAspect="{undefined}" var.inkTool="line" var.onAirYet="{false}" var.editTake="{null}" var.takeAspect="{undefined}" var.calloutBox="{null}" var.calloutIn="{0}" var.calloutOut="{3}" var.editCallout="{null}" var.editFile="" var.playerTime="{0}" var.dragPos="{null}" var.dragFrom="{null}" var.lastSprite="{null}" var.savedKey="">
  <!-- Bram's own layout (~/bram/app/tools/Main.xmlui): header band over the
       main area, nav always visible. themes/studio.json keeps the nav from
       collapsing into a drawer on a narrow window, as Bram's theme does. -->
  <!-- Takes live in studio.db (see schema.sql); Bram serves it read-only via
       /query. Each take's MP4 is served by serve_media.py, which Bram's
       loopback can't do yet (no video content types, no byte ranges). -->
  <DataSource id="takes" url="/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, name, created_at, substr(created_at, 6) AS recorded, duration_s, url, file, source, warning FROM takes ORDER BY position, created_at DESC', params: [] }}"
    pollIntervalInSeconds="5" />
  <!-- serve_media.py runs record.sh; Stop posts the source player's event
       log, record.sh renders from it, and the take appears when it
       registers. -->
  <DataSource id="sources" url="http://127.0.0.1:8765/sources" pollIntervalInSeconds="5" />
  <DataSource id="recStatus" url="http://127.0.0.1:8765/record/status"
    pollIntervalInSeconds="2" />
  <APICall id="startRecording" method="post" url="http://127.0.0.1:8765/record"
    body="{$param}"
    errorNotificationMessage="{$error.message}" />
  <!-- Page state is reset in the Record/Stop click handlers, after execute()
       returns: assignments in this APICall's success handler ran but didn't
       take effect (the page stayed stuck in recording mode). -->
  <!-- Restart discards the running take (no render, no row) and starts a new
       one; Discard only ends it, for a page that lost the take (a reload). -->
  <APICall id="restartRecording" method="post" url="http://127.0.0.1:8765/record/restart"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="cancelRecording" method="post" url="http://127.0.0.1:8765/record/cancel"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="stopRecording" method="post" url="http://127.0.0.1:8765/record/stop"
    body="{$param}"
    errorNotificationMessage="{$error.message}" />
  <!-- One click, no warning: serve_media.py moves the MP4 to media/.trash/. -->
  <!-- The table is refreshed in the trash button's click, after execute():
       this APICall's onSuccess refetch didn't take effect (rows lingered until
       the 5s poll, and clicking one gave "no take with id N"). invalidates="{[]}"
       stops the default refresh of every DataSource (including /devices, which
       runs ffmpeg) after each delete; only the takes table needs refetching. -->
  <!-- Joins every take, in list order, into one MP4 (media/exports/). -->
  <APICall id="exportTakes" method="post" url="http://127.0.0.1:8765/export"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="reorderTakes" method="post" url="http://127.0.0.1:8765/reorder"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Callouts: text burned into a take (overlay.py). Add/delete edit the
       list; render burns the take's text in from its clean copy. -->
  <DataSource id="callouts" url="/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, text, x1, y1, x2, y2, t_in, t_out, tail FROM overlays WHERE take_id = ? AND kind = ? ORDER BY t_in', params: [editTake, &quot;callout&quot;] }}" />
  <APICall id="addCallout" method="post" url="http://127.0.0.1:8765/callouts/add"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="updateCallout" method="post" url="http://127.0.0.1:8765/callouts/update"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteCallout" method="post" url="http://127.0.0.1:8765/callouts/delete"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="renderOverlay" method="post" url="http://127.0.0.1:8765/overlay/render"
    body="{{ id: $param }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteTake" method="post" url="http://127.0.0.1:8765/delete"
    body="{{ id: $param }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />

  <!-- Audio recording test: serve_media.py runs voicetest.py, which records 10s
       with the chosen mic and recorder and adds a voice_tests row. -->
  <DataSource id="devices" url="http://127.0.0.1:8765/devices" />
  <DataSource id="voiceTests" url="/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT * FROM voice_tests ORDER BY created_at DESC', params: [] }}" />
  <APICall id="voiceTest" method="post" url="http://127.0.0.1:8765/voicetest"
    body="{$param}"
    onSuccess="voiceTests.refetch()"
    errorNotificationMessage="{$error.message}" />

  <AppHeader>
    <HStack verticalAlignment="center" width="100%">
      <H3>Bram Studio</H3>
      <SpaceFiller />
      <!-- XMLUI trace viewer. The studio carries its own xs-diff.html and the
           xmlui-parser.es.js it imports (vendor/), as it carries its own engine;
           config.json's appGlobals.xsVerbose turns capture on. -->
      <Inspector src="/vendor/xs-diff.html" tooltip="Inspector: XMLUI trace" />
    </HStack>
  </AppHeader>
  <NavPanel>
    <property name="logoTemplate">
      <Fragment/>
    </property>
    <property name="footerTemplate">
      <Fragment/>
    </property>
    <NavLink label="Takes" to="/" />
    <NavLink label="Audio" to="/bench" />
  </NavPanel>
  <Pages fallbackPath="/">
    <Page url="/">
      <HStack verticalAlignment="center">
        <H2>Sources</H2>
        <Select id="sourceChoice" data="{sources}" valueField="name" labelField="name"
          placeholder="Choose a source"
          width="260px" />
        <!-- Record shows the source player (paused at 0:00, logged as the start
             row) and starts OFF the air (a recpause right after it), so the time
             spent getting ready is cut and never rendered; Start recording goes on
             the air. Every play/pause/seeked/ended is logged until Stop. -->
        <Button label="Record" when="{!capturing}"
          enabled="{!!sourceChoice.value &amp;&amp; !startRecording.inProgress &amp;&amp; !(recStatus.value &amp;&amp; recStatus.value.phase)}"
          onClick="
            playing = '';
            recPaused = true;
            onAirYet = false;
            recEvents = [{ event: 'start', currentTime: 0, playing: false, wallMs: Date.now() }, { event: 'recpause', wallMs: Date.now() }];
            capturing = true;
            try {
              startRecording.execute({ source: sourceChoice.value });
            } catch (e) {
              capturing = false;
            }
          " />
        <!-- Off the air: everything between Pause and Resume is cut from the
             take's picture and voice (render.py); the player is yours to set
             up the next spot meanwhile. -->
        <!-- Pauses the recording, not the video (the player's own controls do
             that); "Pause" alone was mistaken for the video's pause. -->
        <Button label="{recPaused ? (onAirYet ? 'Resume recording' : 'Start recording') : 'Pause recording'}"
          variant="{onAirYet ? 'outlined' : 'solid'}" when="{capturing}"
          enabled="{!!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          onClick="
            if (recPaused) {
              recEvents = [...recEvents, { event: 'recresume', wallMs: Date.now() }];
              recPaused = false;
              onAirYet = true;
            } else {
              recEvents = [...recEvents, { event: 'recpause', wallMs: Date.now() }];
              recPaused = true;
              sourcePlayer.pause();
            }
          " />
        <Button label="Restart" variant="outlined" when="{capturing}"
          enabled="{!restartRecording.inProgress &amp;&amp; !!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          tooltip="Discard this take and start again from 0:00"
          onClick="
            sourcePlayer.pause();
            sourcePlayer.seek(0);
            restartRecording.execute({ source: sourceChoice.value });
            recPaused = true;
            onAirYet = false;
            recEvents = [{ event: 'start', currentTime: 0, playing: false, wallMs: Date.now() }, { event: 'recpause', wallMs: Date.now() }];
          " />
        <Button label="Stop" themeColor="attention" when="{capturing}"
          enabled="{!stopRecording.inProgress &amp;&amp; !!recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}"
          onClick="
            const playerEvents = recEvents.filter(e => ['play', 'pause', 'seeked', 'ended'].includes(e.event)).length;
            const inkEvents = recEvents.filter(e => e.event === 'stroke' || e.event === 'shape' || e.event === 'pointer').length;
            const diag = { duration: sourcePlayer.duration, paused: sourcePlayer.paused,
                           currentTime: sourcePlayer.getCurrentTime(), playerEvents, inkEvents };
            if (!onAirYet) {
              toast('Nothing was recorded: you never clicked Start recording.');
            } else if (playerEvents === 0 &amp;&amp; inkEvents === 0) {
              toast('No player activity in this take, so the picture is a still of 0:00.');
            }
            stopRecording.execute({ events: recEvents, diag });
            capturing = false;
            recPaused = false;
            recEvents = [];
          " />
        <Button label="Refresh" variant="outlined" size="sm" onClick="takes.refetch()" />
        <Button label="Export" variant="outlined" size="sm"
          tooltip="Join all takes, in list order, into one video"
          enabled="{!exportTakes.inProgress &amp;&amp; !capturing &amp;&amp; !!takes.value &amp;&amp; takes.value.length > 0}"
          onClick="exportTakes.execute()" />
      </HStack>
      <HStack verticalAlignment="center" when="{exportTakes.inProgress}">
        <Spinner />
        <Text value="Exporting takes…" />
      </HStack>
      <HStack verticalAlignment="center" when="{!exportTakes.inProgress &amp;&amp; exportTakes.lastResult}">
        <Text value="Exported {exportTakes.lastResult.takes} takes, {exportTakes.lastResult.seconds}s:" />
        <Link to="{exportTakes.lastResult.url}" target="_blank" label="{exportTakes.lastResult.file}" />
      </HStack>
      <!-- A take this page didn't start (it was reloaded mid-take, or another
           tab started it): it has no event log to render, so offer Discard. -->
      <HStack verticalAlignment="center"
        when="{!capturing &amp;&amp; recStatus.value &amp;&amp; recStatus.value.phase === 'recording'}">
        <Text value="A recording is in progress from another page or before a reload." />
        <Button label="Discard" variant="outlined" themeColor="attention"
          enabled="{!cancelRecording.inProgress}" onClick="cancelRecording.execute()" />
      </HStack>
      <HStack verticalAlignment="center" when="{recStatus.value &amp;&amp; recStatus.value.phase}">
        <Spinner />
        <Text value="{recPaused ? (onAirYet ? 'Recording paused: nothing is recorded until you click Resume recording' : 'Ready: set up the video, then click Start recording') : recStatus.value.label}" />
      </HStack>
      <!-- The source movie you narrate over. MediaPlayer is the experimental
           component from xmlui-org/xmlui#3913 (vendor/); its events are the
           take's picture path (render.py's events input). -->
      <!-- One player at a time: the source player exists only while recording
           (Record clears any loaded take; Stop removes it). -->
      <VStack when="{capturing}">
        <!-- Ink over the source (xmlui-org/xmlui#3919): hold Command and drag to
             draw; without it, clicks reach the player. Strokes and the pointer
             path go into the take's event log, in 0-1 picture coordinates. -->
        <!-- Drawing tools (xmlui-org/xmlui#3919 build 3): the selected one is solid. Point draws an arrow (pointerShape). -->
        <HStack verticalAlignment="center">
          <Items data="{[['line', 'Line'], ['arrow', 'Arrow'], ['rect', 'Rect'], ['ellipse', 'Oval'], ['pointer', 'Point'], ['freehand', 'Freehand']]}">
            <Button label="{$item[1]}" size="xs"
              variant="{inkTool === $item[0] ? 'solid' : 'outlined'}"
              tooltip="Hold Command (⌘) and drag to draw. Add Shift (⇧) for a square, circle or 45° line; add Option (⌥) to draw from the center."
              onClick="inkTool = $item[0]" />
          </Items>
        </HStack>
        <PointerLayer id="ink" contentAspect="{sourceAspect}" enabled="{capturing}" tool="{inkTool}" pointerShape="arrow"
          onShapeEnd="(e) => { if (capturing) recEvents = [...recEvents, { event: 'shape', tool: e.tool, x1: e.x1, y1: e.y1, x2: e.x2, y2: e.y2, color: e.color, width: e.width, pointerShape: e.pointerShape, wallMs: e.time, durationMs: e.duration }] }"
          onStrokeEnd="(e) => { if (capturing) recEvents = [...recEvents, { event: 'stroke', points: e.points, color: e.color, width: e.width, wallMs: e.time }] }"
          onPointerMove="(e) => { if (capturing) recEvents = [...recEvents, { event: 'pointer', x: e.x, y: e.y, buttons: e.buttons, wallMs: e.time }] }">
        <MediaPlayer id="sourcePlayer" maxHeight="65vh"
          src="{'http://127.0.0.1:8765/sources/' + encodeURIComponent(sourceChoice.value)}"
          onLoadedMetadata="(e) => sourceAspect = e.videoWidth / e.videoHeight"
          onPlay="(e) => { if (capturing) recEvents = [...recEvents, { event: 'play', currentTime: e.currentTime, wallMs: Date.now() }] }"
          onPause="(e) => { if (capturing) recEvents = [...recEvents, { event: 'pause', currentTime: e.currentTime, wallMs: Date.now() }] }"
          onSeeked="(e) => { if (capturing) recEvents = [...recEvents, { event: 'seeked', currentTime: e.currentTime, wallMs: Date.now() }] }"
          onEnded="(e) => { if (capturing) recEvents = [...recEvents, { event: 'ended', currentTime: e.currentTime, wallMs: Date.now() }] }" />
        </PointerLayer>
      </VStack>
      <!-- The take loaded in the take player (its URL); hidden while recording. -->
      <!-- calloutHandles: the edited callout's eight resize handles (anchors
           named by compass point), centered on its box's corners and edge
           midpoints, square on screen (height scaled by the picture's aspect);
           hidden while the callout is being moved. -->
      <!-- editSprite: the DataSource's sprite, or the last one while the next
           loads. calloutKey: the editor's state as one string; Update is dimmed
           while it equals savedKey (the callout as last loaded or saved). -->
      <VStack when="{playing &amp;&amp; !capturing}"
        var.editSprite="{calloutSprite.value || lastSprite}"
        var.calloutKey="{calloutBox ? [calloutText.value, calloutBox.x1, calloutBox.y1, calloutBox.x2, calloutBox.y2, calloutIn, calloutOut, calloutTail.value].join('|') : ''}"
        var.calloutHandles="{calloutBox &amp;&amp; editSprite &amp;&amp; takeAspect &amp;&amp; !dragPos ? [['nw', calloutBox.x1, calloutBox.y1], ['n', (calloutBox.x1 + calloutBox.x2) / 2, calloutBox.y1], ['ne', calloutBox.x2, calloutBox.y1], ['e', calloutBox.x2, (calloutBox.y1 + calloutBox.y2) / 2], ['se', calloutBox.x2, calloutBox.y2], ['s', (calloutBox.x1 + calloutBox.x2) / 2, calloutBox.y2], ['sw', calloutBox.x1, calloutBox.y2], ['w', calloutBox.x1, (calloutBox.y1 + calloutBox.y2) / 2]].map((h) => ({ id: h[0], url: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 10%22%3E%3Crect x=%221%22 y=%221%22 width=%228%22 height=%228%22 fill=%22white%22 stroke=%22%23222%22 stroke-width=%221.5%22/%3E%3C/svg%3E', x: h[1] - 0.009, y: h[2] - 0.009 * takeAspect, width: 0.018, height: 0.018 * takeAspect })) : []}">
        <HStack horizontalAlignment="end">
          <Button icon="close" variant="ghost" aria-label="Close player"
            tooltip="Close the player" onClick="playing = ''" />
        </HStack>
        <!-- Callouts (overlay.py), edited directly on the video: the player
             shows the take's clean copy (no burned-in text, /clean/<file>) and
             PointerLayer's anchors (xmlui-org/xmlui#3922) draw each callout on
             it as a sprite from the server, made by the same code Apply uses.
             Saved callouts show between their in and out points; the one
             being edited always shows, and dragging it moves it (the layer
             reports the drag; the page moves the anchor), and dragging one of
             its eight handles resizes it (the text refits as you drag).
             Command-drag places a new callout's box. -->
        <DataSource id="calloutSprite" url="http://127.0.0.1:8765/callouts/sprite" method="POST"
          when="{!!calloutBox &amp;&amp; !!editTake}"
          body="{{ take_id: editTake, text: calloutText.value || 'Callout text', x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, tail: calloutTail.value, frame: true }}"
          onLoaded="(d) => { lastSprite = d; dragPos = null; }" />
        <!-- applyState.dirty: the saved callouts differ from what was last burned
             in (the SQL is overlay.py's APPLIED_SQL, which fills
             takes.overlay_applied at Apply); Apply is dimmed otherwise. -->
        <DataSource id="applyState" url="/query" method="POST" dataType="sql" when="{!!editTake}"
          body="{{ sql: 'SELECT (SELECT group_concat(id || char(58) || text || char(58) || x1 || char(58) || y1 || char(58) || x2 || char(58) || y2 || char(58) || t_in || char(58) || t_out || char(58) || ifnull(tail, char(45)), char(124)) FROM (SELECT * FROM overlays WHERE take_id = ? ORDER BY id)) IS NOT overlay_applied AS dirty FROM takes WHERE id = ?', params: [editTake, editTake] }}" />
        <DataSource id="savedSprites" url="http://127.0.0.1:8765/callouts/sprites" method="POST"
          when="{!!editTake}" body="{{ take_id: editTake }}" />
        <!-- lastSprite: the edited callout's latest sprite, kept while the next
             one loads, so its anchor and handles never vanish mid-drag (a
             dragged anchor that unmounts leaves PointerLayer's drag stuck).
             Command-drag ink is invisible once there's a box: it does nothing
             then. -->
        <PointerLayer id="calloutLayer" tool="rect" contentAspect="{takeAspect}" anchorDrag="true"
          color="{calloutBox ? 'transparent' : '#ff3b30'}"
          anchors="{(savedSprites.value || []).filter((a) => a.id !== editCallout &amp;&amp; playerTime >= a.t_in &amp;&amp; playerTime &lt;= a.t_out).concat(calloutBox &amp;&amp; editSprite ? [{ id: 'edit', url: editSprite.url, x: dragPos ? dragPos.x : editSprite.x, y: dragPos ? dragPos.y : editSprite.y, width: editSprite.width, height: editSprite.height }] : []).concat(calloutHandles)}"
          onAnchorDragStart="(e) => { dragFrom = calloutBox; }"
          onAnchorDragMove="(e) => {
            const edges = { nw: [1, 1, 0, 0], n: [0, 1, 0, 0], ne: [0, 1, 1, 0], e: [0, 0, 1, 0], se: [0, 0, 1, 1], s: [0, 0, 0, 1], sw: [1, 0, 0, 1], w: [1, 0, 0, 0] }[e.id];
            if (e.id === 'edit') {
              dragPos = { x: e.x, y: e.y };
            } else if (edges &amp;&amp; dragFrom) {
              const b = dragFrom;
              const x1 = Math.max(0, Math.min(b.x1 + edges[0] * e.dx, b.x2 - 0.04));
              const y1 = Math.max(0, Math.min(b.y1 + edges[1] * e.dy, b.y2 - 0.03));
              const x2 = Math.min(1, Math.max(b.x2 + edges[2] * e.dx, b.x1 + 0.04));
              const y2 = Math.min(1, Math.max(b.y2 + edges[3] * e.dy, b.y1 + 0.03));
              calloutBox = { x1: x1, y1: y1, x2: x2, y2: y2 };
            }
          }"
          onAnchorDragEnd="(e) => {
            if (e.id === 'edit') {
              const w = calloutBox.x2 - calloutBox.x1;
              const h = calloutBox.y2 - calloutBox.y1;
              const nx = Math.min(Math.max(calloutBox.x1 + e.dx, 0), 1 - w);
              const ny = Math.min(Math.max(calloutBox.y1 + e.dy, 0), 1 - h);
              calloutBox = { x1: nx, y1: ny, x2: nx + w, y2: ny + h };
            }
          }"
          onShapeEnd="(e) => {
            if (!calloutBox) {
              calloutBox = { x1: e.x1, y1: e.y1, x2: e.x2, y2: e.y2 };
              calloutIn = takePlayer.getCurrentTime();
              calloutOut = calloutIn + 3;
            }
          }">
          <MediaPlayer id="takePlayer" autoPlay="true" maxHeight="65vh"
            src="{editFile ? 'http://127.0.0.1:8765/clean/' + encodeURIComponent(editFile) : playing}"
            onLoadedMetadata="(e) => takeAspect = e.videoWidth / e.videoHeight"
            onTimeUpdate="(e) => playerTime = e.currentTime"
            onSeeked="(e) => playerTime = e.currentTime" />
          <property name="anchorTemplate">
            <Image src="{$item.url}" width="100%" />
          </property>
        </PointerLayer>
        <!-- Which callout the editor holds, and what's missing. -->
        <Text value="{(editCallout ? 'Editing a saved callout: drag it to move it, drag a handle to resize it; Update keeps the changes, Done when finished' : 'New callout: once placed, drag it to move it, drag a handle to resize it') + (calloutBox ? '' : ' · Hold Command and drag a box on the picture')}" />
        <HStack verticalAlignment="center">
          <TextBox id="calloutText" width="*"
            placeholder="{calloutBox ? 'Callout text' : 'Hold Command and drag a box on the picture, then type the callout'}" />
          <Button label="{'In ' + calloutIn.toFixed(1) + 's'}" size="xs" variant="outlined"
            tooltip="Set the in point to the playhead" onClick="calloutIn = takePlayer.getCurrentTime()" />
          <Button label="{'Out ' + calloutOut.toFixed(1) + 's'}" size="xs" variant="outlined"
            tooltip="Set the out point to the playhead" onClick="calloutOut = takePlayer.getCurrentTime()" />
          <!-- Tail: a speech-bubble pointer off the box at a compass point. -->
          <Select id="calloutTail" initialValue="none" width="130px">
            <Option value="none" label="No tail" />
            <Option value="nw" label="Tail ↖ nw" />
            <Option value="n" label="Tail ↑ n" />
            <Option value="ne" label="Tail ↗ ne" />
            <Option value="e" label="Tail → e" />
            <Option value="se" label="Tail ↘ se" />
            <Option value="s" label="Tail ↓ s" />
            <Option value="sw" label="Tail ↙ sw" />
            <Option value="w" label="Tail ← w" />
          </Select>
          <!-- Add saves a new callout and clears the editor; Update saves the
               one being edited and keeps it loaded; Done stops editing. -->
          <Button label="{editCallout ? 'Update' : 'Add'}" size="xs"
            enabled="{!!calloutBox &amp;&amp; !!calloutText.value &amp;&amp; calloutOut > calloutIn &amp;&amp; (!editCallout || calloutKey !== savedKey)}"
            onClick="
              if (editCallout) {
                updateCallout.execute({ take_id: editTake, id: editCallout, text: calloutText.value, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: calloutOut, tail: calloutTail.value });
                savedKey = calloutKey;
              } else {
                addCallout.execute({ take_id: editTake, text: calloutText.value, x1: calloutBox.x1, y1: calloutBox.y1, x2: calloutBox.x2, y2: calloutBox.y2, t_in: calloutIn, t_out: calloutOut, tail: calloutTail.value });
              calloutText.setValue('');
              calloutBox = null;
              editCallout = null;
              calloutIn = 0;
              calloutOut = 3;
              calloutTail.setValue('none');
              lastSprite = null;
              }
              callouts.refetch();
              savedSprites.refetch();
              applyState.refetch();
            " />
          <Button label="{editCallout ? 'Done' : 'Cancel'}" size="xs" variant="ghost" when="{editCallout || calloutBox}"
            tooltip="{editCallout ? 'Stop editing this callout (unsaved changes are dropped)' : 'Discard this new callout'}"
            onClick="
              calloutText.setValue('');
              calloutBox = null;
              editCallout = null;
              calloutIn = 0;
              calloutOut = 3;
              calloutTail.setValue('none');
              lastSprite = null;
            " />
          <Spinner when="{renderOverlay.inProgress}" />
          <Button label="Apply" size="xs"
            enabled="{!renderOverlay.inProgress &amp;&amp; !!applyState.value &amp;&amp; !!applyState.value[0] &amp;&amp; !!applyState.value[0].dirty}"
            tooltip="Burn this take's saved callouts into its video file, for export (clears the editor; the player shows them live either way)"
            onClick="
              calloutText.setValue('');
              calloutBox = null;
              editCallout = null;
              calloutIn = 0;
              calloutOut = 3;
              calloutTail.setValue('none');
              lastSprite = null;
              renderOverlay.execute(editTake);
              takes.refetch();
              applyState.refetch();
            " />
        </HStack>
        <Items data="{callouts}">
          <HStack verticalAlignment="center">
            <Text value="{$item.text}" width="*" />
            <Text value="{$item.t_in.toFixed(1) + '–' + $item.t_out.toFixed(1) + 's'}" />
            <Button label="Go to" size="xs" variant="ghost" onClick="takePlayer.seek($item.t_in)" />
            <Button label="Edit" size="xs" variant="ghost" tooltip="Load this callout into the editor"
              onClick="
                editCallout = $item.id;
                calloutText.setValue($item.text);
                calloutBox = { x1: $item.x1, y1: $item.y1, x2: $item.x2, y2: $item.y2 };
                calloutIn = $item.t_in;
                calloutOut = $item.t_out;
                calloutTail.setValue($item.tail || 'none');
                savedKey = [$item.text, $item.x1, $item.y1, $item.x2, $item.y2, $item.t_in, $item.t_out, $item.tail || 'none'].join('|');
                lastSprite = null;
                takePlayer.seek($item.t_in);
              " />
            <Button icon="trash" variant="ghost" aria-label="Delete callout" tooltip="Delete this callout"
              onClick="
                deleteCallout.execute($item.id);
                if ($item.id === editCallout) {
                  calloutText.setValue('');
                  calloutBox = null;
                  editCallout = null;
                  calloutIn = 0;
                  calloutOut = 3;
                  calloutTail.setValue('none');
                  lastSprite = null;
                }
                callouts.refetch();
                savedSprites.refetch();
              applyState.refetch();
              " />
          </HStack>
        </Items>
      </VStack>
      <!-- Takes as a drag-reorderable list (DndItems, the xmlui-dnd-list extension
           Bram's queue uses): only the grip drags, so the row's buttons stay live.
           The order is saved to takes.position via POST /reorder. New takes go to
           the top (register.py). -->
      <DndItems data="{takes}" dragHandle="true"
        onReorder="(newOrder) => {
          reorderTakes.execute({ ids: newOrder.map(t => t.id) });
          takes.refetch();
        }">
        <HStack width="100%" verticalAlignment="center" paddingVertical="$space-2">
          <!-- Empty take (no player events): record.sh's warning, with what the
               player reported at Stop. -->
          <Icon name="warning" when="{$item.warning}" tooltip="{$item.warning}" />
          <Text value="{$item.name}" overflowMode="flow" width="*" />
          <Text value="{$item.recorded}" width="110px" />
          <Text value="{$item.duration_s + 's'}" width="70px" />
          <Text value="{$item.source}" width="160px" />
          <!-- Play/pause toggle: one slot, icon and tooltip name the next action. -->
          <Button variant="ghost" enabled="{!capturing}"
            icon="{playing === $item.url &amp;&amp; !takePlayer.paused ? 'pause' : 'play'}"
            tooltip="{playing === $item.url &amp;&amp; !takePlayer.paused ? 'Pause' : 'Play'}"
            aria-label="Play or pause take"
            onClick="
              if (playing === $item.url) {
                takePlayer.paused ? takePlayer.play() : takePlayer.pause();
              } else {
                playing = $item.url;
                editTake = $item.id;
                editFile = $item.file;
              }
            " />
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete take" tooltip="Delete this take (moves the MP4 to media/.trash)"
            onClick="
              if (playing === $item.url) playing = '';
              deleteTake.execute($item.id);
              takes.refetch();
            " />
        </HStack>
      </DndItems>
    </Page>
    <Page url="/bench">
      <H2>Audio recording test</H2>
      <HStack verticalAlignment="center">
        <Select id="mic" data="{devices}" valueField="name" labelField="name"
          initialValue="MacBook Air Microphone" width="260px" />
        <Select id="recorderChoice" initialValue="ffmpeg-raw" width="300px">
          <Option value="ffmpeg-raw" label="ffmpeg raw (today's session.sh)" />
          <Option value="ffmpeg-async" label="ffmpeg + gap fill" />
          <Option value="native" label="native macOS (no ffmpeg)" />
        </Select>
        <Button label="Test (10s)" enabled="{!voiceTest.inProgress}"
          onClick="
            toast('Recording 10s: read the sentence below now');
            voiceTest.execute({ mic: mic.value, recorder: recorderChoice.value });
          " />
      </HStack>
      <Text>
        Read aloud: "She sells sea shells by the seashore, and the quick brown fox
        jumps past six sharp scissors."
      </Text>
      <Table data="{voiceTests}">
        <!-- Never show "No data available" (it flashes while data loads). -->
        <property name="noDataTemplate">
          <Fragment/>
        </property>
        <Column header="Tested" bindTo="created_at" width="190px" />
        <Column header="Mic" bindTo="mic" />
        <Column header="Recorder" bindTo="recorder" />
        <Column header="Expected s" bindTo="expected_s" />
        <Column header="Captured s" bindTo="captured_s" />
        <Column header="Short %" bindTo="short_pct" />
        <Column header="Clicks" bindTo="clicks" />
        <Column header="Peak dB" bindTo="peak_db" />
        <Column header="RMS dB" bindTo="rms_db" />
        <Column header="Play">
          <HStack>
            <Link to="{$item.raw_url}" target="_blank" label="raw" />
            <Link to="{$item.leveled_url}" target="_blank" label="leveled" />
          </HStack>
        </Column>
      </Table>

      <!-- Audio playback test: MediaPlayer's kind="audio" (xmlui-org/xmlui#3913)
           on any take or source. An audio element plays an MP4's audio track,
           so no separate audio files are needed. -->
      <VStack var.audioLog="{[]}" var.audioDuration="">
        <H2>Audio playback test</H2>
        <HStack verticalAlignment="center">
          <Select id="audioChoice" placeholder="Play from…" width="480px"
            data="{[
              ...(takes.value || []).map(t => ({ label: 'Take: ' + t.name.slice(0, 60), value: t.url })),
              ...(sources.value || []).map(x => ({ label: 'Source: ' + x.name, value: 'http://127.0.0.1:8765/sources/' + encodeURIComponent(x.name) }))
            ]}"
            onDidChange="audioLog = []; audioDuration = ''" />
          <Button label="Clear log" variant="outlined" onClick="audioLog = []" />
        </HStack>
        <MediaPlayer kind="audio" when="{audioChoice.value}" src="{audioChoice.value}"
          onLoadedMetadata="(e) => audioDuration = e.duration.toFixed(2) + ' s'"
          onPlay="(e) => audioLog = [...audioLog, 'play at ' + e.currentTime.toFixed(2) + ' s']"
          onPause="(e) => audioLog = [...audioLog, 'pause at ' + e.currentTime.toFixed(2) + ' s']"
          onSeeked="(e) => audioLog = [...audioLog, 'seeked at ' + e.currentTime.toFixed(2) + ' s']"
          onEnded="(e) => audioLog = [...audioLog, 'ended at ' + e.currentTime.toFixed(2) + ' s']" />
        <Text when="{audioChoice.value}" value="Duration: {audioDuration || '(loading)'}" />
        <Items data="{audioLog}">
          <Text value="{$item}" />
        </Items>
      </VStack>
    </Page>
  </Pages>
</App>
