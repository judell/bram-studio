<App name="Bram Studio" layout="vertical-sticky" var.playing="" var.scene="{null}" var.sourceAspect="{undefined}" var.savedKey="" var.dismissedUndo="" var.noteBuffer="" var.dictating="" var.noteEdited="{false}" var.audition="{null}" var.capClip="{[0, 1]}" var.capSeed="{[0, 1]}" var.srcDur="{0}" var.clipBusy="{false}" var.renamingTake="{null}" var.renameDraft="" var.opening="" var.copyingProject="" var.editingSafe="" var.safeDrafts="{{}}" var.renamingProject="" var.projectDraft="">
  <!-- Bram's own layout (~/bram/app/tools/Main.xmlui): header band over the
       main area, nav always visible. themes/studio.json keeps the nav from
       collapsing into a drawer on a narrow window, as Bram's theme does. -->
  <!-- Takes live in the open project's studio.db (see schema.sql and
       studio_paths.py). serve_media.py answers the project's queries
       read-only at its own /query, since it is what knows which project is
       open. The repo's studio.db holds the shared Audio bench (voiceTests
       below), read at serve_media.py's /query/shared, so it works however
       the page is served, not only inside Bram. Each take's MP4 is served by
       serve_media.py too, which Bram's loopback can't do yet (no video
       content types, no byte ranges). -->
  <DataSource id="takes" url="http://127.0.0.1:8765/query" method="POST" dataType="sql"
    body="{{ sql: 'SELECT id, name, created_at, substr(created_at, 6) AS recorded, duration_s, url, file, source, src_end, warning FROM takes ORDER BY position, created_at DESC', params: [] }}"
    pollIntervalInSeconds="60" />
  <!-- A scene appears here when Make scene's clip (/takes/clip) registers. -->
  <DataSource id="sources" url="http://127.0.0.1:8765/sources" pollIntervalInSeconds="60" />
  <!-- The project folders and which one is open ({open, name, projects};
       list_projects() in serve_media.py), for the Projects page and the name
       at the top of the nav panel. -->
  <DataSource id="projects" url="http://127.0.0.1:8765/projects" />
  <!-- Push instead of polling: serve_media.py's GET /events says which list
       changed ({changed: 'takes'|'sources'|'exports'|'projects'})
       and only that one is refetched, plus the Projects page's list, which
       'takes', 'exports' and 'projects' (a project folder changed) all
       affect. Two fetches of that list close together are harmless: the
       later one wins and reads the newer state. 'takes' (any change to
       studio.db) otherwise refetches only the scenes list: the page's own
       edits refresh the lists they touch
       (history, narrations, pauses, items) from their handlers and leave the
       scenes list to this, so no list is fetched twice at once (XMLUI cancels
       a list's fetch in flight when another starts: two rounds 10 ms apart
       after every edit, 2026-10-03, likely what left a stale narrations
       list). EventSource is experimental in XMLUI and has no docs
       page yet (source: xmlui/src/components/EventSource/EventSource.tsx), so
       the polls above stay as a 60 s fallback. -->
  <!-- onOpen (load and every reconnect): the bridge (studio-dictation.js)
       tells the server whether this page is dictating, and into which row,
       so a reload can't leave the server holding the mic for a dictation
       that no longer exists. -->
  <!-- A reconnect also follows the server starting over on another project
       (Open or Create on the Projects page), so onOpen refetches every list;
       when this page asked for the switch (`opening`), it then shows Takes. -->
  <EventSource url="http://127.0.0.1:8765/events"
    onOpen="() => {
      dictating = window.studioDictationSync();
      projects.refetch(); takes.refetch(); exports.refetch();
      if (playing) editor.refresh();
      if (opening) { opening = ''; navigate('/'); }
    }"
    onMessage="(m) => {
      if (m.changed === 'takes') { takes.refetch(); projects.refetch(); }
      else if (m.changed === 'sources') sources.refetch();
      else if (m.changed === 'exports') { exports.refetch(); projects.refetch(); }
      else if (m.changed === 'projects') projects.refetch();
    }" />
  <!-- One click, no warning: serve_media.py moves the MP4 to media/.trash/. -->
  <!-- The table is refreshed in the trash button's click, after execute():
       this APICall's onSuccess refetch didn't take effect (rows lingered until
       the 5s poll, and clicking one gave "no take with id N"). invalidates="{[]}"
       stops the default refresh of every DataSource (including /devices, which
       runs ffmpeg) after each delete; only the takes table needs refetching. -->
  <!-- The finishing workflow's two lists ({exports, leveled}, each newest
       first; see list_exports() in serve_media.py), deleting one (moved to
       media/.trash/), and leveling an export with level_edit.py. No
       onSuccess on either call (xmlui-org/xmlui#3924): the clicks refetch. -->
  <DataSource id="exports" url="http://127.0.0.1:8765/exports" />
  <APICall id="deleteExport" method="post" url="http://127.0.0.1:8765/exports/delete"
    body="{{ name: $param.name, where: $param.where }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="levelExport" method="post" url="http://127.0.0.1:8765/exports/level"
    body="{{ name: $param.name, where: $param.where }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- A row's note, saved when its field loses focus: the buffered-edit shape
       from https://www.xmlui.org/docs/howto/buffer-a-reactive-edit (noteBuffer),
       refetching in the handler instead of onSuccess (xmlui-org/xmlui#3924). -->
  <APICall id="saveExportNote" method="post" url="http://127.0.0.1:8765/exports/note"
    body="{{ name: $param.name, where: $param.where, note: $param.note }}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Every field that takes dictation has the same frame: 🎤 before it (⏹
       while dictating) and ✕ after it to clear it. Keep that when adding
       dictation anywhere else.
       Export-row notes: typed, or dictated with the row's mic. Dictation is
       Bram's script (/__shell/dictation.js, judell/bram#417) behind the
       bridge in studio-dictation.js, called through window as Bram's own
       pane markup does (judell/bram
       app/tools/components/IsolatedDraftEditor.xmlui). The mic starts it: the
       bridge claims the mic from serve_media.py, captures in the browser and
       writes the text into the note as you speak; what you type meanwhile is
       kept. The mic again, or Enter in the note (its Form submits,
       https://www.xmlui.org/docs/howto/submit-a-form-from-a-custom-button),
       stops it, and the page saves the field's text as the note.
       The bridge can't read the field (a component passed to page script is
       a snapshot), so the field's onDidChange reports its text; the bridge
       writes with setValue
       (https://www.xmlui.org/docs/reference/components/TextArea). -->
  <script>
    function noteKey(item) { return item.where + '/' + item.name; }
    function commitNote(item) {
      const note = noteBuffer.trim();
      if (note === (item.note || '')) return;
      // Only an edit deletes: leaving a field with an empty buffer you didn't
      // type into never removes its note (dictation-robust).
      if (note === '') { if (!noteEdited) return; }
      saveExportNote.execute({ name: item.name, where: item.where, note });
      exports.refetch();
    }
    // The ✕ after a dictation field: clearing is the edit itself, so it saves
    // the empty note directly, without the noteEdited guard.
    function clearNote(item) {
      noteBuffer = '';
      saveExportNote.execute({ name: item.name, where: item.where, note: '' });
      exports.refetch();
    }
    function startDictation(item, box) {
      try {
        window.studioDictationStart(box, noteKey(item));
        dictating = noteKey(item);
        box.focus();
      } catch (e) {
        toast.error(e.message);
      }
    }
    function stopDictation(item) {
      try {
        // The field's final text, dictated and typed; null if nothing ran.
        const note = window.studioDictationStop();
        if (typeof note === 'string') {
          noteBuffer = note;
          saveExportNote.execute({ name: item.name, where: item.where, note: note.trim() });
        }
      } catch (e) {
        toast.error(e.message);
      }
      exports.refetch();
      dictating = '';
    }
    function submitNote(item) {
      if (dictating === noteKey(item)) stopDictation(item);
      else commitNote(item);
    }
    // An audition plays a bounded stretch of the take and stops, as judell/av
    // does (https://github.com/judell/av, av.js playIntro/playOutro/playClip):
    // seek to start, set where to stop, play. Its Timer (after the Tabs)
    // pauses once the playhead reaches stop. A handle moved, a tab switched,
    // an edit or another take ends an audition, as does pausing the player. Each stop is logged (/audition/log) with where
    // the playhead actually stopped, to measure how close the 40 ms Timer
    // gets. invalidates: [] keeps the log call from refetching every list.
    // (Not from / to: the markup's script parser rejects from as a name.)
    // Named ...SourceAudition, not playAudition etc.: SceneEditor has its own
    // playAudition, yieldAudition and endAudition, and inside its VStack with
    // a var. these (Main's) won and drove the wrong player
    // (xmlui-org/xmlui#3940, part B).
    function playSourceAudition(start, stop, kind, src) {
      // The capture view's source player (the scene player's are SceneEditor's).
      const P = sourcePlayer;
      const end = sourcePlayer.duration || srcDur;
      const a = { start: Math.max(0, start), stop: Math.min(end, stop), kind, startedMs: Date.now(),
                  at: Math.max(0, start), atMs: Date.now(), src: !!src };
      // No pause before the seek: a pause cuts off a play() still starting
      // (a quick second click), which the page shows as an error.
      P.seek(a.start);
      audition = a;
      P.play();
    }
    // The capture view's nudges: move one end of the clip by delta seconds,
    // re-place the handles by re-seeding capSeed (which fires no slider
    // events), and show that frame, as on the Cut tab. The clip stays within
    // the source and at least 0.52 s long (a take must be 0.5 s).
    // setCap: one end set to t (a typed time, TimeEdge's set), by the same
    // rules.
    function nudgeCap(which, delta) {
      setCap(which, (which === 'start' ? capClip[0] : capClip[1]) + delta);
    }
    function setCap(which, t) {
      const end = sourcePlayer.duration || srcDur;
      const c = capClip;
      const s = which === 'start' ? Math.max(0, Math.min(Math.round(t * 100) / 100, c[1] - 0.52)) : c[0];
      const e = which === 'end' ? Math.min(end, Math.max(Math.round(t * 100) / 100, c[0] + 0.52)) : c[1];
      audition = null;
      if (s !== c[0] || e !== c[1]) {
        capSeed = [s, e];
        capClip = capSeed;
      }
      sourcePlayer.seek(which === 'start' ? s : e);
    }
    // Where the next scene from a source starts: the end of the most recent
    // scene made from it (a clip, file *-clip*), or 0:00 with none.
    function lastSceneEnd(source) {
      const made = (takes.value || []).filter((t) => t.source === source && (t.file || '').indexOf('-clip') !== -1 && t.src_end);
      if (!made.length) return 0;
      return Number(made.reduce((a, b) => (b.id > a.id ? b : a)).src_end) || 0;
    }
    // Set the next scene to start at startAt and run 10 s (or to the end of
    // the source), and show that frame. (Not "from": the markup's script
    // parser rejects it as a name.)
    function nextClipFrom(startAt) {
      const end = sourcePlayer.duration || srcDur || 0;
      const s = Math.max(0, Math.min(startAt, Math.max(0, end - 0.52)));
      capSeed = [s, Math.min(end || s + 10, s + 10)];
      capClip = capSeed;
      sourcePlayer.seek(s);
    }
    // Export: join all scenes into one video. The server first burns in the
    // items of any scene whose items changed since last burned, so what each scene's
    // list shows is what goes out.
    function startExport() {
      navigate('/exports');
      exportTakes.execute();
      exports.refetch();
    }
    // Open a scene in the editor (its name's link in the scenes list), paused
    // at its start: nothing plays by itself. SceneEditor starts its
    // per-scene state over.
    function openScene(item) {
      if (playing === item.url) return;
      scene = item;
      playing = item.url;
    }
    // m:ss.ss for the capture view's times (sources run to minutes).
    function mmss(t) {
      const m = Math.floor(t / 60);
      const r = (t - m * 60).toFixed(2);
      return m + ':' + (r.length === 4 ? '0' + r : r);
    }
    // The user scrubbed during an audition: let go without pausing, so the
    // player does what they asked, and log where the playhead went.
    function yieldSourceAudition(t) {
      const a = audition;
      audition = null;
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/audition/log', method: 'post', invalidates: [],
                          body: { kind: 'yielded-to-scrub-' + a.kind, start: a.start, stop: a.stop, stoppedAt: t } });
      } catch (e) {
        // A missing log line is no reason to bother the user.
      }
    }
    function endSourceAudition() {
      const a = audition;
      const P = sourcePlayer;
      P.pause();
      audition = null;
      const stoppedAt = P.getCurrentTime();
      // A preview that asked to (the Pause tab's) puts the playhead back.
      if (a.returnTo !== undefined) P.seek(a.returnTo);
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/audition/log', method: 'post', invalidates: [],
                          body: { kind: a.kind, start: a.start, stop: a.stop, stoppedAt } });
      } catch (e) {
        // A missing log line is no reason to bother the user.
      }
    }
    // Open and New project (the Projects page). The server writes which
    // project is open and starts itself over on it, so the page doesn't
    // refetch here: the event stream drops and reconnects, and its onOpen
    // (above) refetches every list, clears `opening` and shows Takes. The
    // player closes first, since its take belongs to the project being left.
    // A refusal (a take being recorded, an export running) arrives as an
    // error (https://www.xmlui.org/docs/reference/components/APICall, "Error
    // handling in try/catch blocks"). invalidates: [] (Actions.callApi,
    // https://www.xmlui.org/docs/globals) stops the refetch of every list
    // that would otherwise follow the call and land while the server is
    // starting over, each failing with a toast.
    // A size on the Projects page, its dialogs and notices: binary units with
    // three significant figures (5.95 MiB, 23.8 MiB, 448 MiB, 1.03 GiB), "-"
    // for nothing. formatFileSizeInBytes gives one decimal at every size, so
    // four files of 5.948 MiB read 5.9 each under a total of 23.8.
    function sizeText(bytes) {
      if (!bytes) return '-';
      const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
      const i = Math.min(units.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)));
      const v = bytes / Math.pow(1024, i);
      return i === 0 ? bytes + ' B' : v.toFixed(v >= 100 ? 0 : v >= 10 ? 1 : 2) + ' ' + units[i];
    }
    // A project's line on the Projects page, after its name.
    function projectFacts(p) {
      const facts = [p.takes + (p.takes === 1 ? ' take' : ' takes'), p.seconds + ' s', sizeText(p.bytes)];
      if (p.changed) facts.push('changed ' + p.changed.substring(5));
      if (p.safekeeping.last) facts.push('copied ' + p.safekeeping.last.at.substring(5)
        + (p.safekeeping.changed_since ? ' (changed since)' : ''));
      if (p.stray.length) facts.push(p.stray.length + (p.stray.length === 1 ? ' stray item' : ' stray items'));
      return facts.join(' · ');
    }
    // Safekeeping (the Projects page): where a project's copies go, what the
    // last copy was, and making one (set_safekeeping and copy_project in
    // serve_media.py). The copy runs while you wait; copyingProject shows it.
    function safekeepingNote(s) {
      if (!s.location) return 'No safekeeping location yet.';
      if (!s.exists) return 'The location isn\'t there now: ' + s.location;
      if (!s.last) return 'Not copied yet.';
      return 'Last copied ' + s.last.at.substring(5) + ': ' + s.last.files + ' files, '
        + sizeText(s.last.bytes) + (s.changed_since ? '. The project has changed since.' : '. Unchanged since.')
        + (s.last.extra ? ' ' + s.last.extra + (s.last.extra === 1 ? ' file' : ' files')
          + ' there are no longer in the project (copies never delete).' : '');
    }
    // The location's button: Change (a location is saved, not being
    // edited), Set (the box differs from what's saved) or Cancel (it
    // doesn't). The page's state is passed in, so the expressions that call
    // these follow it.
    function safeEditing(p, editing) { return !p.safekeeping.location || editing === p.slug; }
    function safeDraft(p, drafts) {
      const d = drafts[p.slug];
      return (d === undefined ? (p.safekeeping.location || '') : d).trim();
    }
    function setSafeDraft(slug, v) {
      const d = Object.assign({}, safeDrafts);
      d[slug] = v;
      safeDrafts = d;
    }
    function safeButtonLabel(p, editing, drafts) {
      if (!safeEditing(p, editing)) return 'Change';
      return p.safekeeping.location && safeDraft(p, drafts) === p.safekeeping.location ? 'Cancel' : 'Set';
    }
    function safeButtonEnabled(p, editing, drafts) {
      return safeButtonLabel(p, editing, drafts) !== 'Set' || safeDraft(p, drafts) !== '';
    }
    function safeButton(p) {
      const label = safeButtonLabel(p, editingSafe, safeDrafts);
      if (label === 'Change') {
        setSafeDraft(p.slug, p.safekeeping.location);
        editingSafe = p.slug;
      } else if (label === 'Cancel') {
        editingSafe = '';
      } else if (setSafekeeping(p.slug, safeDraft(p, safeDrafts))) {
        editingSafe = '';
      }
    }
    // Saves a location; true once saved. A folder that isn't there yet is
    // offered to be made (the server asks for create: true before making it).
    function setSafekeeping(slug, location, create) {
      let saved = false;
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/safekeeping', method: 'post',
          body: { slug: slug, location: location, create: !!create }, invalidates: [] });
        if (r.missing) {
          const yes = confirm('Make the folder?', 'There is no folder at ' + r.location + ' yet. Make it, and send copies there?',
            'Make it', 'Cancel');
          return yes ? setSafekeeping(slug, location, true) : false;
        }
        toast.success(r.location ? 'Copies will go to ' + r.location + '.'
          : 'No safekeeping location now. Copies already made are still where they were.');
        saved = true;
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
      return saved;
    }
    // A project's Delete (the Projects page): the question asked first, and
    // the move to the Trash once the answer is yes.
    function deleteProjectQuestion(p) {
      const folder = projects.value ? projects.value.folder : 'projects';
      return 'Move ' + p.name + ' (' + p.takes + (p.takes === 1 ? ' take, ' : ' takes, ') + p.seconds + ' s, '
        + sizeText(p.bytes) + ') to the Trash? To bring it back, drag the folder ' + p.slug
        + ' from the Trash into ' + folder + ' and click Refresh.'
        + (p.safekeeping.copy_exists ? ' Its safekeeping copy in ' + p.safekeeping.copy_path + ' stays where it is.' : '');
    }
    function deleteProject(p) {
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/delete', method: 'post',
          body: { slug: p.slug }, invalidates: [] });
        toast.success(p.name + ' is in the Trash, as ' + r.as + '.');
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
    }
    function clearSafekeepingQuestion(p) {
      const s = p.safekeeping;
      return 'Move the safekeeping copy of ' + p.name + ' (' + s.copy_path
        + (s.last ? ', ' + s.last.files + ' files, ' + sizeText(s.last.bytes) : '')
        + ') to the Trash? The location stays set; the next Copy to safekeeping copies everything again.';
    }
    function clearSafekeeping(p) {
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/projects/safekeeping/clear', method: 'post',
          body: { slug: p.slug }, invalidates: [] });
        toast.success('The safekeeping copy of ' + p.name + ' is in the Trash.');
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
    }
    function copyToSafekeeping(p) {
      copyingProject = p.slug;
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/copy', method: 'post',
          body: { slug: p.slug }, invalidates: [] });
        toast.success('Copied ' + p.name + ': ' + (r.copied - 2) + ' files new or changed, ' + r.skipped
          + ' unchanged, ' + sizeText(r.bytes) + ' in all.');
      } catch (e) {
        toast.error(e.message);
      }
      copyingProject = '';
      projects.refetch();
    }
    // A stray item's Delete (the Projects page): the question the click asks
    // first, and the move to the macOS Trash once the answer is yes.
    function strayQuestion(item) {
      return 'Move ' + item.path + ' (' + sizeText(item.bytes) + ') to the Trash? '
        + 'Its space comes back when you empty the Trash.';
    }
    function deleteStray(item) {
      try {
        Actions.callApi({ url: 'http://127.0.0.1:8765/projects/stray/delete', method: 'post',
          body: { slug: item.slug, path: item.path }, invalidates: [] });
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
    }
    // A category's clean-up button (the Projects page). cleanPlan asks the
    // server what the button would remove, without removing it ({files,
    // bytes}; null, with a note, when that is nothing); cleanQuestion words
    // the confirmation from it; cleanProject does it.
    function cleanPlan(action) {
      try {
        const plan = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/clean', method: 'post',
          body: { slug: action.slug, what: action.what, days: action.days, dry: true }, invalidates: [] });
        if (!plan.files) {
          toast(action.days ? 'Nothing here was deleted more than ' + action.days + ' days ago.' : 'Nothing to clean up.');
          return null;
        }
        return plan;
      } catch (e) {
        toast.error(e.message);
        return null;
      }
    }
    function cleanQuestion(action, plan) {
      return 'Move ' + plan.summary + ' (' + sizeText(plan.bytes) + ') from ' + action.project
        + ' to the Trash? ' + action.warning + ' The space comes back when you empty the Trash.';
    }
    function cleanProject(action) {
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/clean', method: 'post',
          body: { slug: action.slug, what: action.what, days: action.days }, invalidates: [] });
        toast.success('Moved ' + sizeText(r.bytes) + ' to the Trash, as ' + r.as + '.');
      } catch (e) {
        toast.error(e.message);
      }
      projects.refetch();
    }
    function switchProject(path, body, label) {
      try {
        const r = Actions.callApi({ url: 'http://127.0.0.1:8765/projects/' + path, method: 'post', body: body, invalidates: [] });
        if (r.restarting) {
          playing = '';
          scene = null;
          opening = label;
        } else {
          projects.refetch();
        }
        return true;
      } catch (e) {
        toast.error(e.message);
        return false;
      }
    }
  </script>
  <!-- Joins every take, in list order, into one MP4 (media/exports/). -->
  <APICall id="exportTakes" method="post" url="http://127.0.0.1:8765/export"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="reorderTakes" method="post" url="http://127.0.0.1:8765/reorder"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- The Projects page's drag order, saved to projects/.order. -->
  <APICall id="reorderProjects" method="post" url="http://127.0.0.1:8765/projects/reorder"
    body="{$param}" invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <APICall id="deleteTake" method="post" url="http://127.0.0.1:8765/delete"
    body="{{ id: $param }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />
  <!-- Undo the last delete: serve_media.py restores the take, its files and its
       callouts from the .trash/<stem>.json that /delete wrote. The Undo line binds
       to deleteTake.lastResult (https://www.xmlui.org/docs/howto/consume-an-apicall-response);
       dismissedUndo hides it once used; the next delete replaces it. (A ✕ beside Undo read as "cancel the delete" and was clicked for that, 2026-09-28.) No onSuccess on either call:
       an Inspector trace (2026-09-28) showed deleteTake's onSuccess, run from a
       DndItems row, logging success:start but never success:end, which holds
       lastResult back until the 30s handler timeout. Waiting on xmlui-org/xmlui#3924
       (FIFO scheduler; fine with strictDeterminism false, which we don't want). -->
  <APICall id="undeleteTake" method="post" url="http://127.0.0.1:8765/undelete"
    body="{{ undo: $param }}"
    invalidates="{[]}"
    errorNotificationMessage="{$error.message}" />

  <!-- Audio recording test: serve_media.py runs voicetest.py, which records 10s
       with the chosen mic and recorder and adds a voice_tests row. -->
  <DataSource id="devices" url="http://127.0.0.1:8765/devices" />
  <DataSource id="voiceTests" url="http://127.0.0.1:8765/query/shared" method="POST" dataType="sql"
    body="{{ sql: 'SELECT * FROM voice_tests ORDER BY created_at DESC', params: [] }}" />
  <APICall id="voiceTest" method="post" url="http://127.0.0.1:8765/voicetest"
    body="{$param}"
    onSuccess="voiceTests.refetch()"
    errorNotificationMessage="{$error.message}" />

  <AppHeader>
    <HStack verticalAlignment="center" width="100%">
      <H3>Bram Studio</H3>
      <!-- The open project, so it is always clear which one a recording
           will land in. It is here, not in the nav panel: the panel's logo
           slot doesn't wrap, and clipped a long name at both ends. -->
      <Text variant="secondary" value="{projects.value ? projects.value.name : ''}" />
      <SpaceFiller />
      <!-- XMLUI trace viewer. The studio carries its own xs-diff.html and the
           xmlui-parser.es.js it imports (vendor/), as it carries its own engine;
           config.json's xmluiConfig.xsVerbose turns capture on. Capture costs
           time in every handler, so the button beside it turns it off and on:
           serve_media.py's /trace rewrites config.json, and since the engine
           reads it only at startup, the page reloads (location.reload() as in
           https://www.xmlui.org/docs/globals#resetlocalstorage). xmluiConfig
           isn't visible to markup (https://www.xmlui.org/docs/xmlui-config),
           so the button reads the setting from GET /trace (traceState). -->
      <DataSource id="traceState" url="http://127.0.0.1:8765/trace" />
      <Button size="xs" variant="ghost" label="{traceState.value?.on ? 'Trace on' : 'Trace off'}"
        tooltip="{traceState.value?.on ? 'Trace capture is on (Inspector can export). Click to turn it off and reload.' : 'Trace capture is off (faster). Click to turn it on and reload.'}"
        onClick="
          Actions.callApi({ url: 'http://127.0.0.1:8765/trace', method: 'post', invalidates: [],
                            body: { on: !traceState.value?.on } });
          location.reload();
        " />
      <Inspector src="/vendor/xs-diff.html"
        tooltip="{traceState.value?.on ? 'Inspector: XMLUI trace' : 'Inspector: trace capture is off, so there is nothing to export (turn it on with Trace off)'}" />
    </HStack>
  </AppHeader>
  <NavPanel>
    <property name="logoTemplate">
      <Fragment/>
    </property>
    <property name="footerTemplate">
      <Fragment/>
    </property>
    <NavLink label="Projects" to="/projects" />
    <NavLink label="Scenes" to="/" />
    <NavLink label="Exports" to="/exports" />
    <NavLink label="Audio" to="/bench" />
  </NavPanel>
  <Pages fallbackPath="/">
    <!-- Projects: a screencast each, a folder under projects/ (studio_paths.py).
         Open switches Studio to one; Create makes an empty one and opens it.
         Both go through switchProject (above). Rows are laid out like the
         Exports page's. -->
    <Page url="/projects">
      <!-- A clean-up's confirmation, opened with {action, plan}
           (https://www.xmlui.org/docs/howto/choose-between-imperative-and-state-driven-modal-dialogs):
           the plan's summary counts what means something (sessions, takes,
           edits), not files, which a take recorded with ink runs into the
           thousands; below it, the folders things would go from, largest
           first, each an expander listing what in it would go
           (clean_summary in serve_media.py). Nothing moves until Move to
           Trash. -->
      <ModalDialog id="cleanDialog" title="{$param ? 'Clean up: ' + $param.action.category : ''}">
        <Text variant="strong" value="{$param ? 'You lose: ' + $param.action.loses + '.' : ''}" />
        <Text value="{$param ? cleanQuestion($param.action, $param.plan) : ''}" />
        <Text variant="strong" value="What would go" />
        <Items data="{$param ? $param.plan.tree : []}">
          <ExpandableItem iconPosition="start" fullWidthSummary="true">
            <property name="summary">
              <HStack width="100%" verticalAlignment="center">
                <Text value="{$item.path}" width="*" />
                <Text value="{$item.count + ($item.count === 1 ? ' item' : ' items')}" width="90px" />
                <Text value="{sizeText($item.bytes)}" width="90px" />
              </HStack>
            </property>
            <VStack gap="0">
              <Items data="{$item.items}">
                <HStack>
                  <Text variant="secondary" value="{$item.name + ($item.folder ? '/' : '')}" width="*" />
                  <Text variant="secondary" value="{sizeText($item.bytes)}" width="90px" />
                </HStack>
              </Items>
              <Text when="{$item.more > 0}" variant="secondary" value="{'and ' + $item.more + ' more'}" />
            </VStack>
          </ExpandableItem>
        </Items>
        <HStack horizontalAlignment="end">
          <Button label="Keep" variant="ghost" onClick="cleanDialog.close()" />
          <Button label="Move to Trash" themeColor="attention"
            onClick="
              const action = $param.action;
              cleanDialog.close();
              cleanProject(action);
            " />
        </HStack>
      </ModalDialog>
      <!-- Sizes are worked out when the list is fetched (project_usage in
           serve_media.py): at load, after a switch or an action here, and
           whenever the server's change stream says takes, exports or a
           project folder changed (the EventSource above), so there is no
           Refresh button. -->
      <H2>Projects</H2>
      <Text variant="secondary" when="{projects.value &amp;&amp; projects.value.projects.length === 0}"
        value="No projects yet: this Studio keeps its scenes in the repo itself (see README, Where things are kept). Create one below to start a new screencast." />
      <!-- Each project is one line, so the page can be scanned: an expander
           (https://www.xmlui.org/docs/reference/components/ExpandableItem)
           whose summary is the project's row, closed until clicked. Inside:
           what its disk space is for, one line a category, then anything in
           its folder that isn't Studio's (an editor's project folder, a stray
           file), each with Delete. Open sits beside the expander, not in its
           summary, so clicking it doesn't also toggle the details. The inner
           lists have their own $item
           (https://www.xmlui.org/docs/reference/components/Items), so a stray
           row carries its project's slug itself. The list is a drag list like
           the Takes list (DndItems, the xmlui-dnd-list extension): only the
           grip drags, and the order is saved to projects/.order. -->
      <DndItems data="{projects.value ? projects.value.projects : []}" dragHandle="true"
        onReorder="(newOrder) => {
          reorderProjects.execute({ slugs: newOrder.map(p => p.slug) });
          projects.refetch();
        }">
        <HStack verticalAlignment="start" width="100%">
        <ExpandableItem width="*" iconPosition="start" fullWidthSummary="true">
          <property name="summary">
            <!-- One run of text, not columns: spaced out, the facts read as
                 headers for the rows below, which they aren't. The facts
                 take what the name leaves (width="*") and wrap there, not
                 under the pencil, Open and Delete
                 (https://www.xmlui.org/docs/layout#hstack). -->
            <HStack verticalAlignment="center" width="100%" gap="$space-2">
              <Text value="{$item.name}" variant="{$item.open ? 'strong' : 'inherit'}" />
              <Text variant="secondary" value="{projectFacts($item)}" width="*" />
            </HStack>
          </property>
        <!-- Rows are parted by a light rule and a little padding, not a gap
             (borderBottom, as in
             https://www.xmlui.org/docs/howto/dock-elements-to-panel-edges). -->
        <VStack gap="0">
        <Items data="{$item.categories}">
          <HStack verticalAlignment="center" paddingLeft="$space-4" paddingVertical="$space-1"
            borderBottom="1px solid $color-surface-200" when="{($item.key !== 'stray' &amp;&amp; $item.key !== 'logs') || $item.bytes > 0}">
            <Text value="{$item.label}" width="170px" />
            <Text value="{sizeText($item.bytes)}" width="90px" />
            <Text variant="secondary" value="{$item.about}" width="*" />
            <!-- The category's clean-up buttons (CLEAN in serve_media.py;
                 none for takes, re-mix ingredients and exports). A click
                 first asks the server what would go, then asks you in
                 cleanDialog (below), which says what is lost and lets you
                 look through what would go. -->
            <!-- A column of its own on every row, buttons or not, so the
                 descriptions keep their width and the buttons line up. Two
                 buttons stack rather than sit side by side, which kept the
                 column narrow enough for a narrow window. The server sends
                 only buttons that would remove something now. -->
            <VStack width="210px" horizontalAlignment="end" gap="$space-1">
              <Items data="{$item.actions}">
                <Button label="{$item.label}" variant="outlined" size="sm" themeColor="attention"
                  tooltip="Move these to the Trash"
                  onClick="
                    const plan = cleanPlan($item);
                    if (plan) cleanDialog.open({ action: $item, plan: plan });
                  " />
              </Items>
              <!-- What the clean-up costs (LOSES in serve_media.py), under its
                   button, so which ones end an undo is plain before a click. -->
              <Text when="{$item.actions.length > 0}" variant="secondary" textAlign="end"
                value="{'You lose: ' + $item.loses}" />
            </VStack>
          </HStack>
        </Items>
        <Items data="{$item.stray}">
          <HStack verticalAlignment="center" paddingLeft="$space-4" paddingVertical="$space-1"
            borderBottom="1px solid $color-surface-200">
            <Text value="{$item.path + ($item.folder ? '/' : '')}" width="*" />
            <Text value="{sizeText($item.bytes)}" width="100px" />
            <!-- Asks first (https://www.xmlui.org/docs/howto/open-a-confirmation-before-delete). -->
            <Button label="Delete" variant="outlined" size="sm" themeColor="attention"
              tooltip="Move this to the Trash"
              onClick="
                const yes = confirm('Delete a stray item', strayQuestion($item), 'Move to Trash', 'Keep');
                if (yes) deleteStray($item);
              " />
          </HStack>
        </Items>
        <!-- Safekeeping, last in the project: a copy of the project in a
             folder you name (a OneDrive folder, say), of what can't be made
             again and what re-mixing needs (KEEP in serve_media.py). Copy is
             dimmed while nothing has changed since the last copy. -->
        <VStack gap="$space-1" paddingLeft="$space-4" paddingVertical="$space-2">
          <!-- The saved location reads as text with Change; Change turns it
               into a box, and the button becomes Set once the text differs
               (Cancel while it doesn't). With no location yet, the box shows.
               The box's text is kept per project in safeDrafts, through its
               onDidChange, as the Exports notes are (noteBuffer). -->
          <HStack verticalAlignment="center">
            <Text value="Safekeeping" width="170px" />
            <Text when="{!safeEditing($item, editingSafe)}" value="{$item.safekeeping.location}" width="*" />
            <TextBox when="{safeEditing($item, editingSafe)}" width="*" initialValue="{$item.safekeeping.location}"
              placeholder="A folder for copies, such as ~/Library/CloudStorage/OneDrive-Personal"
              onDidChange="(v) => setSafeDraft($item.slug, v)" />
            <Button label="{safeButtonLabel($item, editingSafe, safeDrafts)}" variant="outlined" size="sm"
              enabled="{safeButtonEnabled($item, editingSafe, safeDrafts)}"
              onClick="safeButton($item)" />
          </HStack>
          <HStack verticalAlignment="center">
            <Spinner when="{copyingProject === $item.slug}" />
            <Text variant="secondary" width="*"
              value="{copyingProject === $item.slug ? 'Copying…' : safekeepingNote($item.safekeeping)}" />
            <Button label="Copy to safekeeping" variant="outlined" size="sm"
              enabled="{$item.safekeeping.exists &amp;&amp; $item.safekeeping.changed_since !== false &amp;&amp; !copyingProject}"
              tooltip="{$item.safekeeping.changed_since === false ? 'Nothing has changed since the last copy' : 'Copy the scenes, their re-mix ingredients, exports and logs; unchanged files are skipped'}"
              onClick="copyToSafekeeping($item)" />
            <!-- A fresh start: the copy goes to the Trash (after asking), the
                 location stays, and the next Copy copies everything again. -->
            <Button label="Clear safekeeping" variant="outlined" size="sm" themeColor="attention"
              enabled="{$item.safekeeping.copy_exists &amp;&amp; !copyingProject}"
              tooltip="Move this project's safekeeping copy to the Trash, for a fresh start"
              onClick="
                const yes = confirm('Clear safekeeping', clearSafekeepingQuestion($item), 'Move to Trash', 'Keep');
                if (yes) clearSafekeeping($item);
              " />
          </HStack>
        </VStack>
        </VStack>
        </ExpandableItem>
        <!-- Rename: the pencil turns into a text box that saves the name when
             it loses focus (TextBox has no Enter event:
             https://www.xmlui.org/docs/reference/components/TextBox), if
             changed and not empty, as a scene's name does on the Scenes
             page (/projects/rename: only project.json's name changes, not the
             folder). Beside the expander, not in its summary, so clicking it
             doesn't toggle the details. -->
        <HStack horizontalAlignment="end" verticalAlignment="center" paddingTop="$space-2">
          <Button icon="pencil" size="xs" variant="ghost" when="{renamingProject !== $item.slug}"
            tooltip="Rename this project" enabled="{!opening}"
            onClick="projectDraft = $item.name; renamingProject = $item.slug;" />
          <TextBox when="{renamingProject === $item.slug}" width="220px" initialValue="{$item.name}" autoFocus="true"
            onDidChange="(v) => projectDraft = v"
            onLostFocus="
              const name = projectDraft.trim();
              renamingProject = '';
              if (name &amp;&amp; name !== $item.name) {
                try {
                  Actions.callApi({ url: 'http://127.0.0.1:8765/projects/rename', method: 'post', invalidates: [],
                                    body: { slug: $item.slug, name: name } });
                } catch (e) {
                  toast.error(e.message);
                }
                projects.refetch();
              }
            " />
        </HStack>
        <!-- The summary's own top padding (padding-summary-ExpandableItem),
             so this lines up with it. -->
        <HStack width="90px" horizontalAlignment="end" verticalAlignment="center" paddingTop="$space-2">
          <Text when="{$item.open}" variant="secondary" value="open" />
          <Button when="{!$item.open}" label="Open" variant="outlined" size="sm"
            enabled="{!opening}"
            tooltip="Switch Studio to this project"
            onClick="switchProject('open', { slug: $item.slug }, $item.name)" />
        </HStack>
        <!-- Delete, last on the row: the whole project folder to the Trash,
             under its own name, so dragging it back into projects/ restores
             it (delete_project in serve_media.py). Asks first
             (https://www.xmlui.org/docs/howto/open-a-confirmation-before-delete).
             Not the open project, which Studio is running on. -->
        <HStack width="80px" horizontalAlignment="end" verticalAlignment="center" paddingTop="$space-2">
          <Button label="Delete" variant="outlined" size="sm" themeColor="attention"
            enabled="{!$item.open &amp;&amp; !opening &amp;&amp; !copyingProject}"
            tooltip="{$item.open ? 'This is the open project: open another one to delete it' : 'Move this project to the Trash'}"
            onClick="
              const yes = confirm('Delete a project', deleteProjectQuestion($item), 'Move to Trash', 'Keep');
              if (yes) deleteProject($item);
            " />
        </HStack>
        </HStack>
      </DndItems>
      <!-- The same for what projects share: sources/ and the repo's media/. -->
      <H3 when="{projects.value &amp;&amp; projects.value.shared_stray.length > 0}">Stray items in shared folders</H3>
      <Items data="{projects.value ? projects.value.shared_stray : []}">
        <HStack verticalAlignment="center" paddingLeft="$space-4">
          <Text value="{$item.path + ($item.folder ? '/' : '')}" width="*" />
          <Text value="{sizeText($item.bytes)}" width="100px" />
          <Button label="Delete" variant="outlined" size="sm" themeColor="attention"
            tooltip="Move this to the Trash"
            onClick="
              const yes = confirm('Delete a stray item', strayQuestion($item), 'Move to Trash', 'Keep');
              if (yes) deleteStray($item);
            " />
        </HStack>
      </Items>
      <HStack verticalAlignment="center" when="{!!opening}">
        <Spinner />
        <Text value="{'Opening ' + opening + '…'}" />
      </HStack>
      <H2>New project</H2>
      <HStack verticalAlignment="center">
        <TextBox id="newProjectName" placeholder="Name" width="260px" />
        <Button label="Create"
          enabled="{!!newProjectName.value &amp;&amp; !!newProjectName.value.trim() &amp;&amp; !opening}"
          tooltip="Make an empty project with this name and open it"
          onClick="
            if (switchProject('new', { name: newProjectName.value.trim() }, newProjectName.value.trim())) newProjectName.setValue('');
          " />
      </HStack>
    </Page>
    <Page url="/">
      <HStack verticalAlignment="center">
        <H2>Sources</H2>
        <Select id="sourceChoice" data="{sources}" valueField="name" labelField="name"
          placeholder="Choose a source"
          width="260px" onDidChange="audition = null; playing = ''; scene = null;" />
        <!-- Scene callouts (/scenes/callouts): each scene gets at most one
             3 s callout of its name at the top right, an ordinary item to
             edit on the Annotate tab, burned in by Export. The button
             previews (dryRun) and the dialog confirms. Hidden for now
             (2026-10-14): remove when="{false}" to bring it back. -->
        <Button when="{false}" label="Scene callouts" variant="outlined" size="sm"
          tooltip="Add a 3 s callout of each scene's name at its top right, to edit before you Export"
          enabled="{!!takes.value &amp;&amp; takes.value.length > 0}"
          onClick="
            try {
              calloutsDialog.open(Actions.callApi({ url: 'http://127.0.0.1:8765/scenes/callouts', method: 'post',
                                                    invalidates: [], body: { dryRun: true } }));
            } catch (e) {
              toast.error(e.message);
            }
          " />
        <Button label="Export" variant="outlined" size="sm"
          tooltip="Join all scenes, in list order, into one video (any scene whose items changed has them burned in first)"
          enabled="{!exportTakes.inProgress &amp;&amp; !!takes.value &amp;&amp; takes.value.length > 0}"
          onClick="startExport()" />
      </HStack>
      <!-- Scene callouts' confirmation: every scene, the callout it has (and
           whether it is applied), the one it would get, and any exact copies
           that would be removed; the button carries the plan out. -->
      <ModalDialog id="calloutsDialog" title="Scene callouts">
        <Text value="{$param &amp;&amp; ($param.add || $param.remove) ? 'Each scene gets one 3 s callout of its name at the top right, to edit before you Export.' : 'Every scene has its callout; there is nothing to add or remove.'}" />
        <Items data="{$param ? $param.scenes : []}">
          <Text value="{$item.name + ': ' + ($item.has ? 'has &quot;' + $item.has.text + '&quot; ' + ($item.has.applied ? '✓ applied' : '✗ not applied') : 'would add &quot;' + $item.add + '&quot;') + ($item.remove ? '; ' + $item.remove + ' duplicate' + ($item.remove === 1 ? '' : 's') + ' would be removed' : '')}" />
        </Items>
        <HStack>
          <Button when="{$param &amp;&amp; ($param.add || $param.remove)}" themeColor="primary"
            label="{$param ? [$param.add ? 'Add ' + $param.add + ' callout' + ($param.add === 1 ? '' : 's') : '', $param.remove ? 'Remove ' + $param.remove + ' duplicate' + ($param.remove === 1 ? '' : 's') : ''].filter((x) => x).join(' and ') : ''}"
            onClick="
              try {
                const r = Actions.callApi({ url: 'http://127.0.0.1:8765/scenes/callouts', method: 'post', invalidates: [], body: {} });
                toast.success([r.add ? 'Added ' + r.add + ' callout' + (r.add === 1 ? '' : 's') : '', r.remove ? 'removed ' + r.remove + ' duplicate' + (r.remove === 1 ? '' : 's') : ''].filter((x) => x).join(', ') || 'Nothing to change');
              } catch (e) {
                toast.error(e.message);
              }
              calloutsDialog.close();
              if (playing) editor.refresh();
            " />
          <Button label="{$param &amp;&amp; ($param.add || $param.remove) ? 'Cancel' : 'Close'}" variant="ghost"
            onClick="calloutsDialog.close()" />
        </HStack>
      </ModalDialog>
      <HStack verticalAlignment="center" when="{exportTakes.inProgress}">
        <Spinner />
        <Text value="Exporting scenes…" />
      </HStack>
      <!-- Capture: a take is a stretch of a source movie (/takes/clip), to be
           sequenced and then edited in the take editor (narration, pauses,
           annotations, cuts). The slider's two handles and the nudges set the
           stretch and the player only shows it, as on the Cut tab; the
           player's own scrubber and play/pause stay yours. Play clip, Intro
           and Outro hear it (playSourceAudition, for this player). Shown for the
           chosen source while no take is open: one player at a time.
           Collapsed behind "Make a scene", since an agent may have drafted
           the scenes already
           (https://www.xmlui.org/docs/reference/components/ExpandableItem). -->
      <ExpandableItem when="{!!sourceChoice.value &amp;&amp; !playing}" summary="Make a scene"
        iconPosition="start" fullWidthSummary="true">
        <VStack>
        <MediaPlayer id="sourcePlayer" maxHeight="55vh"
          src="{'http://127.0.0.1:8765/sources/' + encodeURIComponent(sourceChoice.value)}"
          onLoadedMetadata="(e) => { sourceAspect = e.videoWidth / e.videoHeight; srcDur = e.duration || 0; nextClipFrom(lastSceneEnd(sourceChoice.value)); }" />
        <Slider id="capSlider" width="100%" minValue="{0}" maxValue="{srcDur || 1}" step="{0.04}"
          initialValue="{capSeed}" minStepsBetweenThumbs="{13}"
          valueFormat="{(v) => mmss(v)}"
          enabled="{srcDur > 0 &amp;&amp; !clipBusy}"
          onDidChange="(v) => {
            audition = null;
            sourcePlayer.seek(v[0] !== capClip[0] ? v[0] : v[1]);
            capClip = v;
          }" />
        <HStack verticalAlignment="center">
          <TimeEdge what="Start" text="{mmss(capClip[0])}" enabled="{srcDur > 0}"
            onNudge="(d) => nudgeCap('start', d)" onToPlayhead="setCap('start', sourcePlayer.getCurrentTime())" />
          <TimeEdge what="End" text="{mmss(capClip[1])}" enabled="{srcDur > 0}"
            onNudge="(d) => nudgeCap('end', d)" onToPlayhead="setCap('end', sourcePlayer.getCurrentTime())" />
        </HStack>
        <HStack verticalAlignment="center">
          <Button label="Play scene" size="xs" variant="outlined" enabled="{srcDur > 0}"
            tooltip="Play the scene from start to end"
            onClick="playSourceAudition(capClip[0], capClip[1], 'capture-clip', true)" />
          <Button label="Intro 3s" size="xs" variant="outlined" enabled="{srcDur > 0}"
            tooltip="Play the scene's first 3 seconds"
            onClick="playSourceAudition(capClip[0], Math.min(capClip[0] + 3, capClip[1]), 'capture-intro', true)" />
          <Button label="Outro 3s" size="xs" variant="outlined" enabled="{srcDur > 0}"
            tooltip="Play the scene's last 3 seconds"
            onClick="playSourceAudition(Math.max(capClip[1] - 3, capClip[0]), capClip[1], 'capture-outro', true)" />
          <Button label="{'Make scene · ' + mmss(capClip[1] - capClip[0])}" size="xs" themeColor="primary"
            tooltip="Add this scene to the list, with the source's own sound, as the next Scene N (rename it there)"
            enabled="{srcDur > 0 &amp;&amp; !clipBusy}"
            handlerTimeoutMs:onClick="0"
            onClick="
              audition = null;
              clipBusy = true;
              try {
                const r = Actions.callApi({ url: 'http://127.0.0.1:8765/takes/clip', method: 'post', invalidates: [],
                                            body: { source: sourceChoice.value, start: capClip[0], end: capClip[1] } });
                toast.success('Added ' + (r &amp;&amp; r.name ? r.name : 'the scene'));
                // Ready for the next scene: it starts where this one ended.
                nextClipFrom(capClip[1]);
              } catch (e) {
                toast.error(e.message);
              }
              clipBusy = false;
            " />
          <Spinner when="{clipBusy}" />
        </HStack>
        </VStack>
      </ExpandableItem>
      <!-- At page level, so it runs for the capture view and the take editor
           alike (audition.src: the source player). An audition stops at its end (playSourceAudition), and yields to the
           player, whose scrubber and play/pause are always live: a pause
           ends it (one in its first 600 ms is the play() still starting,
           not the user), and so does a scrub, seen as the playhead more
           than 0.3 s from where playing would have taken it: audition.at
           (where it was found) plus the time since (audition.atMs). While
           starting up (its first 0.6 s: paused, or the seek to its start
           not landed yet), audition.at is its start, not what the player
           reports: the seek and the play() both land late, and a press made
           while the player sat at the last stop read that stale position,
           took the jump back for a scrub and played on past the end, every
           other time (2026-10-03, narr-preview yields at 13.4-13.7 s of a
           12.59-18.04 s stretch). A scrub is a jump forward past where
           playing could have taken the playhead (audition.at, where the last
           tick found it, plus the time since) or a jump back from where the
           last tick found it. Playback starting late only leaves the playhead
           behind schedule, never behind its last place: judged against the
           schedule both ways, a start that lagged 0.3 s while the Timer got
           no tick read as a scrub about 0.9 s in, every other press
           (2026-10-03, 11.99-19.64 s yielded at 12.87 s). A yield is logged
           (yieldSourceAudition). -->
      <!-- Every 5 minutes the page logs its own size (studioPageHealth in
           index.html) to serve_media.log as a page-health line: it got
           sluggish after days open and a refresh helped (2026-10-12).
           invalidates: [] keeps the post from refetching every list. -->
      <Timer interval="300000"
        onTick="
          try {
            Actions.callApi({ url: 'http://127.0.0.1:8765/page/health', method: 'post', invalidates: [],
                              body: window.studioPageHealth() });
          } catch (e) {
            // A missing log line is no reason to bother the user.
          }
        " />
      <Timer interval="40" enabled="{!!audition}"
        onTick="
          const P = sourcePlayer;
          const t = P.getCurrentTime();
          const now = Date.now();
          const young = !!audition &amp;&amp; now - audition.startedMs &lt; 600;
          const landed = !!audition &amp;&amp; t >= audition.start - 0.15 &amp;&amp; t &lt;= audition.start + 0.9;
          if (audition &amp;&amp; P.paused) {
            audition = now - audition.startedMs > 600 ? null : { ...audition, at: audition.start, atMs: now };
          } else if (audition &amp;&amp; young &amp;&amp; !landed) {
            audition = { ...audition, at: audition.start, atMs: now };
          } else if (audition &amp;&amp; (t > audition.at + (now - audition.atMs) / 1000 + 0.3 || t &lt; audition.at - 0.3)) {
            yieldSourceAudition(t);
          } else if (audition &amp;&amp; t >= audition.stop) {
            endSourceAudition();
          } else {
            audition = { ...audition, at: t, atMs: now };
          }
        " />
      <!-- The open scene's editor (components/SceneEditor.xmlui), in its
           own scope so an edit doesn't re-evaluate this page. -->
      <SceneEditor id="editor" when="{!!playing}" scene="{scene}" dictating="{dictating}"
        duration="{scene ? ((takes.value || []).find((t) => t.id === scene.id) || { duration_s: 0 }).duration_s : 0}"
        onClose="playing = ''; scene = null;" />
      <!-- Takes as a drag-reorderable list (DndItems, the xmlui-dnd-list extension
           Bram's queue uses): only the grip drags, so the row's buttons stay live.
           The order is saved to takes.position via POST /reorder. New takes go to
           the top (register.py). -->
      <HStack when="{deleteTake.lastResult &amp;&amp; deleteTake.lastResult.undo !== dismissedUndo}"
        verticalAlignment="center">
        <Text value="Deleted {deleteTake.lastResult.name}." />
        <Button label="Undo" size="sm" variant="outlined"
          onClick="
            dismissedUndo = deleteTake.lastResult.undo;
            undeleteTake.execute(dismissedUndo);
          " />
      </HStack>
      <DndItems data="{takes}" dragHandle="true"
        onReorder="(newOrder) => {
          reorderTakes.execute({ ids: newOrder.map(t => t.id) });
        }">
        <!-- The open scene's row is tinted, as the Undo tab tints its
             current edit. -->
        <HStack width="100%" verticalAlignment="center" paddingVertical="$space-2" paddingHorizontal="$space-2"
          borderRadius="$space-1"
          backgroundColor="{playing === $item.url ? '$color-primary-100' : 'transparent'}">
          <!-- A take's warning, set when it was registered (only takes
               recorded live by the retired record.sh have one: an empty take,
               with what the player reported at Stop). -->
          <Icon name="warning" when="{$item.warning}" tooltip="{$item.warning}" />
          <!-- The name is a link that opens the scene in the editor, paused at
               its start (nothing plays by itself; Link's click event:
               https://www.xmlui.org/docs/reference/components/Link). The pencil
               turns it into a text box, which saves when it loses focus
               (TextBox has no Enter event:
               https://www.xmlui.org/docs/reference/components/TextBox), if
               changed and not empty. One scene at a time. -->
          <Link when="{renamingTake !== $item.id}" label="{$item.name}" tooltip="Open this scene"
            onClick="openScene($item)" />
          <TextBox when="{renamingTake === $item.id}" width="320px" initialValue="{$item.name}" autoFocus="true"
            onDidChange="(v) => renameDraft = v"
            onLostFocus="
              const name = renameDraft.trim();
              renamingTake = null;
              if (name &amp;&amp; name !== $item.name) {
                try {
                  Actions.callApi({ url: 'http://127.0.0.1:8765/takes/rename', method: 'post', invalidates: [],
                                    body: { id: $item.id, name: name } });
                } catch (e) {
                  toast.error(e.message);
                }
              }
            " />
          <Button icon="pencil" size="xs" variant="ghost" when="{renamingTake !== $item.id}"
            aria-label="Rename scene" tooltip="Rename this scene"
            onClick="renameDraft = $item.name; renamingTake = $item.id;" />
          <SpaceFiller />
          <Text value="{$item.recorded}" width="110px" />
          <Text value="{$item.duration_s + 's'}" width="70px" />
          <Text value="{$item.source}" width="160px" />
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete scene" tooltip="Delete this scene (moves the MP4 to media/.trash; Undo brings it back)"
            onClick="
              if (playing === $item.url) playing = '';
              deleteTake.execute($item.id);
            " />
        </HStack>
      </DndItems>
    </Page>
    <!-- Exports, a page of its own between Takes and Audio (it was a
         collapsible panel on the Takes page until 2026-10-01). The finishing
         workflow, two sections, each newest first: when, how long, a link, a
         note, and delete. Exports is everything in media/exports/ that isn't
         leveled (what Export makes, and anything an editor saved there);
         Leveled exports is what Level wrote. The Takes page's Export button
         comes here, so the new file's "writing…" row is seen. -->
    <Page url="/exports">
      <!-- One Theme around the lists, not one per row: small spinners
           (https://www.xmlui.org/docs/howto/scope-theme-outside-loops). A
           row whose file an editor is still writing shows "writing… N MB" and
           waits to offer Level. -->
      <Theme size-Spinner="1em">
      <H2>Exports</H2>
      <HStack verticalAlignment="center" when="{exportTakes.inProgress}">
        <Spinner />
        <Text value="Exporting scenes…" />
      </HStack>
      <Text variant="secondary" when="{exports.value &amp;&amp; exports.value.exports.length === 0}"
        value="Nothing exported yet." />
      <!-- Each export takes two lines, in both sections. First: time 110px,
           length 150px, the name. Second: mic, the note (all the width
           that's left; a leveled row's loudness beneath it), its ✕, Level
           (unleveled only) and delete, which ends the line in both sections,
           so the trash cans line up. On one line the fixed columns left the
           note a third of a wide window and almost nothing of a narrow one.
           Exports holds every file here that isn't leveled. One that isn't
           exactly what Export wrote (an editor saved over it, or beside it)
           carries an "edited" tag; the note says what was done. -->
      <Items data="{exports.value ? exports.value.exports : []}">
        <VStack gap="$space-1" paddingBottom="$space-3">
        <HStack verticalAlignment="center">
          <Text value="{$item.created.substring(5, 16)}" width="110px" />
          <HStack width="150px" verticalAlignment="center" gap="$space-1">
            <Text when="{!$item.writing}" value="{$item.seconds + 's'}" />
            <Spinner when="{$item.writing}" />
            <Text when="{$item.writing}" variant="secondary" value="{'writing… ' + ($item.bytes / 1048576).toFixed(1) + ' MB'}" />
          </HStack>
          <HStack width="*" verticalAlignment="center" gap="$space-2">
            <Link to="{$item.url}" target="_blank" label="{$item.name}" />
            <Text variant="secondary" when="{$item.edited}" value="edited" />
          </HStack>
        </HStack>
        <HStack verticalAlignment="center">
          <HStack width="*" verticalAlignment="center" gap="$space-1">
            <Button variant="ghost" label="{dictating === noteKey($item) ? '⏹' : '🎤'}"
              tooltip="{dictating === noteKey($item) ? 'Stop dictating (or press Enter)' : 'Dictate a note'}"
              enabled="{!dictating || dictating === noteKey($item)}"
              onClick="dictating === noteKey($item) ? stopDictation($item) : startDictation($item, noteBox)" />
            <Form width="*" hideButtonRow="true" onSubmit="submitNote($item)">
              <TextArea id="noteBox" width="100%" placeholder="Note…" autoSize="true" maxRows="3" initialValue="{$item.note}"
                onGotFocus="noteBuffer = $item.note || ''; noteEdited = false"
                onDidChange="(v) => { noteBuffer = v; noteEdited = true; window.studioDictationValue(noteKey($item), v); }"
                onLostFocus="if (dictating !== noteKey($item)) commitNote($item)" />
            </Form>
            <Button icon="close" variant="ghost" aria-label="Clear note" tooltip="Clear this note"
              enabled="{!!$item.note &amp;&amp; dictating !== noteKey($item)}"
              onClick="clearNote($item)" />
          </HStack>
          <!-- An export that needs no editing can be leveled directly. -->
          <HStack width="100px" horizontalAlignment="end">
            <Button label="Level" variant="outlined" size="sm"
              enabled="{!levelExport.inProgress &amp;&amp; !$item.writing}"
              tooltip="Cut rumble and even out loudness (level_edit.py) into leveled-…mp4"
              onClick="
                levelExport.execute($item);
                exports.refetch();
              " />
          </HStack>
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete export" tooltip="Delete this export (moves it to media/.trash)"
            onClick="
              deleteExport.execute($item);
              exports.refetch();
            " />
        </HStack>
        </VStack>
      </Items>
      <HStack verticalAlignment="center" when="{levelExport.inProgress}">
        <Spinner />
        <Text value="Leveling…" />
      </HStack>
      <H2>Leveled exports</H2>
      <Text variant="secondary" when="{exports.value &amp;&amp; exports.value.leveled.length === 0}"
        value="Click Level on an export." />
      <!-- A leveled row's second line is aligned to its top: the loudness
           report under the note makes the note's column taller than the
           buttons beside it. -->
      <Items data="{exports.value ? exports.value.leveled : []}">
        <VStack gap="$space-1" paddingBottom="$space-3">
        <HStack verticalAlignment="center">
          <Text value="{$item.created.substring(5, 16)}" width="110px" />
          <HStack width="150px" verticalAlignment="center" gap="$space-1">
            <Text when="{!$item.writing}" value="{$item.seconds + 's'}" />
            <Spinner when="{$item.writing}" />
            <Text when="{$item.writing}" variant="secondary" value="{'writing… ' + ($item.bytes / 1048576).toFixed(1) + ' MB'}" />
          </HStack>
          <Link to="{$item.url}" target="_blank" label="{$item.name}" width="*" />
        </HStack>
        <HStack verticalAlignment="start">
          <HStack width="*" verticalAlignment="start" gap="$space-1">
            <Button variant="ghost" label="{dictating === noteKey($item) ? '⏹' : '🎤'}"
              tooltip="{dictating === noteKey($item) ? 'Stop dictating (or press Enter)' : 'Dictate a note'}"
              enabled="{!dictating || dictating === noteKey($item)}"
              onClick="dictating === noteKey($item) ? stopDictation($item) : startDictation($item, leveledNoteBox)" />
            <Form width="*" hideButtonRow="true" onSubmit="submitNote($item)">
              <TextArea id="leveledNoteBox" width="100%" placeholder="Note…" autoSize="true" maxRows="3" initialValue="{$item.note}"
                onGotFocus="noteBuffer = $item.note || ''; noteEdited = false"
                onDidChange="(v) => { noteBuffer = v; noteEdited = true; window.studioDictationValue(noteKey($item), v); }"
                onLostFocus="if (dictating !== noteKey($item)) commitNote($item)" />
              <Text variant="secondary" value="{$item.report}" />
            </Form>
            <Button icon="close" variant="ghost" aria-label="Clear note" tooltip="Clear this note"
              enabled="{!!$item.note &amp;&amp; dictating !== noteKey($item)}"
              onClick="clearNote($item)" />
          </HStack>
          <Stack width="100px" />
          <Button icon="trash" variant="ghost" themeColor="attention"
            aria-label="Delete leveled export" tooltip="Delete this file (moves it to media/.trash)"
            onClick="
              deleteExport.execute($item);
              exports.refetch();
            " />
        </HStack>
        </VStack>
      </Items>
      </Theme>
    </Page>
    <Page url="/bench">
      <H2>Audio recording test</H2>
      <HStack verticalAlignment="center">
        <Select id="mic" data="{devices}" valueField="name" labelField="name"
          initialValue="MacBook Air Microphone" width="260px" />
        <Select id="recorderChoice" initialValue="ffmpeg-raw" width="300px">
          <Option value="ffmpeg-raw" label="ffmpeg raw (today's session.sh)" />
          <Option value="ffmpeg-async" label="ffmpeg + gap fill" />
          <Option value="native" label="native macOS (no ffmpeg)" />
        </Select>
        <Button label="Test (10s)" enabled="{!voiceTest.inProgress}"
          onClick="
            toast('Recording 10s: read the sentence below now');
            voiceTest.execute({ mic: mic.value, recorder: recorderChoice.value });
          " />
      </HStack>
      <Text>
        Read aloud: "She sells sea shells by the seashore, and the quick brown fox
        jumps past six sharp scissors."
      </Text>
      <Table data="{voiceTests}">
        <!-- Never show "No data available" (it flashes while data loads). -->
        <property name="noDataTemplate">
          <Fragment/>
        </property>
        <Column header="Tested" bindTo="created_at" width="190px" />
        <Column header="Mic" bindTo="mic" />
        <Column header="Recorder" bindTo="recorder" />
        <Column header="Expected s" bindTo="expected_s" />
        <Column header="Captured s" bindTo="captured_s" />
        <Column header="Short %" bindTo="short_pct" />
        <Column header="Clicks" bindTo="clicks" />
        <Column header="Peak dB" bindTo="peak_db" />
        <Column header="RMS dB" bindTo="rms_db" />
        <Column header="Play">
          <HStack>
            <Link to="{$item.raw_url}" target="_blank" label="raw" />
            <Link to="{$item.leveled_url}" target="_blank" label="leveled" />
          </HStack>
        </Column>
      </Table>

      <!-- Audio playback test: MediaPlayer's kind="audio" (xmlui-org/xmlui#3913)
           on any take or source. An audio element plays an MP4's audio track,
           so no separate audio files are needed. -->
      <VStack var.audioLog="{[]}" var.audioDuration="">
        <H2>Audio playback test</H2>
        <HStack verticalAlignment="center">
          <Select id="audioChoice" placeholder="Play from…" width="480px"
            data="{[
              ...(takes.value || []).map(t => ({ label: 'Scene: ' + t.name.slice(0, 60), value: t.url })),
              ...(sources.value || []).map(x => ({ label: 'Source: ' + x.name, value: 'http://127.0.0.1:8765/sources/' + encodeURIComponent(x.name) }))
            ]}"
            onDidChange="audioLog = []; audioDuration = ''">
            <!-- A take's name is long enough to wrap, and a Select's wrapped
                 value centers by default (its face is a button). The
                 template's width and textAlign make it wrap from the left
                 (https://www.xmlui.org/docs/howto/customize-a-selects-selected-value). -->
            <property name="valueTemplate">
              <Text width="100%" textAlign="start" value="{$item.label}" />
            </property>
          </Select>
          <Button label="Clear log" variant="outlined" onClick="audioLog = []" />
        </HStack>
        <MediaPlayer kind="audio" when="{audioChoice.value}" src="{audioChoice.value}"
          onLoadedMetadata="(e) => audioDuration = e.duration.toFixed(2) + ' s'"
          onPlay="(e) => audioLog = [...audioLog, 'play at ' + e.currentTime.toFixed(2) + ' s']"
          onPause="(e) => audioLog = [...audioLog, 'pause at ' + e.currentTime.toFixed(2) + ' s']"
          onSeeked="(e) => audioLog = [...audioLog, 'seeked at ' + e.currentTime.toFixed(2) + ' s']"
          onEnded="(e) => audioLog = [...audioLog, 'ended at ' + e.currentTime.toFixed(2) + ' s']" />
        <Text when="{audioChoice.value}" value="Duration: {audioDuration || '(loading)'}" />
        <Items data="{audioLog}">
          <Text value="{$item}" />
        </Items>
      </VStack>
    </Page>
  </Pages>
</App>
